{
  "manifest_version": 3,
  "name": "Grabbn",
  "version": "1.0.0",
  "description": "Save links to your Grabbn buckets",
  "permissions": ["activeTab", "scripting", "storage", "cookies"],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://grabbn.com/*",
    "https://app.grabbn.com/*",
    "https://www.grabbn.com/*",
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to Seckop",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}

<%
  title = 'Report · ' + bucket.name
  page  = ''
%>
<%- include('partials/layout') %>

<div class="flex justify-center px-4 md:px-6 py-8">
    <div class="w-full max-w-lg flex flex-col gap-6">

        <!-- Back link -->
        <a href="/b/<%= bucketId %>" class="inline-flex items-center gap-1.5 text-xs text-gray-400 hover:text-orchid-600 transition-colors w-fit">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"><g fill="none"><path fill="currentColor" d="M7.828 11H20v2H7.828l4.95 4.95l-1.414 1.414L4 12l7.364-7.364l1.414 1.414z"/></g></svg>
            Back to bucket
        </a>

        <!-- Header -->
        <div>
            <h1 class="text-lg font-semibold text-woodsmoke-950">Report this bucket</h1>
            <p class="text-xs text-gray-400 mt-0.5">Help us keep the community safe. Your report is anonymous.</p>
        </div>

        <!-- Bucket card (read-only preview) -->
        <div class="flex items-center gap-3 p-3 rounded-xl border border-silver-100 bg-silver-50">
            <div class="w-14 h-14 rounded-lg bg-silver-100 overflow-hidden shrink-0 border border-silver-200">
                <% if (thumbnailUrl) { %>
                <img src="<%= imgSrc(thumbnailUrl) %>" alt="<%= bucket.name %>" class="w-full h-full object-cover" onerror="this.style.display='none'">
                <% } else { %>
                <div class="w-full h-full flex items-center justify-center text-silver-300">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24"><g fill="none"><path fill="currentColor" d="M20 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2zm0 2H4v10.1l4.995-4.994a1.25 1.25 0 0 1 1.768 0l4.065 4.066l1.238-1.238a1.25 1.25 0 0 1 1.768 0L20 15.101zm-4.5 2a1.5 1.5 0 1 1 0 3a1.5 1.5 0 0 1 0-3"/></g></svg>
                </div>
                <% } %>
            </div>
            <div class="min-w-0 flex-1">
                <p class="text-sm font-semibold text-woodsmoke-900 truncate"><%= bucket.name %></p>
                <p class="text-xs text-gray-400 truncate">by @<%= curatorName %></p>
                <p class="text-xs text-gray-400 mt-0.5"><%= bucket.links.length %> link<%= bucket.links.length !== 1 ? 's' : '' %></p>
            </div>
        </div>

        <!-- Report form -->
        <form id="reportForm" class="flex flex-col gap-5">

            <!-- Reason -->
            <div class="flex flex-col gap-2">
                <label class="text-xs font-semibold text-woodsmoke-700">Reason <span class="text-red-400">*</span></label>
                <div class="flex flex-col gap-2" id="reasonGroup">
                    <% var reportOptions = [
                        { value: 'spam',           label: 'Spam or self-promotion' },
                        { value: 'malicious',      label: 'Malicious or dangerous links' },
                        { value: 'inappropriate',  label: 'Inappropriate or offensive content' },
                        { value: 'copyright',      label: 'Copyright infringement' },
                    ];
                    if (!bucket.mature) {
                        reportOptions.push({ value: 'mature_content', label: 'Contains mature or adult content not flagged by the curator' });
                    }
                    reportOptions.push({ value: 'other', label: 'Other' });
                    reportOptions.forEach(function(opt) { %>
                    <label class="flex items-center gap-2.5 cursor-pointer group">
                        <span class="relative w-4 h-4 shrink-0">
                            <input type="radio" name="reason" value="<%= opt.value %>" class="peer absolute inset-0 opacity-0 cursor-pointer w-full h-full m-0">
                            <span class="absolute inset-0 rounded-full border-2 border-silver-300 peer-checked:border-orchid-500 transition-colors"></span>
                            <span class="absolute inset-0 flex items-center justify-center opacity-0 peer-checked:opacity-100 transition-opacity pointer-events-none">
                                <span class="w-2 h-2 rounded-full bg-orchid-500"></span>
                            </span>
                        </span>
                        <span class="text-sm text-woodsmoke-700 group-hover:text-woodsmoke-950 transition-colors"><%= opt.label %></span>
                    </label>
                    <% }); %>
                </div>
            </div>

            <!-- Optional detail -->
            <div class="flex flex-col gap-1.5">
                <label for="reportDetail" class="text-xs font-semibold text-woodsmoke-700">Additional details <span class="text-gray-400 font-normal">(optional)</span></label>
                <textarea id="reportDetail" name="detail" rows="3" maxlength="500" placeholder="Describe the issue in more detail…"
                    class="w-full px-3 py-2 text-sm rounded-lg border border-silver-200 bg-white text-woodsmoke-900 placeholder-gray-300 resize-none focus:outline-none focus:ring-2 focus:ring-orchid-300 focus:border-orchid-400 transition"></textarea>
                <p class="text-[11px] text-gray-300 text-right"><span id="detailCount">0</span> / 500</p>
            </div>

            <!-- Submit -->
            <div class="flex items-center gap-3">
                <button type="submit" id="reportSubmitBtn"
                    class="h-9 px-5 text-xs font-semibold rounded-md bg-red-500 hover:bg-red-600 text-white transition-colors">
                    Submit report
                </button>
                <a href="/b/<%= bucketId %>" class="text-xs text-gray-400 hover:text-woodsmoke-600 transition-colors">Cancel</a>
            </div>

            <!-- Feedback message -->
            <p id="reportFeedback" class="hidden text-xs"></p>

        </form>

    </div>
</div>

<script>
    const bucketId = '<%= bucketId %>';

    // Character counter
    const detailEl = document.getElementById('reportDetail');
    const countEl  = document.getElementById('detailCount');
    detailEl.addEventListener('input', function () {
        countEl.textContent = detailEl.value.length;
    });

    // Submit
    document.getElementById('reportForm').addEventListener('submit', async function (e) {
        e.preventDefault();
        const reason = document.querySelector('input[name="reason"]:checked')?.value;
        if (!reason) {
            showFeedback('Please select a reason.', false);
            return;
        }
        const detail  = detailEl.value.trim();
        const btn     = document.getElementById('reportSubmitBtn');
        btn.disabled  = true;
        btn.textContent = 'Submitting…';
        try {
            const res = await fetch('/api/buckets/' + bucketId + '/report', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                credentials: 'include',
                body: JSON.stringify({ reason, detail: detail || undefined }),
            });
            if (res.ok) {
                showFeedback('Report submitted. Thank you for helping keep the community safe.', true);
                document.getElementById('reportForm').querySelectorAll('input, textarea, button').forEach(el => el.disabled = true);
            } else if (res.status === 409) {
                showFeedback('You have already reported this bucket.', false);
                btn.disabled = false;
                btn.textContent = 'Submit report';
            } else if (res.status === 401) {
                showFeedback('You need to be signed in to submit a report.', false);
                btn.disabled = false;
                btn.textContent = 'Submit report';
            } else {
                showFeedback('Something went wrong. Please try again.', false);
                btn.disabled = false;
                btn.textContent = 'Submit report';
            }
        } catch (_) {
            showFeedback('Something went wrong. Please try again.', false);
            btn.disabled = false;
            btn.textContent = 'Submit report';
        }
    });

    function showFeedback(msg, success) {
        const el = document.getElementById('reportFeedback');
        el.textContent = msg;
        el.className = 'text-xs ' + (success ? 'text-green-600' : 'text-red-500');
        el.classList.remove('hidden');
    }
</script>

<%- include('partials/layout-end') %>

<%
  title          = 'Danger Zone'
  page           = 'settings'
  settingsSection = 'danger'
%>
<%- include('partials/layout') %>

<div class="flex flex-1 overflow-hidden justify-center">
  <div class="flex w-full max-w-[992px] overflow-hidden">

    <%- include('partials/settings-nav') %>

    <!-- Content area -->
    <div class="flex-1 overflow-y-auto">
      <div class="w-full px-6 py-6">

        <% if (user && !user.isAnonymous) { %>

        <!-- ── Data ──────────────────────────────────────────────────────────── -->
        <div class="border border-silver-200 rounded-md divide-y divide-silver-100 mb-6">

          <div class="px-5 py-4">
            <p class="text-sm font-semibold uppercase tracking-wide text-woodsmoke-400">Your data</p>
          </div>

          <div class="px-5 py-4 flex items-center justify-between gap-4">
            <div class="flex flex-col gap-0.5 min-w-0">
              <span class="text-sm font-semibold text-woodsmoke-900">Export your data</span>
              <span class="text-sm text-woodsmoke-400">Download a copy of your buckets, grabs and account information</span>
            </div>
            <button id="exportBtn" class="flex items-center justify-center text-sm font-semibold px-5 h-9 border border-silver-200 rounded-md text-woodsmoke-600 hover:border-woodsmoke-300 transition-colors shrink-0 opacity-50 cursor-not-allowed" disabled>
              Export
            </button>
          </div>

        </div>

        <!-- ── Delete Account ─────────────────────────────────────────────────── -->
        <div class="border border-red-200 rounded-md divide-y divide-red-100 mb-6">

          <div class="px-5 py-4">
            <p class="text-sm font-semibold uppercase tracking-wide text-red-400">Danger zone</p>
          </div>

          <div class="px-5 py-4">
            <div class="flex items-start justify-between gap-4" id="deleteDisplay">
              <div class="flex flex-col gap-0.5 min-w-0">
                <span class="text-sm font-semibold text-woodsmoke-900">Delete account</span>
                <span class="text-sm text-woodsmoke-400">Permanently delete your account and all associated data. This cannot be undone.</span>
              </div>
              <button id="deleteShowBtn" class="flex items-center justify-center text-sm font-semibold px-5 h-9 border border-red-200 rounded-md text-red-500 hover:bg-red-50 transition-colors shrink-0">
                Delete account
              </button>
            </div>

            <!-- Confirm form (hidden by default) -->
            <div id="deleteConfirm" class="hidden mt-4 p-4 bg-red-50 border border-red-100 rounded-lg flex flex-col gap-3">
              <p class="text-sm text-red-700 font-medium">This will permanently delete your account, all your buckets, grabs and data. Type <strong>DELETE</strong> to confirm.</p>
              <input id="deleteConfirmInput" type="text" placeholder="Type DELETE to confirm"
                class="w-full h-10 px-3 text-sm border border-red-200 rounded-lg outline-none focus:border-red-400 bg-white transition-colors">
              <p id="deleteError" class="hidden text-sm text-red-500"></p>
              <div class="flex gap-2">
                <button id="deleteConfirmBtn" class="flex items-center justify-center h-9 px-5 text-sm font-semibold bg-red-500 text-white rounded-md hover:bg-red-600 transition-colors disabled:opacity-40 disabled:cursor-not-allowed">
                  Permanently delete
                </button>
                <button id="deleteCancelBtn" class="flex items-center justify-center h-9 px-5 text-sm font-semibold border border-silver-200 text-woodsmoke-600 rounded-md hover:bg-silver-50 transition-colors">
                  Cancel
                </button>
              </div>
            </div>
          </div>

        </div>

        <% } else { %>
          <p class="text-sm text-woodsmoke-400">Please <a href="/?openAuth=true" class="text-orchid-600 font-semibold hover:underline">sign in</a> to manage your settings.</p>
        <% } %>

      </div>
    </div>

  </div>
</div>

<script>
(function () {
  const showBtn      = document.getElementById('deleteShowBtn');
  const confirmBox   = document.getElementById('deleteConfirm');
  const cancelBtn    = document.getElementById('deleteCancelBtn');
  const confirmInput = document.getElementById('deleteConfirmInput');
  const confirmBtn   = document.getElementById('deleteConfirmBtn');
  const deleteError  = document.getElementById('deleteError');
  if (!showBtn) return;

  showBtn.addEventListener('click', () => {
    confirmBox.classList.remove('hidden');
    showBtn.classList.add('hidden');
    confirmInput.focus();
  });

  cancelBtn.addEventListener('click', () => {
    confirmBox.classList.add('hidden');
    showBtn.classList.remove('hidden');
    confirmInput.value = '';
    deleteError.classList.add('hidden');
  });

  confirmBtn.addEventListener('click', async () => {
    deleteError.classList.add('hidden');
    if (confirmInput.value.trim() !== 'DELETE') {
      deleteError.textContent = 'Please type DELETE exactly to confirm.';
      deleteError.classList.remove('hidden');
      return;
    }
    confirmBtn.disabled = true;
    confirmBtn.textContent = 'Deleting…';
    try {
      const res = await fetch('/api/user/account', {
        method: 'DELETE', credentials: 'include',
      });
      if (res.ok) {
        window.location.href = '/';
      } else {
        const data = await res.json().catch(() => ({}));
        deleteError.textContent = data.error || 'Something went wrong. Try again.';
        deleteError.classList.remove('hidden');
        confirmBtn.disabled = false;
        confirmBtn.textContent = 'Permanently delete';
      }
    } catch {
      deleteError.textContent = 'Something went wrong. Try again.';
      deleteError.classList.remove('hidden');
      confirmBtn.disabled = false;
      confirmBtn.textContent = 'Permanently delete';
    }
  });
})();
</script>

<%- include('partials/layout-end') %>

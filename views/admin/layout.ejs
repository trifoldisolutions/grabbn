<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> — Grabbn Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Jost:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/tailwind/output.css">
    <script>
        window.__ADMIN__ = {
            userId:   <%- JSON.stringify(admin?._id ?? null) %>,
            email:    <%- JSON.stringify(admin?.email ?? null) %>,
            username: <%- JSON.stringify(admin?.username ?? null) %>,
            role:     <%- JSON.stringify(admin?.role ?? null) %>
        };

        // ── Global admin helpers — defined here so all page scripts can use them ──

        /** Show a toast. type: 'success' | 'error' | 'info' */
        function showToast(msg, type = 'success') {
            const el  = document.getElementById('adminToast');
            const txt = document.getElementById('adminToastMsg');
            if (!el || !txt) return;
            const colors = { success: 'bg-emerald-600', error: 'bg-red-600', info: 'bg-woodsmoke-800' };
            el.className = el.className.replace(/bg-\S+/, '');
            el.classList.remove('hidden');
            el.classList.add(colors[type] || colors.info);
            txt.textContent = msg;
            clearTimeout(el._t);
            el._t = setTimeout(() => el.classList.add('hidden'), 3500);
        }

        /** Generic admin API call with error handling. */
        async function adminFetch(url, options = {}) {
            try {
                const res  = await fetch(url, {
                    headers: { 'Content-Type': 'application/json', ...options.headers },
                    ...options
                });
                const data = await res.json();
                if (!res.ok) throw new Error(data.error || 'Request failed');
                return data;
            } catch (err) {
                showToast(err.message, 'error');
                throw err;
            }
        }

        /** Simple confirm dialog wrapper — returns true/false. */
        function adminConfirm(msg) {
            return window.confirm(msg);
        }
    </script>
</head>

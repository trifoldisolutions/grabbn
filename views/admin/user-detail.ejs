<%
  title     = viewUser.username || viewUser.email || 'User Detail'
  subtitle  = 'User profile, stats and actions'
  adminPage = 'users'
%>
<%- include('layout') %>

<div class="p-6 space-y-5 max-w-5xl">

    <!-- ── Breadcrumb ──────────────────────────────────────────────────────── -->
    <nav class="flex items-center gap-2 text-xs text-woodsmoke-400">
        <a href="/admin/users" class="hover:text-orchid-600 transition-colors">Users</a>
        <span>/</span>
        <span class="text-woodsmoke-700"><%= viewUser.username || viewUser.email || viewUser._id %></span>
    </nav>

    <!-- ── Profile card ───────────────────────────────────────────────────── -->
    <div class="bg-white border border-silver-100 rounded-xl p-6 flex items-start gap-6">

        <!-- Avatar -->
        <div class="w-16 h-16 rounded-full bg-orchid-100 flex items-center justify-center text-orchid-600 text-2xl font-bold shrink-0">
            <% if (viewUser.avatar) { %>
                <img src="<%= viewUser.avatar %>" class="w-full h-full rounded-full object-cover" />
            <% } else { %>
                <%= (viewUser.username || viewUser.email || '?')[0].toUpperCase() %>
            <% } %>
        </div>

        <!-- Info -->
        <div class="flex-1 min-w-0 space-y-1">
            <div class="flex items-center gap-2 flex-wrap">
                <h2 class="text-base font-semibold text-woodsmoke-950"><%= viewUser.username || '(no username)' %></h2>
                <!-- Role badge -->
                <% if (viewUser.role === 'superadmin') { %>
                    <span class="px-2 py-0.5 rounded-full text-[11px] font-semibold bg-orchid-100 text-orchid-700">superadmin</span>
                <% } else if (viewUser.role === 'moderator') { %>
                    <span class="px-2 py-0.5 rounded-full text-[11px] font-semibold bg-blue-100 text-blue-700">moderator</span>
                <% } else { %>
                    <span class="px-2 py-0.5 rounded-full text-[11px] font-semibold bg-silver-100 text-woodsmoke-500">user</span>
                <% } %>
                <!-- Partner badge -->
                <% if (viewUser.isPartner) { %>
                    <span class="px-2 py-0.5 rounded-full text-[11px] font-semibold bg-amber-100 text-amber-700">partner</span>
                <% } %>
                <!-- Status badge -->
                <% if (viewUser.accountSuspendedAt) { %>
                    <span class="px-2 py-0.5 rounded-full text-[11px] font-semibold bg-red-100 text-red-700">suspended</span>
                <% } else if (!viewUser.isEmailVerified) { %>
                    <span class="px-2 py-0.5 rounded-full text-[11px] font-semibold bg-amber-100 text-amber-700">unverified</span>
                <% } else { %>
                    <span class="px-2 py-0.5 rounded-full text-[11px] font-semibold bg-emerald-100 text-emerald-700">active</span>
                <% } %>
                <!-- Flagged -->
                <% if (viewUser.flagged) { %>
                    <span class="px-2 py-0.5 rounded-full text-[11px] font-semibold bg-red-100 text-red-700">⚑ flagged</span>
                <% } %>
            </div>
            <div class="text-sm text-woodsmoke-500"><%= viewUser.email || '(no email)' %></div>
            <div class="flex flex-wrap gap-x-4 gap-y-1 text-xs text-woodsmoke-400 pt-1">
                <span>Joined <strong class="text-woodsmoke-700"><%= new Date(viewUser.createdAt).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) %></strong></span>
                <% if (viewUser.lastActive) { %>
                <span>Last active <strong class="text-woodsmoke-700"><%= new Date(viewUser.lastActive).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) %></strong></span>
                <% } %>
                <% if (viewUser.country) { %>
                <span>📍 <strong class="text-woodsmoke-700"><%= viewUser.country %><%= viewUser.region ? ` / ${viewUser.region}` : '' %></strong></span>
                <% } %>
            </div>
        </div>

        <!-- Stat pills -->
        <div class="flex flex-col gap-2 shrink-0 text-right">
            <div class="text-xs text-woodsmoke-400">Credits: <span class="font-semibold text-woodsmoke-900"><%= viewUser.credits ?? 0 %></span></div>
            <div class="text-xs text-woodsmoke-400">Stripe: <span class="font-semibold text-woodsmoke-900"><%= viewUser.stripeAccountStatus || 'none' %></span></div>
        </div>
    </div>

    <!-- ── Actions ────────────────────────────────────────────────────────── -->
    <div class="bg-white border border-silver-100 rounded-xl p-5">
        <h3 class="text-xs font-semibold text-woodsmoke-500 uppercase tracking-wider mb-4">Actions</h3>
        <div class="flex flex-wrap gap-2">

            <!-- Suspend / Unsuspend -->
            <% if (viewUser.accountSuspendedAt) { %>
            <button id="unsuspendBtn"
                class="h-8 px-4 text-xs font-semibold text-emerald-700 bg-emerald-50 hover:bg-emerald-100 rounded-md border border-emerald-200 transition-colors">
                Unsuspend Account
            </button>
            <% } else { %>
            <button id="suspendBtn"
                class="h-8 px-4 text-xs font-semibold text-red-700 bg-red-50 hover:bg-red-100 rounded-md border border-red-200 transition-colors">
                Suspend Account
            </button>
            <% } %>

            <!-- Force verify -->
            <% if (!viewUser.isEmailVerified) { %>
            <button id="verifyBtn"
                class="h-8 px-4 text-xs font-semibold text-blue-700 bg-blue-50 hover:bg-blue-100 rounded-md border border-blue-200 transition-colors">
                Force Verify Email
            </button>
            <% } %>

            <!-- Superadmin-only actions -->
            <% if (admin.role === 'superadmin') { %>

            <!-- Adjust credits -->
            <button id="creditsBtn"
                class="h-8 px-4 text-xs font-semibold text-woodsmoke-700 bg-silver-100 hover:bg-silver-200 rounded-md border border-silver-200 transition-colors">
                Adjust Credits
            </button>

            <!-- Change role (only if target is not a superadmin or is own account) -->
            <% if (viewUser._id.toString() !== admin._id.toString()) { %>
            <button id="roleBtn"
                class="h-8 px-4 text-xs font-semibold text-woodsmoke-700 bg-silver-100 hover:bg-silver-200 rounded-md border border-silver-200 transition-colors">
                Change Role
            </button>
            <% } %>

            <!-- Partner toggle -->
            <button id="partnerBtn"
                class="h-8 px-4 text-xs font-semibold text-amber-700 bg-amber-50 hover:bg-amber-100 rounded-md border border-amber-200 transition-colors">
                <%= viewUser.isPartner ? 'Revoke Partner' : 'Grant Partner' %>
            </button>

            <!-- Delete -->
            <% if (viewUser._id.toString() !== admin._id.toString() && viewUser.role !== 'superadmin') { %>
            <button id="deleteBtn"
                class="h-8 px-4 text-xs font-semibold text-white bg-red-600 hover:bg-red-700 rounded-md transition-colors ml-auto">
                Delete User
            </button>
            <% } %>

            <% } %> <!-- end superadmin actions -->

        </div>
    </div>

    <!-- ── Metadata ────────────────────────────────────────────────────────── -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">

        <div class="bg-white border border-silver-100 rounded-xl p-5">
            <h3 class="text-xs font-semibold text-woodsmoke-500 uppercase tracking-wider mb-3">Account Details</h3>
            <dl class="space-y-2 text-sm">
                <div class="flex justify-between">
                    <dt class="text-woodsmoke-400">User ID</dt>
                    <dd class="text-woodsmoke-700 font-mono text-xs truncate max-w-[180px]"><%= viewUser._id %></dd>
                </div>
                <div class="flex justify-between">
                    <dt class="text-woodsmoke-400">Anonymous ID</dt>
                    <dd class="text-woodsmoke-700 font-mono text-xs truncate max-w-[180px]"><%= viewUser.anonymousId || '—' %></dd>
                </div>
                <div class="flex justify-between">
                    <dt class="text-woodsmoke-400">Email verified</dt>
                    <dd class="<%= viewUser.isEmailVerified ? 'text-emerald-600' : 'text-amber-600' %> font-medium">
                        <%= viewUser.isEmailVerified ? 'Yes' : 'No' %>
                    </dd>
                </div>
                <div class="flex justify-between">
                    <dt class="text-woodsmoke-400">Newsletter</dt>
                    <dd class="text-woodsmoke-700"><%= viewUser.newsletterSubscribed ? 'Subscribed' : 'No' %></dd>
                </div>
                <div class="flex justify-between">
                    <dt class="text-woodsmoke-400">Pending credits</dt>
                    <dd class="text-woodsmoke-700"><%= viewUser.pendingCredits ?? 0 %></dd>
                </div>
            </dl>
        </div>

        <div class="bg-white border border-silver-100 rounded-xl p-5">
            <h3 class="text-xs font-semibold text-woodsmoke-500 uppercase tracking-wider mb-3">Stripe</h3>
            <dl class="space-y-2 text-sm">
                <div class="flex justify-between">
                    <dt class="text-woodsmoke-400">Account ID</dt>
                    <dd class="text-woodsmoke-700 font-mono text-xs truncate max-w-[180px]"><%= viewUser.stripeAccountId || '—' %></dd>
                </div>
                <div class="flex justify-between">
                    <dt class="text-woodsmoke-400">Account Status</dt>
                    <dd class="text-woodsmoke-700 capitalize"><%= viewUser.stripeAccountStatus || 'none' %></dd>
                </div>
                <div class="flex justify-between">
                    <dt class="text-woodsmoke-400">First purchase</dt>
                    <dd class="text-woodsmoke-700">
                        <%= viewUser.firstPurchaseAt ? new Date(viewUser.firstPurchaseAt).toLocaleDateString('en-GB') : '—' %>
                    </dd>
                </div>
            </dl>
        </div>

    </div>

    <!-- ── Suspension history ──────────────────────────────────────────────── -->
    <% if (viewUser.accountSuspendedAt) { %>
    <div class="bg-red-50 border border-red-200 rounded-xl p-5">
        <h3 class="text-xs font-semibold text-red-600 uppercase tracking-wider mb-2">Suspension Info</h3>
        <p class="text-sm text-red-700">
            Suspended on <strong><%= new Date(viewUser.accountSuspendedAt).toLocaleString('en-GB') %></strong>.
            Account will be permanently deleted 70 hours after suspension if email is not verified.
        </p>
    </div>
    <% } %>

</div>

<!-- ── Modals ─────────────────────────────────────────────────────────────── -->

<!-- Credits modal -->
<div id="creditsModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-woodsmoke-950/50">
    <div class="bg-white rounded-xl shadow-2xl w-full max-w-sm mx-4 p-6 space-y-4">
        <h2 class="text-base font-semibold text-woodsmoke-950">Adjust Credits</h2>
        <div class="space-y-3">
            <div>
                <label class="text-xs font-semibold text-woodsmoke-500 uppercase tracking-wider block mb-1">Adjustment</label>
                <input id="creditsAmount" type="number" placeholder="+100 or -50"
                    class="w-full h-9 px-3 text-sm border border-silver-200 rounded-md focus:outline-none focus:ring-2 focus:ring-orchid-400" />
                <p class="text-[11px] text-woodsmoke-400 mt-1">Positive to add, negative to subtract. Balance cannot go below 0.</p>
            </div>
            <div>
                <label class="text-xs font-semibold text-woodsmoke-500 uppercase tracking-wider block mb-1">Reason (required)</label>
                <input id="creditsReason" type="text" placeholder="e.g. Refund for failed payment"
                    class="w-full h-9 px-3 text-sm border border-silver-200 rounded-md focus:outline-none focus:ring-2 focus:ring-orchid-400" />
            </div>
        </div>
        <div class="flex gap-2 pt-1">
            <button id="creditsConfirmBtn"
                class="flex-1 h-9 bg-orchid-600 hover:bg-orchid-700 text-white text-sm font-semibold rounded-md transition-colors">
                Apply
            </button>
            <button onclick="document.getElementById('creditsModal').classList.add('hidden')"
                class="flex-1 h-9 bg-silver-100 hover:bg-silver-200 text-woodsmoke-700 text-sm font-medium rounded-md transition-colors">
                Cancel
            </button>
        </div>
    </div>
</div>

<!-- Role modal -->
<div id="roleModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-woodsmoke-950/50">
    <div class="bg-white rounded-xl shadow-2xl w-full max-w-sm mx-4 p-6 space-y-4">
        <h2 class="text-base font-semibold text-woodsmoke-950">Change Role</h2>
        <div>
            <label class="text-xs font-semibold text-woodsmoke-500 uppercase tracking-wider block mb-1">New Role</label>
            <select id="roleSelect"
                class="w-full h-9 px-3 text-sm border border-silver-200 rounded-md focus:outline-none focus:ring-2 focus:ring-orchid-400 bg-white">
                <option value="user">User</option>
                <option value="moderator">Moderator</option>
                <option value="superadmin">Superadmin</option>
            </select>
        </div>
        <div class="flex gap-2 pt-1">
            <button id="roleConfirmBtn"
                class="flex-1 h-9 bg-orchid-600 hover:bg-orchid-700 text-white text-sm font-semibold rounded-md transition-colors">
                Change Role
            </button>
            <button onclick="document.getElementById('roleModal').classList.add('hidden')"
                class="flex-1 h-9 bg-silver-100 hover:bg-silver-200 text-woodsmoke-700 text-sm font-medium rounded-md transition-colors">
                Cancel
            </button>
        </div>
    </div>
</div>

<script>
const USER_ID    = '<%- viewUser._id %>';
const IS_SUPERADMIN = window.__ADMIN__.role === 'superadmin';

// ── Suspend / Unsuspend ───────────────────────────────────────────────────────
document.getElementById('suspendBtn')?.addEventListener('click', async () => {
    if (!adminConfirm('Suspend this user? They will lose access immediately.')) return;
    await adminFetch(`/api/admin/users/${USER_ID}/suspend`, {
        method: 'PATCH', body: JSON.stringify({ suspend: true })
    });
    showToast('User suspended');
    setTimeout(() => location.reload(), 1000);
});

document.getElementById('unsuspendBtn')?.addEventListener('click', async () => {
    await adminFetch(`/api/admin/users/${USER_ID}/suspend`, {
        method: 'PATCH', body: JSON.stringify({ suspend: false })
    });
    showToast('User unsuspended');
    setTimeout(() => location.reload(), 1000);
});

// ── Force verify ──────────────────────────────────────────────────────────────
document.getElementById('verifyBtn')?.addEventListener('click', async () => {
    await adminFetch(`/api/admin/users/${USER_ID}/verify`, { method: 'PATCH' });
    showToast('Email verified');
    setTimeout(() => location.reload(), 1000);
});

// ── Credits ───────────────────────────────────────────────────────────────────
document.getElementById('creditsBtn')?.addEventListener('click', () => {
    document.getElementById('creditsModal').classList.remove('hidden');
});
document.getElementById('creditsConfirmBtn')?.addEventListener('click', async () => {
    const adjustment = Number(document.getElementById('creditsAmount').value);
    const reason     = document.getElementById('creditsReason').value.trim();
    if (!adjustment) return showToast('Enter a non-zero adjustment', 'error');
    if (!reason)     return showToast('Reason is required', 'error');
    await adminFetch(`/api/admin/users/${USER_ID}/credits`, {
        method: 'PATCH', body: JSON.stringify({ adjustment, reason })
    });
    document.getElementById('creditsModal').classList.add('hidden');
    showToast(`Credits adjusted by ${adjustment > 0 ? '+' : ''}${adjustment}`);
    setTimeout(() => location.reload(), 1200);
});

// ── Role ──────────────────────────────────────────────────────────────────────
document.getElementById('roleBtn')?.addEventListener('click', () => {
    document.getElementById('roleSelect').value = '<%- viewUser.role %>';
    document.getElementById('roleModal').classList.remove('hidden');
});
document.getElementById('roleConfirmBtn')?.addEventListener('click', async () => {
    const role = document.getElementById('roleSelect').value;
    if (!adminConfirm(`Change role to "${role}"? This affects their access immediately.`)) return;
    await adminFetch(`/api/admin/users/${USER_ID}/role`, {
        method: 'PATCH', body: JSON.stringify({ role })
    });
    document.getElementById('roleModal').classList.add('hidden');
    showToast('Role updated');
    setTimeout(() => location.reload(), 1000);
});

// ── Partner ───────────────────────────────────────────────────────────────────
document.getElementById('partnerBtn')?.addEventListener('click', async () => {
    const isPartner = <%- viewUser.isPartner %>;
    const action    = isPartner ? 'Revoke partner status from' : 'Grant partner status to';
    if (!adminConfirm(`${action} this user?`)) return;
    await adminFetch(`/api/admin/users/${USER_ID}/partner`, {
        method: 'PATCH', body: JSON.stringify({ isPartner: !isPartner })
    });
    showToast(isPartner ? 'Partner status revoked' : 'Partner status granted');
    setTimeout(() => location.reload(), 1000);
});

// ── Delete ────────────────────────────────────────────────────────────────────
document.getElementById('deleteBtn')?.addEventListener('click', async () => {
    if (!adminConfirm('PERMANENTLY delete this user? This cannot be undone.')) return;
    if (!adminConfirm('Are you absolutely sure?')) return;
    await adminFetch(`/api/admin/users/${USER_ID}`, { method: 'DELETE' });
    showToast('User deleted');
    setTimeout(() => window.location.href = '/admin/users', 1200);
});

// ── Close modals on backdrop click ────────────────────────────────────────────
['creditsModal', 'roleModal'].forEach(id => {
    document.getElementById(id)?.addEventListener('click', function(e) {
        if (e.target === this) this.classList.add('hidden');
    });
});
</script>

<%- include('layout-end') %>

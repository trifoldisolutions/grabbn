<%
  title     = 'FAQ Management'
  adminPage = 'faq'
%>
<%- include('layout') %>

<div class="p-6 space-y-6 max-w-4xl">

    <!-- Header -->
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-lg font-semibold text-woodsmoke-900">FAQ Management</h1>
            <p class="text-xs text-woodsmoke-400 mt-0.5">Manage published Q&As and answer community submissions.</p>
        </div>
        <button id="openAddModal" class="inline-flex items-center justify-center gap-1.5 h-8 px-3 bg-orchid-600 hover:bg-orchid-700 text-white text-xs font-semibold rounded-md transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24"><path fill="currentColor" d="M11 13H5v-2h6V5h2v6h6v2h-6v6h-2z"/></svg>
            Add FAQ item
        </button>
    </div>

    <!-- Tabs -->
    <div class="flex gap-1 border-b border-silver-200">
        <button data-tab="pending"   class="faq-tab flex items-center justify-center px-4 py-2 text-xs font-semibold border-b-2 border-orchid-600 text-orchid-600 -mb-px transition-colors">Pending</button>
        <button data-tab="published" class="faq-tab flex items-center justify-center px-4 py-2 text-xs font-semibold border-b-2 border-transparent text-woodsmoke-400 hover:text-woodsmoke-700 -mb-px transition-colors">Published</button>
        <button data-tab="rejected"  class="faq-tab flex items-center justify-center px-4 py-2 text-xs font-semibold border-b-2 border-transparent text-woodsmoke-400 hover:text-woodsmoke-700 -mb-px transition-colors">Rejected</button>
    </div>

    <!-- Tab content -->
    <div id="tabContent">
        <div id="tabLoader" class="flex justify-center py-8">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" class="text-woodsmoke-300"><circle cx="4" cy="12" r="3" fill="currentColor"><animate attributeName="r" begin="0;b.end-0.25s" dur="0.75s" values="3;.2;3"/></circle><circle cx="12" cy="12" r="3" fill="currentColor"><animate attributeName="r" begin="0.25s" dur="0.75s" values="3;.2;3"/></circle><circle cx="20" cy="12" r="3" fill="currentColor"><animate id="b" attributeName="r" begin="0.5s" dur="0.75s" values="3;.2;3"/></circle></svg>
        </div>
        <div id="itemList" class="space-y-3 hidden"></div>
        <p id="emptyMsg" class="hidden text-sm text-woodsmoke-400 py-4">No items in this tab.</p>
    </div>

</div>

<!-- ── Add / Edit modal ──────────────────────────────────────────────────────── -->
<div id="itemModal" class="hidden fixed inset-0 z-50 items-center justify-center bg-black/40">
    <div class="bg-white rounded-md shadow-xl w-full max-w-lg mx-4 p-6 space-y-4">
        <h3 id="modalTitle" class="text-sm font-semibold text-woodsmoke-900">Add FAQ item</h3>

        <div class="space-y-3">
            <div>
                <label class="block text-xs font-medium text-woodsmoke-600 mb-1">Question</label>
                <textarea id="modalQuestion" rows="2" placeholder="Question text…" class="w-full text-sm border border-silver-200 rounded-md p-2.5 resize-none focus:outline-none focus:border-orchid-400 text-woodsmoke-800 placeholder-woodsmoke-300"></textarea>
            </div>
            <div>
                <label class="block text-xs font-medium text-woodsmoke-600 mb-1">Answer</label>
                <textarea id="modalAnswer" rows="5" placeholder="Answer text…" class="w-full text-sm border border-silver-200 rounded-md p-2.5 resize-none focus:outline-none focus:border-orchid-400 text-woodsmoke-800 placeholder-woodsmoke-300"></textarea>
            </div>
            <div>
                <label class="block text-xs font-medium text-woodsmoke-600 mb-1">Category</label>
                <select id="modalCategory" class="w-full text-sm border border-silver-200 rounded-md px-3 h-9 focus:outline-none focus:border-orchid-400 text-woodsmoke-800 bg-white">
                    <option value="">— select —</option>
                    <option value="account">Account & Verification</option>
                    <option value="buckets">Buckets</option>
                    <option value="partner-program">Partner Program</option>
                    <option value="gtk">GTK</option>
                    <option value="repositories">Repositories & Showrooms</option>
                    <option value="moderation">Content & Moderation</option>
                </select>
            </div>
            <div>
                <label class="block text-xs font-medium text-woodsmoke-600 mb-1">Order <span class="font-normal text-woodsmoke-300">(lower = higher up)</span></label>
                <input id="modalOrder" type="number" value="0" min="0" class="w-24 text-sm border border-silver-200 rounded-md px-3 h-9 focus:outline-none focus:border-orchid-400 text-woodsmoke-800">
            </div>
        </div>

        <p id="modalError" class="hidden text-xs text-red-500"></p>

        <div class="flex items-center justify-end gap-2 pt-1">
            <button id="modalCancel" class="inline-flex items-center justify-center h-8 px-4 text-xs font-medium text-woodsmoke-500 hover:text-woodsmoke-800 transition-colors">Cancel</button>
            <button id="modalSave" class="inline-flex items-center justify-center h-8 px-4 bg-orchid-600 hover:bg-orchid-700 text-white text-xs font-semibold rounded-md transition-colors">Save</button>
        </div>
    </div>
</div>

<script>
(function () {
    const CATEGORY_LABELS = {
        'account':         'Account & Verification',
        'buckets':         'Buckets',
        'partner-program': 'Partner Program',
        'gtk':             'GTK',
        'repositories':    'Repositories & Showrooms',
        'moderation':      'Content & Moderation',
    };

    let currentTab  = 'pending';
    let editingId   = null;

    // ── Tab switching ──────────────────────────────────────────────────────────
    document.querySelectorAll('.faq-tab').forEach(btn => {
        btn.addEventListener('click', () => {
            currentTab = btn.dataset.tab;
            document.querySelectorAll('.faq-tab').forEach(b => {
                const active = b === btn;
                b.classList.toggle('border-orchid-600', active);
                b.classList.toggle('text-orchid-600',   active);
                b.classList.toggle('border-transparent', !active);
                b.classList.toggle('text-woodsmoke-400', !active);
            });
            loadItems();
        });
    });

    // ── Load items ─────────────────────────────────────────────────────────────
    async function loadItems() {
        const loader  = document.getElementById('tabLoader');
        const list    = document.getElementById('itemList');
        const empty   = document.getElementById('emptyMsg');

        loader.classList.remove('hidden');
        list.classList.add('hidden');
        empty.classList.add('hidden');
        list.innerHTML = '';

        try {
            const res  = await adminFetch(`/api/admin/faq?status=${currentTab}`);
            const items = res.items || [];

            loader.classList.add('hidden');

            if (!items.length) { empty.classList.remove('hidden'); return; }

            for (const item of items) {
                list.appendChild(buildCard(item));
            }
            list.classList.remove('hidden');
        } catch (e) {
            loader.classList.add('hidden');
            empty.textContent = 'Failed to load items.';
            empty.classList.remove('hidden');
        }
    }

    function buildCard(item) {
        const card = document.createElement('div');
        card.className = 'border border-silver-200 rounded-md p-4 space-y-2';
        card.dataset.id = item._id;

        const meta = [];
        if (item.source === 'user') meta.push(`<span class="bg-orchid-50 text-orchid-700 text-[10px] font-semibold px-2 py-0.5 rounded-md">Community</span>`);
        if (item.category) meta.push(`<span class="text-[10px] text-woodsmoke-400">${escHtml(CATEGORY_LABELS[item.category] || item.category)}</span>`);
        if (item.submittedBy?.username) meta.push(`<span class="text-[10px] text-woodsmoke-300">by @${escHtml(item.submittedBy.username)}</span>`);

        card.innerHTML = `
            <div class="flex items-start justify-between gap-3">
                <div class="space-y-1 flex-1 min-w-0">
                    ${meta.length ? `<div class="flex items-center gap-2 flex-wrap">${meta.join('')}</div>` : ''}
                    <p class="text-sm font-medium text-woodsmoke-900">${escHtml(item.question)}</p>
                    ${item.answer ? `<p class="text-xs text-woodsmoke-500 leading-relaxed line-clamp-2">${escHtml(item.answer)}</p>` : `<p class="text-xs text-woodsmoke-300 italic">No answer yet.</p>`}
                </div>
                <div class="flex items-center gap-1.5 shrink-0">
                    ${currentTab !== 'published' ? `<button data-action="publish" class="card-action inline-flex items-center justify-center h-7 px-2.5 bg-emerald-50 hover:bg-emerald-100 text-emerald-700 text-xs font-medium rounded-md transition-colors">Publish</button>` : ''}
                    ${currentTab !== 'rejected'  ? `<button data-action="reject"  class="card-action inline-flex items-center justify-center h-7 px-2.5 bg-red-50 hover:bg-red-100 text-red-600 text-xs font-medium rounded-md transition-colors">Reject</button>` : ''}
                    <button data-action="edit"   class="card-action inline-flex items-center justify-center h-7 px-2.5 border border-silver-200 hover:border-silver-300 text-woodsmoke-500 text-xs font-medium rounded-md transition-colors">Edit</button>
                    <button data-action="delete" class="card-action inline-flex items-center justify-center h-7 w-7 border border-silver-200 hover:border-red-200 hover:text-red-500 text-woodsmoke-400 rounded-md transition-colors">
                        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24"><path fill="currentColor" d="M7 21q-.825 0-1.412-.587T5 19V6H4V4h5V3h6v1h5v2h-1v13q0 .825-.587 1.413T17 21zm2-4h2V8H9zm4 0h2V8h-2z"/></svg>
                    </button>
                </div>
            </div>`;

        card.querySelectorAll('.card-action').forEach(btn => {
            btn.addEventListener('click', () => handleCardAction(btn.dataset.action, item, card));
        });

        return card;
    }

    async function handleCardAction(action, item, card) {
        if (action === 'edit') {
            openModal(item);
            return;
        }

        if (action === 'delete') {
            if (!adminConfirm('Delete this FAQ item permanently?')) return;
            try {
                await adminFetch(`/api/admin/faq/${item._id}`, { method: 'DELETE' });
                card.remove();
                showToast('Deleted');
            } catch (e) {}
            return;
        }

        const status = action === 'publish' ? 'published' : 'rejected';

        // If publishing a pending item and there's no answer/category, open the edit modal first
        if (status === 'published' && (!item.answer || !item.category)) {
            openModal(item, true);
            return;
        }

        try {
            await adminFetch(`/api/admin/faq/${item._id}`, {
                method:  'PUT',
                body:    JSON.stringify({ status }),
            });
            card.remove();
            showToast(status === 'published' ? 'Published' : 'Rejected');
        } catch (e) {}
    }

    // ── Modal ──────────────────────────────────────────────────────────────────
    function openModal(item = null, requirePublish = false) {
        editingId = item?._id || null;

        document.getElementById('modalTitle').textContent    = item ? 'Edit FAQ item' : 'Add FAQ item';
        document.getElementById('modalQuestion').value       = item?.question || '';
        document.getElementById('modalAnswer').value         = item?.answer   || '';
        document.getElementById('modalCategory').value       = item?.category || '';
        document.getElementById('modalOrder').value          = item?.order ?? 0;
        document.getElementById('modalError').classList.add('hidden');

        const saveBtn = document.getElementById('modalSave');
        saveBtn.dataset.requirePublish = requirePublish ? '1' : '';

        const modal = document.getElementById('itemModal');
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        document.getElementById('modalQuestion').focus();
    }

    document.getElementById('openAddModal').addEventListener('click', () => openModal());
    document.getElementById('modalCancel').addEventListener('click', closeModal);
    document.getElementById('itemModal').addEventListener('click', (e) => {
        if (e.target === document.getElementById('itemModal')) closeModal();
    });

    function closeModal() {
        const modal = document.getElementById('itemModal');
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        editingId = null;
    }

    document.getElementById('modalSave').addEventListener('click', async () => {
        const question        = document.getElementById('modalQuestion').value.trim();
        const answer          = document.getElementById('modalAnswer').value.trim();
        const category        = document.getElementById('modalCategory').value;
        const order           = parseInt(document.getElementById('modalOrder').value) || 0;
        const requirePublish  = document.getElementById('modalSave').dataset.requirePublish === '1';
        const errorEl         = document.getElementById('modalError');

        if (!question || !answer || !category) {
            errorEl.textContent = 'Question, answer, and category are all required.';
            errorEl.classList.remove('hidden');
            return;
        }

        const saveBtn = document.getElementById('modalSave');
        saveBtn.disabled    = true;
        saveBtn.textContent = 'Saving…';
        errorEl.classList.add('hidden');

        try {
            const payload = { question, answer, category, order };
            if (requirePublish) payload.status = 'published';

            if (editingId) {
                await adminFetch(`/api/admin/faq/${editingId}`, { method: 'PUT', body: JSON.stringify(payload) });
            } else {
                await adminFetch('/api/admin/faq', { method: 'POST', body: JSON.stringify(payload) });
            }

            closeModal();
            showToast(editingId ? 'Updated' : 'Created');
            loadItems();
        } catch (e) {
            errorEl.textContent = e.message || 'Failed to save.';
            errorEl.classList.remove('hidden');
        } finally {
            saveBtn.disabled    = false;
            saveBtn.textContent = 'Save';
        }
    });

    function escHtml(str) {
        return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    loadItems();
})();
</script>

<%- include('layout-end') %>

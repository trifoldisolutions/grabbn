<%
  title          = 'Content'
  page           = 'settings'
  settingsSection = 'content'
%>
<%- include('partials/layout') %>

<div class="flex flex-1 overflow-hidden justify-center">
  <div class="flex w-full max-w-[992px] overflow-hidden">

    <%- include('partials/settings-nav') %>

    <!-- Content area -->
    <div class="flex-1 overflow-y-auto">
      <div class="w-full px-6 py-6">

        <% if (user && !user.isAnonymous) { %>

        <!-- ── Filtering ──────────────────────────────────────────────────────── -->
        <div class="border border-silver-200 rounded-md divide-y divide-silver-100 mb-6">

          <div class="px-5 py-4">
            <p class="text-xs font-semibold uppercase tracking-wide text-woodsmoke-400">Filtering</p>
          </div>

          <div class="px-5 py-4 flex items-center justify-between gap-4">
            <div class="flex flex-col gap-0.5 min-w-0">
              <span class="text-sm font-medium text-woodsmoke-900">Mature content filter</span>
              <span class="text-xs text-woodsmoke-400">Hide buckets flagged as mature from your feed and search results</span>
            </div>
            <button
              id="matureToggle"
              data-enabled="<%= user.isMatureGated ? 'true' : 'false' %>"
              class="relative w-10 h-6 rounded-full transition-colors shrink-0 <%= user.isMatureGated ? 'bg-orchid-500' : 'bg-silver-200' %>"
            >
              <span class="absolute left-1 top-1 w-4 h-4 rounded-full bg-white shadow-sm transition-transform <%= user.isMatureGated ? 'translate-x-4' : '' %>"></span>
            </button>
          </div>

        </div>

        <!-- ── Bucket Defaults ───────────────────────────────────────────────── -->
        <div class="border border-silver-200 rounded-md divide-y divide-silver-100 mb-6">

          <div class="px-5 py-4">
            <p class="text-xs font-semibold uppercase tracking-wide text-woodsmoke-400">New bucket defaults</p>
          </div>

          <div class="px-5 py-4 flex items-center justify-between gap-4">
            <div class="flex flex-col gap-0.5 min-w-0">
              <span class="text-sm font-medium text-woodsmoke-900">Default visibility</span>
              <span class="text-xs text-woodsmoke-400">Visibility applied to new buckets you create</span>
            </div>
            <select class="h-9 px-3 text-sm border border-silver-200 rounded-md text-woodsmoke-700 bg-white outline-none focus:border-orchid-400 transition-colors shrink-0 opacity-50 cursor-not-allowed" disabled>
              <option>Public</option>
              <option>Unlisted</option>
              <option>Private</option>
            </select>
          </div>

          <div class="px-5 py-4 flex items-center justify-between gap-4">
            <div class="flex flex-col gap-0.5 min-w-0">
              <span class="text-sm font-medium text-woodsmoke-900">Create as draft by default</span>
              <span class="text-xs text-woodsmoke-400">New buckets will start as drafts instead of being published immediately</span>
            </div>
            <button class="relative w-10 h-6 rounded-full bg-silver-200 opacity-50 cursor-not-allowed shrink-0" disabled>
              <span class="absolute left-1 top-1 w-4 h-4 rounded-full bg-white shadow-sm transition-transform"></span>
            </button>
          </div>

        </div>

        <p id="contentFeedback" class="hidden text-xs text-center mt-2"></p>

        <% } else { %>
          <p class="text-sm text-woodsmoke-400">Please <a href="/?openAuth=true" class="text-orchid-600 font-semibold hover:underline">sign in</a> to manage your settings.</p>
        <% } %>

      </div>
    </div>

  </div>
</div>

<script>
(function () {
  const toggle   = document.getElementById('matureToggle');
  const feedback = document.getElementById('contentFeedback');
  if (!toggle) return;

  function showFeedback(msg, ok) {
    feedback.textContent = msg;
    feedback.className = `mt-2 text-xs text-center ${ok ? 'text-emerald-600' : 'text-red-500'}`;
    clearTimeout(feedback._t);
    feedback._t = setTimeout(() => { feedback.className = 'hidden text-xs text-center'; }, 3000);
  }

  toggle.addEventListener('click', async () => {
    const current = toggle.dataset.enabled === 'true';
    const next    = !current;
    toggle.disabled = true;
    try {
      const res = await fetch('/api/user/mature-gate', {
        method: 'PATCH', credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ isMatureGated: next }),
      });
      if (!res.ok) throw new Error();
      toggle.dataset.enabled = String(next);
      toggle.classList.toggle('bg-orchid-500', next);
      toggle.classList.toggle('bg-silver-200', !next);
      toggle.querySelector('span').classList.toggle('translate-x-4', next);
      showFeedback(next ? 'Mature content filter enabled.' : 'Mature content filter disabled.', true);
    } catch {
      showFeedback('Could not save. Try again.', false);
    } finally {
      toggle.disabled = false;
    }
  });
})();
</script>

<%- include('partials/layout-end') %>

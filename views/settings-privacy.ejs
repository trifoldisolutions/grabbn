<%
  title          = 'Privacy'
  page           = 'settings'
  settingsSection = 'privacy'
%>
<%- include('partials/layout') %>

<div class="flex flex-1 overflow-hidden justify-center">
  <div class="flex w-full max-w-[992px] overflow-hidden">

    <%- include('partials/settings-nav') %>

    <!-- Content area -->
    <div class="flex-1 overflow-y-auto">
      <div class="w-full px-6 py-6">

        <% if (user && !user.isAnonymous) { %>

        <!-- ── Direct Messages ───────────────────────────────────────────────── -->
        <div class="border border-silver-200 rounded-md divide-y divide-silver-100 mb-6">

          <div class="px-5 py-4">
            <p class="text-xs font-semibold uppercase tracking-wide text-woodsmoke-400">Messaging</p>
          </div>

          <div class="px-5 py-4 flex items-center justify-between gap-4">
            <div class="flex flex-col gap-0.5 min-w-0">
              <span class="text-sm font-medium text-woodsmoke-900">Who can message you</span>
              <span class="text-xs text-woodsmoke-400">Control who is allowed to send you direct messages</span>
            </div>
            <select class="h-9 px-3 text-sm border border-silver-200 rounded-md text-woodsmoke-700 bg-white outline-none focus:border-orchid-400 transition-colors shrink-0 opacity-50 cursor-not-allowed" disabled>
              <option>Everyone</option>
              <option>People I follow</option>
              <option>No one</option>
            </select>
          </div>

        </div>

        <!-- ── Profile Visibility ────────────────────────────────────────────── -->
        <div class="border border-silver-200 rounded-md divide-y divide-silver-100 mb-6">

          <div class="px-5 py-4">
            <p class="text-xs font-semibold uppercase tracking-wide text-woodsmoke-400">Profile</p>
          </div>

          <div class="px-5 py-4 flex items-center justify-between gap-4">
            <div class="flex flex-col gap-0.5 min-w-0">
              <span class="text-sm font-medium text-woodsmoke-900">Show grabbed buckets on profile</span>
              <span class="text-xs text-woodsmoke-400">When on, your grabbed buckets appear on your public profile</span>
            </div>
            <button class="relative w-10 h-6 rounded-full bg-silver-200 opacity-50 cursor-not-allowed shrink-0" disabled>
              <span class="absolute left-1 top-1 w-4 h-4 rounded-full bg-white shadow-sm transition-transform"></span>
            </button>
          </div>

        </div>

        <!-- ── Blocked Users ──────────────────────────────────────────────────── -->
        <div class="border border-silver-200 rounded-md divide-y divide-silver-100 mb-6">

          <div class="px-5 py-4 flex items-center justify-between">
            <p class="text-xs font-semibold uppercase tracking-wide text-woodsmoke-400">Blocked users</p>
            <span class="text-xs text-woodsmoke-400">Coming soon</span>
          </div>

          <div class="px-5 py-5 text-xs text-woodsmoke-400">
            No blocked users.
          </div>

        </div>

        <% } else { %>
          <p class="text-sm text-woodsmoke-400">Please <a href="/?openAuth=true" class="text-orchid-600 font-semibold hover:underline">sign in</a> to manage your settings.</p>
        <% } %>

      </div>
    </div>

  </div>
</div>

<%- include('partials/layout-end') %>

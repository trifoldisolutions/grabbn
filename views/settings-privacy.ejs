<%
  title          = 'Privacy'
  page           = 'settings'
  settingsSection = 'privacy'
%>
<%- include('partials/layout') %>

<div class="flex flex-1 overflow-hidden justify-center">
  <div class="flex w-full max-w-[992px] overflow-hidden">

    <%- include('partials/settings-nav') %>

    <!-- Content area -->
    <div class="flex-1 overflow-y-auto">
      <div class="w-full px-6 py-6">

        <% if (user && !user.isAnonymous) { %>

        <!-- ── Direct Messages ───────────────────────────────────────────────── -->
        <div class="border border-silver-200 rounded-md divide-y divide-silver-100 mb-6">

          <div class="px-5 py-4">
            <p class="text-sm font-semibold uppercase tracking-wide text-woodsmoke-400"><%= t('settings.privacy.section.messaging') %></p>
          </div>

          <div class="px-5 py-4 flex items-center justify-between gap-4">
            <div class="flex flex-col gap-0.5 min-w-0">
              <span class="text-sm font-semibold text-woodsmoke-900"><%= t('settings.privacy.messaging.who_can_message') %></span>
              <span class="text-sm text-woodsmoke-400"><%= t('settings.privacy.messaging.who_can_message_hint') %></span>
            </div>
            <select class="h-9 px-3 text-sm border border-silver-200 rounded-md text-woodsmoke-700 bg-white outline-none focus:border-orchid-400 transition-colors shrink-0 opacity-50 cursor-not-allowed" disabled>
              <option><%= t('settings.privacy.messaging.everyone') %></option>
              <option><%= t('settings.privacy.messaging.people_i_follow') %></option>
              <option><%= t('settings.privacy.messaging.no_one') %></option>
            </select>
          </div>

        </div>

        <!-- ── Profile Visibility ────────────────────────────────────────────── -->
        <div class="border border-silver-200 rounded-md divide-y divide-silver-100 mb-6">

          <div class="px-5 py-4">
            <p class="text-sm font-semibold uppercase tracking-wide text-woodsmoke-400"><%= t('settings.privacy.section.profile') %></p>
          </div>

          <div class="px-5 py-4 flex items-center justify-between gap-4">
            <div class="flex flex-col gap-0.5 min-w-0">
              <span class="text-sm font-semibold text-woodsmoke-900"><%= t('settings.privacy.profile.show_grabbed') %></span>
              <span class="text-sm text-woodsmoke-400"><%= t('settings.privacy.profile.show_grabbed_hint') %></span>
            </div>
            <button class="relative w-10 h-6 rounded-full bg-silver-200 opacity-50 cursor-not-allowed shrink-0" disabled>
              <span class="absolute left-1 top-1 w-4 h-4 rounded-full bg-white shadow-sm transition-transform"></span>
            </button>
          </div>

          <div class="px-5 py-4 flex items-center justify-between gap-4">
            <div class="flex flex-col gap-0.5 min-w-0">
              <span class="text-sm font-semibold text-woodsmoke-900"><%= t('settings.privacy.profile.visibility') %></span>
              <span class="text-sm text-woodsmoke-400"><%= t('settings.privacy.profile.visibility_hint') %></span>
            </div>
            <div class="flex items-center gap-2 shrink-0">
              <span class="text-xs font-medium text-woodsmoke-300"><%= t('settings.privacy.common.coming_soon') %></span>
              <button class="relative w-10 h-6 rounded-full bg-silver-200 opacity-50 cursor-not-allowed shrink-0" disabled>
                <span class="absolute left-1 top-1 w-4 h-4 rounded-full bg-white shadow-sm transition-transform"></span>
              </button>
            </div>
          </div>

          <div class="px-5 py-4 flex items-center justify-between gap-4">
            <div class="flex flex-col gap-0.5 min-w-0">
              <span class="text-sm font-semibold text-woodsmoke-900"><%= t('settings.privacy.profile.show_explore') %></span>
              <span class="text-sm text-woodsmoke-400"><%= t('settings.privacy.profile.show_explore_hint') %></span>
            </div>
            <div class="flex items-center gap-2 shrink-0">
              <span class="text-xs font-medium text-woodsmoke-300"><%= t('settings.privacy.common.coming_soon') %></span>
              <button class="relative w-10 h-6 rounded-full bg-silver-200 opacity-50 cursor-not-allowed shrink-0" disabled>
                <span class="absolute left-1 top-1 w-4 h-4 rounded-full bg-white shadow-sm transition-transform"></span>
              </button>
            </div>
          </div>

        </div>

        <!-- ── Blocked Users ──────────────────────────────────────────────────── -->
        <div class="border border-silver-200 rounded-md divide-y divide-silver-100 mb-6">

          <div class="px-5 py-4 flex items-center justify-between">
            <p class="text-sm font-semibold uppercase tracking-wide text-woodsmoke-400"><%= t('settings.privacy.section.blocked') %></p>
            <span class="text-sm text-woodsmoke-400"><%= t('settings.privacy.common.coming_soon') %></span>
          </div>

          <div class="px-5 py-5 text-sm text-woodsmoke-400">
            <%= t('settings.privacy.blocked.empty') %>
          </div>

        </div>

        <% } else { %>
          <p class="text-sm text-woodsmoke-400"><%- t('settings.common.sign_in_prompt') %></p>
        <% } %>

      </div>
    </div>

  </div>
</div>

<%- include('partials/layout-end') %>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign Up — Grabbn</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Jost:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/tailwind/output.css">
</head>
<body class="min-h-screen flex bg-white">

    <!-- ── Left panel (desktop) ─────────────────────────────────────────── -->
    <div class="hidden md:flex flex-col justify-between w-[400px] shrink-0 bg-woodsmoke-950 px-10 py-12">

        <a href="/" class="flex items-center gap-2.5">
            <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" class="text-orchid-400 shrink-0">
                <g fill="none">
                    <path d="m12.593 23.258l-.011.002l-.071.035l-.02.004l-.014-.004l-.071-.035q-.016-.005-.024.005l-.004.01l-.017.428l.005.02l.01.013l.104.074l.015.004l.012-.004l.104-.074l.012-.016l.004-.017l-.017-.427q-.004-.016-.017-.018m.265-.113l-.013.002l-.185.093l-.01.01l-.003.011l.018.43l.005.012l.008.007l.201.093q.019.005.029-.008l.004-.014l-.034-.614q-.005-.018-.02-.022m-.715.002a.02.02 0 0 0-.027.006l-.006.014l-.034.614q.001.018.017.024l.015-.002l.201-.093l.01-.008l.004-.011l.017-.43l-.003-.012l-.01-.01z"/>
                    <path fill="currentColor" d="M15.5 5a2.5 2.5 0 0 1 2.461 2.058A2.5 2.5 0 0 1 21 9.5V12a8 8 0 0 1-8 8h-.674a8 8 0 0 1-7.155-4.422L2.329 9.894c-.36-.72-.093-1.683.747-2.028c1.043-.427 2.034-.507 3.055.012q.443.227.869.584V7.5a2.5 2.5 0 0 1 3.388-2.338a2.498 2.498 0 0 1 4.224 0A2.5 2.5 0 0 1 15.5 5"/>
                </g>
            </svg>
            <span class="font-bold text-white text-sm" style="font-variant: small-caps; letter-spacing: 0.12em;">GRABBn</span>
        </a>

        <div>
            <h2 class="text-3xl font-bold text-white leading-snug mb-3">Your links,<br>all in one place.</h2>
            <p class="text-woodsmoke-400 text-sm mb-10">Join thousands of people who use Grabbn to capture and organize links from anywhere.</p>
            <ul class="space-y-4">
                <li class="flex items-center gap-3 text-sm text-woodsmoke-300">
                    <span class="w-5 h-5 flex items-center justify-center rounded-md bg-orchid-900 text-orchid-400 shrink-0">
                        <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24"><path fill="currentColor" d="m9.55 18l-5.7-5.7l1.425-1.425L9.55 15.15l9.175-9.175L20.15 7.4z"/></svg>
                    </span>
                    Unlimited scraping — no daily limits
                </li>
                <li class="flex items-center gap-3 text-sm text-woodsmoke-300">
                    <span class="w-5 h-5 flex items-center justify-center rounded-md bg-orchid-900 text-orchid-400 shrink-0">
                        <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24"><path fill="currentColor" d="m9.55 18l-5.7-5.7l1.425-1.425L9.55 15.15l9.175-9.175L20.15 7.4z"/></svg>
                    </span>
                    Access your links from any device
                </li>
                <li class="flex items-center gap-3 text-sm text-woodsmoke-300">
                    <span class="w-5 h-5 flex items-center justify-center rounded-md bg-orchid-900 text-orchid-400 shrink-0">
                        <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24"><path fill="currentColor" d="m9.55 18l-5.7-5.7l1.425-1.425L9.55 15.15l9.175-9.175L20.15 7.4z"/></svg>
                    </span>
                    Permanent data storage
                </li>
                <li class="flex items-center gap-3 text-sm text-woodsmoke-300">
                    <span class="w-5 h-5 flex items-center justify-center rounded-md bg-orchid-900 text-orchid-400 shrink-0">
                        <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24"><path fill="currentColor" d="m9.55 18l-5.7-5.7l1.425-1.425L9.55 15.15l9.175-9.175L20.15 7.4z"/></svg>
                    </span>
                    Keep all your current data
                </li>
            </ul>
        </div>

        <p class="text-xs text-woodsmoke-700">&copy; 2026 Grabbn. All rights reserved.</p>
    </div>

    <!-- ── Right panel (form) ────────────────────────────────────────────── -->
    <div class="flex flex-col flex-1 min-h-screen">

        <!-- Mobile header -->
        <div class="flex md:hidden items-center justify-between px-5 h-14 border-b border-silver-100 shrink-0">
            <a href="/" class="flex items-center gap-2 text-woodsmoke-950">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" class="text-orchid-600">
                    <g fill="none">
                        <path d="m12.593 23.258l-.011.002l-.071.035l-.02.004l-.014-.004l-.071-.035q-.016-.005-.024.005l-.004.01l-.017.428l.005.02l.01.013l.104.074l.015.004l.012-.004l.104-.074l.012-.016l.004-.017l-.017-.427q-.004-.016-.017-.018m.265-.113l-.013.002l-.185.093l-.01.01l-.003.011l.018.43l.005.012l.008.007l.201.093q.019.005.029-.008l.004-.014l-.034-.614q-.005-.018-.02-.022m-.715.002a.02.02 0 0 0-.027.006l-.006.014l-.034.614q.001.018.017.024l.015-.002l.201-.093l.01-.008l.004-.011l.017-.43l-.003-.012l-.01-.01z"/>
                        <path fill="currentColor" d="M15.5 5a2.5 2.5 0 0 1 2.461 2.058A2.5 2.5 0 0 1 21 9.5V12a8 8 0 0 1-8 8h-.674a8 8 0 0 1-7.155-4.422L2.329 9.894c-.36-.72-.093-1.683.747-2.028c1.043-.427 2.034-.507 3.055.012q.443.227.869.584V7.5a2.5 2.5 0 0 1 3.388-2.338a2.498 2.498 0 0 1 4.224 0A2.5 2.5 0 0 1 15.5 5"/>
                    </g>
                </svg>
                <span class="font-bold text-sm" style="font-variant: small-caps; letter-spacing: 0.12em;">GRABBn</span>
            </a>
            <a href="/" class="text-xs text-woodsmoke-400 hover:text-woodsmoke-700">← Home</a>
        </div>

        <!-- Form area -->
        <div class="flex flex-col flex-1 items-center justify-center px-6 py-10 overflow-y-auto">
            <div class="w-full max-w-sm">

                <!-- Step 1: Credentials -->
                <div id="credentialsStep">
                    <div class="mb-7">
                        <h1 class="text-2xl font-bold text-woodsmoke-950 mb-1">Create an account</h1>
                        <p class="text-sm text-woodsmoke-400">Start grabbing links in seconds</p>
                    </div>

                    <form id="signupForm" class="space-y-4">
                        <div>
                            <label for="email" class="block text-sm font-medium text-woodsmoke-800 mb-1.5">Email address</label>
                            <input
                                type="email"
                                id="email"
                                name="email"
                                required
                                autofocus
                                class="w-full px-3 h-11 bg-silver-50 border border-silver-200 rounded-md text-sm focus:bg-orchid-50 focus:outline-none focus:ring-2 focus:ring-orchid-500 focus:border-transparent transition-colors"
                                placeholder="you@example.com"
                            >
                        </div>

                        <div>
                            <label for="username" class="block text-sm font-medium text-woodsmoke-800 mb-1.5">
                                Username <span class="text-red-500">*</span>
                            </label>
                            <input
                                type="text"
                                id="username"
                                name="username"
                                required
                                minlength="3"
                                maxlength="30"
                                pattern="^[a-zA-Z0-9]+$"
                                class="w-full px-3 h-11 bg-silver-50 border border-silver-200 rounded-md text-sm focus:bg-orchid-50 focus:outline-none focus:ring-2 focus:ring-orchid-500 focus:border-transparent transition-colors"
                                placeholder="cooluser123"
                            >
                            <p id="usernameValidation" class="text-xs mt-1 text-woodsmoke-400">3–30 characters, letters and numbers only</p>
                        </div>

                        <div>
                            <label for="password" class="block text-sm font-medium text-woodsmoke-800 mb-1.5">Password</label>
                            <div class="relative">
                                <input
                                    type="password"
                                    id="password"
                                    name="password"
                                    required
                                    minlength="8"
                                    class="w-full px-3 h-11 pr-10 bg-silver-50 border border-silver-200 rounded-md text-sm focus:bg-orchid-50 focus:outline-none focus:ring-2 focus:ring-orchid-500 focus:border-transparent transition-colors"
                                    placeholder="••••••••"
                                >
                                <button
                                    type="button"
                                    data-pw-toggle="password"
                                    class="absolute right-3 top-1/2 -translate-y-1/2 text-woodsmoke-300 hover:text-woodsmoke-500 flex items-center justify-center transition-colors"
                                    aria-label="Toggle password visibility"
                                >
                                    <svg data-pw-eye xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"><g fill="none"><path d="m12.593 23.258l-.011.002l-.071.035l-.02.004l-.014-.004l-.071-.035q-.016-.005-.024.005l-.004.01l-.017.428l.005.02l.01.013l.104.074l.015.004l.012-.004l.104-.074l.012-.016l.004-.017l-.017-.427q-.004-.016-.017-.018m.265-.113l-.013.002l-.185.093l-.01.01l-.003.011l.018.43l.005.012l.008.007l.201.093q.019.005.029-.008l.004-.014l-.034-.614q-.005-.018-.02-.022m-.715.002a.02.02 0 0 0-.027.006l-.006.014l-.034.614q.001.018.017.024l.015-.002l.201-.093l.01-.008l.004-.011l.017-.43l-.003-.012l-.01-.01z"/><path fill="currentColor" d="M12 5c3.679 0 8.162 2.417 9.73 5.901c.146.328.27.71.27 1.099c0 .388-.123.771-.27 1.099C20.161 16.583 15.678 19 12 19s-8.162-2.417-9.73-5.901C2.124 12.77 2 12.389 2 12c0-.388.123-.771.27-1.099C3.839 7.417 8.322 5 12 5m0 3a4 4 0 1 0 0 8a4 4 0 0 0 0-8m0 2a2 2 0 1 1 0 4a2 2 0 0 1 0-4"/></g></svg>
                                    <svg data-pw-eye-off class="hidden" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"><g fill="none" fill-rule="evenodd"><path d="m12.593 23.258l-.011.002l-.071.035l-.02.004l-.014-.004l-.071-.035q-.016-.005-.024.005l-.004.01l-.017.428l.005.02l.01.013l.104.074l.015.004l.012-.004l.104-.074l.012-.016l.004-.017l-.017-.427q-.004-.016-.017-.018m.265-.113l-.013.002l-.185.093l-.01.01l-.003.011l.018.43l.005.012l.008.007l.201.093q.019.005.029-.008l.004-.014l-.034-.614q-.005-.018-.02-.022m-.715.002a.02.02 0 0 0-.027.006l-.006.014l-.034.614q.001.018.017.024l.015-.002l.201-.093l.01-.008l.004-.011l.017-.43l-.003-.012l-.01-.01z"/><path fill="currentColor" d="M2.5 9a1.5 1.5 0 0 1 2.945-.404c1.947 6.502 11.158 6.503 13.109.005a1.5 1.5 0 1 1 2.877.85a10.1 10.1 0 0 1-1.623 3.236l.96.96a1.5 1.5 0 1 1-2.122 2.12l-1.01-1.01a9.6 9.6 0 0 1-1.67.915l.243.906a1.5 1.5 0 0 1-2.897.776l-.251-.935c-.705.073-1.417.073-2.122 0l-.25.935a1.5 1.5 0 0 1-2.898-.776l.242-.907a9.6 9.6 0 0 1-1.669-.914l-1.01 1.01a1.5 1.5 0 1 1-2.122-2.12l.96-.96a10.1 10.1 0 0 1-1.62-3.23A1.5 1.5 0 0 1 2.5 9"/></g></svg>
                                </button>
                            </div>
                            <ul class="grid grid-cols-2 gap-x-4 gap-y-1 mt-1.5">
                                <li id="req-length"    class="flex items-center gap-1.5 text-[11px] text-woodsmoke-300"><span class="w-1.5 h-1.5 rounded-full bg-current shrink-0"></span>8+ characters</li>
                                <li id="req-uppercase" class="flex items-center gap-1.5 text-[11px] text-woodsmoke-300"><span class="w-1.5 h-1.5 rounded-full bg-current shrink-0"></span>2 uppercase</li>
                                <li id="req-lowercase" class="flex items-center gap-1.5 text-[11px] text-woodsmoke-300"><span class="w-1.5 h-1.5 rounded-full bg-current shrink-0"></span>2 lowercase</li>
                                <li id="req-digit"     class="flex items-center gap-1.5 text-[11px] text-woodsmoke-300"><span class="w-1.5 h-1.5 rounded-full bg-current shrink-0"></span>2 numbers</li>
                                <li id="req-special"   class="flex items-center gap-1.5 text-[11px] text-woodsmoke-300"><span class="w-1.5 h-1.5 rounded-full bg-current shrink-0"></span>2 special chars</li>
                            </ul>
                        </div>

                        <div>
                            <label for="passwordConfirm" class="block text-sm font-medium text-woodsmoke-800 mb-1.5">Confirm password</label>
                            <div class="relative">
                                <input
                                    type="password"
                                    id="passwordConfirm"
                                    name="passwordConfirm"
                                    required
                                    minlength="8"
                                    class="w-full px-3 h-11 pr-10 bg-silver-50 border border-silver-200 rounded-md text-sm focus:bg-orchid-50 focus:outline-none focus:ring-2 focus:ring-orchid-500 focus:border-transparent transition-colors"
                                    placeholder="••••••••"
                                >
                                <button
                                    type="button"
                                    data-pw-toggle="passwordConfirm"
                                    class="absolute right-3 top-1/2 -translate-y-1/2 text-woodsmoke-300 hover:text-woodsmoke-500 flex items-center justify-center transition-colors"
                                    aria-label="Toggle password visibility"
                                >
                                    <svg data-pw-eye xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"><g fill="none"><path d="m12.593 23.258l-.011.002l-.071.035l-.02.004l-.014-.004l-.071-.035q-.016-.005-.024.005l-.004.01l-.017.428l.005.02l.01.013l.104.074l.015.004l.012-.004l.104-.074l.012-.016l.004-.017l-.017-.427q-.004-.016-.017-.018m.265-.113l-.013.002l-.185.093l-.01.01l-.003.011l.018.43l.005.012l.008.007l.201.093q.019.005.029-.008l.004-.014l-.034-.614q-.005-.018-.02-.022m-.715.002a.02.02 0 0 0-.027.006l-.006.014l-.034.614q.001.018.017.024l.015-.002l.201-.093l.01-.008l.004-.011l.017-.43l-.003-.012l-.01-.01z"/><path fill="currentColor" d="M12 5c3.679 0 8.162 2.417 9.73 5.901c.146.328.27.71.27 1.099c0 .388-.123.771-.27 1.099C20.161 16.583 15.678 19 12 19s-8.162-2.417-9.73-5.901C2.124 12.77 2 12.389 2 12c0-.388.123-.771.27-1.099C3.839 7.417 8.322 5 12 5m0 3a4 4 0 1 0 0 8a4 4 0 0 0 0-8m0 2a2 2 0 1 1 0 4a2 2 0 0 1 0-4"/></g></svg>
                                    <svg data-pw-eye-off class="hidden" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"><g fill="none" fill-rule="evenodd"><path d="m12.593 23.258l-.011.002l-.071.035l-.02.004l-.014-.004l-.071-.035q-.016-.005-.024.005l-.004.01l-.017.428l.005.02l.01.013l.104.074l.015.004l.012-.004l.104-.074l.012-.016l.004-.017l-.017-.427q-.004-.016-.017-.018m.265-.113l-.013.002l-.185.093l-.01.01l-.003.011l.018.43l.005.012l.008.007l.201.093q.019.005.029-.008l.004-.014l-.034-.614q-.005-.018-.02-.022m-.715.002a.02.02 0 0 0-.027.006l-.006.014l-.034.614q.001.018.017.024l.015-.002l.201-.093l.01-.008l.004-.011l.017-.43l-.003-.012l-.01-.01z"/><path fill="currentColor" d="M2.5 9a1.5 1.5 0 0 1 2.945-.404c1.947 6.502 11.158 6.503 13.109.005a1.5 1.5 0 1 1 2.877.85a10.1 10.1 0 0 1-1.623 3.236l.96.96a1.5 1.5 0 1 1-2.122 2.12l-1.01-1.01a9.6 9.6 0 0 1-1.67.915l.243.906a1.5 1.5 0 0 1-2.897.776l-.251-.935c-.705.073-1.417.073-2.122 0l-.25.935a1.5 1.5 0 0 1-2.898-.776l.242-.907a9.6 9.6 0 0 1-1.669-.914l-1.01 1.01a1.5 1.5 0 1 1-2.122-2.12l.96-.96a10.1 10.1 0 0 1-1.62-3.23A1.5 1.5 0 0 1 2.5 9"/></g></svg>
                                </button>
                            </div>
                            <p id="passwordMatchValidation" class="text-xs mt-1 hidden"></p>
                        </div>

                        <div id="errorMessage" class="hidden bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-md text-sm"></div>
                        <div id="successMessage" class="hidden bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-md text-sm"></div>

                        <div class="space-y-3 pt-1">
                            <label class="flex items-start gap-3 cursor-pointer select-none">
                                <input
                                    type="checkbox"
                                    id="agreeTerms"
                                    class="mt-0.5 w-4 h-4 accent-orchid-600 cursor-pointer shrink-0"
                                >
                                <span class="text-sm text-woodsmoke-500">
                                    I agree to the
                                    <a href="/terms.html" target="_blank" class="text-orchid-600 hover:text-orchid-700 font-medium underline">Terms of Usage</a>
                                    and
                                    <a href="/privacy.html" target="_blank" class="text-orchid-600 hover:text-orchid-700 font-medium underline">Privacy Policy</a>
                                    <span class="text-red-500">*</span>
                                </span>
                            </label>
                            <label class="flex items-start gap-3 cursor-pointer select-none">
                                <input
                                    type="checkbox"
                                    id="newsletterSubscribe"
                                    class="mt-0.5 w-4 h-4 accent-orchid-600 cursor-pointer shrink-0"
                                >
                                <span class="text-sm text-woodsmoke-500">
                                    Keep me updated with product news and improvements
                                    <span class="text-woodsmoke-300">(optional)</span>
                                </span>
                            </label>
                        </div>

                        <button
                            type="submit"
                            id="submitBtn"
                            aria-disabled="true"
                            class="w-full h-11 flex items-center justify-center bg-orchid-700 text-white text-sm font-semibold rounded-md aria-disabled:opacity-50 aria-disabled:cursor-not-allowed hover:bg-orchid-800 transition-colors"
                        >
                            <span data-btn-label>Create Account</span>
                            <span data-btn-loader class="hidden"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"><circle cx="4" cy="12" r="3" fill="currentColor"><animate id="signupDot1" attributeName="r" begin="0;signupDot3.end-0.25s" dur="0.75s" values="3;.2;3"/></circle><circle cx="12" cy="12" r="3" fill="currentColor"><animate attributeName="r" begin="signupDot1.end-0.6s" dur="0.75s" values="3;.2;3"/></circle><circle cx="20" cy="12" r="3" fill="currentColor"><animate id="signupDot3" attributeName="r" begin="signupDot1.end-0.45s" dur="0.75s" values="3;.2;3"/></circle></svg></span>
                        </button>
                    </form>

                    <div class="mt-7 flex items-center gap-4">
                        <div class="flex-1 border-t border-silver-200"></div>
                        <span class="text-xs text-woodsmoke-400">or</span>
                        <div class="flex-1 border-t border-silver-200"></div>
                    </div>

                    <a
                        href="/api/auth/google"
                        class="mt-4 w-full h-11 flex items-center justify-center gap-3 bg-white border border-silver-200 rounded-md text-sm font-medium text-woodsmoke-700 hover:bg-silver-50 transition-colors"
                    >
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
                            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
                        </svg>
                        Continue with Google
                    </a>

                    <p class="mt-6 text-center text-sm text-woodsmoke-500">
                        Already have an account?
                        <a href="/login" class="font-semibold text-orchid-600 hover:text-orchid-700 ml-1">Log in</a>
                    </p>
                </div><!-- end #credentialsStep -->

                <!-- Step 2: OTP verification -->
                <div id="otpStep" class="hidden">
                    <div class="text-center mb-6">
                        <div class="w-12 h-12 bg-orchid-100 rounded-md flex items-center justify-center mx-auto mb-4">
                            <svg xmlns="http://www.w3.org/2000/svg" class="text-orchid-600" width="26" height="26" viewBox="0 0 24 24">
                                <path fill="currentColor" d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2m0 4-8 5-8-5V6l8 5 8-5z"/>
                            </svg>
                        </div>
                        <h2 class="text-xl font-bold text-woodsmoke-950">Verify your email</h2>
                        <p class="text-sm text-woodsmoke-400 mt-2">We sent a 6-digit code to</p>
                        <p class="text-sm font-semibold text-woodsmoke-950 mt-1" id="otpEmailDisplay"></p>
                    </div>

                    <div class="mb-4">
                        <label for="otpCode" class="block text-sm font-medium text-woodsmoke-800 mb-1.5">Verification Code</label>
                        <input
                            type="text"
                            id="otpCode"
                            inputmode="numeric"
                            pattern="[0-9]*"
                            maxlength="6"
                            autocomplete="one-time-code"
                            class="w-full text-center text-2xl tracking-widest px-3 h-11 bg-silver-50 border border-silver-200 rounded-md focus:bg-orchid-50 focus:outline-none focus:ring-2 focus:ring-orchid-500 focus:border-transparent transition-colors"
                            placeholder="000000"
                        >
                    </div>

                    <div id="otpErrorMessage" class="hidden bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-md text-sm mb-4"></div>

                    <button
                        type="button"
                        id="verifyBtn"
                        aria-disabled="true"
                        class="w-full h-11 flex items-center justify-center bg-orchid-700 text-white text-sm font-semibold rounded-md aria-disabled:opacity-50 aria-disabled:cursor-not-allowed hover:bg-orchid-800 transition-colors mb-3"
                    >
                        <span data-btn-label>Verify &amp; Finish</span>
                        <span data-btn-loader class="hidden"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"><circle cx="4" cy="12" r="3" fill="currentColor"><animate id="otpDot1" attributeName="r" begin="0;otpDot3.end-0.25s" dur="0.75s" values="3;.2;3"/></circle><circle cx="12" cy="12" r="3" fill="currentColor"><animate attributeName="r" begin="otpDot1.end-0.6s" dur="0.75s" values="3;.2;3"/></circle><circle cx="20" cy="12" r="3" fill="currentColor"><animate id="otpDot3" attributeName="r" begin="otpDot1.end-0.45s" dur="0.75s" values="3;.2;3"/></circle></svg></span>
                    </button>

                    <div class="flex items-center justify-center gap-1 text-sm text-woodsmoke-500">
                        <span>Didn't receive it?</span>
                        <button type="button" id="resendBtn" class="font-semibold text-orchid-600 hover:text-orchid-700">Resend code</button>
                        <span id="resendCountdown" class="text-woodsmoke-400 hidden">(<span id="countdownNum">60</span>s)</span>
                    </div>
                </div><!-- end #otpStep -->

            </div>
        </div>

        <div class="hidden md:flex items-center justify-center pb-8 shrink-0">
            <a href="/" class="text-xs text-woodsmoke-400 hover:text-woodsmoke-700 transition-colors">← Back to home</a>
        </div>
    </div>

    <script type="module">
        function setBtnLoading(btn) {
            btn.querySelector('[data-btn-label]').classList.add('hidden');
            btn.querySelector('[data-btn-loader]').classList.remove('hidden');
        }
        function setBtnReady(btn) {
            btn.querySelector('[data-btn-label]').classList.remove('hidden');
            btn.querySelector('[data-btn-loader]').classList.add('hidden');
        }

        const signupForm = document.getElementById('signupForm');
        const submitBtn = document.getElementById('submitBtn');
        const errorMessage = document.getElementById('errorMessage');
        const successMessage = document.getElementById('successMessage');
        const emailInput = document.getElementById('email');
        const usernameInput = document.getElementById('username');
        const passwordInput = document.getElementById('password');
        const passwordConfirmInput = document.getElementById('passwordConfirm');

        const usernameValidation = document.getElementById('usernameValidation');
        const passwordMatchValidation = document.getElementById('passwordMatchValidation');

        // Show error from OAuth redirect
        const urlError = new URLSearchParams(window.location.search).get('error');
        if (urlError) {
            const msgs = {
                google_failed: 'Google sign-in failed. Please try again.',
                google_cancelled: 'Google sign-in was cancelled.',
                google_not_configured: 'Google sign-in is not available right now.'
            };
            errorMessage.textContent = msgs[urlError] || 'Something went wrong. Please try again.';
            errorMessage.classList.remove('hidden');
        }

        const agreeTermsCheckbox = document.getElementById('agreeTerms');
        const newsletterCheckbox = document.getElementById('newsletterSubscribe');

        document.querySelectorAll('[data-pw-toggle]').forEach(btn => {
            btn.addEventListener('click', () => {
                const input = document.getElementById(btn.dataset.pwToggle);
                const showing = input.type === 'text';
                input.type = showing ? 'password' : 'text';
                btn.querySelector('[data-pw-eye]').classList.toggle('hidden', !showing);
                btn.querySelector('[data-pw-eye-off]').classList.toggle('hidden', showing);
            });
        });

        function validateEmail(email) {
            return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
        }

        function validateUsername(username) {
            if (!username || username.length < 3 || username.length > 30) {
                return { valid: false, message: 'Username must be 3-30 characters' };
            }
            if (!/^[a-zA-Z0-9]+$/.test(username)) {
                return { valid: false, message: 'Only letters and numbers allowed' };
            }
            return { valid: true, message: 'Valid username' };
        }

        function validatePassword(password) {
            const requirements = {
                length: password.length >= 8,
                lowercase: (password.match(/[a-z]/g) || []).length >= 2,
                uppercase: (password.match(/[A-Z]/g) || []).length >= 2,
                digit: (password.match(/[0-9]/g) || []).length >= 2,
                special: (password.match(/[^a-zA-Z0-9]/g) || []).length >= 2
            };
            return { valid: Object.values(requirements).every(r => r), requirements };
        }

        const PASS_REQS = [
            { id: 'req-length',    test: v => v.length >= 8 },
            { id: 'req-uppercase', test: v => (v.match(/[A-Z]/g) || []).length >= 2 },
            { id: 'req-lowercase', test: v => (v.match(/[a-z]/g) || []).length >= 2 },
            { id: 'req-digit',     test: v => (v.match(/[0-9]/g) || []).length >= 2 },
            { id: 'req-special',   test: v => (v.match(/[^a-zA-Z0-9]/g) || []).length >= 2 },
        ];

        function updatePasswordRequirements(password) {
            PASS_REQS.forEach(({ id, test }) => {
                const li = document.getElementById(id);
                li.classList.toggle('text-emerald-500', test(password));
                li.classList.toggle('text-woodsmoke-300', !test(password));
            });
        }

        function validateForm() {
            const email = emailInput.value.trim();
            const username = usernameInput.value.trim();
            const password = passwordInput.value;
            const passwordConfirm = passwordConfirmInput.value;

            const emailValid = email && validateEmail(email);
            const usernameCheck = validateUsername(username);
            const passwordCheck = validatePassword(password);
            const passwordsMatch = password && password === passwordConfirm;

            if (!username) {
                usernameValidation.textContent = '3–30 characters, letters and numbers only';
                usernameValidation.className = 'text-xs mt-1 text-woodsmoke-400';
            } else if (!usernameCheck.valid) {
                usernameValidation.textContent = usernameCheck.message;
                usernameValidation.className = 'text-xs mt-1 text-red-500';
            } else {
                usernameValidation.textContent = '✓ Valid username';
                usernameValidation.className = 'text-xs mt-1 text-green-600';
            }

            if (!passwordConfirm) {
                passwordMatchValidation.classList.add('hidden');
            } else if (!passwordsMatch) {
                passwordMatchValidation.textContent = '✗ Passwords do not match';
                passwordMatchValidation.className = 'text-xs mt-1 text-red-500';
                passwordMatchValidation.classList.remove('hidden');
            } else {
                passwordMatchValidation.textContent = '✓ Passwords match';
                passwordMatchValidation.className = 'text-xs mt-1 text-green-600';
                passwordMatchValidation.classList.remove('hidden');
            }

            const isValid = emailValid && usernameCheck.valid && passwordCheck.valid && passwordsMatch && agreeTermsCheckbox.checked;
            submitBtn.setAttribute('aria-disabled', !isValid);
        }

        emailInput.addEventListener('input', validateForm);
        usernameInput.addEventListener('input', validateForm);
        passwordInput.addEventListener('input', () => {
            updatePasswordRequirements(passwordInput.value);
            validateForm();
        });
        passwordConfirmInput.addEventListener('input', validateForm);
        agreeTermsCheckbox.addEventListener('change', validateForm);

        async function checkAnonymousStatus() {
            try {
                const response = await fetch('/api/auth/status', { credentials: 'include' });
                if (response.ok) {
                    const data = await response.json();
                    if (!data.isAnonymous) window.location.href = '/showroom';
                }
            } catch {}
        }
        checkAnonymousStatus();

        signupForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            if (submitBtn.getAttribute('aria-disabled') === 'true') return;

            const email = emailInput.value.trim();
            const username = usernameInput.value.trim();
            const password = passwordInput.value;
            const passwordConfirm = passwordConfirmInput.value;

            errorMessage.classList.add('hidden');
            successMessage.classList.add('hidden');

            const usernameCheck = validateUsername(username);
            if (!usernameCheck.valid) {
                errorMessage.textContent = usernameCheck.message;
                errorMessage.classList.remove('hidden');
                return;
            }

            const passwordCheck = validatePassword(password);
            if (!passwordCheck.valid) {
                errorMessage.textContent = 'Password does not meet requirements';
                errorMessage.classList.remove('hidden');
                return;
            }

            if (password !== passwordConfirm) {
                errorMessage.textContent = 'Passwords do not match';
                errorMessage.classList.remove('hidden');
                return;
            }

            submitBtn.setAttribute('aria-disabled', 'true');
            setBtnLoading(submitBtn);

            try {
                const response = await fetch('/api/auth/signup', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify({ email, username, password, newsletter: newsletterCheckbox.checked })
                });
                const data = await response.json();
                if (!response.ok) throw new Error(data.error || 'Signup failed');
                showOtpStep(data.email);
            } catch (error) {
                errorMessage.textContent = error.message;
                errorMessage.classList.remove('hidden');
                setBtnReady(submitBtn);
                validateForm();
            }
        });

        // ── OTP step ──────────────────────────────────────────────────────

        let otpEmail = '';
        let resendTimer = null;

        function showOtpStep(email) {
            otpEmail = email;
            document.getElementById('otpEmailDisplay').textContent = email;
            document.getElementById('credentialsStep').classList.add('hidden');
            document.getElementById('otpStep').classList.remove('hidden');
            document.getElementById('otpCode').focus();
            startResendCooldown();
        }

        function startResendCooldown() {
            const resendBtn = document.getElementById('resendBtn');
            const resendCountdown = document.getElementById('resendCountdown');
            const countdownNum = document.getElementById('countdownNum');
            clearInterval(resendTimer);
            resendBtn.disabled = true;
            resendBtn.classList.add('opacity-50', 'cursor-not-allowed');
            resendCountdown.classList.remove('hidden');
            let seconds = 60;
            countdownNum.textContent = seconds;
            resendTimer = setInterval(() => {
                seconds--;
                countdownNum.textContent = seconds;
                if (seconds <= 0) {
                    clearInterval(resendTimer);
                    resendBtn.disabled = false;
                    resendBtn.classList.remove('opacity-50', 'cursor-not-allowed');
                    resendCountdown.classList.add('hidden');
                }
            }, 1000);
        }

        document.getElementById('otpCode').addEventListener('input', (e) => {
            e.target.value = e.target.value.replace(/\D/g, '');
            document.getElementById('verifyBtn').setAttribute('aria-disabled', e.target.value.length !== 6 ? 'true' : 'false');
        });

        document.getElementById('verifyBtn').addEventListener('click', async () => {
            const verifyBtn = document.getElementById('verifyBtn');
            if (verifyBtn.getAttribute('aria-disabled') === 'true') return;

            const code = document.getElementById('otpCode').value;
            const otpError = document.getElementById('otpErrorMessage');
            otpError.classList.add('hidden');
            verifyBtn.setAttribute('aria-disabled', 'true');
            setBtnLoading(verifyBtn);

            try {
                const response = await fetch('/api/auth/verify-otp', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify({ email: otpEmail, code })
                });
                const data = await response.json();
                if (!response.ok) throw new Error(data.error || 'Verification failed');
                window.location.href = '/showroom';
            } catch (error) {
                otpError.textContent = error.message;
                otpError.classList.remove('hidden');
                setBtnReady(verifyBtn);
                verifyBtn.setAttribute('aria-disabled', document.getElementById('otpCode').value.length !== 6 ? 'true' : 'false');
            }
        });

        document.getElementById('resendBtn').addEventListener('click', async () => {
            const resendBtn = document.getElementById('resendBtn');
            if (resendBtn.disabled) return;
            const otpError = document.getElementById('otpErrorMessage');
            otpError.classList.add('hidden');
            try {
                const response = await fetch('/api/auth/resend-otp', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify({ email: otpEmail })
                });
                const data = await response.json();
                if (!response.ok) throw new Error(data.error || 'Failed to resend');
                document.getElementById('otpCode').value = '';
                document.getElementById('verifyBtn').setAttribute('aria-disabled', 'true');
                startResendCooldown();
            } catch (error) {
                otpError.textContent = error.message;
                otpError.classList.remove('hidden');
            }
        });
    </script>
</body>
</html>

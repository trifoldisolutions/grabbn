<%
  title = 'FAQ'
  page  = 'faq'
%>
<%- include('../partials/layout') %>

<div class="max-w-[992px] mx-auto px-6 pt-10 <%= (user && !user.isAnonymous) ? 'pb-56' : 'pb-24' %> space-y-8">

    <!-- Header -->
    <div class="flex items-start justify-between gap-4 flex-wrap">
        <div>
            <h1 class="text-2xl font-bold text-woodsmoke-950">Frequently Asked Questions</h1>
            <p class="text-sm text-woodsmoke-500 mt-1">Answers to common questions about Grabbn.</p>
        </div>
        <!-- Subtle search -->
        <div class="relative mt-1 shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" class="absolute left-2.5 top-2.5 text-woodsmoke-300 pointer-events-none"><g fill="none" fill-rule="evenodd"><path d="m12.593 23.258l-.011.002l-.071.035l-.02.004l-.014-.004l-.071-.035q-.016-.005-.024.005l-.004.01l-.017.428l.005.02l.01.013l.104.074l.015.004l.012-.004l.104-.074l.012-.016l.004-.017l-.017-.427q-.004-.016-.017-.018m.265-.113l-.013.002l-.185.093l-.01.01l-.003.011l.018.43l.005.012l.008.007l.201.093q.019.005.029-.008l.004-.014l-.034-.614q-.005-.018-.02-.022m-.715.002a.02.02 0 0 0-.027.006l-.006.014l-.034.614q.001.018.017.024l.015-.002l.201-.093l.01-.008l.004-.011l.017-.43l-.003-.012l-.01-.01z"/><path fill="currentColor" d="M10.5 2a8.5 8.5 0 1 0 5.262 15.176l3.652 3.652a1 1 0 0 0 1.414-1.414l-3.652-3.652A8.5 8.5 0 0 0 10.5 2M4 10.5a6.5 6.5 0 1 1 13 0a6.5 6.5 0 0 1-13 0"/></g></svg>
            <input
                id="faqSearch"
                type="text"
                placeholder="Search questions…"
                class="w-52 pl-8 pr-3 h-8 text-sm border border-silver-200 rounded-md focus:outline-none focus:border-orchid-400 text-woodsmoke-800 placeholder-woodsmoke-300 bg-white"
            >
        </div>
    </div>

    <!-- Category pills -->
    <div id="categoryPills" class="flex flex-wrap gap-2">
        <button data-cat="all" class="faq-pill flex items-center justify-center h-7 px-3 text-xs font-medium rounded-md border border-orchid-600 bg-orchid-600 text-white transition-colors">All</button>
        <button data-cat="account"         class="faq-pill flex items-center justify-center h-7 px-3 text-xs font-medium rounded-md border border-silver-200 text-woodsmoke-500 hover:border-silver-300 hover:text-woodsmoke-700 transition-colors">Account & Verification</button>
        <button data-cat="buckets"         class="faq-pill flex items-center justify-center h-7 px-3 text-xs font-medium rounded-md border border-silver-200 text-woodsmoke-500 hover:border-silver-300 hover:text-woodsmoke-700 transition-colors">Buckets</button>
        <button data-cat="partner-program" class="faq-pill flex items-center justify-center h-7 px-3 text-xs font-medium rounded-md border border-silver-200 text-woodsmoke-500 hover:border-silver-300 hover:text-woodsmoke-700 transition-colors">Partner Program</button>
        <button data-cat="gtk"             class="faq-pill flex items-center justify-center h-7 px-3 text-xs font-medium rounded-md border border-silver-200 text-woodsmoke-500 hover:border-silver-300 hover:text-woodsmoke-700 transition-colors">GTK</button>
        <button data-cat="repositories"    class="faq-pill flex items-center justify-center h-7 px-3 text-xs font-medium rounded-md border border-silver-200 text-woodsmoke-500 hover:border-silver-300 hover:text-woodsmoke-700 transition-colors">Repositories & Showrooms</button>
        <button data-cat="moderation"      class="faq-pill flex items-center justify-center h-7 px-3 text-xs font-medium rounded-md border border-silver-200 text-woodsmoke-500 hover:border-silver-300 hover:text-woodsmoke-700 transition-colors">Content & Moderation</button>
    </div>

    <!-- FAQ accordion sections -->
    <div id="faqSections" class="space-y-10">
        <!-- Skeleton loader -->
        <div id="faqLoader" class="space-y-4">
            <% for (let i = 0; i < 3; i++) { %>
            <div class="animate-pulse space-y-2">
                <div class="h-3 w-32 bg-silver-100 rounded"></div>
                <div class="h-10 bg-silver-50 rounded-md border border-silver-100"></div>
                <div class="h-10 bg-silver-50 rounded-md border border-silver-100"></div>
            </div>
            <% } %>
        </div>
    </div>

    <!-- No results message -->
    <p id="faqNoResults" class="hidden text-sm text-woodsmoke-400 py-4">No questions match your search.</p>

    <!-- From the community -->
    <div id="communitySection" class="hidden space-y-4 pt-4 border-t border-silver-100">
        <h2 class="text-xs font-semibold text-woodsmoke-500 uppercase tracking-wider">From the community</h2>
        <p class="text-xs text-woodsmoke-400">These questions have been submitted by users and are awaiting an answer from the Grabbn team.</p>
        <ul id="pendingList" class="space-y-2"></ul>
    </div>

</div>

<!-- ── Fixed ask-a-question bar ─────────────────────────────────────────────── -->
<div class="fixed bottom-0 left-0 md:left-16 right-0 bg-white z-10">
    <div class="max-w-[992px] mx-auto px-6 py-4 space-y-2">
        <div class="flex items-baseline gap-2">
            <h2 class="text-sm font-semibold text-woodsmoke-900 shrink-0">Ask a question</h2>
            <p class="text-xs text-woodsmoke-400 truncate">Can't find what you're looking for? Submit it and the Grabbn team will answer it publicly.</p>
        </div>
        <% if (user && !user.isAnonymous) { %>
        <textarea
            id="questionInput"
            rows="3"
            maxlength="500"
            placeholder="Type your question here…"
            class="w-full text-sm border border-silver-200 rounded-md p-3 resize-none focus:outline-none focus:border-orchid-400 text-woodsmoke-800 placeholder-woodsmoke-300 leading-relaxed"
        ></textarea>
        <div class="flex items-center justify-between">
            <span id="charCount" class="text-xs text-woodsmoke-300">0 / 500</span>
            <div class="flex items-center gap-3">
                <p id="submitMsg" class="hidden text-xs"></p>
                <button
                    id="submitQuestionBtn"
                    class="inline-flex items-center justify-center h-10 px-5 bg-orchid-600 hover:bg-orchid-700 text-white text-sm font-semibold rounded-md transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
                >
                    Submit question
                </button>
            </div>
        </div>
        <% } else { %>
        <p class="text-sm text-woodsmoke-400">
            <a href="/login" class="text-orchid-600 hover:underline font-medium">Sign in</a> to submit a question.
        </p>
        <% } %>
    </div>
</div>

<script>
(function () {
    const FAQ_CATEGORIES = {
        'account':         'Account & Verification',
        'buckets':         'Buckets',
        'partner-program': 'Partner Program',
        'gtk':             'GTK',
        'repositories':    'Repositories & Showrooms',
        'moderation':      'Content & Moderation',
    };

    let allGroups   = {};
    let activeCat   = 'all';
    let searchQuery = '';

    // ── Fetch FAQ data ─────────────────────────────────────────────────────────
    async function loadFaq() {
        try {
            const [faqRes, pendingRes] = await Promise.all([
                fetch('/api/faq'),
                fetch('/api/faq/pending'),
            ]);
            const { grouped }   = await faqRes.json();
            const { questions } = await pendingRes.json();

            allGroups = grouped || {};
            renderSections();
            renderPending(questions || []);
        } catch (e) {
            document.getElementById('faqLoader').innerHTML =
                '<p class="text-sm text-woodsmoke-400">Failed to load FAQ. Please refresh.</p>';
        }
    }

    // ── Render accordion sections ──────────────────────────────────────────────
    function renderSections() {
        const container = document.getElementById('faqSections');
        const loader    = document.getElementById('faqLoader');
        const noResults = document.getElementById('faqNoResults');

        if (loader) loader.remove();

        const catOrder = Object.keys(FAQ_CATEGORIES);
        const sortedGroups = Object.values(allGroups).sort((a, b) => {
            return catOrder.indexOf(a.slug) - catOrder.indexOf(b.slug);
        });

        // Clear previous content (keep loader ref gone)
        container.innerHTML = '';

        const q = searchQuery.toLowerCase().trim();
        let visibleCount = 0;

        for (const group of sortedGroups) {
            if (activeCat !== 'all' && group.slug !== activeCat) continue;

            const matchingItems = group.items.filter(item => {
                if (!q) return true;
                return item.question.toLowerCase().includes(q) || item.answer.toLowerCase().includes(q);
            });

            if (!matchingItems.length) continue;
            visibleCount++;

            const section = document.createElement('div');
            section.className = 'faq-section space-y-1';
            section.dataset.cat = group.slug;

            const heading = document.createElement('h2');
            heading.className = 'text-xs font-semibold text-woodsmoke-500 uppercase tracking-wider mb-3';
            heading.textContent = group.label;
            section.appendChild(heading);

            for (const item of matchingItems) {
                section.appendChild(buildAccordionItem(item, q));
            }

            container.appendChild(section);
        }

        noResults.classList.toggle('hidden', visibleCount > 0);
    }

    function buildAccordionItem(item, highlight) {
        const wrapper = document.createElement('div');
        wrapper.className = 'border border-silver-200 rounded-md overflow-hidden';

        const btn = document.createElement('button');
        btn.className = 'w-full flex items-center justify-between gap-3 px-4 py-3 text-left text-sm font-medium text-woodsmoke-900 hover:bg-silver-50 transition-colors';
        btn.innerHTML = `
            <span class="leading-snug">${escHtml(item.question)}</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" class="shrink-0 transition-transform duration-200 text-woodsmoke-400"><g fill="none" fill-rule="evenodd"><path d="M24 0v24H0V0zM12.593 23.258l-.011.002l-.071.035l-.02.004l-.014-.004l-.071-.035q-.016-.005-.024.005l-.004.01l-.017.428l.005.02l.01.013l.104.074l.015.004l.012-.004l.104-.074l.012-.016l.004-.017l-.017-.427q-.004-.016-.017-.018m.265-.113l-.013.002l-.185.093l-.01.01l-.003.011l.018.43l.005.012l.008.007l.201.093q.019.005.029-.008l.004-.014l-.034-.614q-.005-.019-.02-.022m-.715.002a.02.02 0 0 0-.027.006l-.006.014l-.034.614q.001.018.017.024l.015-.002l.201-.093l.01-.008l.004-.011l.017-.43l-.003-.012l-.01-.01z"/><path fill="currentColor" d="M12.707 15.707a1 1 0 0 1-1.414 0L5.636 10.05A1 1 0 1 1 7.05 8.636l4.95 4.95l4.95-4.95a1 1 0 0 1 1.414 1.414z"/></g></svg>`;

        const body = document.createElement('div');
        body.className = 'hidden px-4 pb-4 text-sm text-woodsmoke-600 leading-relaxed border-t border-silver-100 pt-3';
        body.innerHTML = formatAnswer(item.answer);

        btn.addEventListener('click', () => {
            const isOpen = !body.classList.contains('hidden');
            // close all others in same section
            wrapper.parentElement.querySelectorAll(':scope > div > div.border-t').forEach(b => {
                b.classList.add('hidden');
                const svg = b.previousElementSibling?.querySelector('svg');
                if (svg) svg.style.transform = '';
            });
            if (!isOpen) {
                body.classList.remove('hidden');
                btn.querySelector('svg').style.transform = 'rotate(180deg)';
            }
        });

        wrapper.appendChild(btn);
        wrapper.appendChild(body);
        return wrapper;
    }

    function formatAnswer(text) {
        // Convert newlines to <br> and make bare URLs clickable
        return escHtml(text)
            .replace(/\n/g, '<br>')
            .replace(/(https?:\/\/[^\s<]+)/g, '<a href="$1" class="text-orchid-600 hover:underline" target="_blank" rel="noopener noreferrer">$1</a>');
    }

    function escHtml(str) {
        return str.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    // ── Render pending community questions ────────────────────────────────────
    function renderPending(questions) {
        const section = document.getElementById('communitySection');
        const list    = document.getElementById('pendingList');
        if (!questions.length) return;

        for (const q of questions) {
            const li = document.createElement('li');
            li.className = 'flex items-start gap-2 text-sm text-woodsmoke-600 py-2 border-b border-silver-100 last:border-0';
            li.innerHTML = `
                <svg class="shrink-0 mt-0.5 text-woodsmoke-300" width="14" height="14" viewBox="0 0 24 24">
                    <path fill="currentColor" d="M12 22C6.477 22 2 17.523 2 12S6.477 2 12 2s10 4.477 10 10s-4.477 10-10 10m0-11a1 1 0 0 0-1 1v4a1 1 0 1 0 2 0v-4a1 1 0 0 0-1-1m0-4a1 1 0 1 0 0 2a1 1 0 0 0 0-2"/>
                </svg>
                <span>${escHtml(q.question)}</span>`;
            list.appendChild(li);
        }

        section.classList.remove('hidden');
    }

    // ── Category pill filtering ────────────────────────────────────────────────
    document.getElementById('categoryPills').addEventListener('click', (e) => {
        const btn = e.target.closest('.faq-pill');
        if (!btn) return;
        activeCat = btn.dataset.cat;
        document.querySelectorAll('.faq-pill').forEach(p => {
            const active = p === btn;
            p.classList.toggle('bg-orchid-600',  active);
            p.classList.toggle('text-white',      active);
            p.classList.toggle('border-orchid-600', active);
            p.classList.toggle('text-woodsmoke-500', !active);
            p.classList.toggle('border-silver-200',  !active);
        });
        renderSections();
    });

    // ── Search filtering ───────────────────────────────────────────────────────
    document.getElementById('faqSearch').addEventListener('input', (e) => {
        searchQuery = e.target.value;
        renderSections();
    });

    // ── Question submission ────────────────────────────────────────────────────
    const textarea  = document.getElementById('questionInput');
    const charCount = document.getElementById('charCount');
    const submitBtn = document.getElementById('submitQuestionBtn');
    const submitMsg = document.getElementById('submitMsg');

    if (textarea) {
        textarea.addEventListener('input', () => {
            const len = textarea.value.length;
            charCount.textContent = `${len} / 500`;
        });

        submitBtn.addEventListener('click', async () => {
            const question = textarea.value.trim();
            if (!question) return;

            submitBtn.disabled = true;
            submitBtn.textContent = 'Submitting…';
            submitMsg.classList.add('hidden');

            try {
                const res  = await fetch('/api/faq/questions', {
                    method:  'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body:    JSON.stringify({ question }),
                });
                const data = await res.json();
                if (!res.ok) throw new Error(data.error || 'Failed to submit');

                textarea.value       = '';
                charCount.textContent = '0 / 500';
                submitMsg.textContent = 'Your question has been submitted. The Grabbn team will answer it publicly.';
                submitMsg.classList.remove('hidden');
                submitMsg.classList.add('text-woodsmoke-500');
            } catch (err) {
                submitMsg.textContent = err.message;
                submitMsg.classList.remove('hidden');
                submitMsg.classList.add('text-red-500');
            } finally {
                submitBtn.disabled    = false;
                submitBtn.textContent = 'Submit question';
            }
        });
    }

    loadFaq();
})();
</script>

<%- include('../partials/layout-end') %>

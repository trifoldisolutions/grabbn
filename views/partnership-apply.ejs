<%
  title = 'Apply — Grabbn Partner Program'
  page  = 'partnership'
%>
<%
const _hasAvatar       = !!(user && user.avatar      && user.avatar.trim());
const _hasDisplayName  = !!(user && user.displayName && user.displayName.trim());
const _hasBio          = !!(user && user.bio         && user.bio.trim());
const _profileComplete = _hasAvatar && _hasDisplayName && _hasBio;
%>
<%- include('partials/layout') %>

<div class="max-w-[992px] mx-auto px-6 py-8">

    <!-- ── Already a partner ──────────────────────────────────────── -->
    <% if (user && user.isPartner) { %>
    <div class="space-y-3 text-center py-12">
        <div class="w-12 h-12 rounded-md bg-orchid-100 text-orchid-600 flex items-center justify-center mx-auto">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24"><g fill="none" fill-rule="evenodd"><path d="m12.593 23.258l-.011.002l-.071.035l-.02.004l-.014-.004l-.071-.035q-.016-.005-.024.005l-.004.01l-.017.428l.005.02l.01.013l.104.074l.015.004l.012-.004l.104-.074l.012-.016l.004-.017l-.017-.427q-.004-.016-.017-.018m.265-.113l-.013.002l-.185.093l-.01.01l-.003.011l.018.43l.005.012l.008.007l.201.093q.019.005.029-.008l.004-.014l-.034-.614q-.005-.018-.02-.022m-.715.002a.02.02 0 0 0-.027.006l-.006.014l-.034.614q.001.018.017.024l.015-.002l.201-.093l.01-.008l.004-.011l.017-.43l-.003-.012l-.01-.01z"/><path fill="currentColor" d="M21.546 5.111a1.5 1.5 0 0 1 0 2.121L10.303 18.475a1.6 1.6 0 0 1-2.263 0L2.454 12.89a1.5 1.5 0 1 1 2.121-2.121l4.596 4.596L19.424 5.111a1.5 1.5 0 0 1 2.122 0"/></g></svg>
        </div>
        <h1 class="text-lg font-semibold text-woodsmoke-950">You're already a partner</h1>
        <p class="text-sm text-woodsmoke-500">Your partner features are active. Manage them from within any bucket you own.</p>
        <a href="/showroom" class="inline-block mt-2 text-sm text-orchid-600 hover:underline">Back to Grabbn</a>
    </div>

    <!-- ── Not logged in ──────────────────────────────────────────── -->
    <% } else if (!user || user.isAnonymous) { %>
    <div class="space-y-3 text-center py-12">
        <h1 class="text-lg font-semibold text-woodsmoke-950">Sign in to apply</h1>
        <p class="text-sm text-woodsmoke-500">You need a verified Grabbn account to apply for the Partner Program.</p>
        <a href="/login" class="inline-flex items-center justify-center mt-2 px-5 h-10 bg-orchid-600 hover:bg-orchid-700 text-white text-sm font-semibold rounded-md transition-colors">Sign In</a>
    </div>

    <!-- ── Email not verified ─────────────────────────────────────── -->
    <% } else if (!user.isEmailVerified) { %>
    <div class="space-y-3 text-center py-12">
        <h1 class="text-lg font-semibold text-woodsmoke-950">Verify your email first</h1>
        <p class="text-sm text-woodsmoke-500">You need a verified email address before you can apply.</p>
        <a href="/settings" class="inline-block mt-2 text-sm text-orchid-600 hover:underline">Go to Settings</a>
    </div>

    <!-- ── Application pending ────────────────────────────────────── -->
    <% } else if (applicationStatus && applicationStatus.status === 'pending') { %>
    <div class="space-y-3 text-center py-12">
        <div class="w-12 h-12 rounded-md bg-amber-100 text-amber-600 flex items-center justify-center mx-auto">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24"><path fill="currentColor" d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2m1 14h-2v-2h2zm0-4h-2V7h2z"/></svg>
        </div>
        <h1 class="text-lg font-semibold text-woodsmoke-950">Application under review</h1>
        <p class="text-sm text-woodsmoke-500">
            Submitted <%= new Date(applicationStatus.submittedAt).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) %>.
            We'll email you when it's been reviewed.
        </p>
        <a href="/partnership" class="inline-block mt-2 text-sm text-orchid-600 hover:underline">About the Partner Program</a>
    </div>

    <!-- ── Application flow ───────────────────────────────────────── -->
    <% } else { %>

    <div class="space-y-6">

        <div>
            <h1 class="text-xl font-bold text-woodsmoke-950">Grabbn Partner Program</h1>
            <p class="text-sm text-woodsmoke-400 mt-1">See where you stand, then apply.</p>
        </div>

        <!-- ════════════════════════════════════════════════════════════
             ELIGIBILITY SCREEN
             ════════════════════════════════════════════════════════════ -->
        <div id="eligibilityScreen" class="space-y-5">

            <!-- Loading -->
            <div id="eligibilityLoading" class="flex items-center gap-2.5 py-10 text-sm text-woodsmoke-400">
                <svg class="animate-spin w-4 h-4 shrink-0 text-woodsmoke-300" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4l3-3-3-3v4a8 8 0 00-8 8h4z"></path>
                </svg>
                Checking eligibility…
            </div>

            <!-- Results -->
            <div id="eligibilityResults" class="hidden space-y-4">

                <!-- Rejection notice -->
                <% if (applicationStatus && applicationStatus.status === 'rejected') { %>
                <div class="bg-red-50 border border-red-200 rounded-md p-4 space-y-1">
                    <div class="text-sm font-semibold text-red-800">Previous application not approved</div>
                    <% if (applicationStatus.rejectionReason) { %>
                    <div class="text-sm text-red-700"><%= applicationStatus.rejectionReason %></div>
                    <% } %>
                    <p class="text-sm text-red-600 mt-1">You may submit a new application below.</p>
                </div>
                <% } %>

                <!-- Gate failures (populated by JS) -->
                <div id="gateFailuresNotice" class="hidden bg-red-50 border border-red-200 rounded-md p-4 space-y-1 text-sm text-red-700"></div>

                <!-- Profile incomplete notice -->
                <% if (!_profileComplete) { %>
                <div class="bg-amber-50 border border-amber-200 rounded-md p-4 flex items-start gap-3">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" class="text-amber-500 shrink-0 mt-0.5"><path fill="currentColor" d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2m1 14h-2v-2h2zm0-4h-2V7h2z"/></svg>
                    <div>
                        <div class="text-sm font-semibold text-amber-800">Complete your profile first</div>
                        <p class="text-sm text-amber-700 mt-0.5 leading-relaxed">Partners are the face of Grabbn — add a <a href="/settings/account" class="underline hover:no-underline">profile photo, display name, and bio</a> before applying.</p>
                    </div>
                </div>
                <% } %>

                <!-- Tier cards (built by JS) -->
                <div id="tierCardsContainer" class="grid grid-cols-1 sm:grid-cols-2 gap-4"></div>

            </div>
        </div>

        <!-- ════════════════════════════════════════════════════════════
             FORM SECTION
             ════════════════════════════════════════════════════════════ -->
        <div id="formSection" class="hidden space-y-6">

            <!-- Tier banner -->
            <div class="flex items-center gap-2 text-sm border-b border-silver-100 pb-5">
                <span class="text-woodsmoke-400">Applying for</span>
                <span id="applyingForLabel" class="font-semibold text-woodsmoke-900"></span>
                <span class="text-woodsmoke-300">·</span>
                <button id="changeTierBtn" class="text-sm text-orchid-600 hover:underline flex items-center justify-center">Change</button>
            </div>

            <!-- Step indicator -->
            <div id="stepIndicator" class="flex items-start">
                <div class="flex flex-col items-center gap-1.5 shrink-0">
                    <div id="sn1" class="w-7 h-7 rounded-md flex items-center justify-center text-xs font-bold bg-orchid-600 text-white">1</div>
                    <span id="sl1" class="text-sm font-semibold text-orchid-600 whitespace-nowrap">Application</span>
                </div>
                <div id="sc12" class="flex-1 h-px mt-3.5 mx-2 bg-silver-200"></div>
                <div class="flex flex-col items-center gap-1.5 shrink-0">
                    <div id="sn2" class="w-7 h-7 rounded-md flex items-center justify-center text-xs font-bold bg-silver-100 text-woodsmoke-400">2</div>
                    <span id="sl2" class="text-sm font-medium text-woodsmoke-400 whitespace-nowrap">Identity</span>
                </div>
                <div id="sc23" class="flex-1 h-px mt-3.5 mx-2 bg-silver-200"></div>
                <div class="flex flex-col items-center gap-1.5 shrink-0">
                    <div id="sn3" class="w-7 h-7 rounded-md flex items-center justify-center text-xs font-bold bg-silver-100 text-woodsmoke-400">3</div>
                    <span id="sl3" class="text-sm font-medium text-woodsmoke-400 whitespace-nowrap">Review</span>
                </div>
            </div>
            <p id="stepDescription" class="text-sm text-woodsmoke-500 leading-relaxed -mt-2"></p>

            <!-- ── STEP 1: Application ──────────────────────────────── -->
            <div id="step1" class="hidden space-y-5">

                <div class="space-y-1.5">
                    <label class="text-sm font-semibold text-woodsmoke-600">Why do you want to be a Grabbn Partner? <span class="text-red-500">*</span></label>
                    <textarea id="pitchInput"
                        rows="6"
                        maxlength="4000"
                        placeholder="Tell us about your curation work, your niche, and why you'd be a great fit…"
                        class="w-full text-sm border border-silver-200 rounded-md px-3 py-2.5 resize-none focus:outline-none focus:ring-2 focus:ring-orchid-500 focus:border-transparent text-woodsmoke-900 placeholder-woodsmoke-300">
                    </textarea>
                    <div class="flex items-center justify-between text-sm text-woodsmoke-300">
                        <span id="pitchMinHint" class="text-woodsmoke-400">Minimum 100 characters</span>
                        <span><span id="pitchCount">0</span> / 4000</span>
                    </div>
                </div>

                <div class="space-y-2">
                    <div class="flex items-center justify-between">
                        <label class="text-sm font-semibold text-woodsmoke-600">Linked accounts <span class="text-woodsmoke-300">(optional)</span></label>
                        <button id="addAccountBtn" class="text-sm text-orchid-600 hover:underline flex items-center justify-center">+ Add account</button>
                    </div>
                    <p class="text-sm text-woodsmoke-400">If you operate multiple Grabbn accounts, declare them here.</p>
                    <div id="claimedAccountsList" class="space-y-3"></div>
                </div>

                <div class="flex gap-3 pt-1">
                    <button id="step1Back"
                        class="flex-1 py-2.5 border border-silver-200 text-sm font-semibold text-woodsmoke-700 rounded-md hover:bg-silver-50 transition-colors flex items-center justify-center">
                        Back
                    </button>
                    <button id="step1Next"
                        class="flex-1 py-2.5 bg-orchid-600 hover:bg-orchid-700 text-white text-sm font-semibold rounded-md transition-colors flex items-center justify-center">
                        Continue
                    </button>
                </div>
            </div>

            <!-- ── STEP 2: Identity ────────────────────────────────── -->
            <div id="step2" class="hidden space-y-5">

                <p class="text-sm text-woodsmoke-400 leading-relaxed">
                    Upload a government-issued ID and a selfie holding it. These are reviewed manually by a Grabbn admin — your data stays in-house and is never shared with third parties.
                </p>

                <div class="space-y-1.5">
                    <label class="text-sm font-semibold text-woodsmoke-600">Government-issued ID <span class="text-red-500">*</span></label>
                    <div id="idDropzone" class="border-2 border-dashed border-silver-200 rounded-md p-6 text-center cursor-pointer hover:border-orchid-300 transition-colors">
                        <div id="idPlaceholder" class="space-y-1">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" class="mx-auto text-woodsmoke-300"><path fill="currentColor" d="M19 13a1 1 0 0 0-1 1v.38l-1.48-1.48a2.79 2.79 0 0 0-3.93 0l-.7.7l-2.48-2.48a2.85 2.85 0 0 0-3.93 0L4 12.6V7a1 1 0 0 1 1-1h7a1 1 0 0 0 0-2H5a3 3 0 0 0-3 3v12a3 3 0 0 0 3 3h12a3 3 0 0 0 3-3v-5a1 1 0 0 0-1-1M5 20a1 1 0 0 1-1-1v-3.57l2.9-2.9a.79.79 0 0 1 1.09 0l3.17 3.17l.91.9L15.46 20zm13-1a1 1 0 0 1-.18.54L13.31 15l.7-.7a.77.77 0 0 1 1.1 0L18 17.21zm4.71-14.71l-3-3a1 1 0 0 0-.33-.21a1 1 0 0 0-.76 0a1 1 0 0 0-.33.21l-3 3a1 1 0 0 0 1.42 1.42L19 4.41V10a1 1 0 0 0 2 0V4.41l1.29 1.3a1 1 0 0 0 1.42 0a1 1 0 0 0 0-1.42"/></svg>
                            <div class="text-xs text-woodsmoke-400">Click or drag to upload</div>
                            <div class="text-xs text-woodsmoke-300">JPG, PNG — max 5 MB</div>
                        </div>
                        <img id="idPreview" class="hidden max-h-32 mx-auto rounded-md object-contain" />
                    </div>
                    <input type="file" id="idFile" accept="image/*" class="hidden" />
                </div>

                <div class="space-y-1.5">
                    <label class="text-sm font-semibold text-woodsmoke-600">Selfie holding the ID <span class="text-red-500">*</span></label>
                    <div id="selfieDropzone" class="border-2 border-dashed border-silver-200 rounded-md p-6 text-center cursor-pointer hover:border-orchid-300 transition-colors">
                        <div id="selfiePlaceholder" class="space-y-1">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" class="mx-auto text-woodsmoke-300"><path fill="currentColor" d="M9 2a1 1 0 0 0 0 2h6a1 1 0 1 0 0-2zm-4 4a3 3 0 0 0-3 3v9a3 3 0 0 0 3 3h14a3 3 0 0 0 3-3V9a3 3 0 0 0-3-3zm7 2a5 5 0 1 1 0 10A5 5 0 0 1 12 8m0 2a3 3 0 1 0 0 6a3 3 0 0 0 0-6"/></svg>
                            <div class="text-xs text-woodsmoke-400">Click or drag to upload</div>
                            <div class="text-xs text-woodsmoke-300">JPG, PNG — max 5 MB</div>
                        </div>
                        <img id="selfiePreview" class="hidden max-h-32 mx-auto rounded-md object-contain" />
                    </div>
                    <input type="file" id="selfieFile" accept="image/*" class="hidden" />
                </div>

                <div class="flex items-start gap-2.5 pt-1">
                    <input type="checkbox" id="usResidentCheck"
                        class="mt-0.5 shrink-0 w-4 h-4 accent-orchid-600 cursor-pointer" />
                    <label for="usResidentCheck" class="text-sm text-woodsmoke-600 leading-snug cursor-pointer">
                        I confirm that I currently reside in the United States <span class="text-red-500">*</span>
                    </label>
                </div>

                <div class="flex gap-3 pt-1">
                    <button id="step2Back"
                        class="flex-1 py-2.5 border border-silver-200 text-sm font-semibold text-woodsmoke-700 rounded-md hover:bg-silver-50 transition-colors flex items-center justify-center">
                        Back
                    </button>
                    <button id="step2Next"
                        class="flex-1 py-2.5 bg-orchid-600 hover:bg-orchid-700 text-white text-sm font-semibold rounded-md transition-colors flex items-center justify-center">
                        Review &amp; Submit
                    </button>
                </div>
            </div>

            <!-- ── STEP 3: Review ──────────────────────────────────── -->
            <div id="step3" class="hidden space-y-5">

                <div class="bg-silver-50 border border-silver-100 rounded-md divide-y divide-silver-100">
                    <div class="flex items-center justify-between px-4 py-3 text-sm">
                        <span class="text-woodsmoke-400">Account</span>
                        <span class="text-woodsmoke-700 font-medium"><%= user.email %></span>
                    </div>
                    <div class="flex items-center justify-between px-4 py-3 text-sm">
                        <span class="text-woodsmoke-400">Applying for</span>
                        <span id="reviewTier" class="text-woodsmoke-700 font-medium"></span>
                    </div>
                    <div class="px-4 py-3">
                        <div class="text-sm text-woodsmoke-400 mb-1.5">Pitch</div>
                        <div id="reviewPitch" class="text-sm text-woodsmoke-700 whitespace-pre-line leading-relaxed"></div>
                    </div>
                    <div class="flex items-center gap-6 px-4 py-3 text-sm text-woodsmoke-400">
                        <span>ID: <span id="reviewIdStatus" class="text-woodsmoke-700">—</span></span>
                        <span>Selfie: <span id="reviewSelfieStatus" class="text-woodsmoke-700">—</span></span>
                        <span>US resident: <span class="text-woodsmoke-700">Confirmed</span></span>
                    </div>
                </div>

                <div class="flex items-start gap-2.5">
                    <input type="checkbox" id="ageConfirmCheck"
                        class="mt-0.5 shrink-0 w-4 h-4 accent-orchid-600 cursor-pointer" />
                    <label for="ageConfirmCheck" class="text-sm text-woodsmoke-600 leading-snug cursor-pointer">
                        I confirm that I am at least 18 years old <span class="text-red-500">*</span>
                    </label>
                </div>

                <p class="text-sm text-woodsmoke-400 leading-relaxed">
                    By submitting, you confirm that the information above is accurate and that you agree to the Grabbn Partner Program terms and community guidelines.
                </p>

                <div class="flex gap-3">
                    <button id="step3Back"
                        class="flex-1 py-2.5 border border-silver-200 text-sm font-semibold text-woodsmoke-700 rounded-md hover:bg-silver-50 transition-colors flex items-center justify-center">
                        Back
                    </button>
                    <button id="submitBtn"
                        class="flex-1 py-2.5 bg-orchid-600 hover:bg-orchid-700 text-white text-sm font-semibold rounded-md transition-colors flex items-center justify-center gap-2 disabled:opacity-60 disabled:cursor-not-allowed">
                        <span>Submit Application</span>
                    </button>
                </div>
            </div>

            <!-- ── SUCCESS ─────────────────────────────────────────── -->
            <div id="successState" class="hidden text-center py-8 space-y-3">
                <div class="w-12 h-12 rounded-md bg-emerald-100 text-emerald-600 flex items-center justify-center mx-auto">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24"><g fill="none" fill-rule="evenodd"><path d="m12.593 23.258l-.011.002l-.071.035l-.02.004l-.014-.004l-.071-.035q-.016-.005-.024.005l-.004.01l-.017.428l.005.02l.01.013l.104.074l.015.004l.012-.004l.104-.074l.012-.016l.004-.017l-.017-.427q-.004-.016-.017-.018m.265-.113l-.013.002l-.185.093l-.01.01l-.003.011l.018.43l.005.012l.008.007l.201.093q.019.005.029-.008l.004-.014l-.034-.614q-.005-.018-.02-.022m-.715.002a.02.02 0 0 0-.027.006l-.006.014l-.034.614q.001.018.017.024l.015-.002l.201-.093l.01-.008l.004-.011l.017-.43l-.003-.012l-.01-.01z"/><path fill="currentColor" d="M21.546 5.111a1.5 1.5 0 0 1 0 2.121L10.303 18.475a1.6 1.6 0 0 1-2.263 0L2.454 12.89a1.5 1.5 0 1 1 2.121-2.121l4.596 4.596L19.424 5.111a1.5 1.5 0 0 1 2.122 0"/></g></svg>
                </div>
                <h2 class="text-base font-semibold text-woodsmoke-950">Application submitted</h2>
                <p class="text-sm text-woodsmoke-500">We'll review it and email you at <strong><%= user.email %></strong> as soon as possible.</p>
                <a href="/showroom" class="inline-block mt-2 text-sm text-orchid-600 hover:underline">Back to Grabbn</a>
            </div>

        </div><!-- /formSection -->

    </div>
    <% } %>
</div>

<script>
(function () {

    const eligibilityScreenEl = document.getElementById('eligibilityScreen');
    if (!eligibilityScreenEl) return; // guard: gated states

    const formSectionEl = document.getElementById('formSection');
    const step1El       = document.getElementById('step1');
    const step2El       = document.getElementById('step2');
    const step3El       = document.getElementById('step3');
    const successEl     = document.getElementById('successState');

    let selectedTier      = null;
    let idBase64          = null;
    let selfieBase64      = null;
    const claimedAccounts = [];

    // ── Eligibility ───────────────────────────────────────────────────────────
    const THRESHOLDS = {
        junior: { ageMonths: 3,  buckets: 5,  subscribers: 1000,  grabs: 5000,  enforcementDays: 60  },
        pro:    { ageMonths: 12, buckets: 15, subscribers: 10000, grabs: 50000, enforcementDays: 180 },
    };

    const TIER_LABELS = { junior: 'Junior Partner', pro: 'Pro Partner' };
    const TIER_DESCS  = {
        junior: 'Monetize your curation work with affiliate links and audience-driven features.',
        pro:    'Full monetization suite, priority support, and higher revenue share.',
    };

    function fmtCount(n) {
        if (n >= 1_000_000) return (n / 1_000_000).toFixed(1).replace(/\.0$/, '') + 'M';
        if (n >= 1_000)     return (n / 1_000).toFixed(1).replace(/\.0$/, '') + 'k';
        return n.toLocaleString();
    }

    const CHECK_SVG = `<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" class="shrink-0"><path fill="currentColor" d="M21.546 5.111a1.5 1.5 0 0 1 0 2.121L10.303 18.475a1.6 1.6 0 0 1-2.263 0L2.454 12.89a1.5 1.5 0 1 1 2.121-2.121l4.596 4.596L19.424 5.111a1.5 1.5 0 0 1 2.122 0"/></svg>`;
    const X_SVG    = `<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" class="shrink-0"><path fill="currentColor" d="M19 6.41L17.59 5L12 10.59L6.41 5L5 6.41L10.59 12L5 17.59L6.41 19L12 13.41L17.59 19L19 17.59L13.41 12z"/></svg>`;

    function statRow(label, userVal, reqVal, passes) {
        const iconCls  = passes ? 'text-emerald-500' : 'text-red-400';
        const labelCls = passes ? 'text-woodsmoke-600' : 'text-woodsmoke-400';
        const valCls   = passes ? 'font-medium text-woodsmoke-800' : 'text-woodsmoke-400';
        return `<div class="flex items-center justify-between py-2 border-b border-silver-100 last:border-0">
            <div class="flex items-center gap-2">
                <span class="${iconCls}">${passes ? CHECK_SVG : X_SVG}</span>
                <span class="text-sm ${labelCls}">${label}</span>
            </div>
            <div class="text-sm">
                <span class="${valCls}">${userVal}</span><span class="text-woodsmoke-300"> / ${reqVal}</span>
            </div>
        </div>`;
    }

    function buildTierCard(tier, data, gatesOk, profileOk) {
        const t     = THRESHOLDS[tier];
        const stats = data.stats;
        const td    = data[tier];

        const ageOk         = stats.accountAgeMonths >= t.ageMonths;
        const bucketsOk     = td.qualifyingBuckets  >= t.buckets;
        const subscribersOk = stats.subscriberCount >= t.subscribers;
        const grabsOk       = stats.grabCount       >= t.grabs;
        const enforcementOk = stats.daysSinceLastViolation === null
                              || stats.daysSinceLastViolation >= t.enforcementDays;

        const eligible = tier === 'junior' ? true : (gatesOk && profileOk && td.passes);

        const recordUserVal = stats.daysSinceLastViolation === null
            ? 'No violations' : `${stats.daysSinceLastViolation}d clean`;
        const recordReqVal  = `${t.enforcementDays}d clean`;

        const badge = eligible
            ? `<span class="shrink-0 text-sm font-medium text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded-md">Eligible</span>`
            : `<span class="shrink-0 text-sm font-medium text-woodsmoke-400 bg-silver-100 px-2 py-0.5 rounded-md">Not eligible</span>`;

        const applyBtn = eligible
            ? `<button data-tier="${tier}" class="apply-tier-btn w-full py-2.5 text-sm font-semibold rounded-md flex items-center justify-center bg-orchid-600 hover:bg-orchid-700 text-white transition-colors">Apply as ${TIER_LABELS[tier]}</button>`
            : `<button disabled class="w-full py-2.5 text-sm font-semibold rounded-md flex items-center justify-center bg-silver-100 text-woodsmoke-300 cursor-not-allowed">Requirements not met</button>`;

        return `<div class="border ${eligible ? 'border-silver-200' : 'border-silver-100 bg-silver-50/50'} rounded-md p-4 space-y-3">
            <div class="flex items-start justify-between gap-3">
                <div>
                    <div class="text-base font-semibold text-woodsmoke-900">${TIER_LABELS[tier]}</div>
                    <p class="text-sm text-woodsmoke-400 mt-0.5 leading-snug">${TIER_DESCS[tier]}</p>
                </div>
                ${badge}
            </div>
            <div>
                ${statRow('Account age',        `${stats.accountAgeMonths} mo`,      `${t.ageMonths} mo`, ageOk)}
                ${statRow('Subscribers',        fmtCount(stats.subscriberCount),     fmtCount(t.subscribers), subscribersOk)}
                ${statRow('Grabs',              fmtCount(stats.grabCount),           fmtCount(t.grabs), grabsOk)}
                ${statRow('Qualifying buckets', String(td.qualifyingBuckets),        String(t.buckets), bucketsOk)}
                ${statRow('Clean record',       recordUserVal,                       recordReqVal, enforcementOk)}
            </div>
            ${applyBtn}
        </div>`;
    }

    async function loadEligibility() {
        try {
            const res  = await fetch('/api/partnership/eligibility', { credentials: 'include' });
            const data = await res.json();

            document.getElementById('eligibilityLoading').classList.add('hidden');

            if (!res.ok) {
                showError(data.error || 'Failed to check eligibility');
                return;
            }

            // Gate failures
            const failures = [];
            if (!data.gates.emailVerified)       failures.push('Your email must be verified before applying.');
            if (!data.gates.accountStanding)     failures.push('Your account has a standing issue that prevents you from applying.');
            if (!data.gates.noActiveApplication) failures.push('You already have a pending application.');
            const gateNotice = document.getElementById('gateFailuresNotice');
            if (failures.length) {
                gateNotice.innerHTML = failures.map(m => `<p>${m}</p>`).join('');
                gateNotice.classList.remove('hidden');
            }

            const gatesOk   = data.gates.emailVerified && data.gates.accountStanding && data.gates.noActiveApplication;
            const profileOk = <%- JSON.stringify(_profileComplete) %>;

            const container = document.getElementById('tierCardsContainer');
            container.innerHTML = buildTierCard('junior', data, gatesOk, profileOk)
                                + buildTierCard('pro',    data, gatesOk, profileOk);

            container.querySelectorAll('.apply-tier-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    selectedTier = btn.dataset.tier;
                    document.getElementById('applyingForLabel').textContent = TIER_LABELS[selectedTier];
                    eligibilityScreenEl.classList.add('hidden');
                    formSectionEl.classList.remove('hidden');
                    showStep(1);
                });
            });

            document.getElementById('eligibilityResults').classList.remove('hidden');
        } catch {
            document.getElementById('eligibilityLoading').classList.add('hidden');
            showError('Network error — could not check eligibility');
        }
    }

    loadEligibility();

    // ── Change tier ───────────────────────────────────────────────────────────
    document.getElementById('changeTierBtn')?.addEventListener('click', () => {
        formSectionEl.classList.add('hidden');
        eligibilityScreenEl.classList.remove('hidden');
    });

    // ── Step indicator ────────────────────────────────────────────────────────
    const STEP_CHECK = `<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" class="shrink-0"><g fill="none" fill-rule="evenodd"><path d="m12.593 23.258l-.011.002l-.071.035l-.02.004l-.014-.004l-.071-.035q-.016-.005-.024.005l-.004.01l-.017.428l.005.02l.01.013l.104.074l.015.004l.012-.004l.104-.074l.012-.016l.004-.017l-.017-.427q-.004-.016-.017-.018m.265-.113l-.013.002l-.185.093l-.01.01l-.003.011l.018.43l.005.012l.008.007l.201.093q.019.005.029-.008l.004-.014l-.034-.614q-.005-.018-.02-.022m-.715.002a.02.02 0 0 0-.027.006l-.006.014l-.034.614q.001.018.017.024l.015-.002l.201-.093l.01-.008l.004-.011l.017-.43l-.003-.012l-.01-.01z"/><path fill="currentColor" d="M21.546 5.111a1.5 1.5 0 0 1 0 2.121L10.303 18.475a1.6 1.6 0 0 1-2.263 0L2.454 12.89a1.5 1.5 0 1 1 2.121-2.121l4.596 4.596L19.424 5.111a1.5 1.5 0 0 1 2.122 0"/></g></svg>`;

    const STEP_DESCRIPTIONS = {
        1: 'Tell us about your curation work and why you\'d be a great fit.',
        2: 'Upload a government-issued ID and a selfie holding it to verify your identity.',
        3: 'Review everything before you submit. Your application will be assessed manually by the Grabbn team.',
    };

    function updateStepIndicator(current) {
        const desc = document.getElementById('stepDescription');
        if (desc) desc.textContent = STEP_DESCRIPTIONS[current] ?? '';

        for (let i = 1; i <= 3; i++) {
            const node  = document.getElementById(`sn${i}`);
            const label = document.getElementById(`sl${i}`);
            const line  = i < 3 ? document.getElementById(`sc${i}${i + 1}`) : null;
            if (!node || !label) continue;

            if (i < current) {
                node.className  = 'w-7 h-7 rounded-md flex items-center justify-center bg-orchid-600 text-white';
                node.innerHTML  = STEP_CHECK;
                label.className = 'text-sm font-medium text-orchid-500 whitespace-nowrap';
                if (line) line.className = 'flex-1 h-px mt-3.5 mx-2 bg-orchid-300';
            } else if (i === current) {
                node.className  = 'w-7 h-7 rounded-md flex items-center justify-center bg-orchid-600 text-white text-xs font-bold';
                node.innerHTML  = String(i);
                label.className = 'text-sm font-semibold text-orchid-600 whitespace-nowrap';
                if (line) line.className = 'flex-1 h-px mt-3.5 mx-2 bg-silver-200';
            } else {
                node.className  = 'w-7 h-7 rounded-md flex items-center justify-center bg-silver-100 text-woodsmoke-400 text-xs font-bold';
                node.innerHTML  = String(i);
                label.className = 'text-sm font-medium text-woodsmoke-400 whitespace-nowrap';
                if (line) line.className = 'flex-1 h-px mt-3.5 mx-2 bg-silver-200';
            }
        }
    }

    // ── Step routing ──────────────────────────────────────────────────────────
    function showStep(n) {
        step1El.classList.toggle('hidden', n !== 1);
        step2El.classList.toggle('hidden', n !== 2);
        step3El.classList.toggle('hidden', n !== 3);
        updateStepIndicator(n);
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function showError(msg) {
        window.showToast(msg, 'error');
    }

    // ── Step navigation ───────────────────────────────────────────────────────
    document.getElementById('step1Back')?.addEventListener('click', () => {
        formSectionEl.classList.add('hidden');
        eligibilityScreenEl.classList.remove('hidden');
    });
    document.getElementById('step2Back')?.addEventListener('click', () => showStep(1));
    document.getElementById('step3Back')?.addEventListener('click', () => showStep(2));

    // ── File pickers ──────────────────────────────────────────────────────────
    function wireFilePicker(dropzoneId, fileInputId, previewId, placeholderId, setter) {
        const dropzone    = document.getElementById(dropzoneId);
        const fileInput   = document.getElementById(fileInputId);
        const preview     = document.getElementById(previewId);
        const placeholder = document.getElementById(placeholderId);
        if (!dropzone) return;

        dropzone.addEventListener('click', () => fileInput.click());
        dropzone.addEventListener('dragover', e => { e.preventDefault(); dropzone.classList.add('border-orchid-400'); });
        dropzone.addEventListener('dragleave', () => dropzone.classList.remove('border-orchid-400'));
        dropzone.addEventListener('drop', e => {
            e.preventDefault();
            dropzone.classList.remove('border-orchid-400');
            const file = e.dataTransfer.files[0];
            if (file) processFile(file);
        });
        fileInput.addEventListener('change', () => { if (fileInput.files[0]) processFile(fileInput.files[0]); });

        function processFile(file) {
            if (file.size > 5 * 1024 * 1024) { showError('File too large — max 5 MB'); return; }
            const reader = new FileReader();
            reader.onload = e => {
                setter(e.target.result);
                preview.src = e.target.result;
                preview.classList.remove('hidden');
                placeholder.classList.add('hidden');
            };
            reader.readAsDataURL(file);
        }
    }

    wireFilePicker('idDropzone',     'idFile',     'idPreview',     'idPlaceholder',     v => { idBase64 = v; });
    wireFilePicker('selfieDropzone', 'selfieFile', 'selfiePreview', 'selfiePlaceholder', v => { selfieBase64 = v; });

    // ── Pitch counter ─────────────────────────────────────────────────────────
    const pitchInput = document.getElementById('pitchInput');
    const pitchCount = document.getElementById('pitchCount');
    const pitchHint  = document.getElementById('pitchMinHint');
    if (pitchInput && pitchCount) {
        pitchInput.addEventListener('input', () => {
            const len = pitchInput.value.length;
            pitchCount.textContent = len;
            if (pitchHint) pitchHint.classList.toggle('text-woodsmoke-300', len >= 100);
        });
    }

    // ── Linked accounts ───────────────────────────────────────────────────────
    const addAccountBtn = document.getElementById('addAccountBtn');
    const claimedList   = document.getElementById('claimedAccountsList');

    if (addAccountBtn) {
        addAccountBtn.addEventListener('click', () => {
            const idx = claimedAccounts.length;
            claimedAccounts.push({ email: '', phone: '', bucketOwnerIds: ['', '', ''] });

            const el = document.createElement('div');
            el.className = 'bg-silver-50 border border-silver-100 rounded-md p-3 space-y-2';
            el.dataset.idx = idx;
            el.innerHTML = `
                <div class="flex items-center justify-between">
                    <span class="text-sm font-semibold text-woodsmoke-600">Account ${idx + 1}</span>
                    <button class="remove-account text-sm text-red-500 hover:underline">Remove</button>
                </div>
                <input data-field="email" type="email" placeholder="Email"
                    class="w-full text-sm border border-silver-200 rounded-md px-2 py-2 focus:outline-none focus:ring-1 focus:ring-orchid-400" />
                <input data-field="phone" type="tel" placeholder="Phone"
                    class="w-full text-sm border border-silver-200 rounded-md px-2 py-2 focus:outline-none focus:ring-1 focus:ring-orchid-400" />
                <div class="text-sm text-woodsmoke-400">Up to 3 bucket owner IDs from this account:</div>
                <input data-field="bid0" type="text" placeholder="Bucket owner ID 1"
                    class="w-full text-sm border border-silver-200 rounded-md px-2 py-2 focus:outline-none focus:ring-1 focus:ring-orchid-400" />
                <input data-field="bid1" type="text" placeholder="Bucket owner ID 2"
                    class="w-full text-sm border border-silver-200 rounded-md px-2 py-2 focus:outline-none focus:ring-1 focus:ring-orchid-400" />
                <input data-field="bid2" type="text" placeholder="Bucket owner ID 3"
                    class="w-full text-sm border border-silver-200 rounded-md px-2 py-2 focus:outline-none focus:ring-1 focus:ring-orchid-400" />
            `;

            el.querySelectorAll('input').forEach(inp => {
                inp.addEventListener('input', () => {
                    const f = inp.dataset.field;
                    if      (f === 'email') claimedAccounts[idx].email = inp.value;
                    else if (f === 'phone') claimedAccounts[idx].phone = inp.value;
                    else if (f.startsWith('bid')) claimedAccounts[idx].bucketOwnerIds[+f.slice(3)] = inp.value;
                });
            });

            el.querySelector('.remove-account').addEventListener('click', () => {
                claimedAccounts.splice(idx, 1);
                el.remove();
            });

            claimedList.appendChild(el);
        });
    }

    // ── Step 1 → Step 2 ──────────────────────────────────────────────────────
    document.getElementById('step1Next')?.addEventListener('click', () => {
        const pitch = pitchInput?.value?.trim() || '';
        if (pitch.length < 100) { showError('Pitch must be at least 100 characters'); return; }
        showStep(2);
    });

    // ── Step 2 → Step 3 ──────────────────────────────────────────────────────
    document.getElementById('step2Next')?.addEventListener('click', () => {
        if (!idBase64)     { showError('Please upload your government-issued ID'); return; }
        if (!selfieBase64) { showError('Please upload a selfie holding your ID');  return; }
        if (!document.getElementById('usResidentCheck')?.checked) {
            showError('Please confirm your US residency');
            return;
        }

        const pitch = pitchInput?.value?.trim() || '';
        document.getElementById('reviewPitch').textContent        = pitch;
        document.getElementById('reviewIdStatus').textContent     = 'Uploaded';
        document.getElementById('reviewSelfieStatus').textContent = 'Uploaded';
        document.getElementById('reviewTier').textContent         = TIER_LABELS[selectedTier];

        showStep(3);
    });

    // ── Submit ────────────────────────────────────────────────────────────────
    document.getElementById('submitBtn')?.addEventListener('click', async () => {
        const submitBtn  = document.getElementById('submitBtn');
        const submitSpan = submitBtn.querySelector('span');

        if (!document.getElementById('ageConfirmCheck')?.checked) {
            showError('Please confirm you are at least 18 years old');
            return;
        }

        submitBtn.disabled     = true;
        submitSpan.textContent = 'Submitting…';

        try {
            const pitch    = pitchInput?.value?.trim() || '';
            const accounts = claimedAccounts.filter(a => a.email || a.phone);

            const res = await fetch('/api/partnership/apply', {
                method:      'POST',
                headers:     { 'Content-Type': 'application/json' },
                credentials: 'include',
                body: JSON.stringify({
                    pitch,
                    tier:                selectedTier,
                    idFileRef:           idBase64,
                    selfieFileRef:       selfieBase64,
                    claimedAccounts:     accounts,
                    usResidentConfirmed: true,
                    ageConfirmed:        true,
                }),
            });

            const data = await res.json();
            if (!res.ok) {
                showError(data.error || 'Something went wrong');
                submitBtn.disabled     = false;
                submitSpan.textContent = 'Submit Application';
                return;
            }

            step3El.classList.add('hidden');
            successEl.classList.remove('hidden');
            document.getElementById('stepIndicator')?.classList.add('hidden');
            document.querySelector('#formSection .border-b')?.classList.add('hidden');
        } catch {
            showError('Network error — please try again');
            submitBtn.disabled     = false;
            submitSpan.textContent = 'Submit Application';
        }
    });

})();
</script>

<%- include('partials/layout-end') %>

    <!-- PAGE SCRIPT -->
    <script type="module">
        const API_BASE = window.location.origin;
        let isLoggedIn = false;

        async function init() {
            try {
                const res = await fetch(`${API_BASE}/api/credits/balance`, { credentials: 'include' });

                if (res.ok) {
                    const { credits } = await res.json();
                    isLoggedIn = true;

                    const pill = document.getElementById('balancePill');
                    document.getElementById('balanceAmount').textContent = credits.toLocaleString();
                    pill.classList.remove('hidden');
                    pill.classList.add('flex');

                    document.getElementById('navAuthArea').innerHTML = `
                        <a href="/showroom"
                           class="text-sm font-semibold text-white bg-orchid-700 hover:bg-orchid-800 transition-colors px-4 py-2 rounded-md">
                            Open app
                        </a>
                    `;
                } else {
                    renderLoggedOutNav();
                }
            } catch {
                renderLoggedOutNav();
            }
        }

        function renderLoggedOutNav() {
            document.getElementById('navAuthArea').innerHTML = `
                <a href="/login"
                   class="text-sm text-gray-500 hover:text-woodsmoke-950 transition-colors px-3 py-1.5 rounded-md">
                    Sign in
                </a>
                <a href="/signup"
                   class="text-sm font-semibold text-white bg-orchid-700 hover:bg-orchid-800 transition-colors px-4 py-2 rounded-md">
                    Get started free
                </a>
            `;
        }

        async function doCheckout(btn, credits, originalLabel) {
            if (!isLoggedIn) {
                window.location.href = `/login?redirect=${encodeURIComponent('/topup')}`;
                return;
            }

            btn.disabled = true;
            btn.textContent = 'Redirecting to Stripe…';

            try {
                const res = await fetch(`${API_BASE}/api/credits/topup`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify({ credits })
                });

                if (!res.ok) {
                    const err = await res.json();
                    throw new Error(err.error || 'Failed to create checkout session');
                }

                const { url } = await res.json();
                window.location.href = url;
            } catch (err) {
                btn.disabled = false;
                btn.textContent = originalLabel;
                const errorBanner = document.getElementById('errorBanner');
                if (errorBanner) {
                    errorBanner.textContent = err.message || 'Something went wrong. Please try again.';
                    errorBanner.classList.remove('hidden');
                    setTimeout(() => errorBanner.classList.add('hidden'), 5000);
                }
            }
        }

        document.querySelectorAll('.buyBtn').forEach(btn => {
            btn.addEventListener('click', () => {
                doCheckout(btn, parseInt(btn.dataset.credits, 10), btn.dataset.label);
            });
        });

        let customMode = 'crd';

        const customInputWrapper = document.getElementById('customInputWrapper');
        const customAmountInput  = document.getElementById('customAmountInput');
        const customModeToggle   = document.getElementById('customModeToggle');
        const customBuyBtn       = document.getElementById('customBuyBtn');
        const customAmountHint   = document.getElementById('customAmountHint');
        const customAmountError  = document.getElementById('customAmountError');

        function updateCustomHint() {
            const raw = parseFloat(customAmountInput.value);
            if (!raw || raw <= 0) { customAmountHint.classList.add('hidden'); return; }
            customAmountHint.textContent = customMode === 'crd'
                ? `= $${(raw / 100).toFixed(2)}`
                : `= ${Math.round(raw * 100).toLocaleString()} GTK`;
            customAmountHint.classList.remove('hidden');
        }

        customModeToggle.addEventListener('click', () => {
            customMode = customMode === 'crd' ? 'usd' : 'crd';
            const isCrd = customMode === 'crd';
            customModeToggle.textContent = isCrd ? 'GTK' : 'USD';
            customAmountInput.step        = isCrd ? '1' : '0.01';
            customAmountInput.placeholder = isCrd ? '0' : '0.00';
            customAmountInput.value = '';
            customAmountHint.classList.add('hidden');
            customAmountError.classList.add('hidden');
        });

        customAmountInput.addEventListener('input', () => {
            customAmountError.classList.add('hidden');
            updateCustomHint();
        });

        customBuyBtn.addEventListener('click', () => {
            customAmountError.classList.add('hidden');
            const raw = parseFloat(customAmountInput.value);
            if (!raw || raw <= 0) return;
            const credits = customMode === 'crd' ? Math.round(raw) : Math.round(raw * 100);
            if (credits < 800 || credits > 50000) {
                customAmountError.textContent = 'Enter an amount between 800 GTK ($8.00) and 50,000 GTK ($500.00).';
                customAmountError.classList.remove('hidden');
                return;
            }
            doCheckout(customBuyBtn, credits, 'Buy');
        });

        // Pre-fill custom amount from ?gtk= query param (e.g. redirected from boost modal)
        const jwlParam = new URLSearchParams(window.location.search).get('gtk');
        if (jwlParam) {
            const jwlVal = parseInt(jwlParam, 10);
            if (jwlVal > 0) {
                customAmountInput.value = jwlVal;
                customInputWrapper.classList.add('border-orchid-400');
                customInputWrapper.classList.remove('border-gray-200');
                updateCustomHint();
                setTimeout(() => customInputWrapper.closest('.bg-white').scrollIntoView({ behavior: 'smooth', block: 'center' }), 200);
            }
        }

        init();
    </script>

    <!-- Error banner -->
    <div id="errorBanner"
        class="hidden fixed bottom-5 left-1/2 -translate-x-1/2 bg-red-600 text-white text-sm font-semibold px-5 py-3 rounded-xl shadow-lg z-50 max-w-sm text-center">
    </div>

</body>
</html>

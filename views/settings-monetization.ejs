<%
  title          = 'Monetization'
  page           = 'settings'
  settingsSection = 'monetization'
%>
<%- include('partials/layout') %>

<div class="flex flex-1 overflow-hidden justify-center">
  <div class="flex w-full max-w-[992px] overflow-hidden">

    <%- include('partials/settings-nav') %>

    <!-- Content area -->
    <div class="flex-1 overflow-y-auto">
      <div class="w-full px-6 py-6">

        <% if (user && !user.isAnonymous) { %>

        <!-- ── Stripe Payouts ─────────────────────────────────────────────────── -->
        <div class="border border-silver-200 rounded-md divide-y divide-silver-100 mb-6">

          <div class="px-5 py-4">
            <p class="text-sm font-semibold uppercase tracking-wide text-woodsmoke-400">Payouts</p>
          </div>

          <div class="px-5 py-4 flex items-center justify-between gap-4">
            <div class="flex flex-col gap-0.5 min-w-0">
              <span class="text-sm font-semibold text-woodsmoke-900">Stripe payout account</span>
              <span class="text-sm text-woodsmoke-400">Connect a Stripe account to receive payments from your paid buckets</span>
            </div>
            <button class="flex items-center justify-center text-sm font-semibold px-5 h-9 border border-silver-200 rounded-md text-woodsmoke-600 opacity-50 cursor-not-allowed" disabled>
              Connect
            </button>
          </div>

          <div class="px-5 py-4 flex items-center justify-between gap-4">
            <div class="flex flex-col gap-0.5 min-w-0">
              <span class="text-sm font-semibold text-woodsmoke-900">Cash out</span>
              <span class="text-sm text-woodsmoke-400">Transfer your available balance to your bank account</span>
            </div>
            <button class="flex items-center justify-center text-sm font-semibold px-5 h-9 border border-silver-200 rounded-md text-woodsmoke-600 opacity-50 cursor-not-allowed" disabled>
              Cash out
            </button>
          </div>

          <div class="px-5 py-4 flex items-center justify-between gap-4">
            <div class="flex flex-col gap-0.5 min-w-0">
              <span class="text-sm font-semibold text-woodsmoke-900">Transaction history</span>
              <span class="text-sm text-woodsmoke-400">View your past earnings and payouts</span>
            </div>
            <button class="flex items-center justify-center text-sm font-semibold px-5 h-9 border border-silver-200 rounded-md text-woodsmoke-600 opacity-50 cursor-not-allowed" disabled>
              View
            </button>
          </div>

        </div>

        <!-- ── Meta-fetch Quota ───────────────────────────────────────────────── -->
        <div class="border border-silver-200 rounded-md divide-y divide-silver-100 mb-6">

          <div class="px-5 py-4">
            <p class="text-sm font-semibold uppercase tracking-wide text-woodsmoke-400">Meta-fetch quota</p>
          </div>

          <div class="px-5 py-4 flex items-center justify-between gap-4">
            <div class="flex flex-col gap-0.5 min-w-0">
              <span class="text-sm font-semibold text-woodsmoke-900">Daily usage</span>
              <span class="text-sm text-woodsmoke-400">Automatic link previews used today</span>
            </div>
            <span class="text-sm font-semibold text-woodsmoke-500">— / —</span>
          </div>

          <div class="px-5 py-4 flex items-center justify-between gap-4">
            <div class="flex flex-col gap-0.5 min-w-0">
              <span class="text-sm font-semibold text-woodsmoke-900">Top up credits</span>
              <span class="text-sm text-woodsmoke-400">Purchase additional meta-fetch quota</span>
            </div>
            <button class="flex items-center justify-center text-sm font-semibold px-5 h-9 border border-silver-200 rounded-md text-woodsmoke-600 opacity-50 cursor-not-allowed" disabled>
              Top up
            </button>
          </div>

        </div>

        <% } else { %>
          <p class="text-sm text-woodsmoke-400">Please <a href="/?openAuth=true" class="text-orchid-600 font-semibold hover:underline">sign in</a> to manage your settings.</p>
        <% } %>

      </div>
    </div>

  </div>
</div>

<%- include('partials/layout-end') %>

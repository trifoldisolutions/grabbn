<%
  title          = 'Monetization'
  page           = 'settings'
  settingsSection = 'monetization'
%>
<%- include('partials/layout') %>

<div class="flex flex-1 overflow-hidden justify-center">
  <div class="flex flex-col md:flex-row w-full max-w-[992px] overflow-hidden">

    <%- include('partials/settings-nav') %>

    <!-- Content area -->
    <div class="flex-1 overflow-y-auto scrollbar-hide">
      <div class="w-full px-6 py-6 pb-20 md:pb-6">

        <% if (user && !user.isAnonymous) { %>

        <!-- ── Partner Program ───────────────────────────────────────────── -->
        <div class="border border-silver-200 rounded-md divide-y divide-silver-100 mb-6">

          <div class="px-5 py-4">
            <p class="text-sm font-semibold uppercase tracking-wide text-woodsmoke-400">Partner Program</p>
          </div>

          <% if (user.isPartner) { %>

            <!-- Tier / status row -->
            <div class="px-5 py-4 flex items-center justify-between gap-4">
              <div class="flex flex-col gap-0.5 min-w-0">
                <span class="text-sm font-semibold text-woodsmoke-900">Tier</span>
                <span id="partnerSince" class="text-sm text-woodsmoke-400">Approved Grabbn Partner</span>
              </div>
              <span id="tierBadge" class="flex items-center justify-center text-sm font-semibold px-3 h-7 bg-orchid-50 text-orchid-700 border border-orchid-200 rounded-md shrink-0">Partner</span>
            </div>

            <!-- Ad earnings placeholder -->
            <div class="px-5 py-4 flex items-center justify-between gap-4">
              <div class="flex flex-col gap-0.5 min-w-0">
                <span class="text-sm font-semibold text-woodsmoke-900">Ad earnings</span>
                <span class="text-sm text-woodsmoke-400">Revenue from ads on your buckets will appear here once payouts are live</span>
              </div>
              <span class="flex items-center justify-center text-sm font-semibold px-3 h-7 bg-silver-50 text-woodsmoke-400 border border-silver-200 rounded-md shrink-0">Coming soon</span>
            </div>

            <!-- Program details -->
            <div class="px-5 py-4 flex items-center justify-between gap-4">
              <div class="flex flex-col gap-0.5 min-w-0">
                <span class="text-sm font-semibold text-woodsmoke-900">Program details</span>
                <span class="text-sm text-woodsmoke-400">Benefits, tier requirements, and enforcement policy</span>
              </div>
              <a href="/partnership" class="flex items-center justify-center text-sm font-semibold px-5 h-9 border border-silver-200 rounded-md text-woodsmoke-600 hover:border-woodsmoke-300 transition-colors shrink-0">
                View
              </a>
            </div>

            <!-- Upgrade to Pro — revealed by JS when tier is junior -->
            <div id="upgradeRow" class="px-5 py-4 flex items-center justify-between gap-4" style="display:none">
              <div class="flex flex-col gap-0.5 min-w-0">
                <span class="text-sm font-semibold text-woodsmoke-900">Upgrade to Pro</span>
                <span class="text-sm text-woodsmoke-400">Apply for Pro Partner status to unlock a higher revenue share rate</span>
              </div>
              <a href="/partnership/apply?tier=pro" class="flex items-center justify-center text-sm font-semibold px-5 h-9 border border-orchid-500 text-orchid-600 hover:bg-orchid-50 rounded-md transition-colors shrink-0">
                Apply
              </a>
            </div>

          <% } else { %>

            <!-- Status row — filled by JS -->
            <div class="px-5 py-4 flex items-center justify-between gap-4">
              <div class="flex flex-col gap-0.5 min-w-0">
                <span class="text-sm font-semibold text-woodsmoke-900">Status</span>
                <span id="appStatusDesc" class="text-sm text-woodsmoke-400">—</span>
              </div>
              <span id="appStatusBadge" class="flex items-center justify-center text-sm font-semibold px-3 h-7 bg-silver-50 text-woodsmoke-400 border border-silver-200 rounded-md shrink-0">—</span>
            </div>

            <!-- Eligibility stats — filled by JS -->
            <div class="px-5 py-5 space-y-5">
              <div class="relative inline-block">
                <button id="tierDropdownBtn" class="flex items-center justify-center gap-1.5 text-xs font-semibold uppercase tracking-wide text-woodsmoke-500 hover:text-woodsmoke-700 transition-colors">
                  <span id="tierDropdownLabel">Junior Partner eligibility</span>
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" class="shrink-0 transition-transform duration-150"><g fill="none" fill-rule="evenodd"><path d="M24 0v24H0V0zM12.593 23.258l-.011.002l-.071.035l-.02.004l-.014-.004l-.071-.035q-.016-.005-.024.005l-.004.01l-.017.428l.005.02l.01.013l.104.074l.015.004l.012-.004l.104-.074l.012-.016l.004-.017l-.017-.427q-.004-.016-.017-.018m.265-.113l-.013.002l-.185.093l-.01.01l-.003.011l.018.43l.005.012l.008.007l.201.093q.019.005.029-.008l.004-.014l-.034-.614q-.005-.019-.02-.022m-.715.002a.02.02 0 0 0-.027.006l-.006.014l-.034.614q.001.018.017.024l.015-.002l.201-.093l.01-.008l.004-.011l.017-.43l-.003-.012l-.01-.01z"/><path fill="currentColor" d="M12.707 15.707a1 1 0 0 1-1.414 0L5.636 10.05A1 1 0 1 1 7.05 8.636l4.95 4.95l4.95-4.95a1 1 0 0 1 1.414 1.414z"/></g></svg>
                </button>
                <div id="tierDropdownMenu" class="hidden absolute top-full left-0 mt-1.5 bg-white border border-silver-200 rounded-md shadow-sm z-10 py-1 min-w-[210px]">
                  <button id="tierOptJunior" class="flex items-center w-full px-3 py-2 text-sm font-semibold text-woodsmoke-900 hover:bg-silver-50 text-left">Junior Partner eligibility</button>
                  <button id="tierOptPro"    class="flex items-center w-full px-3 py-2 text-sm text-woodsmoke-500 hover:bg-silver-50 text-left">Pro Partner eligibility</button>
                </div>
              </div>

              <div class="space-y-6">

                <div class="space-y-1.5">
                  <div class="flex items-start justify-between gap-4">
                    <div>
                      <div class="flex items-center gap-2">
                        <span class="w-1.5 h-1.5 rounded-full bg-woodsmoke-300 shrink-0"></span>
                        <span class="text-sm font-semibold text-woodsmoke-900">Account age</span>
                      </div>
                      <p class="text-xs text-woodsmoke-400 mt-0.5 ml-3.5">How long your Grabbn account has been active</p>
                    </div>
                    <span id="statAge" class="text-xs font-semibold text-woodsmoke-700 tabular-nums shrink-0">—</span>
                  </div>
                  <div class="h-1.5 bg-silver-100 rounded-md overflow-hidden">
                    <div id="barAge" class="h-full bg-orchid-400 rounded-md" style="width:0%;transition:width .5s ease"></div>
                  </div>
                </div>

                <div class="space-y-1.5">
                  <div class="flex items-start justify-between gap-4">
                    <div>
                      <div class="flex items-center gap-2">
                        <span class="w-1.5 h-1.5 rounded-full bg-woodsmoke-300 shrink-0"></span>
                        <span class="text-sm font-semibold text-woodsmoke-900">Qualifying buckets</span>
                      </div>
                      <p class="text-xs text-woodsmoke-400 mt-0.5 ml-3.5">Public buckets meeting the minimum age, link count, and click thresholds</p>
                    </div>
                    <span id="statBuckets" class="text-xs font-semibold text-woodsmoke-700 tabular-nums shrink-0">—</span>
                  </div>
                  <div class="h-1.5 bg-silver-100 rounded-md overflow-hidden">
                    <div id="barBuckets" class="h-full bg-orchid-400 rounded-md" style="width:0%;transition:width .5s ease"></div>
                  </div>
                </div>

                <div class="space-y-1.5">
                  <div class="flex items-start justify-between gap-4">
                    <div>
                      <div class="flex items-center gap-2">
                        <span class="w-1.5 h-1.5 rounded-full bg-woodsmoke-300 shrink-0"></span>
                        <span class="text-sm font-semibold text-woodsmoke-900">Subscribers</span>
                      </div>
                      <p class="text-xs text-woodsmoke-400 mt-0.5 ml-3.5">Accounts following you on Grabbn</p>
                    </div>
                    <span id="statSubs" class="text-xs font-semibold text-woodsmoke-700 tabular-nums shrink-0">—</span>
                  </div>
                  <div class="h-1.5 bg-silver-100 rounded-md overflow-hidden">
                    <div id="barSubs" class="h-full bg-orchid-400 rounded-md" style="width:0%;transition:width .5s ease"></div>
                  </div>
                </div>

                <div class="space-y-1.5">
                  <div class="flex items-start justify-between gap-4">
                    <div>
                      <div class="flex items-center gap-2">
                        <span class="w-1.5 h-1.5 rounded-full bg-woodsmoke-300 shrink-0"></span>
                        <span class="text-sm font-semibold text-woodsmoke-900">Cumulative grabs</span>
                      </div>
                      <p class="text-xs text-woodsmoke-400 mt-0.5 ml-3.5">Total grabs across all your public buckets</p>
                    </div>
                    <span id="statGrabs" class="text-xs font-semibold text-woodsmoke-700 tabular-nums shrink-0">—</span>
                  </div>
                  <div class="h-1.5 bg-silver-100 rounded-md overflow-hidden">
                    <div id="barGrabs" class="h-full bg-orchid-400 rounded-md" style="width:0%;transition:width .5s ease"></div>
                  </div>
                </div>

                <div class="flex items-start justify-between gap-4">
                  <div>
                    <div class="flex items-center gap-2">
                      <span class="w-1.5 h-1.5 rounded-full bg-woodsmoke-300 shrink-0"></span>
                      <span class="text-sm font-semibold text-woodsmoke-900">Enforcement record</span>
                    </div>
                    <p class="text-xs text-woodsmoke-400 mt-0.5 ml-3.5">No actioned violations within the required clean window</p>
                  </div>
                  <span id="statEnf" class="flex items-center gap-1.5 text-xs font-semibold tabular-nums shrink-0 text-woodsmoke-300">
                    <span class="w-1.5 h-1.5 rounded-full bg-current shrink-0"></span>
                    <span id="enfText">—</span>
                  </span>
                </div>

              </div>

              <p class="text-xs text-woodsmoke-400">And more — content quality, intent, and curation history are also evaluated during review.</p>
            </div>

            <!-- Program details -->
            <div class="px-5 py-4 flex items-center justify-between gap-4">
              <div class="flex flex-col gap-0.5 min-w-0">
                <span class="text-sm font-semibold text-woodsmoke-900">Program details</span>
                <span class="text-sm text-woodsmoke-400">Benefits, eligibility requirements, and the application process</span>
              </div>
              <a href="/partnership" class="flex items-center justify-center text-sm font-semibold px-5 h-9 border border-silver-200 rounded-md text-woodsmoke-600 hover:border-woodsmoke-300 transition-colors shrink-0">
                View
              </a>
            </div>

            <!-- Apply CTA — hidden by JS if a pending application exists -->
            <div id="applyRow" class="px-5 py-4 flex items-center justify-between gap-4">
              <div class="flex flex-col gap-0.5 min-w-0">
                <span class="text-sm font-semibold text-woodsmoke-900">Apply</span>
                <span class="text-sm text-woodsmoke-400">Free to apply — applications are reviewed manually by the Grabbn team</span>
              </div>
              <a id="applyBtn" href="/partnership/apply" class="flex items-center justify-center text-sm font-semibold px-5 h-9 bg-orchid-600 hover:bg-orchid-700 text-white rounded-md transition-colors shrink-0">
                Apply
              </a>
            </div>

          <% } %>

        </div>

        <!-- ── Stripe Payouts ─────────────────────────────────────────────────── -->
        <div class="border border-silver-200 rounded-md divide-y divide-silver-100 mb-6">

          <div class="px-5 py-4">
            <p class="text-sm font-semibold uppercase tracking-wide text-woodsmoke-400">Payouts</p>
          </div>

          <div class="px-5 py-4 flex items-center justify-between gap-4">
            <div class="flex flex-col gap-0.5 min-w-0">
              <span class="text-sm font-semibold text-woodsmoke-900">Stripe payout account</span>
              <span id="connectDesc" class="text-sm text-woodsmoke-400">Connect a Stripe account to receive payments from your paid buckets</span>
            </div>
            <button id="connectBtn" class="flex items-center justify-center text-sm font-semibold px-5 h-9 border border-silver-200 rounded-md text-woodsmoke-600 hover:border-woodsmoke-300 transition-colors shrink-0">
              Connect
            </button>
          </div>

          <div class="px-5 py-4 flex items-center justify-between gap-4">
            <div class="flex flex-col gap-0.5 min-w-0">
              <span class="text-sm font-semibold text-woodsmoke-900">Transaction history</span>
              <span class="text-sm text-woodsmoke-400">View your past earnings, top-ups, and cash outs</span>
            </div>
            <a href="/transactions" class="flex items-center justify-center text-sm font-semibold px-5 h-9 border border-silver-200 rounded-md text-woodsmoke-600 hover:border-woodsmoke-300 transition-colors shrink-0">
              View
            </a>
          </div>

        </div>

        <!-- ── Credits ───────────────────────────────────────────────────────── -->
        <div class="border border-silver-200 rounded-md divide-y divide-silver-100 mb-6">

          <div class="px-5 py-4">
            <p class="text-sm font-semibold uppercase tracking-wide text-woodsmoke-400">GTK</p>
          </div>

          <div class="px-5 py-4 flex items-center justify-between gap-4">
            <div class="flex flex-col gap-0.5 min-w-0">
              <span class="text-sm font-semibold text-woodsmoke-900">Top up GTK</span>
              <span class="text-sm text-woodsmoke-400">Purchase GTK to unlock paywalled buckets</span>
            </div>
            <a href="/topup" class="flex items-center justify-center text-sm font-semibold px-5 h-9 border border-silver-200 rounded-md text-woodsmoke-600 hover:border-woodsmoke-300 transition-colors shrink-0">
              Top up
            </a>
          </div>

        </div>

        <% } else { %>
          <p class="text-sm text-woodsmoke-400">Please <a href="/?openAuth=true" class="text-orchid-600 font-semibold hover:underline">sign in</a> to manage your settings.</p>
        <% } %>

      </div>
    </div>

  </div>
</div>

<% if (user && !user.isAnonymous) { %>
<script>
(function () {

  // ── Stripe Connect ───────────────────────────────────────────────────────────
  const btn  = document.getElementById('connectBtn');
  const desc = document.getElementById('connectDesc');

  async function loadConnectStatus() {
    try {
      const data   = await fetch('/api/connect/status').then(r => r.json());
      const status = data.stripeAccountStatus ?? 'none';
      if (status === 'active') {
        btn.textContent = 'Connected';
        btn.disabled    = true;
        btn.classList.add('opacity-50', 'cursor-not-allowed');
        btn.classList.remove('hover:border-woodsmoke-300');
        desc.textContent = 'Your Stripe account is connected. Payouts are active.';
      } else if (status === 'pending') {
        btn.textContent  = 'Continue setup';
        desc.textContent = 'Your Stripe account setup is incomplete. Continue to activate payouts.';
      }
    } catch (err) {
      console.error('Failed to load connect status:', err);
    }
  }

  btn.addEventListener('click', async () => {
    btn.disabled    = true;
    btn.textContent = 'Redirecting…';
    try {
      const res  = await fetch('/api/connect/onboard', { method: 'POST' });
      const data = await res.json();
      if (data.url) {
        window.location.href = data.url;
      } else {
        alert(data.error || 'Could not start Stripe setup. Please try again.');
        btn.disabled    = false;
        btn.textContent = 'Connect';
      }
    } catch {
      btn.disabled    = false;
      btn.textContent = 'Connect';
    }
  });

  loadConnectStatus();

  // ── Partner Program ──────────────────────────────────────────────────────────
  const IS_PARTNER = <%- user.isPartner ? 'true' : 'false' %>;

  if (IS_PARTNER) {
    fetch('/api/partnership/status')
      .then(r => r.json())
      .then(({ application: app }) => {
        if (!app) return;
        const tier       = app.tier;
        const since      = app.reviewedAt
          ? new Date(app.reviewedAt).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })
          : null;
        const tierBadge    = document.getElementById('tierBadge');
        const partnerSince = document.getElementById('partnerSince');
        const upgradeRow   = document.getElementById('upgradeRow');
        if (tierBadge)    tierBadge.textContent    = tier === 'pro' ? 'Pro Partner' : 'Junior Partner';
        if (partnerSince && since) partnerSince.textContent = 'Partner since ' + since;
        if (upgradeRow && tier === 'junior') upgradeRow.style.display = '';
      })
      .catch(err => console.error('[partner status]', err));

  } else {
    Promise.all([
      fetch('/api/partnership/status').then(r => r.json()),
      fetch('/api/partnership/eligibility').then(r => r.json()),
    ]).then(([statusData, eligData]) => {
      const app    = statusData.application;
      const stats  = eligData.stats  || {};
      const junior = eligData.junior || {};

      // Status badge + description
      const badge    = document.getElementById('appStatusBadge');
      const descEl   = document.getElementById('appStatusDesc');
      const applyRow = document.getElementById('applyRow');

      if (app && app.status === 'pending') {
        const submitted = new Date(app.submittedAt).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
        if (badge)    badge.textContent  = 'Under review';
        if (descEl)   descEl.textContent = 'Application submitted ' + submitted + ' — under review by the Grabbn team';
        if (applyRow) applyRow.style.display = 'none';
      } else if (app && app.status === 'rejected') {
        const reviewed = app.reviewedAt
          ? new Date(app.reviewedAt).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })
          : null;
        if (badge)  badge.textContent  = 'Not approved';
        if (descEl) descEl.textContent = reviewed
          ? 'Application reviewed ' + reviewed + ' — not approved. You may reapply when eligible.'
          : 'Previous application was not approved — you may reapply when eligible.';
      } else {
        if (badge)  badge.textContent  = 'Not enrolled';
        if (descEl) descEl.textContent = 'Not enrolled — partners earn ad revenue and gain per-bucket monetization controls';
      }

      // Eligibility — store and render per tier
      const _elig = eligData;

      function renderEligTier(tier) {
        const t = tier === 'pro'
          ? { ageMonths: 12, buckets: 15, subs: 10000, grabs: 50000, enfDays: 180 }
          : { ageMonths:  3, buckets:  5, subs:  1000, grabs:  5000, enfDays:  60 };
        const s  = _elig.stats       || {};
        const td = _elig[tier]       || {};

        function bar(statId, barId, value, threshold, label) {
          const statEl = document.getElementById(statId);
          const barEl  = document.getElementById(barId);
          const met    = value >= threshold;
          if (statEl) statEl.textContent = label ?? (value.toLocaleString() + ' / ' + threshold.toLocaleString() + (met ? ' ✓' : ''));
          if (barEl)  barEl.style.width  = Math.min(100, (value / threshold) * 100) + '%';
        }

        // Account age
        const ageM   = s.accountAgeMonths ?? 0;
        const ageD   = s.accountAgeDays   ?? 0;
        const ageLbl = ageM >= t.ageMonths
          ? ageM + ' months ✓'
          : ageM > 0 ? ageM + ' / ' + t.ageMonths + ' months' : ageD + ' days / ' + t.ageMonths + ' months';
        bar('statAge', 'barAge', ageM, t.ageMonths, ageLbl);

        bar('statBuckets', 'barBuckets', td.qualifyingBuckets ?? 0, t.buckets);
        bar('statSubs',    'barSubs',    s.subscriberCount    ?? 0, t.subs);
        bar('statGrabs',   'barGrabs',   s.grabCount          ?? 0, t.grabs);

        // Enforcement — dot indicator, no bar
        const dc      = s.daysSinceLastViolation;
        const enfPass = dc === null || dc >= t.enfDays;
        const enfLbl  = dc === null ? 'No violations'
          : dc >= t.enfDays ? dc + ' days clean'
          : dc + ' / ' + t.enfDays + ' days clean';
        const sEnf   = document.getElementById('statEnf');
        const enfTxt = document.getElementById('enfText');
        if (enfTxt) enfTxt.textContent = enfLbl;
        if (sEnf)   sEnf.className     = 'flex items-center gap-1.5 text-xs font-semibold tabular-nums shrink-0 '
          + (enfPass ? 'text-emerald-500' : 'text-woodsmoke-300');

        // Update dropdown label and option weights
        const lbl  = document.getElementById('tierDropdownLabel');
        const jOpt = document.getElementById('tierOptJunior');
        const pOpt = document.getElementById('tierOptPro');
        if (lbl)  lbl.textContent = tier === 'pro' ? 'Pro Partner eligibility' : 'Junior Partner eligibility';
        if (jOpt) jOpt.className  = 'flex items-center w-full px-3 py-2 text-sm hover:bg-silver-50 text-left '
            + (tier === 'junior' ? 'font-semibold text-woodsmoke-900' : 'text-woodsmoke-500');
        if (pOpt) pOpt.className  = 'flex items-center w-full px-3 py-2 text-sm hover:bg-silver-50 text-left '
            + (tier === 'pro'    ? 'font-semibold text-woodsmoke-900' : 'text-woodsmoke-500');

        // Enable / disable the Apply button based on whether this tier's criteria pass
        const applyBtn = document.getElementById('applyBtn');
        if (applyBtn) {
          const passes = (_elig[tier] || {}).passes;
          applyBtn.href = '/partnership/apply?tier=' + tier;
          if (passes) {
            applyBtn.classList.remove('opacity-50', 'cursor-not-allowed', 'pointer-events-none');
            applyBtn.classList.add('hover:bg-orchid-700');
          } else {
            applyBtn.classList.add('opacity-50', 'cursor-not-allowed', 'pointer-events-none');
            applyBtn.classList.remove('hover:bg-orchid-700');
          }
        }
      }

      renderEligTier('junior');

      // Dropdown open/close
      const _dBtn  = document.getElementById('tierDropdownBtn');
      const _dMenu = document.getElementById('tierDropdownMenu');
      _dBtn?.addEventListener('click', e => { e.stopPropagation(); _dMenu.classList.toggle('hidden'); });
      document.addEventListener('click', () => _dMenu?.classList.add('hidden'));
      document.getElementById('tierOptJunior')?.addEventListener('click', () => { renderEligTier('junior'); _dMenu.classList.add('hidden'); });
      document.getElementById('tierOptPro')?.addEventListener('click',    () => { renderEligTier('pro');    _dMenu.classList.add('hidden'); });
    }).catch(err => console.error('[partner load]', err));
  }

})();
</script>
<% } %>

<%- include('partials/layout-end') %>

<script>
(function () {
    const bucketId   = '<%= bucketId %>';
    const bucketName = '<%= bucket.name.replace(/'/g, "\\'") %>';

    // TimeAgo
    (function () {
        function relativeTime(date) {
            const diff = Math.floor((Date.now() - date) / 1000);
            if (diff < 60)            return 'just now';
            if (diff < 3600)          return Math.floor(diff / 60) + 'm ago';
            if (diff < 86400)         return Math.floor(diff / 3600) + 'h ago';
            if (diff < 2592000)       return Math.floor(diff / 86400) + 'd ago';
            if (diff < 31536000)      return Math.floor(diff / 2592000) + 'mo ago';
            return Math.floor(diff / 31536000) + 'y ago';
        }
        const created = new Date('<%= bucket.createdAt.toISOString() %>');
        const updated = new Date('<%= (bucket.updatedAt || bucket.createdAt).toISOString() %>');
        const createdLabel = relativeTime(created);
        const updatedLabel = relativeTime(updated);
        const label = created.getTime() === updated.getTime()
            ? createdLabel
            : createdLabel + ' \u2022 updated ' + updatedLabel;
        const el = document.getElementById('bvTimeAgo');
        if (el) el.textContent = label;
    })();
    const shareUrl  = '<%= `${shareBaseUrl}/b/${bucketId}?ref=share` %>';
    const linkHrefs = <%- JSON.stringify(visibleLinks.map(function(l){ return l.href; })) %>;

    // Track link clicks
    document.querySelectorAll('a.bv-link-row').forEach(function (a) {
        a.addEventListener('click', function () {
            var payload = JSON.stringify({ href: this.href, bucketId: bucketId });
            navigator.sendBeacon('/api/links/click', new Blob([payload], { type: 'application/json' }));
        });
    });

    // Link context menus
    document.querySelectorAll('.bv-link-menu-btn').forEach(function (btn) {
        btn.addEventListener('click', function (e) {
            e.preventDefault();
            e.stopPropagation();
            var menu = btn.nextElementSibling;
            document.querySelectorAll('.bv-link-menu').forEach(function (m) {
                if (m !== menu) m.classList.add('hidden');
            });
            menu.classList.toggle('hidden');
        });
    });

    document.querySelectorAll('.bv-copy-link').forEach(function (btn) {
        btn.addEventListener('click', function (e) {
            e.stopPropagation();
            var href = btn.closest('[data-href]').dataset.href;
            navigator.clipboard.writeText(href).catch(function () {});
            btn.closest('.bv-link-menu').classList.add('hidden');
            var orig = btn.textContent;
            btn.textContent = 'Copied!';
            setTimeout(function () { btn.textContent = orig; }, 2000);
        });
    });

    document.querySelectorAll('.bv-request-update').forEach(function (btn) {
        btn.addEventListener('click', function (e) {
            e.stopPropagation();
            btn.textContent = 'Update requested';
            btn.disabled = true;
            btn.classList.add('opacity-50', 'cursor-default');
            var menu = btn.closest('.bv-link-menu');
            setTimeout(function () { menu.classList.add('hidden'); }, 2000);
        });
    });

    document.querySelectorAll('.bv-report-link').forEach(function (btn) {
        btn.addEventListener('click', function (e) {
            e.stopPropagation();
            window.location.href = '/report/' + bucketId;
        });
    });

    // ── Clone Link modal ──────────────────────────────────────────────────────
    (function () {
        var modal        = document.getElementById('bvCloneModal');
        var backdrop     = document.getElementById('bvCloneBackdrop');
        var closeBtn     = document.getElementById('bvCloseCloneModal');
        var listEl       = document.getElementById('bvCloneBucketList');
        var confirmBtn   = document.getElementById('bvCloneConfirm');
        var pendingLink  = null;   // { href, text, image, duration }
        var bucketCache  = null;   // fetched once per page load

        function openModal(linkData) {
            pendingLink = linkData;
            modal.classList.remove('hidden');
            window.lockScroll ? window.lockScroll() : (document.body.style.overflow = 'hidden');
            loadBuckets();
        }

        function closeModal() {
            modal.classList.add('hidden');
            window.unlockScroll ? window.unlockScroll() : (document.body.style.overflow = '');
            listEl.querySelectorAll('input[type=checkbox]').forEach(function (cb) { cb.checked = false; });
            updateConfirmState();
        }

        function updateConfirmState() {
            var any = listEl.querySelector('input[type=checkbox]:checked');
            confirmBtn.disabled = !any;
        }

        function renderBuckets(buckets) {
            var filtered = buckets.filter(function (b) { return b.name !== bucketName; });
            if (!filtered.length) {
                listEl.innerHTML = '<p class="px-4 py-8 text-center text-sm text-woodsmoke-400">No other buckets to clone to.</p>';
                return;
            }
            listEl.innerHTML = filtered.map(function (b) {
                var thumb = b.thumbnail
                    ? '<img src="' + b.thumbnail + '" alt="" class="w-10 h-10 object-cover rounded-md bg-silver-100">'
                    : '<div class="w-10 h-10 rounded-md bg-silver-100 shrink-0 flex items-center justify-center text-silver-300"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><g fill="none"><path fill="currentColor" d="M3 6a3 3 0 0 1 3-3h12a3 3 0 0 1 3 3v12a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3zm3-1a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V6a1 1 0 0 0-1-1z"/></g></svg></div>';
                return '<label class="flex items-center gap-3 px-4 py-2.5 hover:bg-silver-50 cursor-pointer">'
                    + '<input type="checkbox" class="bv-clone-cb w-4 h-4 rounded accent-orchid-700 shrink-0" data-bucket-name="' + b.name.replace(/"/g, '&quot;') + '">'
                    + '<span class="shrink-0">' + thumb + '</span>'
                    + '<span class="flex flex-col min-w-0 flex-1">'
                    +   '<span class="text-sm font-medium text-woodsmoke-950 truncate">' + b.name + '</span>'
                    +   '<span class="text-xs text-woodsmoke-400">' + b.linkCount + ' link' + (b.linkCount !== 1 ? 's' : '') + '</span>'
                    + '</span>'
                    + '</label>';
            }).join('');
            listEl.querySelectorAll('.bv-clone-cb').forEach(function (cb) {
                cb.addEventListener('change', updateConfirmState);
            });
            updateConfirmState();
        }

        function loadBuckets() {
            if (bucketCache) { renderBuckets(bucketCache); return; }
            listEl.innerHTML = '<p class="px-4 py-8 text-center text-sm text-woodsmoke-400">Loading…</p>';
            fetch('/api/buckets/mine', { credentials: 'include' })
                .then(function (r) { return r.json(); })
                .then(function (data) { bucketCache = data; renderBuckets(data); })
                .catch(function () {
                    listEl.innerHTML = '<p class="px-4 py-8 text-center text-sm text-red-400">Failed to load buckets.</p>';
                });
        }

        confirmBtn.addEventListener('click', function () {
            var selected = Array.from(listEl.querySelectorAll('.bv-clone-cb:checked'))
                .map(function (cb) { return cb.dataset.bucketName; });
            if (!selected.length || !pendingLink) return;

            var DOTS_SVG = '<svg width="24" height="10" viewBox="0 0 24 10" xmlns="http://www.w3.org/2000/svg" fill="currentColor"><circle cx="3" cy="5" r="2.5"><animate attributeName="opacity" values="1;0.2;1" dur="1s" begin="0s" repeatCount="indefinite"/></circle><circle cx="12" cy="5" r="2.5"><animate attributeName="opacity" values="1;0.2;1" dur="1s" begin="0.2s" repeatCount="indefinite"/></circle><circle cx="21" cy="5" r="2.5"><animate attributeName="opacity" values="1;0.2;1" dur="1s" begin="0.4s" repeatCount="indefinite"/></circle></svg>';
            confirmBtn.disabled = true;
            confirmBtn.innerHTML = DOTS_SVG;

            fetch('/api/links', {
                method: 'POST',
                credentials: 'include',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ links: [pendingLink], buckets: selected })
            })
            .then(function (r) { return r.json(); })
            .then(function () {
                bucketCache = null;
                confirmBtn.disabled = false;
                confirmBtn.textContent = 'Cloned!';
                setTimeout(function () {
                    closeModal();
                    confirmBtn.textContent = 'Confirm Choices';
                }, 1200);
            })
            .catch(function () {
                confirmBtn.disabled = false;
                confirmBtn.textContent = 'Error — try again';
                setTimeout(function () { confirmBtn.textContent = 'Confirm Choices'; }, 2000);
            });
        });

        closeBtn.addEventListener('click', closeModal);
        backdrop.addEventListener('click', closeModal);

        document.querySelectorAll('.bv-clone-link').forEach(function (btn) {
            btn.addEventListener('click', function (e) {
                e.stopPropagation();
                var container = btn.closest('[data-href]');
                btn.closest('.bv-link-menu').classList.add('hidden');
                openModal({
                    href:     container.dataset.href,
                    text:     container.dataset.linkText     || '',
                    image:    container.dataset.linkImage    || null,
                    duration: container.dataset.linkDuration || '',
                });
            });
        });
    })();

    // ── Move Link modal ───────────────────────────────────────────────────────
    (function () {

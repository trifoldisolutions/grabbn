        var backdrop     = document.getElementById('bvMoveBackdrop');
        var closeBtn     = document.getElementById('bvCloseMoveModal');
        var listEl       = document.getElementById('bvMoveBucketList');
        var confirmBtn   = document.getElementById('bvMoveConfirm');
        var pendingLink  = null;   // { href, text, image, duration, sourceEl }
        var bucketCache  = null;

        function openModal(linkData) {
            pendingLink = linkData;
            modal.classList.remove('hidden');
            window.lockScroll ? window.lockScroll() : (document.body.style.overflow = 'hidden');
            loadBuckets();
        }

        function closeModal() {
            modal.classList.add('hidden');
            window.unlockScroll ? window.unlockScroll() : (document.body.style.overflow = '');
            listEl.querySelectorAll('input[type=checkbox]').forEach(function (cb) { cb.checked = false; });
            updateConfirmState();
        }

        function updateConfirmState() {
            var any = listEl.querySelector('input[type=checkbox]:checked');
            confirmBtn.disabled = !any;
        }

        function renderBuckets(buckets) {
            var filtered = buckets.filter(function (b) { return b.name !== bucketName; });
            if (!filtered.length) {
                listEl.innerHTML = '<p class="px-4 py-8 text-center text-sm text-woodsmoke-400">No other buckets to move to.</p>';
                return;
            }
            listEl.innerHTML = filtered.map(function (b) {
                var thumb = b.thumbnail
                    ? '<img src="' + b.thumbnail + '" alt="" class="w-10 h-10 object-cover rounded-md bg-silver-100">'
                    : '<div class="w-10 h-10 rounded-md bg-silver-100 shrink-0 flex items-center justify-center text-silver-300"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><g fill="none"><path fill="currentColor" d="M3 6a3 3 0 0 1 3-3h12a3 3 0 0 1 3 3v12a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3zm3-1a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V6a1 1 0 0 0-1-1z"/></g></svg></div>';
                return '<label class="flex items-center gap-3 px-4 py-2.5 hover:bg-silver-50 cursor-pointer">'
                    + '<input type="checkbox" class="bv-move-cb w-4 h-4 rounded accent-orchid-700 shrink-0" data-bucket-name="' + b.name.replace(/"/g, '&quot;') + '">'
                    + '<span class="shrink-0">' + thumb + '</span>'
                    + '<span class="flex flex-col min-w-0 flex-1">'
                    +   '<span class="text-sm font-medium text-woodsmoke-950 truncate">' + b.name + '</span>'
                    +   '<span class="text-xs text-woodsmoke-400">' + b.linkCount + ' link' + (b.linkCount !== 1 ? 's' : '') + '</span>'
                    + '</span>'
                    + '</label>';
            }).join('');
            listEl.querySelectorAll('.bv-move-cb').forEach(function (cb) {
                cb.addEventListener('change', updateConfirmState);
            });
            updateConfirmState();
        }

        function loadBuckets() {
            if (bucketCache) { renderBuckets(bucketCache); return; }
            listEl.innerHTML = '<p class="px-4 py-8 text-center text-sm text-woodsmoke-400">Loading…</p>';
            fetch('/api/buckets/mine', { credentials: 'include' })
                .then(function (r) { return r.json(); })
                .then(function (data) { bucketCache = data; renderBuckets(data); })
                .catch(function () {
                    listEl.innerHTML = '<p class="px-4 py-8 text-center text-sm text-red-400">Failed to load buckets.</p>';
                });
        }

        confirmBtn.addEventListener('click', function () {
            var selected = Array.from(listEl.querySelectorAll('.bv-move-cb:checked'))
                .map(function (cb) { return cb.dataset.bucketName; });
            if (!selected.length || !pendingLink) return;

            var DOTS_SVG = '<svg width="24" height="10" viewBox="0 0 24 10" xmlns="http://www.w3.org/2000/svg" fill="currentColor"><circle cx="3" cy="5" r="2.5"><animate attributeName="opacity" values="1;0.2;1" dur="1s" begin="0s" repeatCount="indefinite"/></circle><circle cx="12" cy="5" r="2.5"><animate attributeName="opacity" values="1;0.2;1" dur="1s" begin="0.2s" repeatCount="indefinite"/></circle><circle cx="21" cy="5" r="2.5"><animate attributeName="opacity" values="1;0.2;1" dur="1s" begin="0.4s" repeatCount="indefinite"/></circle></svg>';
            confirmBtn.disabled = true;
            confirmBtn.innerHTML = DOTS_SVG;

            fetch('/api/links', {
                method: 'POST',
                credentials: 'include',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ links: [pendingLink], buckets: selected })
            })
            .then(function (r) {
                if (!r.ok) throw new Error('clone failed');
                return fetch('/api/buckets/' + encodeURIComponent(bucketName) + '/links', {
                    method: 'DELETE',
                    credentials: 'include',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ href: pendingLink.href })
                });
            })
            .then(function (r) {
                if (!r.ok) throw new Error('delete failed');
                bucketCache = null;
                confirmBtn.disabled = false;
                confirmBtn.textContent = 'Moved!';
                if (pendingLink.sourceEl) {
                    pendingLink.sourceEl.remove();
                }
                setTimeout(function () {
                    closeModal();
                    confirmBtn.textContent = 'Move Link';
                }, 1200);
            })
            .catch(function () {
                confirmBtn.disabled = false;
                confirmBtn.textContent = 'Error — try again';
                setTimeout(function () { confirmBtn.textContent = 'Move Link'; }, 2000);
            });
        });

        closeBtn.addEventListener('click', closeModal);
        backdrop.addEventListener('click', closeModal);

        document.querySelectorAll('.bv-move-link').forEach(function (btn) {
            btn.addEventListener('click', function (e) {
                e.stopPropagation();
                var container = btn.closest('[data-href]');
                btn.closest('.bv-link-menu').classList.add('hidden');
                openModal({
                    href:     container.dataset.href,
                    text:     container.dataset.linkText     || '',
                    image:    container.dataset.linkImage    || null,

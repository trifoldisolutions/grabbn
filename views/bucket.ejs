    // Close all context menus on outside click
    document.addEventListener('click', function () {
        document.querySelectorAll('.bv-link-menu').forEach(function (m) { m.classList.add('hidden'); });
    });

    // Not interested — two-level overlay
    const bvNotInterestedBtn = document.getElementById('bvNotInterestedBtn');
    if (bvNotInterestedBtn) {
        const NI_SUB_REASONS = {
            'not-relevant':   { title: 'What feels off?',          reasons: [{ label: 'Not my style',       value: 'not-my-style' }, { label: "Topic doesn't interest me", value: 'wrong-topic' }] },
            'low-quality':    { title: "What's the issue?",        reasons: [{ label: 'Too few links',      value: 'too-few-links' }, { label: 'Links look outdated',       value: 'outdated-links' }, { label: 'Misleading title',          value: 'misleading-title' }] },
            'trust-safety':   { title: 'What did you notice?',     reasons: [{ label: 'Inappropriate content', value: 'inappropriate' }, { label: 'Spam',                   value: 'spam' }] },
            'already-in-feed':{ title: null,                       reasons: [] }
        };

        const BTN_CLS = 'bv-ni-sub w-full h-9 px-4 text-xs font-medium rounded-md bg-white/10 hover:bg-white/20 text-white border border-white/20 transition-colors flex items-center justify-center';

        function blurContent()   { document.getElementById('bvLinksCol').classList.add('blur-sm', 'pointer-events-none', 'select-none'); }
        function unblurContent() { document.getElementById('bvLinksCol').classList.remove('blur-sm', 'pointer-events-none', 'select-none'); }

        function closeAllNi() {
            document.getElementById('bvNiOverlay1').classList.add('hidden');
            document.getElementById('bvNiOverlay2').classList.add('hidden');
            unblurContent();
        }

        function submitNi(category, reason) {
            closeAllNi();
            const label = document.getElementById('bvNotInterestedLabel');
            label.textContent = 'Noted';
            bvNotInterestedBtn.disabled = true;
            bvNotInterestedBtn.classList.add('opacity-60', 'cursor-default');
            fetch('/api/buckets/<%= bucket._id %>/not-interested', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ category, reason: reason || null })
            }).catch(function () {});
        }

        bvNotInterestedBtn.addEventListener('click', function () {
            blurContent();
            document.getElementById('bvNiOverlay1').classList.remove('hidden');
        });

        document.getElementById('bvNiCancel1').addEventListener('click', closeAllNi);

        document.querySelectorAll('.bv-ni-cat').forEach(function (btn) {
            btn.addEventListener('click', function () {
                const category = btn.dataset.category;
                const config   = NI_SUB_REASONS[category];

                // "Already in my feed" — no sub-reasons, submit immediately
                if (!config || config.reasons.length === 0) {
                    submitNi(category, null);
                    return;
                }

                // Show level-2 overlay
                document.getElementById('bvNiOverlay1').classList.add('hidden');
                document.getElementById('bvNiSubTitle').textContent = config.title;

                const container = document.getElementById('bvNiSubReasons');
                container.innerHTML = '';
                config.reasons.forEach(function (r) {
                    const b = document.createElement('button');
                    b.className = BTN_CLS;
                    b.textContent = r.label;
                    b.addEventListener('click', function () { submitNi(category, r.value); });
                    container.appendChild(b);
                });

                // Back button
                const back = document.createElement('button');
                back.className = 'w-full h-9 px-4 text-xs font-medium rounded-md bg-transparent hover:bg-white/10 text-white transition-colors flex items-center justify-center';
                back.textContent = '← Back';
                back.addEventListener('click', function () {
                    document.getElementById('bvNiOverlay2').classList.add('hidden');
                    document.getElementById('bvNiOverlay1').classList.remove('hidden');
                });
                container.appendChild(back);

                document.getElementById('bvNiOverlay2').classList.remove('hidden');
            });
        });
    }

    // Share
    function generateSid() {
        try {
            const arr = new Uint8Array(9);
            crypto.getRandomValues(arr);
            return Array.from(arr, function (b) { return b.toString(36).padStart(2, '0'); }).join('').slice(0, 12);
        } catch (_) {
            return Math.random().toString(36).slice(2, 10) + Date.now().toString(36).slice(-4);
        }
    }

    document.getElementById('bvShareBtn').addEventListener('click', async function () {
        const label = document.getElementById('bvShareLabel');
        const shareText = '<% if (user && !user.isAnonymous) { %>@<%= user.username %> is sharing a link collection with you from Grabbn. Have a look at it!<% } else { %>Check out this link collection on Grabbn!<% } %>';
        const url = shareUrl + '&sid=' + generateSid();
        if (navigator.share) {
            try { await navigator.share({ title: '<%= bucket.name.replace(/'/g, "\\'") %>', text: shareText, url: url }); } catch (_) {}
        } else {
            await navigator.clipboard.writeText(shareText + '\n' + url).catch(() => {});
            label.textContent = 'Link copied!';
            setTimeout(function () { label.textContent = 'Share'; }, 2000);
        }
        // Record share
        fetch('/api/buckets/' + bucketId + '/share', { method: 'POST', credentials: 'include' }).catch(() => {});
    });

    // Copy all links
    document.getElementById('bvCopyLinksBtn').addEventListener('click', async function () {
        const label = document.getElementById('bvCopyLinksLabel');
        if (!linkHrefs.length) return;
        try {
            await navigator.clipboard.writeText(linkHrefs.join('\n'));
            label.textContent = 'Copied!';
        } catch (_) {
            label.textContent = 'Failed';
        }
        setTimeout(function () { label.textContent = 'Copy all links'; }, 2000);
    });

    // Star rating widget
    (function () {
        const starBtns = document.querySelectorAll('.bv-star-btn');
        if (!starBtns.length) return;

        const feedback = document.getElementById('bvRatingFeedback');
        let current = <%- userRating || 'null' %>;

        const SVG_FILLED  = '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"><g fill="none"><path d="m12.593 23.258l-.011.002l-.071.035l-.02.004l-.014-.004l-.071-.035q-.016-.005-.024.005l-.004.01l-.017.428l.005.02l.01.013l.104.074l.015.004l.012-.004l.104-.074l.012-.016l.004-.017l-.017-.427q-.004-.016-.017-.018m.265-.113l-.013.002l-.185.093l-.01.01l-.003.011l.018.43l.005.012l.008.007l.201.093q.019.005.029-.008l.004-.014l-.034-.614q-.005-.018-.02-.022m-.715.002a.02.02 0 0 0-.027.006l-.006.014l-.034.614q.001.018.017.024l.015-.002l.201-.093l.01-.008l.004-.011l.017-.43l-.003-.012l-.01-.01z"/><path fill="currentColor" d="M10.92 2.868a1.25 1.25 0 0 1 2.16 0l2.795 4.798l5.428 1.176a1.25 1.25 0 0 1 .667 2.054l-3.7 4.141l.56 5.525a1.25 1.25 0 0 1-1.748 1.27L12 19.592l-5.082 2.24a1.25 1.25 0 0 1-1.748-1.27l.56-5.525l-3.7-4.14a1.25 1.25 0 0 1 .667-2.055l5.428-1.176z"/></g></svg>';
        const SVG_OUTLINE = '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"><g fill="none" fill-rule="evenodd"><path d="m12.593 23.258l-.011.002l-.071.035l-.02.004l-.014-.004l-.071-.035q-.016-.005-.024.005l-.004.01l-.017.428l.005.02l.01.013l.104.074l.015.004l.012-.004l.104-.074l.012-.016l.004-.017l-.017-.427q-.004-.016-.017-.018m.265-.113l-.013.002l-.185.093l-.01.01l-.003.011l.018.43l.005.012l.008.007l.201.093q.019.005.029-.008l.004-.014l-.034-.614q-.005-.018-.02-.022m-.715.002a.02.02 0 0 0-.027.006l-.006.014l-.034.614q.001.018.017.024l.015-.002l.201-.093l.01-.008l.004-.011l.017-.43l-.003-.012l-.01-.01z"/><path fill="currentColor" d="M10.92 2.868a1.25 1.25 0 0 1 2.16 0l2.795 4.798l5.428 1.176a1.25 1.25 0 0 1 .667 2.054l-3.7 4.141l.56 5.525a1.25 1.25 0 0 1-1.748 1.27L12 19.592l-5.082 2.24a1.25 1.25 0 0 1-1.748-1.27l.56-5.525l-3.7-4.14a1.25 1.25 0 0 1 .667-2.055l5.428-1.176zM12 4.987L9.687 8.959a1.25 1.25 0 0 1-.816.592l-4.492.973l3.062 3.427c.234.262.347.61.312.959l-.463 4.573l4.206-1.854a1.25 1.25 0 0 1 1.008 0l4.206 1.854l-.463-4.573a1.25 1.25 0 0 1 .311-.959l3.063-3.427l-4.492-.973a1.25 1.25 0 0 1-.816-.592z"/></g></svg>';

        function paint(filled) {
            starBtns.forEach(function (btn) {
                const s = Number(btn.dataset.stars);
                const active = s <= filled;
                btn.className = 'bv-star-btn w-9 h-9 flex items-center justify-center rounded-md border transition-colors '
                    + (active ? 'border-amber-300 bg-amber-50 text-amber-500' : 'border-silver-200 text-silver-300 hover:border-amber-200 hover:text-amber-400 hover:bg-amber-50');
                btn.innerHTML = active ? SVG_FILLED : SVG_OUTLINE;
            });
        }

        starBtns.forEach(function (btn) {
            btn.addEventListener('mouseenter', function () {
                if (!btn.disabled) paint(Number(btn.dataset.stars));
            });
            btn.addEventListener('mouseleave', function () {
                paint(current || 0);
            });
            btn.addEventListener('click', async function () {
                if (btn.disabled) return;
                const stars = Number(btn.dataset.stars);
                starBtns.forEach(function (b) { b.disabled = true; });
                try {
                    const res = await fetch('/api/buckets/' + bucketId + '/rate', {
                        method: 'POST',
                        credentials: 'include',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ stars })
                    });
                    const data = await res.json();
                    if (res.ok) {
                        current = stars;
                        paint(current);
                        const label = document.querySelector('#bvRatingWidget p');
                        if (label) label.textContent = 'Your rating';
                        if (feedback) { feedback.textContent = 'Saved'; setTimeout(function () { feedback.textContent = ''; }, 2000); }
                    } else {
                        if (feedback) { feedback.textContent = data.error || 'Failed'; setTimeout(function () { feedback.textContent = ''; }, 3000); }
                    }
                } catch (_) {

        const panelComments = document.getElementById('bvPanelComments');
        if (!tabRecs || !tabComments) return;

        let commentsLoaded = false;

        function activateTab(tab) {
            [tabRecs, tabComments].forEach(function (t) {
                t.classList.remove('border-orchid-600', 'text-orchid-700');
                t.classList.add('border-transparent', 'text-woodsmoke-400');
            });
            tab.classList.remove('border-transparent', 'text-woodsmoke-400');
            tab.classList.add('border-orchid-600', 'text-orchid-700');
        }

        tabRecs.addEventListener('click', function () {
            activateTab(tabRecs);
            panelRecs.classList.remove('hidden');
            panelComments.classList.add('hidden');
        });

        tabComments.addEventListener('click', function () {
            activateTab(tabComments);
            panelRecs.classList.add('hidden');
            panelComments.classList.remove('hidden');

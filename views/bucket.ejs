    if (followBtn) {
        followBtn.addEventListener('click', async function () {
            const following = followBtn.dataset.following === 'true';
            const anonId    = followBtn.dataset.anonId;
            followBtn.disabled = true;
            try {
                const res = await fetch('/api/users/' + anonId + '/subscribe', {
                    method: following ? 'DELETE' : 'POST',
                    credentials: 'include'
                });
                if (res.ok) {
                    if (following) {
                        followBtn.dataset.following = 'false';
                        followBtn.textContent = 'Follow';
                        followBtn.className = 'shrink-0 h-8 px-3 text-xs font-semibold rounded-md bg-orchid-700 hover:bg-orchid-800 text-white transition-colors flex items-center justify-center';
                    } else {
                        followBtn.dataset.following = 'true';
                        followBtn.textContent = 'Following';
                        followBtn.className = 'shrink-0 h-8 px-3 text-xs font-semibold rounded-md border border-silver-200 text-woodsmoke-500 hover:border-red-200 hover:text-red-500 hover:bg-red-50 transition-colors flex items-center justify-center';
                    }
                } else {
                    const data = await res.json();
                    followBtn.textContent = data.error || 'Failed';
                    setTimeout(function () {
                        followBtn.textContent = following ? 'Following' : 'Follow';
                    }, 2000);
                }
            } catch (_) {
                followBtn.textContent = 'Error';
                setTimeout(function () {

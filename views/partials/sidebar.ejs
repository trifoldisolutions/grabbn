<script>
    // FAB wires up to the same desktop action buttons
    const mobileActionFab = document.getElementById('mobileActionFab');
    if (mobileActionFab) {
        mobileActionFab.addEventListener('click', function () {
            const desktopBtn = document.getElementById('newBucketCreationBtn');
            if (desktopBtn) desktopBtn.click();
        });
    }

</script>

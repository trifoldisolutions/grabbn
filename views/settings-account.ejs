              placeholder="000000">
            <p id="emailVerifyError" class="hidden text-sm text-red-500"></p>
            <div class="flex gap-2">
              <button id="emailVerifyBtn" class="flex items-center justify-center h-9 px-5 text-sm font-semibold bg-orchid-600 text-white rounded-md hover:bg-orchid-700 transition-colors disabled:opacity-40 disabled:cursor-not-allowed">Verify</button>
              <button id="emailResendBtn" class="flex items-center justify-center h-9 px-5 text-sm font-semibold border border-silver-200 text-woodsmoke-600 rounded-md hover:bg-silver-50 transition-colors disabled:opacity-40 disabled:cursor-not-allowed">Resend</button>

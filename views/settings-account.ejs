              <span class="text-sm text-woodsmoke-400">
                <% if (user.passwordChangedAt) { %>
                  Last changed <%= new Date(user.passwordChangedAt).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) %>
                <% } else { %>
                  <%= t('settings.account.password.last_changed') %>
                <% } %>
              </span>
            </div>
            <button id="passwordEditBtn" class="flex items-center justify-center text-sm font-semibold px-5 h-9 border border-silver-200 rounded-md text-woodsmoke-600 hover:border-woodsmoke-300 transition-colors shrink-0 disabled:opacity-50 disabled:cursor-default">
              <%= t('settings.common.change') %>
            </button>
          </div>
          <div id="passwordForm" class="hidden mt-3 flex flex-col gap-2">
            <div class="relative">
              <input id="currentPasswordInput" type="password"
                class="w-full h-10 px-3 pr-10 text-sm border border-silver-200 rounded-md outline-none focus:border-orchid-400 transition-colors"

  // ── Shared: smart dropdown positioning ──────────────────────────────────────
  function positionDropdown(btn, dropdown) {
    const btnRect      = btn.getBoundingClientRect();
    const dropHeight   = dropdown.offsetHeight;
    const spaceBelow   = window.innerHeight - btnRect.bottom;
    const spaceAbove   = btnRect.top;
    const openUpward   = spaceBelow < dropHeight + 8 && spaceAbove > spaceBelow;
    dropdown.style.top    = openUpward ? 'auto' : '100%';
    dropdown.style.bottom = openUpward ? '100%' : 'auto';
    dropdown.style.marginTop    = openUpward ? '0' : '4px';
    dropdown.style.marginBottom = openUpward ? '4px' : '0';
  }


    'is.gd','v.gd','rb.gy','cutt.ly','shorturl.at','clck.ru','rebrand.ly','bl.ink',
    'lnkd.in','snip.ly','soo.gd','adf.ly','bit.do','tr.im','cli.gs','youtu.be',
  ]);
  const _PLATFORM_DOMAINS = {
    twitter:   ['twitter.com','x.com'],
    github:    ['github.com'],
    instagram: ['instagram.com'],
    linkedin:  ['linkedin.com'],
    youtube:   ['youtube.com','youtu.be'],
    tiktok:    ['tiktok.com'],
    facebook:  ['facebook.com','fb.com'],
    discord:   ['discord.gg','discord.com'],
    twitch:    ['twitch.tv'],
    bluesky:   ['bsky.app','bsky.social'],
    other:     null,
    onlyfans:  ['onlyfans.com'],
    fansly:    ['fansly.com'],
    fanvue:    ['fanvue.com'],
    pornhub:   ['pornhub.com'],
  };
  function validateLinkUrl(url, platform = null) {
    if (!url) return null;
    let u;
    try { u = new URL(url); } catch { return 'Enter a valid URL.'; }
    if (u.protocol !== 'https:') return 'Links must use HTTPS.';
    const host = u.hostname.replace(/^www\./, '');
    if (_SHORTENER_HOSTS.has(host)) return 'URL shorteners are not allowed.';
    if (platform && platform !== 'other') {
      const allowed = _PLATFORM_DOMAINS[platform];
      if (allowed) {
        const ok = allowed.some(d => host === d || host.endsWith('.' + d));
        if (!ok) {
          const p = PLATFORMS.find(x => x.id === platform);
          return `Must be a ${p ? p.name : platform} link (${allowed.join(' or ')}).`;
        }
      }
    }
    return null;
  }


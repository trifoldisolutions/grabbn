            <ul id="passwordReqs" class="grid grid-cols-2 gap-x-4 gap-y-1 mt-0.5">
              <li id="req-length"  class="flex items-center gap-1.5 text-[11px] text-woodsmoke-300"><span class="req-dot w-1.5 h-1.5 rounded-full bg-current shrink-0"></span>8+ characters</li>
              <li id="req-upper"   class="flex items-center gap-1.5 text-[11px] text-woodsmoke-300"><span class="req-dot w-1.5 h-1.5 rounded-full bg-current shrink-0"></span>2 uppercase</li>
              <li id="req-lower"   class="flex items-center gap-1.5 text-[11px] text-woodsmoke-300"><span class="req-dot w-1.5 h-1.5 rounded-full bg-current shrink-0"></span>2 lowercase</li>
              <li id="req-digit"   class="flex items-center gap-1.5 text-[11px] text-woodsmoke-300"><span class="req-dot w-1.5 h-1.5 rounded-full bg-current shrink-0"></span>2 numbers</li>
              <li id="req-special" class="flex items-center gap-1.5 text-[11px] text-woodsmoke-300"><span class="req-dot w-1.5 h-1.5 rounded-full bg-current shrink-0"></span>2 special chars</li>
            </ul>
            <p id="passwordError" class="hidden text-sm text-red-500"></p>
            <div class="flex gap-2">
              <button id="passwordSaveBtn" class="flex items-center justify-center h-9 px-5 text-sm font-semibold bg-orchid-600 text-white rounded-md hover:bg-orchid-700 transition-colors disabled:opacity-40 disabled:cursor-not-allowed"><%= t('settings.common.save') %></button>
              <button id="passwordCancelBtn" class="flex items-center justify-center h-9 px-5 text-sm font-semibold border border-silver-200 text-woodsmoke-600 rounded-md hover:bg-silver-50 transition-colors"><%= t('settings.common.cancel') %></button>
            </div>
          </div>
        </div>

      </div>

      <!-- ── Preferences ─────────────────────────────────────────────────────── -->
      <div class="border border-silver-200 rounded-md divide-y divide-silver-100 mb-6">

        <div class="px-5 py-4">
          <p class="text-sm font-semibold uppercase tracking-wide text-woodsmoke-400"><%= t('settings.account.section.preferences') %></p>
        </div>

        <!-- Language -->
        <div class="px-5 py-4 flex items-center justify-between gap-4">
          <div class="flex flex-col gap-0.5 min-w-0">
            <span class="text-sm font-semibold text-woodsmoke-900"><%= t('settings.account.language.label') %></span>
            <span id="languageDisplay" class="text-sm text-woodsmoke-400"><%= ({en:'English',es:'Spanish',fr:'French',de:'German',pt:'Portuguese',it:'Italian',nl:'Dutch',ru:'Russian',ja:'Japanese',zh:'Chinese',ko:'Korean',ar:'Arabic',hi:'Hindi',tr:'Turkish',pl:'Polish',sv:'Swedish',no:'Norwegian',da:'Danish',fi:'Finnish',id:'Indonesian'})[user.language || 'en'] || 'English' %></span>
          </div>
          <div class="relative shrink-0" id="languagePickerWrap">
            <button id="languagePickerBtn" type="button"
              class="flex items-center gap-2 h-9 px-3 text-sm font-semibold border border-silver-200 rounded-md text-woodsmoke-700 hover:border-woodsmoke-300 transition-colors w-40">
              <span id="languagePickerLabel" class="flex-1 text-left truncate"><%= ({en:'English',es:'Spanish',fr:'French',de:'German',pt:'Portuguese',it:'Italian',nl:'Dutch',ru:'Russian',ja:'Japanese',zh:'Chinese',ko:'Korean',ar:'Arabic',hi:'Hindi',tr:'Turkish',pl:'Polish',sv:'Swedish',no:'Norwegian',da:'Danish',fi:'Finnish',id:'Indonesian'})[user.language || 'en'] || 'English' %></span>

          <div id="emailVerifyForm" class="hidden mt-3 flex flex-col gap-2">
            <p class="text-sm text-woodsmoke-500">Enter the 6-digit code sent to <span id="emailVerifyTarget" class="font-medium text-woodsmoke-700"></span></p>

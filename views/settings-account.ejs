<%
  title          = 'Account'
  page           = 'settings'
  settingsSection = 'account'
%>
<%- include('partials/layout') %>

<div class="flex flex-1 overflow-hidden justify-center">
  <div class="flex flex-col md:flex-row w-full max-w-[992px] overflow-hidden">

  <%- include('partials/settings-nav') %>

  <!-- Content area -->
  <div class="flex-1 overflow-y-auto scrollbar-hide">
    <div class="w-full px-6 py-6 pb-20 md:pb-6">

      <% if (user && !user.isAnonymous) { %>

      <!-- ── Profile ────────────────────────────────────────────────────────── -->
      <div class="border border-silver-200 rounded-md divide-y divide-silver-100 mb-6">

        <div class="px-5 py-4">
          <p class="text-sm font-semibold uppercase tracking-wide text-woodsmoke-400"><%= t('settings.account.section.profile') %></p>
        </div>

        <!-- Avatar -->
        <div class="px-5 py-4 flex items-center justify-between gap-4">
          <div class="flex flex-col gap-0.5 min-w-0">
            <span class="text-sm font-semibold text-woodsmoke-900"><%= t('settings.account.avatar.label') %></span>
            <span class="text-sm text-woodsmoke-400"><%= t('settings.account.avatar.hint') %></span>
          </div>
          <div class="flex items-center gap-3 shrink-0">
            <div id="avatarPreview" class="w-10 h-10 rounded-md overflow-hidden flex items-center justify-center <%= user.avatar ? '' : 'bg-orchid-100' %>">
              <% if (user.avatar) { %>
                <img id="avatarImg" src="<%= user.avatar %>" alt="avatar" class="w-full h-full object-cover">
              <% } else { %>
                <svg id="avatarPlaceholder" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" class="text-orchid-600"><g fill="none"><path d="m12.593 23.258l-.011.002l-.071.035l-.02.004l-.014-.004l-.071-.035q-.016-.005-.024.005l-.004.01l-.017.428l.005.02l.01.013l.104.074l.015.004l.012-.004l.104-.074l.012-.016l.004-.017l-.017-.427q-.004-.016-.017-.018m.265-.113l-.013.002l-.185.093l-.01.01l-.003.011l.018.43l.005.012l.008.007l.201.093q.019.005.029-.008l.004-.014l-.034-.614q-.005-.018-.02-.022m-.715.002a.02.02 0 0 0-.027.006l-.006.014l-.034.614q.001.018.017.024l.015-.002l.201-.093l.01-.008l.004-.011l.017-.43l-.003-.012l-.01-.01z"/><path fill="currentColor" d="M12 13c2.396 0 4.575.694 6.178 1.672c.8.488 1.484 1.064 1.978 1.69c.486.615.844 1.351.844 2.138c0 .845-.411 1.511-1.003 1.986c-.56.45-1.299.748-2.084.956c-1.578.417-3.684.558-5.913.558s-4.335-.14-5.913-.558c-.785-.208-1.524-.506-2.084-.956C3.41 20.01 3 19.345 3 18.5c0-.787.358-1.523.844-2.139c.494-.625 1.177-1.2 1.978-1.69C7.425 13.695 9.605 13 12 13m0-11a5 5 0 1 1 0 10a5 5 0 0 1 0-10"/></g></svg>
              <% } %>
            </div>
            <input id="avatarInput" type="file" accept="image/jpeg,image/png,image/webp,image/gif" class="hidden">
            <button id="avatarChangeBtn" class="flex items-center justify-center text-sm font-semibold px-5 h-9 border border-silver-200 rounded-md text-woodsmoke-600 hover:border-woodsmoke-300 transition-colors">
              <%= t('settings.account.avatar.change') %>
            </button>
          </div>
        </div>

        <!-- Username -->
        <div class="px-5 py-4">
          <%
            const _uLog = (user.usernameChangeLog || []).map(d => new Date(d).getTime());
            const _uNow = Date.now();
            const _uLimits = [
              { count: 2, windowMs: 24 * 60 * 60 * 1000 },
              { count: 3, windowMs: 7 * 24 * 60 * 60 * 1000 },
              { count: 4, windowMs: 30 * 24 * 60 * 60 * 1000 },
            ];
            let _canChangeUsername = true;
            let _nextUsernameDate = null;
            for (const { count, windowMs } of _uLimits) {
              const inWindow = _uLog.filter(t => _uNow - t < windowMs).sort((a, b) => a - b);
              if (inWindow.length >= count) {
                _canChangeUsername = false;
                _nextUsernameDate = new Date(inWindow[0] + windowMs).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
                break;
              }
            }
          %>
          <div class="flex items-start justify-between gap-4" id="usernameDisplay">
            <div class="flex flex-col gap-0.5 min-w-0">
              <span class="text-sm font-semibold text-woodsmoke-900"><%= t('settings.account.username.label') %></span>
              <span class="text-sm text-woodsmoke-400">@<%= user.username %></span>
              <% if (!_canChangeUsername) { %>
                <span id="usernameAvailableHint" class="text-[11px] text-woodsmoke-300 mt-0.5">Available to change <%= _nextUsernameDate %></span>
              <% } %>
            </div>
            <button id="usernameEditBtn" <%= _canChangeUsername ? '' : 'disabled' %>
              class="flex items-center justify-center text-sm font-semibold px-5 h-9 border border-silver-200 rounded-md shrink-0 transition-colors text-woodsmoke-600 hover:border-woodsmoke-300 disabled:opacity-50 disabled:cursor-default">
              <%= t('settings.common.edit') %>
            </button>
          </div>
          <div id="usernameForm" class="hidden mt-3 flex flex-col gap-2">
            <input id="usernameInput" type="text" value="<%= user.username %>" maxlength="20"
              class="w-full h-10 px-3 text-sm border border-silver-200 rounded-md outline-none focus:border-orchid-400 transition-colors"
              placeholder="Username">
            <p class="text-[11px] text-woodsmoke-400"><%= t('settings.account.username.hint') %></p>
            <p id="usernameError" class="hidden text-sm text-red-500"></p>
            <div class="flex gap-2">
              <button id="usernameSaveBtn" class="flex items-center justify-center h-9 px-5 text-sm font-semibold bg-orchid-600 text-white rounded-md hover:bg-orchid-700 transition-colors disabled:opacity-40 disabled:cursor-not-allowed"><%= t('settings.common.save') %></button>
              <button id="usernameCancelBtn" class="flex items-center justify-center h-9 px-5 text-sm font-semibold border border-silver-200 text-woodsmoke-600 rounded-md hover:bg-silver-50 transition-colors"><%= t('settings.common.cancel') %></button>
            </div>
          </div>
        </div>

        <!-- Display Name -->
        <div class="px-5 py-4">
          <div class="flex items-start justify-between gap-4" id="displayNameDisplay">
            <div class="flex flex-col gap-0.5 min-w-0">
              <span class="text-sm font-semibold text-woodsmoke-900"><%= t('settings.account.display_name.label') %></span>
              <span class="text-sm text-woodsmoke-400 break-words"><%= user.displayName || t('settings.account.display_name.not_set') %></span>
            </div>
            <button id="displayNameEditBtn" class="flex items-center justify-center text-sm font-semibold px-5 h-9 border border-silver-200 rounded-md text-woodsmoke-600 hover:border-woodsmoke-300 transition-colors shrink-0 disabled:opacity-50 disabled:cursor-default">
              <%= t('settings.common.edit') %>
            </button>
          </div>
          <div id="displayNameForm" class="hidden mt-3 flex flex-col gap-2">
            <input id="displayNameInput" type="text" value="<%= user.displayName || '' %>"
              class="w-full h-10 px-3 text-sm border border-silver-200 rounded-md outline-none focus:border-orchid-400 transition-colors"
              placeholder="<%= t('settings.account.display_name.placeholder') %>">
            <div class="flex items-center justify-between">
              <p class="text-[11px] text-woodsmoke-400">Letters only · max 30 characters</p>
              <span id="displayNameCount" class="text-[10px] text-woodsmoke-300"><%= (user.displayName || '').length %>/30</span>
            </div>
            <p id="displayNameError" class="hidden text-sm text-red-500"></p>
            <div class="flex gap-2">
              <button id="displayNameSaveBtn" class="flex items-center justify-center h-9 px-5 text-sm font-semibold bg-orchid-600 text-white rounded-md hover:bg-orchid-700 transition-colors disabled:opacity-40 disabled:cursor-not-allowed"><%= t('settings.common.save') %></button>
              <button id="displayNameCancelBtn" class="flex items-center justify-center h-9 px-5 text-sm font-semibold border border-silver-200 text-woodsmoke-600 rounded-md hover:bg-silver-50 transition-colors"><%= t('settings.common.cancel') %></button>
            </div>
          </div>
        </div>

        <!-- Bio -->
        <div class="px-5 py-4">
          <div class="flex items-start justify-between gap-4" id="bioDisplay">
            <div class="flex flex-col gap-0.5 min-w-0">
              <span class="text-sm font-semibold text-woodsmoke-900"><%= t('settings.account.bio.label') %></span>
              <span class="text-sm text-woodsmoke-400 break-words"><%= user.bio || t('settings.account.bio.empty') %></span>
            </div>
            <button id="bioEditBtn" class="flex items-center justify-center text-sm font-semibold px-5 h-9 border border-silver-200 rounded-md text-woodsmoke-600 hover:border-woodsmoke-300 transition-colors shrink-0 disabled:opacity-50 disabled:cursor-default">
              <%= t('settings.common.edit') %>
            </button>
          </div>
          <div id="bioForm" class="hidden mt-3 flex flex-col gap-2">
            <div class="relative">
              <textarea id="bioInput" maxlength="128" rows="3"
                class="w-full px-3 py-2.5 text-sm border border-silver-200 rounded-lg outline-none focus:border-orchid-400 transition-colors resize-none"
                placeholder="<%= t('settings.account.bio.placeholder') %>"><%= user.bio || '' %></textarea>
              <span id="bioCount" class="absolute bottom-2 right-3 text-[10px] text-woodsmoke-300"><%= (user.bio || '').length %>/128</span>
            </div>
            <p id="bioError" class="hidden text-sm text-red-500"></p>
            <div class="flex gap-2">
              <button id="bioSaveBtn" class="flex items-center justify-center h-9 px-5 text-sm font-semibold bg-orchid-600 text-white rounded-md hover:bg-orchid-700 transition-colors disabled:opacity-40 disabled:cursor-not-allowed"><%= t('settings.common.save') %></button>
              <button id="bioCancelBtn" class="flex items-center justify-center h-9 px-5 text-sm font-semibold border border-silver-200 text-woodsmoke-600 rounded-md hover:bg-silver-50 transition-colors"><%= t('settings.common.cancel') %></button>
            </div>
          </div>
        </div>

        <!-- Category -->
        <div class="px-5 py-4 flex items-center justify-between gap-4">
          <div class="flex flex-col gap-0.5 min-w-0">
            <span class="text-sm font-semibold text-woodsmoke-900"><%= t('settings.account.category.label') %></span>
            <span id="categoryDisplay" class="text-sm text-woodsmoke-400"><%= user.category ? user.category.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase()) : t('settings.account.category.not_set') %></span>
          </div>
          <div class="relative shrink-0" id="categoryPickerWrap">
            <button id="categoryPickerBtn" type="button"
              class="flex items-center gap-2 h-9 px-3 text-sm font-semibold border border-silver-200 rounded-md text-woodsmoke-700 hover:border-woodsmoke-300 transition-colors w-44">
              <span id="categoryPickerLabel" class="flex-1 text-left truncate"><%= user.category ? user.category.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase()) : t('settings.account.category.not_set') %></span>
              <svg id="categoryChevron" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" class="shrink-0 transition-transform duration-150"><g fill="none" fill-rule="evenodd"><path d="M24 0v24H0V0zM12.593 23.258l-.011.002l-.071.035l-.02.004l-.014-.004l-.071-.035q-.016-.005-.024.005l-.004.01l-.017.428l.005.02l.01.013l.104.074l.015.004l.012-.004l.104-.074l.012-.016l.004-.017l-.017-.427q-.004-.016-.017-.018m.265-.113l-.013.002l-.185.093l-.01.01l-.003.011l.018.43l.005.012l.008.007l.201.093q.019.005.029-.008l.004-.014l-.034-.614q-.005-.019-.02-.022m-.715.002a.02.02 0 0 0-.027.006l-.006.014l-.034.614q.001.018.017.024l.015-.002l.201-.093l.01-.008l.004-.011l.017-.43l-.003-.012l-.01-.01z"/><path fill="currentColor" d="M12.707 15.707a1 1 0 0 1-1.414 0L5.636 10.05A1 1 0 1 1 7.05 8.636l4.95 4.95l4.95-4.95a1 1 0 0 1 1.414 1.414z"/></g></svg>
            </button>
            <div id="categoryDropdown" class="hidden absolute top-full right-0 mt-1 w-72 bg-white border border-silver-200 rounded-md shadow-lg z-50 py-1 max-h-72 overflow-y-auto"></div>
          </div>
        </div>

      </div>

      <!-- ── Links ────────────────────────────────────────────────────────────── -->
      <div class="border border-silver-200 rounded-md divide-y divide-silver-100 mb-6">

        <div class="px-5 py-4">
          <p class="text-sm font-semibold uppercase tracking-wide text-woodsmoke-400"><%= t('settings.account.section.links') %></p>
        </div>

        <!-- Website -->
        <div class="px-5 py-4">
          <div class="flex items-center justify-between gap-4" id="websiteDisplay">
            <div class="flex flex-col gap-0.5 min-w-0">
              <span class="text-sm font-semibold text-woodsmoke-900"><%= t('settings.account.website.label') %></span>
              <% if (user.website) { %>
                <a id="websiteUrl" href="<%= user.website %>" target="_blank" rel="noopener noreferrer"
                  class="text-sm text-orchid-500 hover:underline truncate"><%= user.website %></a>
              <% } else { %>
                <span id="websiteUrl" class="text-sm text-woodsmoke-400"><%= t('settings.account.website.not_set') %></span>
              <% } %>
            </div>
            <button id="websiteEditBtn" class="flex items-center justify-center text-sm font-semibold px-5 h-9 border border-silver-200 rounded-md text-woodsmoke-600 hover:border-woodsmoke-300 transition-colors shrink-0 disabled:opacity-50 disabled:cursor-default"><%= t('settings.common.edit') %></button>
          </div>
          <div id="websiteForm" class="hidden mt-3 flex flex-col gap-2">
            <input id="websiteInput" type="url" value="<%= user.website || '' %>" maxlength="200"
              class="w-full h-10 px-3 text-sm border border-silver-200 rounded-md outline-none focus:border-orchid-400 transition-colors"
              placeholder="https://yourwebsite.com">
            <p id="websiteError" class="hidden text-sm text-red-500"></p>
            <div class="flex gap-2">
              <button id="websiteSaveBtn" class="flex items-center justify-center h-9 px-5 text-sm font-semibold bg-orchid-600 text-white rounded-md hover:bg-orchid-700 transition-colors disabled:opacity-40 disabled:cursor-not-allowed"><%= t('settings.common.save') %></button>
              <button id="websiteCancelBtn" class="flex items-center justify-center h-9 px-5 text-sm font-semibold border border-silver-200 text-woodsmoke-600 rounded-md hover:bg-silver-50 transition-colors"><%= t('settings.common.cancel') %></button>
            </div>
          </div>
        </div>

        <!-- Socials -->
        <div class="px-5 py-4">
          <div class="flex items-center justify-between gap-4 mb-3">
            <span class="text-sm font-semibold text-woodsmoke-900"><%= t('settings.account.socials.label') %></span>
            <button id="addSocialBtn" class="flex items-center justify-center gap-1.5 text-sm font-semibold h-8 px-3 border border-silver-200 rounded-md text-woodsmoke-600 hover:border-woodsmoke-300 transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 5v14M5 12h14"/></svg>
              <%= t('settings.account.socials.add') %>
            </button>
          </div>
          <div id="socialsList" class="flex flex-wrap gap-2"></div>
          <div id="addSocialForm" class="hidden mt-2">
            <div class="flex items-center gap-2">
              <div class="relative shrink-0" id="platformPickerWrap">
                <button id="platformPickerBtn" type="button"
                  class="flex items-center gap-2 h-9 px-3 text-sm font-semibold border border-silver-200 rounded-md text-woodsmoke-400 hover:border-woodsmoke-300 transition-colors w-36">
                  <span id="platformPickerLabel" class="flex-1 text-left truncate"><%= t('settings.account.socials.platform') %></span>
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" class="shrink-0"><g fill="none" fill-rule="evenodd"><path d="M24 0v24H0V0zM12.593 23.258l-.011.002l-.071.035l-.02.004l-.014-.004l-.071-.035q-.016-.005-.024.005l-.004.01l-.017.428l.005.02l.01.013l.104.074l.015.004l.012-.004l.104-.074l.012-.016l.004-.017l-.017-.427q-.004-.016-.017-.018m.265-.113l-.013.002l-.185.093l-.01.01l-.003.011l.018.43l.005.012l.008.007l.201.093q.019.005.029-.008l.004-.014l-.034-.614q-.005-.019-.02-.022m-.715.002a.02.02 0 0 0-.027.006l-.006.014l-.034.614q.001.018.017.024l.015-.002l.201-.093l.01-.008l.004-.011l.017-.43l-.003-.012l-.01-.01z"/><path fill="currentColor" d="M12.707 15.707a1 1 0 0 1-1.414 0L5.636 10.05A1 1 0 1 1 7.05 8.636l4.95 4.95l4.95-4.95a1 1 0 0 1 1.414 1.414z"/></g></svg>
                </button>
                <div id="platformDropdown" class="hidden absolute top-full left-0 mt-1 w-44 bg-white border border-silver-200 rounded-md shadow-lg z-50 py-1 max-h-52 overflow-y-auto"></div>
              </div>
              <input id="socialUrlInput" type="url" maxlength="200"
                class="flex-1 h-9 px-3 text-sm border border-silver-200 rounded-md outline-none focus:border-orchid-400 transition-colors min-w-0"
                placeholder="https://...">
              <button id="addSocialSaveBtn" class="flex items-center justify-center w-9 h-9 shrink-0 bg-orchid-600 text-white rounded-md hover:bg-orchid-700 transition-colors disabled:opacity-40">
                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6 9 17l-5-5"/></svg>
              </button>
              <button id="addSocialCancelBtn" class="flex items-center justify-center w-9 h-9 shrink-0 border border-silver-200 text-woodsmoke-400 rounded-md hover:bg-silver-50 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 6 6 18M6 6l12 12"/></svg>
              </button>
            </div>
            <p id="addSocialError" class="hidden text-sm text-red-500 mt-1.5"></p>
          </div>
        </div>

      </div>

      <!-- ── Security ───────────────────────────────────────────────────────── -->
      <div class="border border-silver-200 rounded-md divide-y divide-silver-100 mb-6">

        <div class="px-5 py-4">
          <p class="text-sm font-semibold uppercase tracking-wide text-woodsmoke-400"><%= t('settings.account.section.security') %></p>
        </div>

        <!-- Email -->
        <%
          const _eLog = (user.emailChangeLog || []).map(d => new Date(d).getTime());
          const _eLimits = [
            { count: 1, windowMs: 24 * 60 * 60 * 1000 },
            { count: 2, windowMs: 7 * 24 * 60 * 60 * 1000 },
            { count: 3, windowMs: 30 * 24 * 60 * 60 * 1000 },
          ];
          const _emailLifetimeExhausted = _eLog.length >= 3;
          let _canChangeEmail = !_emailLifetimeExhausted;
          let _nextEmailDate = null;
          if (_canChangeEmail) {
            for (const { count, windowMs } of _eLimits) {
              const inWindow = _eLog.filter(t => Date.now() - t < windowMs).sort((a, b) => a - b);
              if (inWindow.length >= count) {
                _canChangeEmail = false;
                _nextEmailDate = new Date(inWindow[0] + windowMs).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
                break;
              }
            }
          }
        %>
        <div class="px-5 py-4">
          <div class="flex items-start justify-between gap-4">
            <div class="flex flex-col gap-0.5 min-w-0">
              <span class="text-sm font-semibold text-woodsmoke-900"><%= t('settings.account.email.label') %></span>
              <div class="flex items-center gap-1.5 mt-0.5">
                <span id="emailValue" class="text-sm text-woodsmoke-400 truncate"><%= user.email %></span>
                <% if (user.isEmailVerified) { %>
                  <span id="emailBadge" class="text-[10px] font-semibold px-1.5 py-0.5 rounded-full bg-emerald-50 text-emerald-600"><%= t('settings.account.email.verified') %></span>
                <% } else { %>
                  <span id="emailBadge" class="text-[10px] font-semibold px-1.5 py-0.5 rounded-full bg-amber-50 text-amber-500"><%= t('settings.account.email.unverified') %></span>
                <% } %>
              </div>
              <% if (user.pendingEmail) { %>
                <p id="emailPendingNotice" class="text-[11px] text-woodsmoke-400 mt-0.5">Pending: <span class="font-medium text-woodsmoke-600"><%= user.pendingEmail %></span> — check your inbox for a code</p>
              <% } %>
              <% if (_emailLifetimeExhausted) { %>
                <span class="text-[11px] text-woodsmoke-300 mt-0.5">Lifetime email change limit reached</span>
              <% } else if (!_canChangeEmail) { %>
                <span class="text-[11px] text-woodsmoke-300 mt-0.5">Available to change <%= _nextEmailDate %></span>
              <% } %>
            </div>
            <div class="flex gap-2 shrink-0">
              <% if (!user.isEmailVerified) { %>
                <button id="resendOtpBtn" class="flex items-center justify-center text-sm font-semibold px-5 h-9 border border-silver-200 rounded-md text-woodsmoke-600 hover:border-woodsmoke-300 transition-colors">
                  <%= t('settings.account.email.verify_btn') %>
                </button>
              <% } %>
              <% if (user.pendingEmail) { %>
                <button id="emailEnterCodeBtn" class="flex items-center justify-center text-sm font-semibold px-5 h-9 border border-orchid-200 rounded-md text-orchid-600 hover:border-orchid-400 transition-colors">
                  Enter code
                </button>
              <% } %>
              <button id="emailEditBtn" <%= _canChangeEmail ? '' : 'disabled' %>
                class="flex items-center justify-center text-sm font-semibold px-5 h-9 border border-silver-200 rounded-md text-woodsmoke-600 hover:border-woodsmoke-300 transition-colors disabled:opacity-50 disabled:cursor-default">
                <%= t('settings.common.edit') %>
              </button>
            </div>
          </div>
          <!-- Step 1: request change -->
          <div id="emailRequestForm" class="hidden mt-3 flex flex-col gap-2">
            <input id="emailNewInput" type="email" autocomplete="email"
              class="w-full h-10 px-3 text-sm border border-silver-200 rounded-md outline-none focus:border-orchid-400 transition-colors"
              placeholder="New email address">
            <div class="relative">
              <input id="emailPasswordInput" type="password" autocomplete="current-password"
                class="w-full h-10 px-3 pr-10 text-sm border border-silver-200 rounded-md outline-none focus:border-orchid-400 transition-colors"
                placeholder="Current password">
              <button type="button" data-pw-toggle="emailPasswordInput" class="absolute right-3 top-1/2 -translate-y-1/2 text-woodsmoke-300 hover:text-woodsmoke-500 transition-colors">

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Log In — Grabbn</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Jost:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/tailwind/output.css">
</head>
<body class="bg-gray-50 min-h-screen flex items-center justify-center px-4">

    <div class="max-w-md w-full">
        <!-- Logo/Header -->
        <div class="text-center mb-8">
            <h1 class="text-3xl font-bold text-gray-800 mb-2">Grabbn • Link Grabber</h1>
            <p class="text-gray-600">Log in to your account</p>
        </div>

        <!-- Login Form Card -->
        <div class="bg-white rounded-lg shadow-lg p-8">

            <!-- Step 1: Credentials -->
            <div id="credentialsStep">
            <form id="loginForm" class="space-y-5">
                <div>
                    <label for="email" class="block text-sm font-medium text-woodsmoke-950 mb-1">
                        Email Address
                    </label>
                    <input
                        type="email"
                        id="email"
                        name="email"
                        required
                        autofocus
                        class="w-full px-3 h-12 border border-gray-300 rounded-md focus:bg-orchid-50 focus:outline-none focus:ring-2 focus:ring-orchid-500 focus:border-transparent"
                        placeholder="you@example.com"
                    >
                </div>

                <div>
                    <label for="password" class="block text-sm font-medium text-woodsmoke-950 mb-1">
                        Password
                    </label>
                    <div class="relative">
                        <input
                            type="password"
                            id="password"
                            name="password"
                            required
                            class="w-full px-3 h-12 pr-10 border border-gray-300 rounded-md focus:bg-orchid-50 focus:outline-none focus:ring-2 focus:ring-orchid-500 focus:border-transparent"
                            placeholder="••••••••"
                        >
                        <button
                            type="button"
                            id="togglePassword"
                            class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-500 hover:text-gray-700 focus:outline-none p-1"
                            aria-label="Toggle password visibility"
                        >
                            <svg id="passwordEyeOpen" xmlns="http://www.w3.org/2000/svg" width="21" height="21" viewBox="0 0 24 24">
                                <path fill="currentColor" d="M14.591 14.091q1.063-1.062 1.063-2.591T14.59 8.909T12 7.846T9.409 8.91T8.346 11.5t1.063 2.591T12 15.154t2.591-1.063m-4.503-.678Q9.3 12.625 9.3 11.5t.788-1.912T12 8.8t1.913.788t.787 1.912t-.787 1.913T12 14.2t-1.912-.787M6.56 16.43q-2.474-1.57-3.997-4.116q-.125-.205-.178-.404t-.053-.411t.053-.41t.178-.406Q4.087 8.14 6.56 6.57T12 5t5.44 1.57t3.997 4.115q.125.205.178.404t.052.411t-.052.41t-.178.406q-1.523 2.545-3.997 4.115T12 18t-5.44-1.57m10.628-.917Q19.55 14.025 20.8 11.5q-1.25-2.525-3.613-4.012T12 6T6.813 7.488T3.2 11.5q1.25 2.525 3.613 4.013T12 17t5.188-1.487"/>
                            </svg>
                            <svg id="passwordEyeClosed" class="hidden" xmlns="http://www.w3.org/2000/svg" width="21" height="21" viewBox="0 0 24 24">
                                <path fill="currentColor" d="M14.579 8.921q.494.495.822 1.314t.266 1.602q0 .202-.14.339q-.14.138-.342.138t-.34-.138t-.137-.34q.067-.669-.142-1.25q-.21-.58-.635-1.005t-1.025-.64t-1.256-.13q-.202.02-.359-.111t-.176-.333t.109-.358t.33-.176q.796-.1 1.634.218t1.39.87M12 6q-.59 0-1.165.066q-.576.067-1.14.205q-.214.056-.388-.057t-.241-.303q-.068-.207.039-.38t.314-.229q.633-.163 1.278-.233Q11.342 5 12 5q3.021 0 5.58 1.55t3.962 4.216q.1.18.14.354t.041.38t-.037.38t-.138.354q-.47.924-1.122 1.712t-1.434 1.456q-.165.14-.363.12q-.198-.022-.333-.199q-.134-.177-.106-.368q.027-.192.193-.332q.754-.652 1.369-1.433q.615-.78 1.048-1.69q-1.25-2.525-3.613-4.012T12 6m0 12q-2.966 0-5.452-1.562t-3.99-4.128q-.125-.181-.178-.39t-.053-.42t.05-.417t.175-.392q.615-1.039 1.364-1.97q.75-.933 1.734-1.644L3.21 4.631q-.14-.147-.147-.347q-.007-.201.153-.361q.159-.16.353-.16t.354.16l16.154 16.154q.14.14.153.341t-.153.366q-.16.16-.354.16t-.354-.16l-3.538-3.526q-.894.41-1.862.576Q13.002 18 12 18M6.358 7.785q-1.033.707-1.835 1.646q-.802.938-1.323 2.069q1.25 2.525 3.613 4.013T12 17q.789 0 1.562-.11q.773-.111 1.504-.398l-1.632-1.642q-.332.19-.688.247t-.746.057q-1.529 0-2.591-1.063T8.346 11.5q0-.39.067-.746t.237-.688zm4.354 4.354"/>
                            </svg>
                        </button>
                    </div>
                    <div class="text-right mt-1">
                        <a href="/v2/reset-password" class="text-xs text-orchid-600 hover:text-orchid-700 font-medium">Forgot password?</a>
                    </div>
                </div>

                <!-- Error message -->
                <div id="errorMessage" class="hidden bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg text-sm">
                </div>

                <!-- Success message -->
                <div id="successMessage" class="hidden bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-lg text-sm">
                </div>

                <button
                    type="submit"
                    id="submitBtn"
                    aria-disabled="true"
                    class="w-full h-12 flex items-center justify-center bg-orchid-700 text-white font-semibold rounded-md aria-disabled:opacity-50 aria-disabled:cursor-not-allowed"
                >
                    Log In
                </button>
            </form>

            <!-- Divider -->
            <div class="mt-6 mb-6 flex items-center">
                <div class="flex-1 border-t border-gray-300"></div>
                <span class="px-4 text-sm text-gray-500">or</span>
                <div class="flex-1 border-t border-gray-300"></div>
            </div>

            <!-- Sign up link -->
            <div class="text-center">
                <p class="text-sm text-gray-600">
                    Don't have an account?
                    <a href="/v2/signup" class="font-semibold text-orchid-600 hover:text-orchid-700">
                        Sign Up
                    </a>
                </p>
            </div>
            </div><!-- end #credentialsStep -->

            <!-- Step 1b: Email verification required (unverified / suspended accounts) -->
            <div id="verifyEmailStep" class="hidden">
                <div class="text-center mb-6">
                    <div class="w-16 h-16 bg-orchid-100 rounded-full flex items-center justify-center mx-auto mb-4">
                        <svg xmlns="http://www.w3.org/2000/svg" class="text-orchid-600" width="32" height="32" viewBox="0 0 24 24">
                            <path fill="currentColor" d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2m0 4-8 5-8-5V6l8 5 8-5z"/>
                        </svg>
                    </div>
                    <h2 class="text-xl font-bold text-gray-800">Verify your email</h2>
                    <p class="text-sm text-gray-600 mt-2" id="verifyEmailDesc">Your account needs email verification before you can log in.</p>
                    <p class="text-sm font-semibold text-gray-800 mt-1" id="verifyEmailDisplay"></p>
                </div>

                <div id="verifyEmailError" class="hidden bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-md text-sm mb-4"></div>

                <button
                    type="button"
                    id="sendVerifyCodeBtn"
                    class="w-full h-12 flex items-center justify-center bg-orchid-700 text-white font-semibold rounded-md hover:bg-orchid-800 transition-colors mb-3"
                >
                    Send Verification Code
                </button>

                <div class="text-center">
                    <button type="button" id="backToLoginBtn" class="text-sm text-orchid-600 hover:text-orchid-700 font-medium">
                        ← Back to login
                    </button>
                </div>
            </div><!-- end #verifyEmailStep -->

            <!-- Step 2: OTP verification -->
            <div id="otpStep" class="hidden">
                <div class="text-center mb-6">
                    <div class="w-16 h-16 bg-orchid-100 rounded-full flex items-center justify-center mx-auto mb-4">
                        <svg xmlns="http://www.w3.org/2000/svg" class="text-orchid-600" width="32" height="32" viewBox="0 0 24 24">
                            <path fill="currentColor" d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2m0 4-8 5-8-5V6l8 5 8-5z"/>
                        </svg>
                    </div>
                    <h2 class="text-xl font-bold text-gray-800">Check your email</h2>
                    <p class="text-sm text-gray-600 mt-2">We sent a 6-digit code to</p>
                    <p class="text-sm font-semibold text-gray-800 mt-1" id="otpEmailDisplay"></p>
                </div>

                <div class="mb-4">
                    <label for="otpCode" class="block text-sm font-medium text-woodsmoke-950 mb-1">Verification Code</label>
                    <input
                        type="text"
                        id="otpCode"
                        inputmode="numeric"
                        pattern="[0-9]*"
                        maxlength="6"
                        autocomplete="one-time-code"
                        class="w-full text-center text-2xl tracking-widest px-3 h-12 border border-gray-300 rounded-md focus:bg-orchid-50 focus:outline-none focus:ring-2 focus:ring-orchid-500 focus:border-transparent"
                        placeholder="000000"
                    >
                </div>

                <div id="otpErrorMessage" class="hidden bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg text-sm mb-4"></div>

                <button
                    type="button"
                    id="verifyBtn"
                    aria-disabled="true"
                    class="w-full h-12 flex items-center justify-center bg-orchid-700 text-white font-semibold rounded-md aria-disabled:opacity-50 aria-disabled:cursor-not-allowed mb-3"
                >
                    Verify Code
                </button>

                <div class="text-center text-sm text-gray-600">
                    Didn't receive it?
                    <button type="button" id="resendBtn" class="font-semibold text-orchid-600 hover:text-orchid-700 ml-1">
                        Resend code
                    </button>
                    <span id="resendCountdown" class="text-gray-500 hidden"> (<span id="countdownNum">60</span>s)</span>
                </div>
            </div><!-- end #otpStep -->

        </div>

        <!-- Benefits -->
        <div class="mt-6 p-4 bg-orchid-50 border border-orchid-200 rounded-lg">
            <p class="text-sm font-semibold text-orchid-800 mb-2">✨ Member Benefits:</p>
            <ul class="text-sm text-orchid-700 space-y-1 ml-5 list-disc">
                <li>Unlimited scraping (no daily limits)</li>
                <li>Access your links from any device</li>
                <li>Permanent data storage</li>
            </ul>
        </div>

        <!-- Back to home -->
        <div class="mt-6 text-center">
            <a href="/" class="text-sm text-gray-600 hover:text-gray-800">
                ← Back to Home
            </a>
        </div>
    </div>

    <script type="module">
        const loginForm = document.getElementById('loginForm');
        const submitBtn = document.getElementById('submitBtn');
        const errorMessage = document.getElementById('errorMessage');
        const successMessage = document.getElementById('successMessage');
        const emailInput = document.getElementById('email');
        const passwordInput = document.getElementById('password');

        // Password toggle
        const togglePassword = document.getElementById('togglePassword');
        const passwordEyeOpen = document.getElementById('passwordEyeOpen');
        const passwordEyeClosed = document.getElementById('passwordEyeClosed');

        togglePassword.addEventListener('click', () => {
            const isPassword = passwordInput.type === 'password';
            passwordInput.type = isPassword ? 'text' : 'password';
            passwordEyeOpen.classList.toggle('hidden', isPassword);
            passwordEyeClosed.classList.toggle('hidden', !isPassword);
        });

        function validateEmail(email) {
            return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
        }

        function validateForm() {
            const email = emailInput.value.trim();
            const password = passwordInput.value;
            submitBtn.setAttribute('aria-disabled', !(email && password && validateEmail(email)));
        }

        emailInput.addEventListener('input', validateForm);
        passwordInput.addEventListener('input', validateForm);

        // ── Verify Email step ─────────────────────────────���────────────────────

        let pendingVerifyEmail = '';

        function showVerifyEmailStep(email, suspended) {
            pendingVerifyEmail = email;
            document.getElementById('verifyEmailDisplay').textContent = email;
            document.getElementById('verifyEmailDesc').textContent = suspended
                ? 'Your account was suspended because the email was not verified in time. Send a new code to verify now.'
                : 'Your email address must be verified before you can log in. Send a verification code to your inbox.';
            document.getElementById('credentialsStep').classList.add('hidden');
            document.getElementById('verifyEmailStep').classList.remove('hidden');
        }

        document.getElementById('sendVerifyCodeBtn').addEventListener('click', async () => {
            const btn = document.getElementById('sendVerifyCodeBtn');
            const err = document.getElementById('verifyEmailError');
            err.classList.add('hidden');
            btn.textContent = 'Sending...';
            btn.disabled = true;

            try {
                const response = await fetch('/api/auth/resend-otp', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify({ email: pendingVerifyEmail })
                });
                const data = await response.json();
                if (!response.ok) throw new Error(data.error || 'Failed to send code');
                document.getElementById('verifyEmailStep').classList.add('hidden');
                showOtpStep(pendingVerifyEmail);
            } catch (error) {
                err.textContent = error.message;
                err.classList.remove('hidden');
                btn.textContent = 'Send Verification Code';
                btn.disabled = false;
            }
        });

        document.getElementById('backToLoginBtn').addEventListener('click', () => {
            document.getElementById('verifyEmailStep').classList.add('hidden');
            document.getElementById('credentialsStep').classList.remove('hidden');
        });

        // ── OTP step ──────────────────────────────────────────────────────────

        let otpEmail = '';
        let resendTimer = null;

        function showOtpStep(email) {
            otpEmail = email;
            document.getElementById('otpEmailDisplay').textContent = email;
            document.getElementById('credentialsStep').classList.add('hidden');
            document.getElementById('otpStep').classList.remove('hidden');
            document.getElementById('otpCode').focus();
            startResendCooldown();
        }

        function startResendCooldown() {
            const resendBtn = document.getElementById('resendBtn');
            const resendCountdown = document.getElementById('resendCountdown');
            const countdownNum = document.getElementById('countdownNum');
            clearInterval(resendTimer);
            resendBtn.disabled = true;
            resendBtn.classList.add('opacity-50', 'cursor-not-allowed');
            resendCountdown.classList.remove('hidden');
            let seconds = 60;
            countdownNum.textContent = seconds;
            resendTimer = setInterval(() => {
                seconds--;
                countdownNum.textContent = seconds;
                if (seconds <= 0) {
                    clearInterval(resendTimer);
                    resendBtn.disabled = false;
                    resendBtn.classList.remove('opacity-50', 'cursor-not-allowed');
                    resendCountdown.classList.add('hidden');
                }
            }, 1000);
        }

        document.getElementById('otpCode').addEventListener('input', (e) => {
            e.target.value = e.target.value.replace(/\D/g, '');
            document.getElementById('verifyBtn').setAttribute('aria-disabled', e.target.value.length !== 6 ? 'true' : 'false');
        });

        document.getElementById('verifyBtn').addEventListener('click', async () => {
            const verifyBtn = document.getElementById('verifyBtn');
            if (verifyBtn.getAttribute('aria-disabled') === 'true') return;

            const code = document.getElementById('otpCode').value;
            const otpError = document.getElementById('otpErrorMessage');
            otpError.classList.add('hidden');
            verifyBtn.setAttribute('aria-disabled', 'true');
            verifyBtn.textContent = 'Verifying...';

            try {
                const response = await fetch('/api/auth/verify-otp', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify({ email: otpEmail, code })
                });
                const data = await response.json();
                if (!response.ok) throw new Error(data.error || 'Verification failed');
                const params = new URLSearchParams(window.location.search);
                window.location.href = params.get('redirect') || '/v2';
            } catch (error) {
                otpError.textContent = error.message;
                otpError.classList.remove('hidden');
                verifyBtn.textContent = 'Verify Code';
                const code = document.getElementById('otpCode').value;
                verifyBtn.setAttribute('aria-disabled', code.length !== 6 ? 'true' : 'false');
            }
        });

        document.getElementById('resendBtn').addEventListener('click', async () => {
            const resendBtn = document.getElementById('resendBtn');
            if (resendBtn.disabled) return;
            const otpError = document.getElementById('otpErrorMessage');
            otpError.classList.add('hidden');
            try {
                const response = await fetch('/api/auth/resend-otp', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify({ email: otpEmail })
                });
                const data = await response.json();
                if (!response.ok) throw new Error(data.error || 'Failed to resend');
                document.getElementById('otpCode').value = '';
                document.getElementById('verifyBtn').setAttribute('aria-disabled', 'true');
                startResendCooldown();
            } catch (error) {
                otpError.textContent = error.message;
                otpError.classList.remove('hidden');
            }
        });

        // ── Login form submission ──────────────────────────────────────────────

        loginForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            if (submitBtn.getAttribute('aria-disabled') === 'true') return;

            const email = emailInput.value.trim();
            const password = passwordInput.value;

            errorMessage.classList.add('hidden');
            successMessage.classList.add('hidden');
            submitBtn.setAttribute('aria-disabled', 'true');
            submitBtn.textContent = 'Logging in...';

            try {
                const response = await fetch('/api/auth/login', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify({ email, password })
                });

                const data = await response.json();

                if (!response.ok) {
                    if (data.code === 'EMAIL_NOT_VERIFIED' || data.code === 'ACCOUNT_SUSPENDED') {
                        submitBtn.textContent = 'Log In';
                        validateForm();
                        showVerifyEmailStep(data.email || email, data.code === 'ACCOUNT_SUSPENDED');
                        return;
                    }
                    if (data.code === 'ACCOUNT_DELETED') {
                        throw new Error('Your account was deleted due to non-verification. Please sign up again.');
                    }
                    throw new Error(data.error || 'Login failed');
                }

                showOtpStep(data.email || email);

            } catch (error) {
                errorMessage.textContent = error.message;
                errorMessage.classList.remove('hidden');
                submitBtn.textContent = 'Log In';
                validateForm();
            }
        });
    </script>
</body>
</html>

<%
  title = domain
  page  = 'repository'
%>
<%- include('partials/layout') %>

<div class="flex h-full">

    <!-- Main content -->
    <div class="flex-1 overflow-y-auto p-4">

        <!-- Header -->
        <div class="flex items-center gap-3 mb-6">
            <a href="/v2/showroom" class="flex items-center justify-center w-8 h-8 rounded-full hover:bg-gray-100 transition-colors text-gray-500 hover:text-woodsmoke-950 shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
            </a>
            <div>
                <h1 id="repo-title" class="text-xl font-bold"><%= domain %></h1>
                <p id="repo-meta" class="text-sm text-gray-400">Loading…</p>
            </div>
        </div>

        <!-- Links grid -->
        <div id="repo-links" class="flex flex-col gap-2">
            <!-- Injected by JS -->
        </div>

        <!-- Empty / error states -->
        <div id="repo-empty" class="hidden text-center py-16 text-sm text-gray-400">No links found for this repository.</div>
        <div id="repo-error" class="hidden text-center py-16 text-sm text-red-400">Failed to load repository.</div>

    </div>

</div>

<script>
    window.__REPO_DOMAIN__ = '<%= domain.replace(/'/g, "\\'") %>';
</script>
<script src="/v2/scripts/repository.js"></script>

<%- include('partials/layout-end') %>

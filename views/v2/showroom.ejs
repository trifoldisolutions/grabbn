        <!-- Cards grid (infinite scroll container) -->
        <div id="showroom-grid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-1 lg:grid-cols-1 gap-4 w-full md:w-[80%] md:mx-auto overflow-y-auto">
            <!-- Cards injected here by JS -->
        </div>

        <div id="showroom-loader" class="flex justify-center py-8 hidden">
            <span class="text-sm text-gray-400">Loading...</span>
        </div>
    </div>

    <!-- Right sidebar -->
    <div class="hidden md:flex w-72 shrink-0 overflow-y-auto py-4 flex-col gap-8">

        <!-- Repositories -->
        <div id="repositoriesSection">
            <div>
                <h2 class="text-xl font-bold">Repositories</h2>
                <p class="text-sm text-gray-400">This will be a very small section descriptive text</p>
            </div>
            <div class="grid grid-cols-3 gap-1.5" id="repositories-list"></div>
        </div>

        <!-- Top Curators -->
        <div id="topCuratorsSection">
            <div>
                <h2 class="text-xl font-bold">Top Curators</h2>
                <p class="text-sm text-gray-400">This will be a very small section descriptive text</p>
            </div>
            <div class="flex flex-col gap-3" id="curators-list"></div>
        </div>

    </div>

</div>

<script src="/v2/scripts/showroom.js"></script>

<%- include('partials/layout-end') %>

<%
  title = 'Show Room'
  page  = 'home'
%>
<%- include('partials/layout') %>

<div class="flex h-full justify-center gap-8 px-6">

    <!-- Main feed -->
    <div id="main-feed" class="w-full md:max-w-2xl overflow-y-auto py-6">
        <!-- Cards grid (infinite scroll container) -->
        <div id="showroom-grid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-1 lg:grid-cols-1 gap-4 w-full md:w-[80%] md:mx-auto overflow-y-auto">
            <!-- Cards injected here by JS -->
        </div>

        <div id="showroom-loader" class="flex justify-center py-8 hidden">
            <span class="text-sm text-gray-400">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"><circle cx="4" cy="12" r="3" fill="currentColor"><animate id="SVG9IgbRbsl" attributeName="r" begin="0;SVGFUNpCWdG.end-0.25s" dur="0.75s" values="3;.2;3"/></circle><circle cx="12" cy="12" r="3" fill="currentColor"><animate attributeName="r" begin="SVG9IgbRbsl.end-0.6s" dur="0.75s" values="3;.2;3"/></circle><circle cx="20" cy="12" r="3" fill="currentColor"><animate id="SVGFUNpCWdG" attributeName="r" begin="SVG9IgbRbsl.end-0.45s" dur="0.75s" values="3;.2;3"/></circle></svg>
            </span>
        </div>
    </div>

    <!-- Right sidebar -->
    <div class="hidden md:flex w-72 shrink-0 overflow-y-auto py-4 flex-col gap-8">

        <!-- Repositories -->
        <div id="repositoriesSection">
            <!-- <div class="mb-2">
                <h2 class="text-md font-bold">Suggested for you</h2>
                <p class="text-sm text-gray-400">This will be a very small section descriptive text</p>
            </div> -->
            <div class="grid grid-cols-2 gap-1.5" id="repositories-list"></div>
        </div>

        <!-- Top Curators -->
        <div id="topCuratorsSection">
            <!-- <div>
                <h2 class="text-xl font-bold">Top Curators</h2>
                <p class="text-sm text-gray-400">This will be a very small section descriptive text</p>
            </div> -->
            <div class="flex flex-col gap-3" id="curators-list"></div>
        </div>

    </div>

</div>

<script src="/v2/scripts/showroom.js"></script>

<%- include('partials/layout-end') %>

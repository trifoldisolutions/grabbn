<%
  title = `@${profileUser.username}`
  page  = 'profile'
%>
<%- include('partials/layout') %>

<!-- ── Embed bucket data for client-side modal ─────────────────────────── -->
<script>
    window.__PROFILE_OWN__           = <%- JSON.stringify(ownBuckets) %>;
    window.__PROFILE_GRABBED__       = <%- JSON.stringify(grabbedBuckets) %>;
    window.__PROFILE_REPOS__         = <%- JSON.stringify(userRepos) %>;
    window.__PROFILE_IS_OWNER__      = <%- JSON.stringify(isOwner) %>;
    window.__PROFILE_VIEWER_AUTHED__ = <%- JSON.stringify(!!(user && !user.isAnonymous)) %>;
    window.__PROFILE_ANON_ID__       = <%- JSON.stringify(profileUser.anonymousId) %>;
</script>

<div class="w-full max-w-5xl mx-auto px-4 md:px-6 py-8">

    <!-- ── Profile header ─────────────────────────────────────────────── -->
    <div class="flex flex-col items-center gap-4 mb-8">

        <!-- Avatar -->
        <div class="w-24 h-24 rounded-full overflow-hidden shrink-0 flex items-center justify-center <%= profileUser.avatar ? '' : 'bg-orchid-100' %>">
            <% if (profileUser.avatar) { %>
                <img src="<%= profileUser.avatar %>" alt="avatar" class="w-full h-full object-cover">
            <% } else { %>
                <svg xmlns="http://www.w3.org/2000/svg" width="44" height="44" viewBox="0 0 24 24" class="text-orchid-600"><g fill="none"><path d="m12.593 23.258l-.011.002l-.071.035l-.02.004l-.014-.004l-.071-.035q-.016-.005-.024.005l-.004.01l-.017.428l.005.02l.01.013l.104.074l.015.004l.012-.004l.104-.074l.012-.016l.004-.017l-.017-.427q-.004-.016-.017-.018m.265-.113l-.013.002l-.185.093l-.01.01l-.003.011l.018.43l.005.012l.008.007l.201.093q.019.005.029-.008l.004-.014l-.034-.614q-.005-.018-.02-.022m-.715.002a.02.02 0 0 0-.027.006l-.006.014l-.034.614q.001.018.017.024l.015-.002l.201-.093l.01-.008l.004-.011l.017-.43l-.003-.012l-.01-.01z"/><path fill="currentColor" d="M12 13c2.396 0 4.575.694 6.178 1.672c.8.488 1.484 1.064 1.978 1.69c.486.615.844 1.351.844 2.138c0 .845-.411 1.511-1.003 1.986c-.56.45-1.299.748-2.084.956c-1.578.417-3.684.558-5.913.558s-4.335-.14-5.913-.558c-.785-.208-1.524-.506-2.084-.956C3.41 20.01 3 19.345 3 18.5c0-.787.358-1.523.844-2.139c.494-.625 1.177-1.2 1.978-1.69C7.425 13.695 9.605 13 12 13m0-11a5 5 0 1 1 0 10a5 5 0 0 1 0-10"/></g></svg>
            <% } %>
        </div>

        <!-- Username & email (email only shown to owner) -->
        <div class="text-center">
            <h1 class="text-2xl font-bold">@<%= profileUser.username %></h1>
            <% if (isOwner && profileUser.email) { %>
                <div class="flex flex-col items-center gap-2 mt-1.5">

                    <!-- Email -->
                    <p class="text-sm text-gray-400"><%= profileUser.email %></p>

                    <!-- Credit status badge -->
                    <div class="relative w-full max-w-sm mt-3">
                        <!-- Only visible to you — straddles the top border -->
                        <span class="absolute left-1/2 -translate-x-1/2 -top-2.75 flex items-center gap-1 text-xs text-gray-500 bg-gray-100 border border-gray-200 px-1.5 py-0.5 rounded-full whitespace-nowrap z-10">
                            <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24"><g fill="none"><path fill="currentColor" d="M12 2a5 5 0 1 0 0 10A5 5 0 0 0 12 2M4 13a8 8 0 0 0 8 8a8 8 0 0 0 8-8z" opacity=".3"/><path fill="currentColor" fill-rule="evenodd" d="M12 4a3 3 0 1 0 0 6a3 3 0 0 0 0-6M7 7a5 5 0 1 1 10 0A5 5 0 0 1 7 7m-3 6a8 8 0 0 1 16 0v1H4v-1zm2.1 3H18.9A8 8 0 0 1 4.1 16z" clip-rule="evenodd"/></g></svg>
                            Only visible to you
                        </span>
                        <div class="border border-gray-100 rounded-xl overflow-hidden">
                        <div class="flex items-center gap-4 bg-gray-50 px-4 py-2.5">

                            <!-- Top up icon btn -->
                            <a href="/v2/topup" title="Top Up"
                                class="h-12 aspect-square flex items-center justify-center rounded-lg text-orchid-500 hover:text-orchid-700 hover:bg-orchid-50 transition-colors shrink-0">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"><g fill="none"><path d="m12.593 23.258l-.011.002l-.071.035l-.02.004l-.014-.004l-.071-.035q-.016-.005-.024.005l-.004.01l-.017.428l.005.02l.01.013l.104.074l.015.004l.012-.004l.104-.074l.012-.016l.004-.017l-.017-.427q-.004-.016-.017-.018m.265-.113l-.013.002l-.185.093l-.01.01l-.003.011l.018.43l.005.012l.008.007l.201.093q.019.005.029-.008l.004-.014l-.034-.614q-.005-.018-.02-.022m-.715.002a.02.02 0 0 0-.027.006l-.006.014l-.034.614q.001.018.017.024l.015-.002l.201-.093l.01-.008l.004-.011l.017-.43l-.003-.012l-.01-.01z"/><path fill="currentColor" d="M10.5 20a1.5 1.5 0 0 0 3 0v-6.5H20a1.5 1.5 0 0 0 0-3h-6.5V4a1.5 1.5 0 0 0-3 0v6.5H4a1.5 1.5 0 0 0 0 3h6.5z"/></g></svg>
                            </a>

                            <div class="w-px h-8 bg-gray-200 shrink-0"></div>

                            <!-- Balance -->
                            <div class="flex flex-col items-center">
                                <span id="profileCreditBalance" class="text-lg font-bold text-gray-800 leading-tight">—</span>
                                <span class="text-xs text-gray-500">Balance</span>
                            </div>

                            <div class="w-px h-8 bg-gray-200 shrink-0"></div>

                            <!-- 7d earnings -->
                            <div class="flex flex-col items-center">
                                <span id="profileCreditEarned" class="text-lg font-bold text-emerald-600 leading-tight">—</span>
                                <span class="text-xs text-gray-500">7d earnings</span>
                            </div>

                            <div class="w-px h-8 bg-gray-200 shrink-0"></div>

                            <!-- 7d spendings -->
                            <div class="flex flex-col items-center">
                                <span id="profileCreditSpent" class="text-lg font-bold text-red-500 leading-tight">—</span>
                                <span class="text-xs text-gray-500">7d spendings</span>
                            </div>
                        </div>

                        <!-- Get more insights -->
                        <div class="py-1.5 text-center">
                            <a href="/v2/transactions" class="text-sm text-orchid-500 hover:text-orchid-700 transition-colors">Get more insights →</a>
                        </div>
                        </div><!-- /border wrapper -->
                    </div><!-- /relative wrapper -->
                </div>
            <% } %>
        </div>

        <!-- Stats row -->
        <div class="flex items-center gap-8 mt-1">
            <div class="flex flex-col items-center">
                <span class="text-lg font-bold"><%= ownBuckets.length %></span>
                <span class="text-xs text-gray-500">Buckets</span>
            </div>
            <div class="flex flex-col items-center">
                <span class="text-lg font-bold"><%= totalGrabs.toLocaleString() %></span>
                <span class="text-xs text-gray-500">Grabs</span>
            </div>
            <div class="flex flex-col items-center">
                <span class="text-lg font-bold" data-stat="subscribers"><%= subscriberCount.toLocaleString() %></span>
                <span class="text-xs text-gray-500">Subscribers</span>
            </div>
            <div class="flex flex-col items-center">
                <span class="text-lg font-bold"><%= followingCount.toLocaleString() %></span>
                <span class="text-xs text-gray-500">Following</span>
            </div>
        </div>

        <!-- Member since -->
        <p class="text-xs text-gray-400">Member since <%= memberSince %></p>

        <!-- Action buttons — differ for owner vs visitor -->
        <div class="flex items-center gap-2">
            <% if (isOwner) { %>
                <a href="/v2/settings" class="px-5 py-2 text-sm font-semibold border border-silver-200 rounded-md hover:bg-silver-50 transition-colors">
                    Edit Profile
                </a>
            <% } else { %>
                <button id="followBtn" disabled class="px-5 py-2 text-sm font-semibold bg-orchid-600 text-white rounded-md hover:bg-orchid-700 transition-colors opacity-50 cursor-not-allowed">
                    Follow
                </button>
                <button id="dmBtn" class="flex items-center gap-1.5 px-5 py-2 text-sm font-semibold border border-silver-200 rounded-md hover:bg-silver-50 transition-colors">
                    <!-- mingcute:chat-1-line -->
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"><g fill="none"><path d="m12.593 23.258l-.011.002l-.071.035l-.02.004l-.014-.004l-.071-.035q-.016-.005-.024.005l-.004.01l-.017.428l.005.02l.01.013l.104.074l.015.004l.012-.004l.104-.074l.012-.016l.004-.017l-.017-.427q-.004-.016-.017-.018m.265-.113l-.013.002l-.185.093l-.01.01l-.003.011l.018.43l.005.012l.008.007l.201.093q.019.005.029-.008l.004-.014l-.034-.614q-.005-.018-.02-.022m-.715.002a.02.02 0 0 0-.027.006l-.006.014l-.034.614q.001.018.017.024l.015-.002l.201-.093l.01-.008l.004-.011l.017-.43l-.003-.012l-.01-.01z"/><path fill="currentColor" d="M12 2c5.523 0 10 4.477 10 10s-4.477 10-10 10a9.96 9.96 0 0 1-4.644-1.142L3.31 21.97a1 1 0 0 1-1.282-1.282l1.114-4.044A9.96 9.96 0 0 1 2 12C2 6.477 6.477 2 12 2m0 2a8 8 0 0 0-6.992 11.923l.16.282l-1.005 3.646l3.646-1.005l.282.16A8 8 0 1 0 12 4m-3 7a1 1 0 1 1 0 2a1 1 0 0 1 0-2m3 0a1 1 0 1 1 0 2a1 1 0 0 1 0-2m3 0a1 1 0 1 1 0 2a1 1 0 0 1 0-2"/></g></svg>
                    Message
                </button>
            <% } %>
            <button id="shareProfileBtn" class="flex items-center gap-1.5 px-5 py-2 text-sm font-semibold border border-silver-200 rounded-md hover:bg-silver-50 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"><g fill="none"><path d="m12.593 23.258l-.011.002l-.071.035l-.02.004l-.014-.004l-.071-.035q-.016-.005-.024.005l-.004.01l-.017.428l.005.02l.01.013l.104.074l.015.004l.012-.004l.104-.074l.012-.016l.004-.017l-.017-.427q-.004-.016-.017-.018m.265-.113l-.013.002l-.185.093l-.01.01l-.003.011l.018.43l.005.012l.008.007l.201.093q.019.005.029-.008l.004-.014l-.034-.614q-.005-.018-.02-.022m-.715.002a.02.02 0 0 0-.027.006l-.006.014l-.034.614q.001.018.017.024l.015-.002l.201-.093l.01-.008l.004-.011l.017-.43l-.003-.012l-.01-.01z"/><path fill="currentColor" d="m10.114 4.491l-.203 3.144l-.02.417l-.09.01C5.363 8.582 2 12.366 2 17q0 .686.102 1.357c.279 1.845.489 2.024 1.772.498a9 9 0 0 1 1.04-1.03a7.96 7.96 0 0 1 4.754-1.818l.226-.005l.061 1.229l.166 2.345c.08.804.926 1.353 1.704.914c.352-.198.695-.41 1.04-.62c1.787-1.118 3.46-2.403 5.09-3.738c.96-.8 1.8-1.558 2.516-2.248c.33-.323.66-.646.979-.98c.462-.484.508-1.285.024-1.792c-1.114-1.165-2.688-2.624-4.647-4.172c-1.588-1.242-3.23-2.402-4.97-3.421c-.837-.477-1.667.177-1.743.972"/></g></svg>
                Share
            </button>
        </div>

    </div>

    <!-- ── Tabs ────────────────────────────────────────────────────────── -->
    <div class="border-b border-gray-100 mb-6">
        <div class="flex gap-0">
            <button id="tabBuckets" class="profile-tab px-5 py-3 text-sm font-semibold border-b-2 border-orchid-600 text-orchid-600 transition-colors" data-tab="buckets">
                Buckets
                <span class="ml-1.5 text-xs bg-orchid-100 text-orchid-600 px-1.5 py-0.5 rounded-full"><%= ownBuckets.length %></span>
            </button>
            <% if (isOwner) { %>
                <button id="tabGrabbed" class="profile-tab px-5 py-3 text-sm font-semibold border-b-2 border-transparent text-gray-400 hover:text-gray-600 transition-colors" data-tab="grabbed">
                    Grabbed
                    <span class="ml-1.5 text-xs bg-gray-100 text-gray-500 px-1.5 py-0.5 rounded-full"><%= grabbedBuckets.length %></span>
                </button>
                <button id="tabRepos" class="profile-tab px-5 py-3 text-sm font-semibold border-b-2 border-transparent text-gray-400 hover:text-gray-600 transition-colors" data-tab="repos">
                    Repos
                    <span id="reposTabCount" class="ml-1.5 text-xs bg-gray-100 text-gray-500 px-1.5 py-0.5 rounded-full"><%= userRepos.length %></span>
                </button>
            <% } %>
        </div>
    </div>

    <!-- ── Buckets tab ─────────────────────────────────────────────────── -->
    <div id="panelBuckets">
        <% if (ownBuckets.length === 0) { %>
            <div class="flex flex-col items-center justify-center py-16 gap-3 text-center">
                <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" class="text-gray-300"><g fill="none"><path d="m12.593 23.258l-.011.002l-.071.035l-.02.004l-.014-.004l-.071-.035q-.016-.005-.024.005l-.004.01l-.017.428l.005.02l.01.013l.104.074l.015.004l.012-.004l.104-.074l.012-.016l.004-.017l-.017-.427q-.004-.016-.017-.018m.265-.113l-.013.002l-.185.093l-.01.01l-.003.011l.018.43l.005.012l.008.007l.201.093q.019.005.029-.008l.004-.014l-.034-.614q-.005-.018-.02-.022m-.715.002a.02.02 0 0 0-.027.006l-.006.014l-.034.614q.001.018.017.024l.015-.002l.201-.093l.01-.008l.004-.011l.017-.43l-.003-.012l-.01-.01z"/><path fill="currentColor" d="M15.5 5a2.5 2.5 0 0 1 2.461 2.058A2.5 2.5 0 0 1 21 9.5V12a8 8 0 0 1-8 8h-.674a8 8 0 0 1-7.155-4.422L2.329 9.894c-.36-.72-.093-1.683.747-2.028c1.043-.427 2.034-.507 3.055.012q.443.227.869.584V7.5a2.5 2.5 0 0 1 3.388-2.338a2.498 2.498 0 0 1 4.224 0A2.5 2.5 0 0 1 15.5 5"/></g></svg>
                <p class="text-sm text-gray-400"><%= isOwner ? "No buckets yet. Start curating!" : "No public buckets yet." %></p>
            </div>
        <% } else { %>
            <div class="grid grid-cols-2 gap-4">
                <% ownBuckets.forEach(function(b) { %>
                    <%- include('partials/bucket-card', { b, isOwn: isOwner }) %>
                <% }); %>
            </div>
        <% } %>
    </div>

    <!-- ── Repos tab (owner only) ───────────────────────────────────────── -->
    <% if (isOwner) { %>
        <div id="panelRepos" class="hidden"></div>
    <% } %>

    <!-- ── Grabbed tab (owner only) ────────────────────────────────────── -->
    <% if (isOwner) { %>
        <div id="panelGrabbed" class="hidden">
            <% if (grabbedBuckets.length === 0) { %>
                <div class="flex flex-col items-center justify-center py-16 gap-3 text-center">
                    <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" class="text-gray-300"><g fill="none"><path d="m12.593 23.258l-.011.002l-.071.035l-.02.004l-.014-.004l-.071-.035q-.016-.005-.024.005l-.004.01l-.017.428l.005.02l.01.013l.104.074l.015.004l.012-.004l.104-.074l.012-.016l.004-.017l-.017-.427q-.004-.016-.017-.018m.265-.113l-.013.002l-.185.093l-.01.01l-.003.011l.018.43l.005.012l.008.007l.201.093q.019.005.029-.008l.004-.014l-.034-.614q-.005-.018-.02-.022m-.715.002a.02.02 0 0 0-.027.006l-.006.014l-.034.614q.001.018.017.024l.015-.002l.201-.093l.01-.008l.004-.011l.017-.43l-.003-.012l-.01-.01z"/><path fill="currentColor" d="M17.961 7.058a2.5 2.5 0 0 0-3.349-1.896a2.498 2.498 0 0 0-4.225 0A2.5 2.5 0 0 0 7 7.5l.001.962a4.7 4.7 0 0 0-.87-.584C5.11 7.36 4.12 7.44 3.077 7.866c-.84.345-1.107 1.308-.747 2.028l2.842 5.684A8 8 0 0 0 12.326 20H13a8 8 0 0 0 8-8V9.5a2.5 2.5 0 0 0-3.039-2.442M10 7.5a.5.5 0 1 0-1 0V11a1 1 0 0 1-1.78.625c-.925-1.156-1.517-1.72-1.995-1.964a1.2 1.2 0 0 0-.835-.117l2.57 5.14A6 6 0 0 0 12.326 18H13a6 6 0 0 0 6-6V9.5a.5.5 0 1 0-1 0v.5a1 1 0 1 1-2 0V7.5a.5.5 0 1 0-1 0V10a1 1 0 1 1-2 0V6.5a.5.5 0 1 0-1 0V10a1 1 0 1 1-2 0z"/></g></svg>
                    <p class="text-sm text-gray-400">You haven't grabbed any buckets yet.</p>
                </div>
            <% } else { %>
                <div class="grid grid-cols-2 gap-4">
                    <% grabbedBuckets.forEach(function(b) { %>
                        <%- include('partials/bucket-card', { b, isOwn: false }) %>
                    <% }); %>
                </div>
            <% } %>
        </div>
    <% } %>

</div>

<!-- ── Credit badge JS (owner only) ──────────────────────────────────── -->
<% if (isOwner) { %>
<script>
(function () {
    const balanceEl = document.getElementById('profileCreditBalance');
    const earnedEl  = document.getElementById('profileCreditEarned');
    const spentEl   = document.getElementById('profileCreditSpent');

    fetch('/api/credits/summary', { credentials: 'include' })
        .then(r => r.ok ? r.json() : null)
        .then(data => {
            if (!data) return;
            balanceEl.textContent = data.balance.toLocaleString();
            earnedEl.textContent  = data.earned7d.toLocaleString();
            spentEl.textContent   = data.spent7d.toLocaleString();
        })
        .catch(() => {});
})();
</script>
<% } %>

<!-- ── Bucket edit modal (owner only) ────────────────────────────────── -->
<% if (isOwner) { %>
<div id="editBucketModal" class="hidden fixed inset-0 z-[100] flex items-center justify-center bg-black/50 p-4">
    <div class="bg-white rounded-lg shadow-xl max-w-sm w-full p-6 flex flex-col gap-y-4">
        <div class="flex items-center justify-between">
            <h3 id="editBucketModalTitle" class="font-bold text-gray-900 text-base">Edit Bucket</h3>
            <button id="closeEditBucketModal" class="text-gray-400 hover:text-gray-600 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"><path fill="currentColor" d="M6.4 19L5 17.6l5.6-5.6L5 6.4L6.4 5l5.6 5.6L17.6 5L19 6.4L13.4 12l5.6 5.6l-1.4 1.4l-5.6-5.6z"/></svg>
            </button>
        </div>
        <input id="editBucketNameInput" type="text" placeholder="Bucket name…" maxlength="80"
            class="w-full h-11 px-3 text-sm border border-gray-200 rounded-lg outline-none focus:border-orchid-400 transition-colors">
        <p id="editBucketError" class="hidden text-xs text-red-500"></p>
        <button id="editBucketConfirmBtn"
            class="h-11 w-full rounded-lg bg-orchid-600 hover:bg-orchid-700 text-white text-sm font-semibold transition-colors flex items-center justify-center disabled:opacity-40 disabled:cursor-not-allowed">
            Save Changes
        </button>
    </div>
</div>
<% } %>


<script>
(function () {
    const isOwner = window.__PROFILE_IS_OWNER__;

    // ── Bucket edit modal (owner only) ───────────────────────────────────────
    const editModal      = document.getElementById('editBucketModal');
    const editInput      = document.getElementById('editBucketNameInput');
    const editConfirmBtn = document.getElementById('editBucketConfirmBtn');
    const editErrorEl    = document.getElementById('editBucketError');
    const closeEditBtn   = document.getElementById('closeEditBucketModal');

    let _editingBucket = null; // bucket object currently being edited

    function openEditModal(bucket) {
        _editingBucket = bucket;
        if (editInput)  { editInput.value = bucket.name; editInput.disabled = false; }
        if (editConfirmBtn) { editConfirmBtn.disabled = false; editConfirmBtn.textContent = 'Save Changes'; }
        if (editErrorEl) { editErrorEl.textContent = ''; editErrorEl.classList.add('hidden'); }
        editModal?.classList.remove('hidden');
        setTimeout(() => { editInput?.select(); }, 50);
    }

    function closeEditModal() {
        editModal?.classList.add('hidden');
        _editingBucket = null;
    }

    if (editModal) {
        closeEditBtn?.addEventListener('click', closeEditModal);
        editModal.addEventListener('click', e => { if (e.target === editModal) closeEditModal(); });
        document.addEventListener('keydown', e => {
            if (e.key === 'Escape' && !editModal.classList.contains('hidden')) closeEditModal();
        });

        async function handleEditSave() {
            if (!_editingBucket) return;
            const newName = editInput?.value.trim();
            if (!newName) { editInput?.focus(); return; }

            if (editConfirmBtn) { editConfirmBtn.disabled = true; editConfirmBtn.textContent = 'Saving…'; }
            if (editInput) editInput.disabled = true;
            if (editErrorEl) editErrorEl.classList.add('hidden');

            try {
                const res = await fetch(`/api/buckets/${encodeURIComponent(_editingBucket.name)}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify({ newName })
                });
                const data = await res.json();
                if (!res.ok) throw new Error(data.error || 'Failed to save');

                // Update embedded data so subsequent opens use the new name
                const pool = window.__PROFILE_OWN__;
                const entry = pool?.find(b => b._id === _editingBucket._id);
                if (entry) entry.name = data.name;

                // Update the card's visual name on the page
                const card = document.querySelector(`[data-bucket-id="${_editingBucket._id}"]`);
                if (card) {
                    const nameEl = card.querySelector('p.font-medium');
                    if (nameEl) nameEl.textContent = data.name;
                }

                closeEditModal();
            } catch (err) {
                if (editErrorEl) { editErrorEl.textContent = err.message; editErrorEl.classList.remove('hidden'); }
                if (editConfirmBtn) { editConfirmBtn.disabled = false; editConfirmBtn.textContent = 'Save Changes'; }
                if (editInput) { editInput.disabled = false; editInput.focus(); }
            }
        }

        editConfirmBtn?.addEventListener('click', handleEditSave);
        editInput?.addEventListener('keydown', e => { if (e.key === 'Enter') handleEditSave(); });
    }

    // ── Tab switching ────────────────────────────────────────────────────────
    const tabs   = document.querySelectorAll('.profile-tab');
    const panels = {
        buckets: document.getElementById('panelBuckets'),
        grabbed: document.getElementById('panelGrabbed'),
        repos:   document.getElementById('panelRepos'),
    };

    tabs.forEach(tab => {
        tab.addEventListener('click', () => {
            const target = tab.dataset.tab;
            tabs.forEach(t => {
                const active = t.dataset.tab === target;
                t.classList.toggle('border-orchid-600',  active);
                t.classList.toggle('text-orchid-600',    active);
                t.classList.toggle('border-transparent', !active);
                t.classList.toggle('text-gray-400',      !active);
            });
            Object.entries(panels).forEach(([key, el]) => {
                if (el) el.classList.toggle('hidden', key !== target);
            });
        });
    });

    // ── Repos panel (owner only) ─────────────────────────────────────────────
    (function () {
        if (!isOwner) return;
        const reposPanel = document.getElementById('panelRepos');
        if (!reposPanel) return;

        let repos      = (window.__PROFILE_REPOS__ || []).slice();
        const ownBuckets = window.__PROFILE_OWN__ || [];

        function getBucketsForRepo(repoId) {
            return ownBuckets.filter(b => b.repoId && String(b.repoId) === String(repoId));
        }

        function updateTabCount() {
            const el = document.getElementById('reposTabCount');
            if (el) el.textContent = repos.length;
        }

        // ── Render ─────────────────────────────────────────────────────────
        function renderRepos() {
            reposPanel.innerHTML = '';

            if (repos.length === 0) {
                reposPanel.innerHTML = `
                    <div class="flex flex-col items-center justify-center py-16 gap-3 text-center">
                        <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" class="text-gray-300"><g fill="none"><path fill="currentColor" d="M3 6a3 3 0 0 1 3-3h3.93a3 3 0 0 1 2.121.879l.707.707A1 1 0 0 0 13.465 5H19a3 3 0 0 1 3 3v9a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3z" opacity=".2"/><path fill="currentColor" fill-rule="evenodd" d="M6 5a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V8a1 1 0 0 0-1-1h-5.535a3 3 0 0 1-2.12-.879l-.708-.707A1 1 0 0 0 8.929 5zm-3 1a3 3 0 0 1 3-3h2.929a3 3 0 0 1 2.12.879l.708.707A1 1 0 0 0 12.465 5H18a3 3 0 0 1 3 3v9a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3z" clip-rule="evenodd"/></g></svg>
                        <p class="text-sm text-gray-400">No repos yet. Create one from the bucket editor.</p>
                    </div>`;
                return;
            }

            const list = document.createElement('div');
            list.className = 'flex flex-col gap-4';
            repos.forEach(repo => list.appendChild(buildRepoCard(repo)));
            reposPanel.appendChild(list);
        }

        // ── Build a single repo card ────────────────────────────────────────
        const BUCKET_ICON = `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"><g fill="none"><path d="m12.593 23.258l-.011.002l-.071.035l-.02.004l-.014-.004l-.071-.035q-.016-.005-.024.005l-.004.01l-.017.428l.005.02l.01.013l.104.074l.015.004l.012-.004l.104-.074l.012-.016l.004-.017l-.017-.427q-.004-.016-.017-.018m.265-.113l-.013.002l-.185.093l-.01.01l-.003.011l.018.43l.005.012l.008.007l.201.093q.019.005.029-.008l.004-.014l-.034-.614q-.005-.018-.02-.022m-.715.002a.02.02 0 0 0-.027.006l-.006.014l-.034.614q.001.018.017.024l.015-.002l.201-.093l.01-.008l.004-.011l.017-.43l-.003-.012l-.01-.01z"/><path fill="currentColor" d="M19.82 6a2 2 0 0 1 1.972 2.329l-1.666 10A2 2 0 0 1 18.153 20H5.847a2 2 0 0 1-1.973-1.671l-1.666-10A2 2 0 0 1 4.18 6ZM18 3a1 1 0 1 1 0 2H6a1 1 0 0 1 0-2Z"/></g></svg>`;

        const IMG_PLACEHOLDER = `<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24"><g fill="none"><path fill="currentColor" d="M20 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2zm0 2H4v10.1l4.995-4.994a1.25 1.25 0 0 1 1.768 0l4.065 4.066l1.238-1.238a1.25 1.25 0 0 1 1.768 0L20 15.101zm-4.5 2a1.5 1.5 0 1 1 0 3a1.5 1.5 0 0 1 0-3"/></g></svg>`;

        function buildBucketCard(b) {
            const vis = b.visibility || (b.isPublic ? 'public' : 'private');
            const badge = b.isDraft
                ? `<span class="shrink-0 text-[10px] font-semibold px-1.5 py-0.5 rounded-full bg-sky-50 text-sky-500">Draft</span>`
                : vis === 'public'
                    ? `<span class="shrink-0 text-[10px] font-semibold px-1.5 py-0.5 rounded-full bg-orchid-100 text-orchid-600">Public</span>`
                    : vis === 'unlisted'
                        ? `<span class="shrink-0 text-[10px] font-semibold px-1.5 py-0.5 rounded-full bg-amber-50 text-amber-500">Unlisted</span>`
                        : `<span class="shrink-0 text-[10px] font-semibold px-1.5 py-0.5 rounded-full bg-gray-100 text-gray-400">Private</span>`;
            const thumb = b.displayThumb
                ? `<img src="${escHtml(b.displayThumb)}" class="w-full aspect-square object-cover rounded-md" loading="lazy" onerror="this.style.display='none'">`
                : `<div class="w-full aspect-square bg-silver-100 rounded-md flex items-center justify-center text-gray-300">${IMG_PLACEHOLDER}</div>`;
            return `
                <div class="flex flex-col rounded-md bg-white border border-silver-100 cursor-pointer hover:shadow-md transition-shadow w-[calc(25%-9px)] shrink-0"
                    data-action="open-bucket" data-bucket-id="${escHtml(b._id)}">
                    <div class="px-3 pt-3 pb-3">${thumb}</div>
                    <div class="px-3 pt-1 pb-3 flex flex-col gap-0.5">
                        <div class="flex items-center gap-1">
                            <p class="font-medium text-base leading-snug truncate flex-1">${escHtml(b.name)}</p>
                            ${badge}
                        </div>
                    </div>
                </div>`;
        }

        function buildRepoCard(repo) {
            const buckets = getBucketsForRepo(repo._id);
            const card = document.createElement('div');
            card.className = 'bg-white border border-silver-100 rounded-xl overflow-hidden';
            card.dataset.repoId = repo._id;

            card.innerHTML = `
                <div class="flex items-center justify-between px-4 py-3.5 border-b border-silver-100">
                    <div class="flex items-center gap-2 min-w-0 flex-1 mr-3">
                        <span class="text-orchid-400 shrink-0">${BUCKET_ICON}</span>
                        <span class="repo-name-display font-semibold text-sm text-woodsmoke-900 truncate">${escHtml(repo.name)}</span>
                        <span class="repo-bucket-count text-xs bg-orchid-50 text-orchid-600 px-1.5 py-0.5 rounded-full shrink-0">${buckets.length}</span>
                    </div>
                    <div class="flex items-center gap-1.5 shrink-0">
                        <button data-action="rename" data-repo-id="${repo._id}"
                            class="h-7 px-3 flex items-center justify-center rounded-md text-xs font-semibold border border-silver-200 text-woodsmoke-600 hover:border-orchid-300 hover:text-orchid-600 transition-colors">Edit</button>
                        <button data-action="share" data-repo-id="${repo._id}"
                            class="h-7 px-3 flex items-center justify-center rounded-md text-xs font-semibold border border-silver-200 text-woodsmoke-600 hover:border-orchid-300 hover:text-orchid-600 transition-colors">Share</button>
                        <button data-action="delete" data-repo-id="${repo._id}"
                            class="h-7 px-3 flex items-center justify-center rounded-md text-xs font-semibold border border-silver-200 text-woodsmoke-600 hover:border-red-200 hover:text-red-500 transition-colors">Delete</button>
                    </div>
                </div>
                <div class="repo-inline-rename hidden px-4 py-3 border-b border-silver-100 flex items-center gap-2">
                    <input type="text" maxlength="80" placeholder="Repo name…"
                        class="repo-rename-input flex-1 px-3 py-1.5 rounded-md border border-silver-200 text-sm text-woodsmoke-950 outline-none focus:border-orchid-400 focus:ring-2 focus:ring-orchid-100 transition"/>
                    <button data-action="rename-save" data-repo-id="${repo._id}"
                        class="px-3 h-8 flex items-center justify-center bg-woodsmoke-950 text-white text-xs font-semibold rounded-md hover:bg-woodsmoke-800 transition-colors shrink-0">Save</button>
                    <button data-action="rename-cancel" data-repo-id="${repo._id}"
                        class="w-8 h-8 flex items-center justify-center rounded-md border border-silver-200 text-gray-400 hover:text-red-500 transition-colors shrink-0">✕</button>
                    <p class="repo-rename-error hidden text-xs text-red-500"></p>
                </div>
                <div class="repo-buckets-area p-4">
                    ${buckets.length === 0
                        ? `<p class="text-xs text-gray-400 italic">No buckets assigned yet. Open a bucket and pick this repo from the Settings tab.</p>`
                        : `<div class="flex gap-3 overflow-x-auto pb-1">${buckets.map(buildBucketCard).join('')}</div>`
                    }
                </div>`;

            return card;
        }

        // ── Helpers ────────────────────────────────────────────────────────
        function escHtml(str) {
            return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
        }

        function findCard(repoId) {
            return reposPanel.querySelector(`[data-repo-id="${repoId}"]`);
        }

        // ── Rename ─────────────────────────────────────────────────────────
        function startRename(repoId) {
            const card = findCard(repoId);
            if (!card) return;
            const repo = repos.find(r => String(r._id) === String(repoId));
            if (!repo) return;
            const inlineRow = card.querySelector('.repo-inline-rename');
            const input     = card.querySelector('.repo-rename-input');
            const errEl     = card.querySelector('.repo-rename-error');
            inlineRow.classList.remove('hidden');
            errEl.classList.add('hidden');
            input.value = repo.name;
            input.focus();
            input.select();
        }

        function cancelRename(repoId) {
            const card = findCard(repoId);
            if (!card) return;
            card.querySelector('.repo-inline-rename').classList.add('hidden');
        }

        async function saveRename(repoId) {
            const card  = findCard(repoId);
            if (!card) return;
            const input  = card.querySelector('.repo-rename-input');
            const errEl  = card.querySelector('.repo-rename-error');
            const saveBtn = card.querySelector('[data-action="rename-save"]');
            const name   = input.value.trim();

            if (!name) { errEl.textContent = 'Name cannot be empty.'; errEl.classList.remove('hidden'); return; }

            saveBtn.disabled = true;
            saveBtn.textContent = '…';
            errEl.classList.add('hidden');

            try {
                const res  = await fetch(`/api/repos/${repoId}`, {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify({ name }),
                });
                const data = await res.json();
                if (!res.ok) { errEl.textContent = data.error || 'Failed to rename.'; errEl.classList.remove('hidden'); return; }

                // Update local data + DOM
                const repo = repos.find(r => String(r._id) === String(repoId));
                if (repo) repo.name = data.name;
                const nameDisplay = card.querySelector('.repo-name-display');
                if (nameDisplay) nameDisplay.textContent = data.name;
                card.querySelector('.repo-inline-rename').classList.add('hidden');
            } catch (_) {
                errEl.textContent = 'Network error.';
                errEl.classList.remove('hidden');
            } finally {
                saveBtn.disabled = false;
                saveBtn.textContent = 'Save';
            }
        }

        // ── Delete ─────────────────────────────────────────────────────────
        async function handleDelete(repoId, btn) {
            if (btn.dataset.confirm !== 'yes') {
                btn.dataset.confirm = 'yes';
                btn.textContent = 'Confirm?';
                btn.classList.add('border-red-300', 'text-red-500');
                btn.classList.remove('border-silver-200', 'text-woodsmoke-600');
                setTimeout(() => {
                    if (btn.dataset.confirm === 'yes') {
                        btn.dataset.confirm = '';
                        btn.textContent = 'Delete';
                        btn.classList.remove('border-red-300', 'text-red-500');
                        btn.classList.add('border-silver-200', 'text-woodsmoke-600');
                    }
                }, 3500);
                return;
            }

            btn.disabled = true;
            btn.textContent = '…';
            try {
                const res = await fetch(`/api/repos/${repoId}`, { method: 'DELETE', credentials: 'include' });
                if (!res.ok) { btn.disabled = false; btn.textContent = 'Delete'; return; }

                ownBuckets.forEach(b => { if (b.repoId && String(b.repoId) === String(repoId)) b.repoId = null; });
                repos = repos.filter(r => String(r._id) !== String(repoId));
                updateTabCount();
                renderRepos();
            } catch (_) {
                btn.disabled = false;
                btn.textContent = 'Delete';
            }
        }

        // ── Share ───────────────────────────────────────────────────────────
        async function handleShare(repoId, btn) {
            const url = `${window.location.origin}/v2/o/${repoId}`;
            const orig = btn.textContent;
            if (navigator.share) {
                try { await navigator.share({ url }); } catch (_) {}
            } else {
                await navigator.clipboard.writeText(url).catch(() => {});
                btn.textContent = 'Copied!';
                setTimeout(() => { btn.textContent = orig; }, 2000);
            }
        }

        // ── Event delegation ────────────────────────────────────────────────
        reposPanel.addEventListener('click', function (e) {
            const btn = e.target.closest('[data-action]');
            if (!btn) return;
            const action   = btn.dataset.action;
            const repoId   = btn.dataset.repoId;
            const bucketId = btn.dataset.bucketId;

            if (action === 'rename')        startRename(repoId);
            if (action === 'rename-cancel') cancelRename(repoId);
            if (action === 'rename-save')   saveRename(repoId);
            if (action === 'delete')        handleDelete(repoId, btn);
            if (action === 'share')         handleShare(repoId, btn);
            if (action === 'open-bucket') {
                const bucket = ownBuckets.find(b => b._id === bucketId);
                if (bucket && window.openBucketModal) window.openBucketModal(bucket);
            }
        });

        reposPanel.addEventListener('keydown', function (e) {
            if (e.key !== 'Enter') return;
            const input = e.target.closest('.repo-rename-input');
            if (!input) return;
            const card  = input.closest('[data-repo-id]');
            if (card) saveRename(card.dataset.repoId);
        });

        // Initial render
        renderRepos();
    })();

    // ── Follow button ─────────────────────────────────────────────────────────
    const followBtn = document.getElementById('followBtn');
    if (followBtn) {
        const curatorAnonId = window.__PROFILE_ANON_ID__;

        function setFollowState(following) {
            followBtn.dataset.following = following ? '1' : '0';
            followBtn.disabled = false;
            followBtn.classList.remove('opacity-50', 'cursor-not-allowed', 'bg-red-50', 'text-red-600', 'border-red-200');
            if (following) {
                followBtn.textContent = 'Following';
                followBtn.classList.remove('bg-orchid-600', 'hover:bg-orchid-700', 'text-white');
                followBtn.classList.add('border', 'border-silver-200', 'text-woodsmoke-800');
            } else {
                followBtn.textContent = 'Follow';
                followBtn.classList.add('bg-orchid-600', 'hover:bg-orchid-700', 'text-white');
                followBtn.classList.remove('border', 'border-silver-200', 'text-woodsmoke-800');
            }
        }

        // Hover effect for "Following" → "Unfollow"
        followBtn.addEventListener('mouseenter', () => {
            if (followBtn.dataset.following !== '1') return;
            followBtn.textContent = 'Unfollow';
            followBtn.classList.add('bg-red-50', 'text-red-600', 'border-red-200');
            followBtn.classList.remove('text-woodsmoke-800', 'border-silver-200');
        });
        followBtn.addEventListener('mouseleave', () => {
            if (followBtn.dataset.following !== '1') return;
            followBtn.textContent = 'Following';
            followBtn.classList.remove('bg-red-50', 'text-red-600', 'border-red-200');
            followBtn.classList.add('text-woodsmoke-800', 'border-silver-200');
        });

        // Check initial follow state (unauthenticated users get the btn enabled immediately pointing to login)
        if (window.__PROFILE_VIEWER_AUTHED__) {
            fetch(`/api/users/${curatorAnonId}/subscribe`, { credentials: 'include' })
                .then(r => r.ok ? r.json() : null)
                .then(data => {
                    if (data) setFollowState(data.isSubscribed);
                    else { followBtn.disabled = false; followBtn.classList.remove('opacity-50', 'cursor-not-allowed'); }
                })
                .catch(() => { followBtn.disabled = false; followBtn.classList.remove('opacity-50', 'cursor-not-allowed'); });
        } else {
            followBtn.disabled = false;
            followBtn.classList.remove('opacity-50', 'cursor-not-allowed');
        }

        followBtn.addEventListener('click', async () => {
            if (!window.__PROFILE_VIEWER_AUTHED__) {
                window.location.href = '/v2/login';
                return;
            }
            const isFollowing = followBtn.dataset.following === '1';
            followBtn.disabled = true;
            followBtn.classList.add('opacity-50', 'cursor-not-allowed');
            try {
                const res = await fetch(`/api/users/${curatorAnonId}/subscribe`, {
                    method: isFollowing ? 'DELETE' : 'POST',
                    credentials: 'include',
                });
                if (res.ok) {
                    setFollowState(!isFollowing);
                    const subCountEl = document.querySelector('[data-stat="subscribers"]');
                    if (subCountEl) {
                        const current = parseInt(subCountEl.textContent.replace(/,/g, ''), 10) || 0;
                        subCountEl.textContent = (current + (isFollowing ? -1 : 1)).toLocaleString();
                    }
                } else {
                    followBtn.disabled = false;
                    followBtn.classList.remove('opacity-50', 'cursor-not-allowed');
                }
            } catch (_) {
                followBtn.disabled = false;
                followBtn.classList.remove('opacity-50', 'cursor-not-allowed');
            }
        });
    }

    // ── Direct message button ─────────────────────────────────────────────────
    const dmBtn = document.getElementById('dmBtn');
    if (dmBtn) {
        dmBtn.addEventListener('click', async () => {
            dmBtn.disabled = true;
            dmBtn.textContent = '…';
            try {
                // Send an empty probe message is wrong — instead navigate to messages
                // and let the user compose. But we need a conversationId first.
                // POST /api/dm/send with a placeholder triggers conversation creation
                // only on actual send, so we just navigate to messages with recipientId
                // as a query param so the inbox can open the right conversation or scaffold a new one.
                window.location.href = '/v2/messages?recipient=<%= profileUser._id %>&username=<%= profileUser.username %>';
            } catch (_) {
                dmBtn.disabled = false;
                dmBtn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"><g fill="none"><path fill="currentColor" d="M12 2c5.523 0 10 4.477 10 10s-4.477 10-10 10a9.96 9.96 0 0 1-4.644-1.142L3.31 21.97a1 1 0 0 1-1.282-1.282l1.114-4.044A9.96 9.96 0 0 1 2 12C2 6.477 6.477 2 12 2m0 2a8 8 0 0 0-6.992 11.923l.16.282l-1.005 3.646l3.646-1.005l.282.16A8 8 0 1 0 12 4m-3 7a1 1 0 1 1 0 2a1 1 0 0 1 0-2m3 0a1 1 0 1 1 0 2a1 1 0 0 1 0-2m3 0a1 1 0 1 1 0 2a1 1 0 0 1 0-2"/></g></svg> Message`;
            }
        });
    }

    // ── Share profile button ─────────────────────────────────────────────────
    const shareBtn = document.getElementById('shareProfileBtn');
    if (shareBtn) {
        shareBtn.addEventListener('click', async () => {
            const url = window.location.href;
            if (navigator.share) {
                try { await navigator.share({ title: '@<%= profileUser.username %> on Grabbn', url }); } catch (_) {}
            } else {
                await navigator.clipboard.writeText(url).catch(() => {});
                const orig = shareBtn.innerHTML;
                shareBtn.textContent = 'Link copied!';
                setTimeout(() => { shareBtn.innerHTML = orig; }, 2000);
            }
        });
    }

    // ── Card click: own buckets → edit modal, grabbed buckets → bucket page ──
    ['panelBuckets', 'panelGrabbed'].forEach(id => {
        const panel = document.getElementById(id);
        if (!panel) return;
        panel.querySelectorAll('[data-bucket-id]').forEach(card => {
            if (card.closest('[data-bucket-id]') !== card) return;
            card.style.cursor = 'pointer';
            card.addEventListener('click', e => {
                if (e.target.closest('.card-share-btn')) return;
                if (e.target.closest('a[href]')) return;
                if (id === 'panelBuckets' && isOwner && window.openBucketModal) {
                    const bucket = window.__PROFILE_OWN__?.find(b => b._id === card.dataset.bucketId);
                    if (bucket) { window.openBucketModal(bucket); return; }
                }
                window.location.href = `/v2/b/${card.dataset.bucketId}`;
            });
        });
    });

    // ── Shared sid generator ──────────────────────────────────────────────────
    function generateSid() {
        try {
            const arr = new Uint8Array(9);
            crypto.getRandomValues(arr);
            return Array.from(arr, b => b.toString(36).padStart(2, '0')).join('').slice(0, 12);
        } catch (_) {
            return Math.random().toString(36).slice(2, 10) + Date.now().toString(36).slice(-4);
        }
    }

    // ── Share button on bucket cards ──────────────────────────────────────────
    async function handleCardShare(btn) {
        if (btn.dataset.busy) return;
        btn.dataset.busy = '1';

        const bucketId = btn.dataset.bucketId;
        const url      = `${window.location.origin}/v2/b/${bucketId}?ref=share&sid=${generateSid()}`;
        const origHtml = btn.innerHTML;

        const showFeedback = () => {
            btn.innerHTML = '<span>Link copied!</span>';
            setTimeout(() => { btn.innerHTML = origHtml; delete btn.dataset.busy; }, 2000);
        };

        if (navigator.share) {
            try {
                await navigator.share({ url });
                delete btn.dataset.busy;
            } catch (_) {
                await navigator.clipboard.writeText(url).catch(() => {});
                showFeedback();
            }
        } else {
            await navigator.clipboard.writeText(url).catch(() => {});
            showFeedback();
        }
        fetch(`/api/buckets/${bucketId}/share`, { method: 'POST', credentials: 'include' }).catch(() => {});
    }

    document.querySelectorAll('.card-share-btn').forEach(btn => {
        btn.addEventListener('click', () => handleCardShare(btn));
    });

})();
</script>

<%- include('partials/layout-end') %>

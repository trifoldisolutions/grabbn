    function setFollowBtnState(btn, following) {
        btn.dataset.following = following ? '1' : '0';
        btn.classList.remove('opacity-50', 'cursor-not-allowed',
                             'bg-red-50', 'text-red-600', 'border-red-200',
                             'bg-orchid-600', 'hover:bg-orchid-700', 'text-white',
                             'border', 'border-silver-200', 'text-woodsmoke-800');
        if (following) {
            btn.textContent = 'Following';
            btn.classList.add('border', 'border-silver-200', 'text-woodsmoke-800');
        } else {
            btn.textContent = 'Follow';
            btn.classList.add('bg-orchid-600', 'hover:bg-orchid-700', 'text-white');
        }
    }

    function renderHeaderActions(other) {
        const actionsDiv = document.getElementById('chatHeaderActions');
        if (!actionsDiv || !other) return;

        const anonId = activeAnonId;
        const userId = esc(String(other._id));
        const uname  = esc(other.username || '');

        // Follow btn lives next to the user info, not in the actions strip
        const followSlot = document.getElementById('chatFollowSlot');
        if (followSlot) {
            followSlot.innerHTML = anonId
                ? `<button id="chatFollowBtn" data-following="0" data-anonid="${esc(anonId)}"
                        class="px-4 py-1.5 text-sm font-semibold rounded-md transition-colors bg-orchid-600 text-white hover:bg-orchid-700 opacity-50 cursor-not-allowed" disabled>
                        Follow
                   </button>`
                : '';
        }

        actionsDiv.innerHTML = `
            <button id="chatSearchBtn" title="Search messages"
                class="h-8 w-8 flex items-center justify-center rounded-md text-silver-400 hover:text-woodsmoke-700 hover:bg-silver-100 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><g fill="none" fill-rule="evenodd"><path fill="currentColor" d="M10.5 2a8.5 8.5 0 1 0 5.262 15.176l3.652 3.652a1 1 0 0 0 1.414-1.414l-3.652-3.652A8.5 8.5 0 0 0 10.5 2M4 10.5a6.5 6.5 0 1 1 13 0a6.5 6.5 0 0 1-13 0"/></g></svg>
            </button>
            <div class="relative">
                <button id="chatMoreBtn" title="More options"
                    class="h-8 w-8 flex items-center justify-center rounded-md text-silver-400 hover:text-woodsmoke-700 hover:bg-silver-100 transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"><g fill="none"><path d="m12.593 23.258l-.011.002l-.071.035l-.02.004l-.014-.004l-.071-.035q-.016-.005-.024.005l-.004.01l-.017.428l.005.02l.01.013l.104.074l.015.004l.012-.004l.104-.074l.012-.016l.004-.017l-.017-.427q-.004-.016-.017-.018m.265-.113l-.013.002l-.185.093l-.01.01l-.003.011l.018.43l.005.012l.008.007l.201.093q.019.005.029-.008l.004-.014l-.034-.614q-.005-.018-.02-.022m-.715.002a.02.02 0 0 0-.027.006l-.006.014l-.034.614q.001.018.017.024l.015-.002l.201-.093l.01-.008l.004-.011l.017-.43l-.003-.012l-.01-.01z"/><path fill="currentColor" d="M12 16.5a1.5 1.5 0 1 1 0 3a1.5 1.5 0 0 1 0-3m0-6a1.5 1.5 0 1 1 0 3a1.5 1.5 0 0 1 0-3m0-6a1.5 1.5 0 1 1 0 3a1.5 1.5 0 0 1 0-3"/></g></svg>
                </button>
                <div id="chatMoreMenu" class="hidden absolute right-0 top-full mt-1 bg-white rounded-xl shadow-lg border border-silver-100 py-1 z-50 w-48">
                    <button id="chatMuteBtn"
                        class="w-full flex items-center gap-2.5 px-4 py-2.5 text-sm text-woodsmoke-700 hover:bg-silver-50 transition-colors">
                        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24"><g fill="none"><path d="m12.593 23.258l-.011.002l-.071.035l-.02.004l-.014-.004l-.071-.035q-.016-.005-.024.005l-.004.01l-.017.428l.005.02l.01.013l.104.074l.015.004l.012-.004l.104-.074l.012-.016l.004-.017l-.017-.427q-.004-.016-.017-.018m.265-.113l-.013.002l-.185.093l-.01.01l-.003.011l.018.43l.005.012l.008.007l.201.093q.019.005.029-.008l.004-.014l-.034-.614q-.005-.018-.02-.022m-.715.002a.02.02 0 0 0-.027.006l-.006.014l-.034.614q.001.018.017.024l.015-.002l.201-.093l.01-.008l.004-.011l.017-.43l-.003-.012l-.01-.01z"/><path fill="currentColor" d="M13.26 3.3a1.1 1.1 0 0 1 1.734.78l.006.114v15.612a1.1 1.1 0 0 1-1.643.957l-.096-.062L6.68 16H4a2 2 0 0 1-1.995-1.85L2 14v-4a2 2 0 0 1 1.85-1.994L4 8h2.68zm4.326 5.872L19 10.586l1.414-1.414a1 1 0 1 1 1.414 1.414L20.414 12l1.414 1.414a1 1 0 0 1-1.414 1.415L19 13.414l-1.414 1.415a1 1 0 0 1-1.414-1.415L17.586 12l-1.414-1.414a1 1 0 1 1 1.414-1.414"/></g></svg>
                        <span id="chatMuteBtnLabel">${activeMuted ? 'Unmute Chat' : 'Mute Chat'}</span>
                    </button>
                    <div class="border-t border-silver-100 my-1"></div>
                    <button id="chatBlockBtn" data-userid="${userId}"
                        class="w-full flex items-center gap-2.5 px-4 py-2.5 text-sm text-woodsmoke-700 hover:bg-red-50 hover:text-red-500 transition-colors">
                        ${BLOCK_SVG} Block @${uname}
                    </button>
                    <button id="chatReportBtn" data-userid="${userId}"
                        class="w-full flex items-center gap-2.5 px-4 py-2.5 text-sm text-woodsmoke-700 hover:bg-red-50 hover:text-red-500 transition-colors">
                        ${REPORT_SVG} Report @${uname}
                    </button>
                </div>
            </div>`;

        // ── More menu toggle ────────────────────────────────────────────────
        const moreBtn  = document.getElementById('chatMoreBtn');
        const moreMenu = document.getElementById('chatMoreMenu');
        moreBtn?.addEventListener('click', (e) => {
            e.stopPropagation();
            moreMenu.classList.toggle('hidden');
        });
        document.addEventListener('click', function closeMore(e) {
            if (!moreMenu?.contains(e.target) && e.target !== moreBtn) {
                moreMenu?.classList.add('hidden');
            }
        }, { capture: true });

        // ── Mute ────────────────────────────────────────────────────────────
        document.getElementById('chatMuteBtn')?.addEventListener('click', async function () {
            moreMenu?.classList.add('hidden');
            const wasMuted = activeMuted;
            activeMuted = !wasMuted;
            // Update label immediately
            const label = document.getElementById('chatMuteBtnLabel');
            if (label) label.textContent = activeMuted ? 'Unmute Chat' : 'Mute Chat';
            // Update conversations state
            conversations = conversations.map(c =>
                String(c._id) === String(activeConvId) ? { ...c, isMuted: activeMuted } : c
            );
            try {
                await fetch(`/api/dm/${activeConvId}/mute`, {
                    method: activeMuted ? 'POST' : 'DELETE',
                });
            } catch (_) {
                // Revert on failure
                activeMuted = wasMuted;
                if (label) label.textContent = activeMuted ? 'Unmute Chat' : 'Mute Chat';
            }
        });

        // ── Follow ──────────────────────────────────────────────────────────
        const followBtn = document.getElementById('chatFollowBtn');
        if (followBtn && anonId) {
            // Fetch initial follow state
            fetch(`/api/users/${anonId}/subscribe`, { credentials: 'include' })
                .then(r => r.ok ? r.json() : null)
                .then(data => {
                    if (!followBtn.isConnected) return;
                    setFollowBtnState(followBtn, data?.subscribed || false);
                    followBtn.disabled = false;
                    followBtn.classList.remove('opacity-50', 'cursor-not-allowed');
                })
                .catch(() => {
                    if (!followBtn.isConnected) return;
                    followBtn.disabled = false;
                    followBtn.classList.remove('opacity-50', 'cursor-not-allowed');
                });

            followBtn.addEventListener('mouseenter', () => {
                if (followBtn.dataset.following !== '1') return;
                followBtn.textContent = 'Unfollow';
                followBtn.classList.add('bg-red-50', 'text-red-600', 'border-red-200');
                followBtn.classList.remove('text-woodsmoke-800', 'border-silver-200', 'bg-orchid-600', 'hover:bg-orchid-700', 'text-white');
            });
            followBtn.addEventListener('mouseleave', () => {
                if (followBtn.dataset.following !== '1') return;
                followBtn.textContent = 'Following';
                followBtn.classList.remove('bg-red-50', 'text-red-600', 'border-red-200');
                followBtn.classList.add('text-woodsmoke-800', 'border-silver-200');
            });
            followBtn.addEventListener('click', async () => {
                const isFollowing = followBtn.dataset.following === '1';
                followBtn.disabled = true;
                try {
                    const res = await fetch(`/api/users/${followBtn.dataset.anonid}/subscribe`, {
                        method: isFollowing ? 'DELETE' : 'POST',
                        credentials: 'include',
                    });
                    if (res.ok || res.status === 409) setFollowBtnState(followBtn, !isFollowing);
                } catch (_) {}
                followBtn.disabled = false;
            });
        }

        // ── Block ───────────────────────────────────────────────────────────
        document.getElementById('chatBlockBtn')?.addEventListener('click', async function () {
            moreMenu?.classList.add('hidden');
            if (!confirm(`Block @${other.username}? They won't be able to message you.`)) return;
            this.disabled = true;
            try {
                const res = await fetch(`/api/users/${this.dataset.userid}/block`, { method: 'POST' });
                if (res.ok) {
                    conversations = conversations.filter(c => String(c.otherUser._id) !== String(other._id));
                    renderConvList();
                    activeConvId = null;
                    history.pushState({}, '', '/v2/messages');
                    chatEmpty.classList.remove('hidden');
                    chatActive.classList.add('hidden');
                    chatActive.classList.remove('flex');
                    actionsDiv.innerHTML = '';
                }
            } catch (_) { this.disabled = false; }
        });

        // ── Report ──────────────────────────────────────────────────────────
        document.getElementById('chatReportBtn')?.addEventListener('click', function () {
            moreMenu?.classList.add('hidden');
            window.location.href = `/v2/report/${this.dataset.userid}`;
        });

        // ── Search button ────────────────────────────────────────────────────
        document.getElementById('chatSearchBtn')?.addEventListener('click', () => {
            openChatSearch();
        });
    }

    // ── Chat search ───────────────────────────────────────────────────────────
    const chatSearchBar   = document.getElementById('chatSearchBar');
    const chatSearchInput = document.getElementById('chatSearchInput');
    const chatSearchCount = document.getElementById('chatSearchCount');
    const chatSearchPrev  = document.getElementById('chatSearchPrev');
    const chatSearchNext  = document.getElementById('chatSearchNext');
    const chatSearchClose = document.getElementById('chatSearchClose');

    let searchMatches = [];   // array of { row, mark } elements
    let searchCursor  = -1;

    function openChatSearch() {
        chatSearchBar.classList.remove('hidden');
        chatSearchBar.classList.add('flex');
        chatSearchInput.value = '';
        chatSearchInput.focus();
        clearSearchHighlights();
    }

    function closeChatSearch() {
        chatSearchBar.classList.add('hidden');
        chatSearchBar.classList.remove('flex');
        chatSearchInput.value = '';
        clearSearchHighlights();
    }

    function clearSearchHighlights() {
        // Restore original text in every highlighted bubble
        messagesList.querySelectorAll('[data-msg-id] .msg-bubble-wrap mark.chat-match').forEach(mark => {
            const parent = mark.parentNode;
            parent.replaceChild(document.createTextNode(mark.textContent), mark);
            parent.normalize();
        });
        searchMatches = [];
        searchCursor  = -1;
        chatSearchCount.classList.add('hidden');
        chatSearchPrev.disabled = true;
        chatSearchNext.disabled = true;
    }

    function runSearch(q) {
        clearSearchHighlights();
        if (!q) return;

        const re = new RegExp(q.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'), 'gi');

        // Walk only text nodes inside bubble wrap divs
        messagesList.querySelectorAll('[data-msg-id] .msg-bubble-wrap').forEach(wrap => {
            highlightTextNodes(wrap, re);
        });

        searchMatches = Array.from(messagesList.querySelectorAll('mark.chat-match'));

        if (!searchMatches.length) {
            chatSearchCount.textContent = 'No results';
            chatSearchCount.classList.remove('hidden');
            chatSearchPrev.disabled = true;
            chatSearchNext.disabled = true;
            return;
        }

        chatSearchPrev.disabled = false;
        chatSearchNext.disabled = false;
        // Jump to the last (most recent visible) match
        searchCursor = searchMatches.length - 1;
        scrollToMatch(searchCursor);
        updateSearchCount();
    }

    function highlightTextNodes(root, re) {
        const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, {
            acceptNode(node) {
                // Skip inside <a> tags so links stay clickable
                if (node.parentElement.closest('a')) return NodeFilter.FILTER_REJECT;
                return NodeFilter.FILTER_ACCEPT;
            }
        });
        const hits = [];
        let node;
        while ((node = walker.nextNode())) {
            if (re.test(node.textContent)) hits.push(node);
            re.lastIndex = 0;
        }
        hits.forEach(textNode => {
            const frag = document.createDocumentFragment();
            let last = 0;
            let m;
            re.lastIndex = 0;
            const txt = textNode.textContent;
            while ((m = re.exec(txt)) !== null) {
                if (m.index > last) frag.appendChild(document.createTextNode(txt.slice(last, m.index)));
                const mark = document.createElement('mark');
                mark.className = 'chat-match bg-yellow-200 text-woodsmoke-900 rounded px-0.5 not-italic';
                mark.textContent = m[0];
                frag.appendChild(mark);
                last = m.index + m[0].length;
            }
            if (last < txt.length) frag.appendChild(document.createTextNode(txt.slice(last)));
            textNode.parentNode.replaceChild(frag, textNode);
        });
    }

    function scrollToMatch(idx) {
        // Remove active highlight from previous
        searchMatches.forEach(m => m.classList.remove('bg-orange-300'));
        const el = searchMatches[idx];
        if (!el) return;
        el.classList.add('bg-orange-300');
        el.scrollIntoView({ block: 'center', behavior: 'smooth' });
    }

    function updateSearchCount() {
        chatSearchCount.textContent = `${searchCursor + 1} / ${searchMatches.length}`;
        chatSearchCount.classList.remove('hidden');
    }

    let searchDebounce;
    chatSearchInput?.addEventListener('input', function () {
        clearTimeout(searchDebounce);
        searchDebounce = setTimeout(() => runSearch(this.value.trim()), 200);
    });

    chatSearchInput?.addEventListener('keydown', function (e) {
        if (e.key === 'Enter') {
            e.preventDefault();
            if (!searchMatches.length) return;
            if (e.shiftKey) {
                searchCursor = (searchCursor - 1 + searchMatches.length) % searchMatches.length;
            } else {
                searchCursor = (searchCursor + 1) % searchMatches.length;
            }
            scrollToMatch(searchCursor);
            updateSearchCount();
        } else if (e.key === 'Escape') {
            closeChatSearch();
        }
    });

    chatSearchPrev?.addEventListener('click', () => {
        if (!searchMatches.length) return;
        searchCursor = (searchCursor - 1 + searchMatches.length) % searchMatches.length;
        scrollToMatch(searchCursor);
        updateSearchCount();
    });

    chatSearchNext?.addEventListener('click', () => {
        if (!searchMatches.length) return;
        searchCursor = (searchCursor + 1) % searchMatches.length;
        scrollToMatch(searchCursor);
        updateSearchCount();
    });

    chatSearchClose?.addEventListener('click', closeChatSearch);

    // ── Conv list controls ────────────────────────────────────────────────────

    document.getElementById('markAllReadBtn')?.addEventListener('click', async function () {
        this.textContent = '…';
        this.disabled = true;
        try {
            await fetch('/api/dm/read-all', { method: 'POST' });
            conversations = conversations.map(c => ({ ...c, unreadCount: 0 }));
            renderConvList();
        } catch (_) {}
        this.textContent = 'Mark all as read';
        this.disabled = false;
    });

    document.getElementById('clearAllConvsBtn')?.addEventListener('click', async function () {
        await fetch('/api/dm/read-all', { method: 'POST' }).catch(() => {});
        conversations = [];
        renderConvList();
        if (activeConvId) {
            activeConvId = null;
            history.pushState({}, '', '/v2/messages');
            chatEmpty.classList.remove('hidden');
            chatActive.classList.add('hidden');
            chatActive.classList.remove('flex');
        }
    });

    // ── Real-time: incoming message ───────────────────────────────────────────

    window.addEventListener('grabbn:new_dm', function (e) {
        const detail = e.detail;

        // Update the conversation list in-place so we control ordering.
        // Muted conversations stay in their current position — no bubbling to top.
        const idx = conversations.findIndex(c => String(c._id) === detail.conversationId);
        if (idx !== -1) {
            const conv = { ...conversations[idx] };
            // Update preview + unread count
            conv.lastMessagePreview  = detail.preview || conv.lastMessagePreview;
            conv.lastMessageAt       = new Date().toISOString();
            conv.lastMessageSenderId = null; // incoming — not from me
            if (String(activeConvId) !== detail.conversationId) {
                conv.unreadCount = (conv.unreadCount || 0) + 1;
            }
            // Only bubble to top if NOT muted
            if (!conv.isMuted) {
                conversations.splice(idx, 1);
                conversations.unshift(conv);
            } else {
                conversations[idx] = conv;
            }
        } else {
            // New conversation — fall back to a full reload
            loadConversations();
            return;
        }
        renderConvList();

        // If we're already viewing this conversation, fetch and append the message
        if (detail.conversationId === String(activeConvId)) {
            fetch(`/api/dm/${activeConvId}/messages?limit=1`)
                .then(r => r.ok ? r.json() : null)
                .then(data => {
                    if (!data || !data.messages.length) return;
                    const latest = data.messages[data.messages.length - 1];
                    if (messagesList.querySelector(`[data-msg-id="${latest._id}"]`)) return;
                    const dk = msgDateKey(latest.createdAt);
                    if (dk !== lastRenderedDate) {
                        messagesList.appendChild(buildDateSeparator(latest.createdAt));
                        lastRenderedDate = dk;
                    }
                    messagesList.appendChild(buildBubble(latest));
                    scrollBottom(true);
                    fetch(`/api/dm/${activeConvId}/read`, { method: 'POST' }).catch(() => {});
                }).catch(() => {});
        }
    });

    // ── Real-time: recipient read our messages ────────────────────────────────

    window.addEventListener('grabbn:dm_read', function (e) {
        const { conversationId } = e.detail;
        // Flip every sent-status icon in the active conversation to the "read" (double-check) state
        if (activeConvId && String(activeConvId) === String(conversationId)) {
            messagesList.querySelectorAll('[data-msg-status]').forEach(el => {
                el.innerHTML = _readSvg;
                el.classList.remove('opacity-70');
                el.classList.add('opacity-100');
            });
        }
        // Update conversation list preview icon — works even if another conv is active
        conversations = conversations.map(c =>
            String(c._id) === String(conversationId) ? { ...c, otherUnreadCount: 0 } : c
        );
        renderConvList();
    });

    // ── Real-time: message deleted by either participant ─────────────────────

    window.addEventListener('grabbn:dm_deleted', function (e) {
        const { messageId, conversationId } = e.detail;
        // Remove from the active chat view if it's the open conversation
        if (String(activeConvId) === String(conversationId)) {
            const bubble = messagesList.querySelector(`[data-msg-id="${messageId}"]`);
            if (bubble) bubble.remove();
        }
        // Refresh conv list so the preview updates for everyone
        loadConversations();
    });

    // ── Real-time: message pinned ─────────────────────────────────────────────

    window.addEventListener('grabbn:dm_pinned', function (e) {
        const { conversationId, pinnedMessage } = e.detail;
        if (String(activeConvId) === String(conversationId)) {
            renderPinnedBanner(pinnedMessage);
        }
        // Keep conversations list in sync so re-opening shows the pin
        conversations = conversations.map(c =>
            String(c._id) === String(conversationId) ? { ...c, pinnedMessage } : c
        );
    });

    // ── Real-time: message unpinned ───────────────────────────────────────────

    window.addEventListener('grabbn:dm_unpinned', function (e) {
        const { conversationId } = e.detail;
        if (String(activeConvId) === String(conversationId)) {
            clearPinnedBanner();
        }
        conversations = conversations.map(c =>
            String(c._id) === String(conversationId) ? { ...c, pinnedMessage: null } : c
        );
    });

    // ── Real-time: presence change (other user online / offline) ─────────────

    window.addEventListener('grabbn:presence', function (e) {
        const { type, userId, lastSeenAt } = e.detail;
        // Only update the header if this event is about the person we're chatting with
        if (!activeOther || String(activeOther._id) !== String(userId)) return;
        const el = document.getElementById('chatStatusText');
        if (!el) return;
        if (type === 'user_online') {
            el.textContent = 'Online';
            el.className = 'text-[11px] text-emerald-500 leading-none';
            delete el.dataset.liveTime;
            delete el.dataset.livePrefix;
        } else {
            const ts = lastSeenAt || new Date().toISOString();
            el.textContent = 'Last seen just now';
            el.className = 'text-[11px] text-silver-400 leading-none';
            el.dataset.liveTime   = ts;
            el.dataset.livePrefix = 'Last seen ';
        }
    });

    // ── New-conversation compose (from profile DM button) ─────────────────────

    const params      = new URLSearchParams(location.search);
    const recipientId = params.get('recipient');
    const recipientUsername = params.get('username');

    if (recipientId) {
        // Clean URL
        history.replaceState({}, '', '/v2/messages');

        // Check if a conversation already exists
        loadConversations(function (convs) {
            const existing = convs.find(c => String(c.otherUser._id) === recipientId);
            if (existing) {
                openConversation(
                    String(existing._id),
                    { _id: String(existing.otherUser._id), username: existing.otherUser.username, avatar: existing.otherUser.avatar || null },
                    null
                );
            } else {
                showComposePanel();
            }
        });
    } else {
        // Normal load
        loadConversations(function () {
            // If an active conversation was set server-side, open it now
            if (activeConvId && activeOther) {
                openConversation(activeConvId, activeOther, M.context);
            }
        });
    }

    // ── Compose panel (new conversation, no existing conv) ───────────────────

    function showComposePanel() {
        const panel   = document.getElementById('composePanel');
        const toEl    = document.getElementById('composeTo');
        const input   = document.getElementById('composeInput');
        const sendB   = document.getElementById('composeSendBtn');
        const cancelB = document.getElementById('composeCancelBtn');
        const backdrop = document.getElementById('composeBackdrop');

        toEl.textContent = `New message to @${recipientUsername || recipientId}`;
        panel.classList.remove('hidden');
        input.focus();

        function hide() { panel.classList.add('hidden'); }

        cancelB.addEventListener('click', hide);
        backdrop.addEventListener('click', hide);

        sendB.addEventListener('click', function () {
            const body = input.value.trim();
            if (!body) return;
            sendB.disabled = true;
            fetch('/api/dm/send', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ recipientId, body }),
            })
            .then(r => r.ok ? r.json() : r.json().then(e => Promise.reject(e)))
            .then(data => {
                hide();
                loadConversations(function (convs) {
                    const c = convs.find(c => String(c._id) === String(data.conversationId));
                    if (c) openConversation(String(data.conversationId), c.otherUser, null);
                });
            })
            .catch(err => { alert(err?.error || 'Failed to send'); sendB.disabled = false; });
        });
    }

    // ── Hide DM dot — always suppressed while on messages page ───────────────
    const dmDot = document.getElementById('dmDot');
    if (dmDot) dmDot.classList.add('hidden');

})();
</script>

<%- include('partials/layout-end') %>

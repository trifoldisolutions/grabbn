<%
  page = 'messages'
%>
<%- include('partials/layout') %>
<style>
  /* Hide the mobile bottom nav only when the chat panel is active — the chat input replaces it */
  body.chat-open nav.fixed.bottom-0 { display: none !important; }
  /* Hide scrollbar in the messages area while keeping it scrollable */
  #messagesArea::-webkit-scrollbar { display: none; }
  #messagesArea { -ms-overflow-style: none; scrollbar-width: none; }
</style>
<script>
  // Tell the browser to resize the layout viewport when the keyboard opens,
  // not just the visual viewport. This keeps the header + input bar pinned
  // and only shrinks the scrollable messages area.
  (function () {
    const vp = document.querySelector('meta[name="viewport"]');
    if (vp) vp.content = 'width=device-width, initial-scale=1.0, interactive-widget=resizes-content';
  })();
  // If a conversation is already active on page load, mark body so the bottom nav hides immediately
  <% if (activeConversationId) { %>
  document.body.classList.add('chat-open');
  <% } %>
</script>

<script>
    window.__MSG__ = {
        activeConversationId: <%- JSON.stringify(activeConversationId || null) %>,
        currentUserId:        <%- JSON.stringify(String(user._id)) %>,
        otherUser:  <%- JSON.stringify(otherUser ? { _id: String(otherUser._id), username: otherUser.username || '', avatar: otherUser.avatar || null, anonymousId: otherUser.anonymousId || null } : null) %>,
        context:    <%- JSON.stringify(conversation && conversation.contextCommentId ? {
            commentId:    String(conversation.contextCommentId),
            body:         conversation.contextCommentBody || '',
            username:     conversation.contextCommentUsername || '',
            bucketId:     conversation.contextCommentBucketId ? String(conversation.contextCommentBucketId) : null,
            bucketName:   conversation.contextCommentBucketName || null,
        } : null) %>,
    };
</script>

<!-- ── Two-column messages layout ────────────────────────────────────────────── -->
<div class="flex flex-1 min-h-0 overflow-hidden" id="msgRoot">

    <!-- ── LEFT: Conversation list ─────────────────────────────────────────── -->
    <div id="convPanel"
         class="<%= activeConversationId ? 'hidden md:flex' : 'flex' %> w-full md:w-96 shrink-0 flex-col bg-white border-r border-silver-100 overflow-hidden">

        <!-- Panel header — search -->
        <div class="px-3 py-2.5 border-b border-silver-100 bg-white shrink-0">
            <div class="flex items-center gap-2 bg-silver-100 rounded-lg px-3 h-10">
                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" class="text-silver-400 shrink-0"><g fill="none" fill-rule="evenodd"><path fill="currentColor" d="M10.5 2a8.5 8.5 0 1 0 5.262 15.176l3.652 3.652a1 1 0 0 0 1.414-1.414l-3.652-3.652A8.5 8.5 0 0 0 10.5 2M4 10.5a6.5 6.5 0 1 1 13 0 6.5 6.5 0 0 1-13 0"/></g></svg>
                <input id="convSearch" type="text" placeholder="Search messages…"
                    class="flex-1 bg-transparent text-sm focus:outline-none placeholder-silver-400 min-w-0" />
                <button id="convSearchClear" class="hidden text-silver-400 hover:text-woodsmoke-500 transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24"><path fill="currentColor" d="m12 13.414 4.243 4.243a1 1 0 0 0 1.414-1.414L13.414 12l4.243-4.243a1 1 0 0 0-1.414-1.414L12 10.586 7.757 6.343a1 1 0 0 0-1.414 1.414L10.586 12l-4.243 4.243a1 1 0 1 0 1.414 1.414z"/></svg>
                </button>
            </div>
        </div>

        <!-- Panel controls — unread count + actions -->
        <div class="px-4 py-2 border-b border-silver-100 bg-white shrink-0 flex items-center justify-between gap-2 min-h-[2.25rem]">
            <span id="unreadTotalBadge" class="hidden text-xs font-semibold text-orchid-600 bg-orchid-50 rounded-full px-2 py-0.5 shrink-0"></span>
            <div class="flex items-center gap-4 ml-auto shrink-0">
                <button id="markAllReadBtn" class="text-xs text-silver-400 hover:text-woodsmoke-700 transition-colors whitespace-nowrap">Mark all as read</button>
                <button id="clearAllConvsBtn" class="text-xs text-silver-400 hover:text-red-400 transition-colors whitespace-nowrap">Clear all</button>
            </div>
        </div>

        <!-- Conversation items -->
        <div id="convList" class="flex-1 overflow-y-auto">
            <div class="py-8 text-center text-sm text-silver-400">Loading…</div>
        </div>
    </div>

    <!-- ── RIGHT: Chat area ─────────────────────────────────────────────────── -->
    <div id="chatPanel"
         class="<%= activeConversationId ? 'flex' : 'hidden md:flex' %> flex-1 min-h-0 flex-col overflow-hidden bg-silver-50">

        <!-- Empty state (no active conversation) -->
        <div id="chatEmpty" class="<%= activeConversationId ? 'hidden' : 'flex' %> flex-1 flex-col items-center justify-center gap-3 text-center px-8">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" class="text-silver-200"><g fill="none"><path fill="currentColor" d="M19 3a3 3 0 0 1 3 3v10a3 3 0 0 1-3 3h-3.697l-2.61 1.74c-.42.28-.966.28-1.386 0L8.697 19H5a3 3 0 0 1-3-3V6a3 3 0 0 1 3-3zM8.5 10a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3m7 0a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3"/></g></svg>
            <p class="text-sm text-silver-400">Select a conversation to start chatting.</p>
        </div>

        <!-- Active conversation (hidden until one is selected) -->
        <div id="chatActive" class="<%= activeConversationId ? 'flex' : 'hidden' %> flex-col flex-1 min-h-0 overflow-hidden">

            <!-- Chat header — full width of the right panel -->
            <div id="chatHeader" class="flex items-center gap-3 px-5 h-16 border-b border-silver-100 bg-white shrink-0">
                <!-- Back button — mobile only -->
                <button id="chatBackBtn" class="md:hidden p-1.5 -ml-1 rounded-md text-silver-400 hover:text-woodsmoke-700 hover:bg-silver-50 transition-colors shrink-0">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"><g fill="none"><path d="M24 0v24H0V0zM12.593 23.258l-.011.002l-.071.035l-.02.004l-.014-.004l-.071-.035q-.016-.005-.024.005l-.004.01l-.017.428l.005.02l.01.013l.104.074l.015.004l.012-.004l.104-.074l.012-.016l.004-.017l-.017-.427q-.004-.016-.017-.018m.265-.113l-.013.002l-.185.093l-.01.01l-.003.011l.018.43l.005.012l.008.007l.201.093q.019.005.029-.008l.004-.014l-.034-.614q-.005-.019-.02-.022m-.715.002a.02.02 0 0 0-.027.006l-.006.014l-.034.614q.001.018.017.024l.015-.002l.201-.093l.01-.008l.004-.011l.017-.43l-.003-.012l-.01-.01z"/><path fill="currentColor" d="M3.636 11.293a1 1 0 0 0 0 1.414l5.657 5.657a1 1 0 0 0 1.414-1.414L6.757 13H20a1 1 0 1 0 0-2H6.757l3.95-3.95a1 1 0 0 0-1.414-1.414z"/></g></svg>
                </button>
                <!-- Avatar + name + status -->
                <div id="chatHeaderUser" class="flex items-center gap-3 min-w-0 flex-1"></div>
                <!-- Action buttons -->
                <div id="chatHeaderActions" class="flex items-center gap-1.5 shrink-0"></div>
            </div>

            <!-- Pinned message banner -->
            <div id="pinnedMsgBanner" class="hidden items-center gap-3 px-4 py-2 border-b border-silver-100 bg-white shrink-0 cursor-pointer hover:bg-silver-50 transition-colors">
                <div id="pinnedMsgAvatar" class="shrink-0"></div>
                <div class="flex-1 min-w-0">
                    <p class="text-[10px] font-semibold text-orchid-500 leading-none mb-0.5">Pinned message</p>
                    <p id="pinnedMsgBody" class="text-xs text-woodsmoke-700 truncate"></p>
                </div>
                <button id="pinnedMsgUnpinBtn" title="Unpin"
                    class="shrink-0 p-1 rounded text-silver-400 hover:text-red-400 transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24"><g fill="none"><path fill="currentColor" d="M6.707 5.293a1 1 0 0 0-1.414 1.414L10.586 12l-5.293 5.293a1 1 0 1 0 1.414 1.414L12 13.414l5.293 5.293a1 1 0 0 0 1.414-1.414L13.414 12l5.293-5.293a1 1 0 0 0-1.414-1.414L12 10.586z"/></g></svg>
                </button>
            </div>

            <!-- Chat search bar — shown when user clicks the search icon -->
            <div id="chatSearchBar" class="hidden items-center gap-2 px-4 py-2 border-b border-silver-100 bg-white shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="text-silver-400 shrink-0" width="14" height="14" viewBox="0 0 24 24"><g fill="none" fill-rule="evenodd"><path fill="currentColor" d="M10.5 2a8.5 8.5 0 1 0 5.262 15.176l3.652 3.652a1 1 0 0 0 1.414-1.414l-3.652-3.652A8.5 8.5 0 0 0 10.5 2M4 10.5a6.5 6.5 0 1 1 13 0a6.5 6.5 0 0 1-13 0"/></g></svg>
                <input id="chatSearchInput" type="text" placeholder="Search messages…"
                    class="flex-1 text-sm bg-transparent focus:outline-none placeholder-silver-400 min-w-0" />
                <span id="chatSearchCount" class="text-xs text-silver-400 shrink-0 hidden"></span>
                <button id="chatSearchPrev" class="p-1 rounded text-silver-400 hover:text-woodsmoke-700 hover:bg-silver-100 transition-colors disabled:opacity-30" disabled>
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"><g fill="none"><path fill="currentColor" d="M11.293 7.293a1 1 0 0 1 1.414 0l6 6a1 1 0 0 1-1.414 1.414L12 9.414l-5.293 5.293a1 1 0 0 1-1.414-1.414z"/></g></svg>
                </button>
                <button id="chatSearchNext" class="p-1 rounded text-silver-400 hover:text-woodsmoke-700 hover:bg-silver-100 transition-colors disabled:opacity-30" disabled>
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"><g fill="none"><path fill="currentColor" d="M12.707 16.707a1 1 0 0 1-1.414 0l-6-6a1 1 0 0 1 1.414-1.414L12 14.586l5.293-5.293a1 1 0 0 1 1.414 1.414z"/></g></svg>
                </button>
                <button id="chatSearchClose" class="p-1 rounded text-silver-400 hover:text-woodsmoke-700 hover:bg-silver-100 transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"><g fill="none"><path fill="currentColor" d="M6.707 5.293a1 1 0 0 0-1.414 1.414L10.586 12l-5.293 5.293a1 1 0 1 0 1.414 1.414L12 13.414l5.293 5.293a1 1 0 0 0 1.414-1.414L13.414 12l5.293-5.293a1 1 0 0 0-1.414-1.414L12 10.586z"/></g></svg>
                </button>
            </div>

            <!-- Centering wrapper — caps messages + input at 75% on wide screens -->
            <div class="flex flex-col flex-1 min-h-0 overflow-hidden w-full xl:w-3/4 xl:mx-auto">

            <!-- Messages list -->
            <div id="messagesArea" class="flex-1 overflow-y-auto px-4 md:px-6 py-4 flex flex-col gap-1">
                <div id="loadMoreWrapper" class="hidden text-center pb-2">
                    <button id="loadMoreBtn" class="text-xs text-orchid-500 hover:text-orchid-700 transition-colors">Load earlier messages</button>
                </div>
                <div id="contextCard" class="hidden mx-auto w-full max-w-sm bg-orchid-50 border border-orchid-100 rounded-xl px-4 py-3 mb-2 text-xs text-woodsmoke-500"></div>
                <div id="messagesList" class="flex flex-col gap-1"></div>
                <div id="messagesLoading" class="py-8 text-center text-sm text-silver-400 flex justify-center w-full">
                    <span>
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"><circle cx="4" cy="12" r="3" fill="currentColor"><animate id="SVG9IgbRbsl" attributeName="r" begin="0;SVGFUNpCWdG.end-0.25s" dur="0.75s" values="3;.2;3"/></circle><circle cx="12" cy="12" r="3" fill="currentColor"><animate attributeName="r" begin="SVG9IgbRbsl.end-0.6s" dur="0.75s" values="3;.2;3"/></circle><circle cx="20" cy="12" r="3" fill="currentColor"><animate id="SVGFUNpCWdG" attributeName="r" begin="SVG9IgbRbsl.end-0.45s" dur="0.75s" values="3;.2;3"/></circle></svg>
                    </span>
                </div>
            </div>

            <!-- Input bar -->
            <div id="msgInputBar" class="shrink-0 border-t border-silver-100 px-4 md:px-6 py-3 bg-white">
                <!-- Context badge (shown when DM started from a comment) -->
                <div id="contextBadge" class="hidden mb-2 flex items-start gap-2 bg-orchid-50 border border-orchid-100 rounded-lg px-3 py-2.5">
                    <div class="flex-1 min-w-0">
                        <p class="text-xs text-orchid-500 font-medium mb-0.5">Replying to comment by <span id="ctxUsername" class="font-semibold"></span></p>
                        <p id="ctxBody" class="text-xs text-woodsmoke-500 truncate"></p>
                    </div>
                </div>
                <!-- Fake single-item input: textarea + send btn inside one styled container -->
                <div class="flex items-end gap-2 bg-silver-50 border border-silver-200 rounded-md px-3 py-2 focus-within:border-orchid-300 transition-colors">
                    <textarea
                        id="msgInput"
                        placeholder="Message… (u:user · b:bucket · paste a link)"
                        maxlength="350"
                        autocomplete="off"
                        rows="1"
                        class="flex-1 resize-none text-sm bg-transparent focus:outline-none placeholder-silver-400 leading-relaxed max-h-36 overflow-y-auto"
                    ></textarea>
                    <div class="flex items-center gap-2 shrink-0 self-end pb-0.5">
                        <span id="charCounter" class="hidden text-[10px] text-silver-400 pointer-events-none"></span>
                        <button id="sendBtn"
                            class="size-8 flex items-center justify-center bg-orchid-600 text-white rounded-md hover:bg-orchid-700 transition-colors disabled:opacity-50 disabled:cursor-not-allowed shrink-0">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path fill="currentColor" d="M3.478 2.405a.75.75 0 0 0-.926.94l2.432 7.905H13.5a.75.75 0 0 1 0 1.5H4.984l-2.432 7.905a.75.75 0 0 0 .926.94 60.519 60.519 0 0 0 18.445-8.986.75.75 0 0 0 0-1.218A60.517 60.517 0 0 0 3.478 2.405z"/></svg>
                        </button>
                    </div>
                </div>
            </div>

            </div><!-- /centering wrapper -->
        </div>
    </div>
</div>

<!-- ── New-conversation compose panel (shown when ?recipient= is set) ──────── -->
<div id="composePanel" class="hidden fixed inset-0 z-40 flex items-end md:items-center justify-center">
    <div class="absolute inset-0 bg-woodsmoke-950/30" id="composeBackdrop"></div>
    <div class="relative w-full max-w-md mx-4 bg-white rounded-2xl shadow-2xl border border-silver-100 p-5">
        <p class="text-sm font-semibold text-woodsmoke-900 mb-3" id="composeTo"></p>
        <textarea id="composeInput" placeholder="Write your first message…" maxlength="350" rows="3"
            class="w-full resize-none text-sm bg-silver-50 border border-silver-200 rounded-xl px-3.5 py-2.5 focus:outline-none focus:border-orchid-300 transition-colors placeholder-silver-400 leading-relaxed mb-3"></textarea>
        <div class="flex gap-2 justify-end">
            <button id="composeCancelBtn" class="px-4 py-2 text-sm rounded-lg border border-silver-200 text-woodsmoke-500 hover:bg-silver-50 transition-colors">Cancel</button>
            <button id="composeSendBtn" class="px-4 py-2 text-sm font-semibold bg-orchid-600 text-white rounded-lg hover:bg-orchid-700 transition-colors disabled:opacity-50">Send</button>
        </div>
    </div>
</div>

<script>
(function () {
    const M             = window.__MSG__;
    const me            = M.currentUserId;
    const convList      = document.getElementById('convList');
    const chatEmpty     = document.getElementById('chatEmpty');
    const chatActive    = document.getElementById('chatActive');
    const chatPanel     = document.getElementById('chatPanel');
    const convPanel     = document.getElementById('convPanel');
    const chatHeader    = document.getElementById('chatHeaderUser');
    const messagesList  = document.getElementById('messagesList');
    const messagesArea  = document.getElementById('messagesArea');
    const messagesLoading = document.getElementById('messagesLoading');
    const loadMoreBtn   = document.getElementById('loadMoreBtn');
    const loadMoreWrap  = document.getElementById('loadMoreWrapper');
    const msgInput      = document.getElementById('msgInput');
    const sendBtn       = document.getElementById('sendBtn');
    const charCounter   = document.getElementById('charCounter');
    const contextBadge  = document.getElementById('contextBadge');
    const contextCard   = document.getElementById('contextCard');
    const chatBackBtn   = document.getElementById('chatBackBtn');
    const convSearch    = document.getElementById('convSearch');
    const convSearchClear = document.getElementById('convSearchClear');

    // State
    let activeConvId   = M.activeConversationId;
    let activeOther    = M.otherUser;         // { _id, username, avatar, anonymousId }
    let activeAnonId   = M.otherUser?.anonymousId || null;
    let oldestDate        = null;
    let lastRenderedDate  = null;
    let hasMore           = false;
    let sending           = false;
    let contextSent    = false;
    let conversations  = [];
    let activeContext  = M.context;
    let activePinnedMsg = null; // { messageId, body, senderUsername, senderAvatar } | null
    let activeMuted     = false;

    // ── Helpers ──────────────────────────────────────────────────────────────

    const pinnedBanner     = document.getElementById('pinnedMsgBanner');
    const pinnedAvatarEl   = document.getElementById('pinnedMsgAvatar');
    const pinnedBodyEl     = document.getElementById('pinnedMsgBody');
    const pinnedUnpinBtn   = document.getElementById('pinnedMsgUnpinBtn');

    function renderPinnedBanner(pinned) {
        activePinnedMsg = pinned;
        if (!pinned || !pinnedBanner) return;
        const avatarHtml = pinned.senderAvatar
            ? `<img src="${esc(pinned.senderAvatar)}" class="w-7 h-7 rounded-full object-cover shrink-0" />`
            : `<div class="w-7 h-7 rounded-full bg-orchid-100 flex items-center justify-center shrink-0"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" class="text-orchid-500"><g fill="none"><path fill="currentColor" d="M12 13c2.396 0 4.575.694 6.178 1.672c.8.488 1.484 1.064 1.978 1.69c.486.615.844 1.351.844 2.138c0 .845-.411 1.511-1.003 1.986c-.56.45-1.299.748-2.084.956c-1.578.417-3.684.558-5.913.558s-4.335-.14-5.913-.558c-.785-.208-1.524-.506-2.084-.956C3.41 20.01 3 19.345 3 18.5c0-.787.358-1.523.844-2.139c.494-.625 1.177-1.2 1.978-1.69C7.425 13.695 9.605 13 12 13m0-11a5 5 0 1 1 0 10a5 5 0 0 1 0-10"/></g></svg></div>`;
        pinnedAvatarEl.innerHTML = avatarHtml;
        pinnedBodyEl.textContent = pinned.body;
        pinnedBanner.classList.remove('hidden');
        pinnedBanner.classList.add('flex');
    }

    function clearPinnedBanner() {
        activePinnedMsg = null;
        if (!pinnedBanner) return;
        pinnedBanner.classList.add('hidden');
        pinnedBanner.classList.remove('flex');
    }

    // Clicking the banner scrolls to the pinned message in the feed
    pinnedBanner?.addEventListener('click', function (e) {
        if (e.target.closest('#pinnedMsgUnpinBtn')) return;
        if (!activePinnedMsg) return;
        const el = messagesList.querySelector(`[data-msg-id="${activePinnedMsg.messageId}"]`);
        if (el) el.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });

    // Unpin button
    pinnedUnpinBtn?.addEventListener('click', async function (e) {
        e.stopPropagation();
        if (!activeConvId) return;
        try {
            await fetch(`/api/dm/${activeConvId}/pin`, { method: 'DELETE' });
            // WS event will update both sides; clear optimistically on our side too
            clearPinnedBanner();
        } catch (_) {}
    });

    function msgDateKey(dateStr) {
        const d = new Date(dateStr);
        return `${d.getFullYear()}-${d.getMonth()}-${d.getDate()}`;
    }

    function formatDateLabel(dateStr) {
        const d   = new Date(dateStr);
        const now = new Date();
        const todayStart = new Date(now.getFullYear(), now.getMonth(), now.getDate());
        const dayStart   = new Date(d.getFullYear(),   d.getMonth(),   d.getDate());
        const diffDays   = Math.round((todayStart - dayStart) / 86400000);
        if (diffDays === 0) return 'Today';
        if (diffDays === 1) return 'Yesterday';
        if (diffDays < 7)   return d.toLocaleDateString('en-US', { weekday: 'long' });
        if (d.getFullYear() === now.getFullYear())
            return d.toLocaleDateString('en-US', { month: 'long', day: 'numeric' });
        return d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
    }

    function buildDateSeparator(dateStr) {
        const el = document.createElement('div');
        el.className = 'flex items-center justify-center py-3';
        el.dataset.dateSep = msgDateKey(dateStr);
        el.innerHTML = `<span class="text-[11px] font-medium text-silver-500 bg-silver-100 rounded-full px-3 py-1">${formatDateLabel(dateStr)}</span>`;
        return el;
    }

    function esc(s) {
        return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    function formatTime(dateStr) {
        return new Date(dateStr).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
    }

    function timeAgo(dateStr) {
        const diff = Date.now() - new Date(dateStr).getTime();
        const m = Math.floor(diff / 60000);
        if (m < 1)  return 'just now';
        if (m < 60) return m + 'm ago';
        const h = Math.floor(m / 60);
        if (h < 24) return h + 'h ago';
        const d = Math.floor(h / 24);
        if (d < 7)  return d + 'd ago';
        return new Date(dateStr).toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
    }

    // ── Live time refresh — no DB calls, pure client-side recalculation ────────
    // Any element with data-live-time="<ISO>" gets its text refreshed every minute.
    // Optional data-live-prefix="Last seen " prepends a label.
    setInterval(() => {
        document.querySelectorAll('[data-live-time]').forEach(el => {
            const prefix = el.dataset.livePrefix || '';
            el.textContent = prefix + timeAgo(el.dataset.liveTime);
        });
    }, 60_000);

    function avatarEl(username, avatar, size) {
        const sz = size || 'w-10 h-10';
        if (avatar) return `<img src="${esc(avatar)}" alt="" class="${sz} rounded-full object-cover shrink-0">`;
        return `<div class="${sz} rounded-full bg-orchid-100 flex items-center justify-center shrink-0"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" class="text-orchid-600"><g fill="none"><path fill="currentColor" d="M12 13c2.396 0 4.575.694 6.178 1.672c.8.488 1.484 1.064 1.978 1.69c.486.615.844 1.351.844 2.138c0 .845-.411 1.511-1.003 1.986c-.56.45-1.299.748-2.084.956c-1.578.417-3.684.558-5.913.558s-4.335-.14-5.913-.558c-.785-.208-1.524-.506-2.084-.956C3.41 20.01 3 19.345 3 18.5c0-.787.358-1.523.844-2.139c.494-.625 1.177-1.2 1.978-1.69C7.425 13.695 9.605 13 12 13m0-11a5 5 0 1 1 0 10a5 5 0 0 1 0-10"/></g></svg></div>`;
    }

    function fmtCount(n) {
        if (n >= 1000000) return (n / 1000000).toFixed(1).replace(/\.0$/, '') + 'M';
        if (n >= 1000)    return (n / 1000).toFixed(1).replace(/\.0$/, '') + 'k';
        return String(n);
    }

    function renderBucketCard(entity, isMine, addTopBorder) {
        const s       = entity.snapshot || {};
        const name    = s.name || '';
        const count   = s.linkCount ?? 0;
        const paid    = s.isPaywalled || false;
        const tier    = paid ? (s.price > 0 ? `$${s.price}` : 'Paid') : 'Free';
        const tierBg  = paid ? 'bg-orchid-500' : 'bg-emerald-500';
        const IMG_ICON = `<svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" class="text-silver-400"><g fill="none"><path fill="currentColor" d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2zm0 2H5v14l4.293-4.293a1 1 0 0 1 1.32-.083l.094.083L12 16l3.293-3.293a1 1 0 0 1 1.32-.083l.094.083L19 15zm-4.5 2a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3"/></g></svg>`;
        const thumbHtml = s.thumbnail
            ? `<img src="${esc(s.thumbnail)}" alt="" class="w-full h-40 object-cover block">`
            : `<div class="w-full h-40 flex items-center justify-center bg-silver-200">${IMG_ICON}</div>`;
        const borderTop = addTopBorder
            ? (isMine ? 'border-t border-orchid-500' : 'border-t border-silver-200')
            : '';
        const footBg  = isMine ? '' : 'bg-white';
        const nameCls = isMine ? 'text-white' : 'text-woodsmoke-800';
        const metaCls = isMine ? 'text-white/50' : 'text-silver-400';

        // Curator row
        let curatorHtml = '';
        if (s.curator) {
            const { username, avatar } = s.curator;
            const avatarHtml = avatar
                ? `<img src="${esc(avatar)}" alt="" class="w-4 h-4 rounded-full object-cover shrink-0">`
                : `<span class="w-4 h-4 rounded-full flex items-center justify-center text-[9px] font-bold shrink-0 ${isMine ? 'bg-orchid-400 text-white' : 'bg-orchid-100 text-orchid-600'}">${esc((username[0] || '?').toUpperCase())}</span>`;
            const pub = s.publishedAt ? timeAgo(s.publishedAt) : null;
            const upd = s.updatedAt   ? timeAgo(s.updatedAt)   : null;
            const showUpd = upd && s.publishedAt && s.updatedAt &&
                Math.abs(new Date(s.publishedAt) - new Date(s.updatedAt)) > 60000;
            curatorHtml = `<div class="flex items-center gap-1 flex-wrap ${metaCls} text-[11px] mt-0.5">
                ${avatarHtml}
                <span class="${isMine ? 'text-white/70' : 'text-woodsmoke-500'} font-medium">@${esc(username)}</span>
                ${pub ? `<span>·</span><span>${esc(pub)}</span>` : ''}
                ${showUpd ? `<span>·</span><span>updated ${esc(upd)}</span>` : ''}
            </div>`;
        }

        // Stats row
        const views = fmtCount(s.viewCount || 0);
        const grabs = fmtCount(s.grabCount || 0);
        const ratingHtml = s.ratingAvg
            ? `<span>★ ${esc(String(s.ratingAvg))}</span><span>·</span>`
            : '';
        const statsHtml = `<div class="flex items-center gap-1.5 ${metaCls} text-[11px] mt-0.5">
            ${ratingHtml}
            <span>${views} views</span>
            <span>·</span>
            <span>${grabs} grabs</span>
        </div>`;

        return `<a href="/v2/bucket/${esc(entity.value)}" class="block ${borderTop}" style="text-decoration:none">
            <div class="relative">
                ${thumbHtml}
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/10 to-transparent flex flex-col justify-end px-2.5 pb-2">
                    <div class="flex items-center gap-1.5">
                        <span class="text-[10px] font-medium bg-black/50 text-white rounded px-1.5 py-0.5">${count} link${count !== 1 ? 's' : ''}</span>
                        <span class="text-[10px] font-semibold ${tierBg} text-white rounded px-1.5 py-0.5">${esc(tier)}</span>
                    </div>
                </div>
            </div>
            <div class="px-3 pt-2 pb-2.5 ${footBg}">
                <p class="text-[13px] font-semibold truncate ${nameCls}">${esc(name)}</p>
                ${curatorHtml}
                ${statsHtml}
            </div>
        </a>`;
    }

    function renderMsgBody(body, entities, isMine) {
        let out = esc(body);
        const all = (entities || []).slice().sort((a, b) => b.raw.length - a.raw.length);

        // Entity-based substitution: u: → chip with avatar, b: → inline link
        all.forEach(e => {
            const escapedRaw = esc(e.raw);
            if (e.type === 'mention') {
                const av = e.snapshot?.avatar;
                const avatarHtml = av
                    ? `<img src="${esc(av)}" alt="" class="w-5 h-5 rounded-full object-cover shrink-0">`
                    : `<span class="w-5 h-5 rounded-full flex items-center justify-center text-[10px] font-bold shrink-0 ${isMine ? 'bg-white/20 text-white' : 'bg-orchid-200 text-orchid-700'}">${esc((e.value[0] || '?').toUpperCase())}</span>`;
                const chipCls = isMine
                    ? 'bg-white/15 hover:bg-white/25 text-white'
                    : 'bg-orchid-50 hover:bg-orchid-100 text-orchid-700';
                out = out.split(escapedRaw).join(
                    `<a href="/v2/u/${esc(e.value)}" class="inline-flex items-center gap-1 ${chipCls} rounded-full pl-0.5 pr-2 py-0.5 align-middle transition-colors" style="text-decoration:none">${avatarHtml}<span class="text-xs font-semibold leading-none">@${esc(e.value)}</span></a>`
                );
            } else if (e.type === 'bucket_ref') {
                // Strip from inline text — the card below is the visual representation
                out = out.split(escapedRaw).join('');
            }
        });

        // Fallback: any u: not resolved to an entity (user not found)
        out = out.replace(/\bu:([a-zA-Z0-9_]{1,30})/g, (_, u) =>
            `<a href="/v2/u/${esc(u)}" class="underline underline-offset-2 opacity-90">u:${esc(u)}</a>`);
        // Fallback: raw URLs
        out = out.replace(/(https?:\/\/[^\s<]+)/g, url =>
            `<a href="${esc(url)}" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2 opacity-90 break-all">${esc(url)}</a>`);

        const bucketRefs = (entities || []).filter(e => e.type === 'bucket_ref');
        const hasText = !!out.trim();
        const cardsHtml = bucketRefs.map((e, i) =>
            renderBucketCard(e, isMine, hasText || i > 0)
        ).join('');
        return { textHtml: out, cardsHtml };
    }

    // ── Chat header ──────────────────────────────────────────────────────────

    function renderChatHeader(other, statusText) {
        if (!other) { chatHeader.innerHTML = ''; return; }
        const statusHtml = statusText !== undefined
            ? `<span id="chatStatusText" class="text-[11px] ${statusText === 'Online' ? 'text-emerald-500' : 'text-silver-400'} leading-none">${esc(statusText)}</span>`
            : `<span id="chatStatusText" class="text-[11px] text-silver-300 leading-none">—</span>`;
        chatHeader.innerHTML = `
            <div class="flex items-center gap-6 min-w-0 flex-1">
                <a href="/v2/u/${esc(other.username)}" class="flex items-center gap-3 min-w-0 hover:opacity-80 transition-opacity shrink-0">
                    ${avatarEl(other.username, other.avatar, 'w-11 h-11')}
                    <div class="flex flex-col gap-1 min-w-0">
                        <span class="font-semibold leading-none truncate">@${esc(other.username)}</span>
                        ${statusHtml}
                    </div>
                </a>
                <div id="chatFollowSlot" class="shrink-0"></div>
            </div>`;
    }

    function fetchAndSetStatus(other) {
        if (!other?._id) return;
        fetch(`/api/users/${esc(other._id)}/online-status`)
            .then(r => r.ok ? r.json() : null)
            .then(data => {
                if (!data) return;
                const el = document.getElementById('chatStatusText');
                if (!el) return;
                if (data.online) {
                    el.textContent = 'Online';
                    el.className = 'text-[11px] text-emerald-500 leading-none';
                    delete el.dataset.liveTime;
                    delete el.dataset.livePrefix;
                } else if (data.lastSeenAt) {
                    el.textContent = 'Last seen ' + timeAgo(data.lastSeenAt);
                    el.className = 'text-[11px] text-silver-400 leading-none';
                    el.dataset.liveTime   = data.lastSeenAt;
                    el.dataset.livePrefix = 'Last seen ';
                } else {
                    el.textContent = 'Offline';
                    el.className = 'text-[11px] text-silver-400 leading-none';
                    delete el.dataset.liveTime;
                    delete el.dataset.livePrefix;
                }
            }).catch(() => {});
    }

    // ── Conversation list ─────────────────────────────────────────────────────

    function renderConvItem(c, isActive) {
        const unread   = c.unreadCount || 0;
        const preview  = (c.lastMessagePreview || '').slice(0, 55);
        const active   = isActive ? 'bg-white border-r-2 border-r-orchid-500' : (unread ? 'bg-orchid-50' : '');
        const isMySent = c.lastMessageSenderId && String(c.lastMessageSenderId) === me;
        const isRead   = isMySent && !(c.otherUnreadCount > 0);

        let previewContent;
        if (isMySent) {
            const iconCls = isRead ? 'text-orchid-400' : 'text-silver-400';
            const icon    = isRead ? _readSvg : _sentSvg;
            const txtCls  = unread ? 'font-medium text-woodsmoke-700' : 'text-silver-500';
            previewContent = `
                <span class="text-xs truncate flex-1 ${txtCls}">You: ${esc(preview)}</span>
                <span class="shrink-0 flex items-center ${iconCls}">${icon}</span>`;
        } else {
            previewContent = `<span class="text-xs truncate flex-1 ${unread ? 'font-medium text-woodsmoke-700' : 'text-silver-500'}">${preview || '<span class="italic text-silver-400">No messages yet</span>'}</span>`;
        }

        const MUTE_ICON = `<svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" class="text-silver-400 shrink-0"><g fill="none"><path fill="currentColor" d="M13.26 3.3a1.1 1.1 0 0 1 1.734.78l.006.114v15.612a1.1 1.1 0 0 1-1.643.957l-.096-.062L6.68 16H4a2 2 0 0 1-1.995-1.85L2 14v-4a2 2 0 0 1 1.85-1.994L4 8h2.68zm4.326 5.872L19 10.586l1.414-1.414a1 1 0 1 1 1.414 1.414L20.414 12l1.414 1.414a1 1 0 0 1-1.414 1.415L19 13.414l-1.414 1.415a1 1 0 0 1-1.414-1.415L17.586 12l-1.414-1.414a1 1 0 1 1 1.414-1.414"/></g></svg>`;

        return `
        <button class="w-full flex items-center gap-3 px-4 py-3.5 hover:bg-white transition-colors text-left group conv-item ${active}"
                data-conv-id="${esc(String(c._id))}"
                data-other-id="${esc(String(c.otherUser._id))}"
                data-other-username="${esc(c.otherUser.username)}"
                data-other-avatar="${esc(c.otherUser.avatar || '')}"
                data-other-anon-id="${esc(c.otherUser.anonymousId || '')}">
            ${avatarEl(c.otherUser.username, c.otherUser.avatar)}
            <div class="flex-1 min-w-0">
                <div class="flex items-baseline justify-between gap-1">
                    <div class="flex items-center gap-1 min-w-0">
                        <span class="font-semibold text-sm truncate ${unread ? 'text-woodsmoke-900' : 'text-woodsmoke-700'}">@${esc(c.otherUser.username)}</span>
                        ${c.isMuted ? MUTE_ICON : ''}
                    </div>
                    <span data-live-time="${c.lastMessageAt}" class="text-[10px] text-silver-400 shrink-0">${timeAgo(c.lastMessageAt)}</span>
                </div>
                <div class="flex items-center gap-1.5 mt-0.5">
                    ${previewContent}
                    ${unread ? `<span class="shrink-0 min-w-[1.1rem] h-[1.1rem] rounded-full bg-orchid-600 text-white text-[9px] font-bold flex items-center justify-center px-1">${unread > 9 ? '9+' : unread}</span>` : ''}
                </div>
            </div>
        </button>`;
    }

    function renderConvList(query) {
        const q = (query || convSearch?.value || '').trim().toLowerCase();
        const filtered = q
            ? conversations.filter(c => c.otherUser.username.toLowerCase().includes(q) || (c.lastMessagePreview || '').toLowerCase().includes(q))
            : conversations;

        if (!filtered.length) {
            convList.innerHTML = `
                <div class="flex flex-col items-center justify-center py-12 gap-2 px-4 text-center">
                    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" class="text-silver-300"><g fill="none"><path fill="currentColor" d="M19 3a3 3 0 0 1 3 3v10a3 3 0 0 1-3 3h-3.697l-2.61 1.74c-.42.28-.966.28-1.386 0L8.697 19H5a3 3 0 0 1-3-3V6a3 3 0 0 1 3-3zM8.5 10a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3m7 0a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3"/></g></svg>
                    <p class="text-xs text-silver-400">${q ? 'No results.' : 'No conversations yet.'}</p>
                </div>`;
            return;
        }
        convList.innerHTML = filtered
            .map(c => renderConvItem(c, String(c._id) === String(activeConvId)))
            .join('');
        updateUnreadTotal();
    }

    function updateUnreadTotal() {
        const badge = document.getElementById('unreadTotalBadge');
        if (!badge) return;
        const count = conversations.filter(c => (c.unreadCount || 0) > 0).length;
        if (count > 0) {
            badge.textContent = count + ' unread';
            badge.classList.remove('hidden');
        } else {
            badge.classList.add('hidden');
        }
    }

    // ── Search ────────────────────────────────────────────────────────────────
    if (convSearch) {
        convSearch.addEventListener('input', function () {
            const q = this.value.trim();
            convSearchClear.classList.toggle('hidden', !q);
            renderConvList();
        });
        convSearchClear.addEventListener('click', function () {
            convSearch.value = '';
            this.classList.add('hidden');
            renderConvList();
            convSearch.focus();
        });
    }

    function loadConversations(cb) {
        fetch('/api/dm/conversations')
            .then(r => r.ok ? r.json() : null)
            .then(data => {
                if (data) {
                    conversations = data.conversations;
                    renderConvList();
                    if (cb) cb(conversations);
                }
            }).catch(() => {});
    }

    // ── Message status icon (sent / seen) ────────────────────────────────────

    const _sentSvg = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><g fill="none" fill-rule="evenodd"><path d="m12.593 23.258l-.011.002l-.071.035l-.02.004l-.014-.004l-.071-.035q-.016-.005-.024.005l-.004.01l-.017.428l.005.02l.01.013l.104.074l.015.004l.012-.004l.104-.074l.012-.016l.004-.017l-.017-.427q-.004-.016-.017-.018m.265-.113l-.013.002l-.185.093l-.01.01l-.003.011l.018.43l.005.012l.008.007l.201.093q.019.005.029-.008l.004-.014l-.034-.614q-.005-.018-.02-.022m-.715.002a.02.02 0 0 0-.027.006l-.006.014l-.034.614q.001.018.017.024l.015-.002l.201-.093l.01-.008l.004-.011l.017-.43l-.003-.012l-.01-.01z"/><path fill="currentColor" d="M21.192 5.465a1 1 0 0 1 0 1.414L9.95 18.122a1.1 1.1 0 0 1-1.556 0l-5.586-5.586a1 1 0 1 1 1.415-1.415l4.95 4.95L19.777 5.465a1 1 0 0 1 1.414 0Z"/></g></svg>`;
    const _readSvg = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><g fill="none"><path d="m12.594 23.258l-.012.002l-.071.035l-.02.004l-.014-.004l-.071-.036q-.016-.004-.024.006l-.004.01l-.017.428l.005.02l.01.013l.104.074l.015.004l.012-.004l.104-.074l.012-.016l.004-.017l-.017-.427q-.004-.016-.016-.018m.264-.113l-.014.002l-.184.093l-.01.01l-.003.011l.018.43l.005.012l.008.008l.201.092q.019.005.029-.008l.004-.014l-.034-.614q-.005-.019-.02-.022m-.715.002a.02.02 0 0 0-.027.006l-.006.014l-.034.614q.001.018.017.024l.015-.002l.201-.093l.01-.008l.003-.011l.018-.43l-.003-.012l-.01-.01z"/><path fill="currentColor" d="M2.222 11.121a1 1 0 0 1 1.32-.083l.094.083l4.242 4.243a1 1 0 0 1-1.32 1.497l-.094-.083l-4.242-4.242a1 1 0 0 1 0-1.415m20.556-5.656a1 1 0 0 1 .083 1.32l-.083.094l-9.829 9.828a1.1 1.1 0 0 1-1.46.086l-.096-.085l-4.171-4.172a1 1 0 0 1 1.32-1.498l.094.083l3.535 3.536l9.193-9.192a1 1 0 0 1 1.414 0m-5 0a1 1 0 0 1 .083 1.32l-.083.094l-4.95 4.95a1 1 0 0 1-1.497-1.32l.083-.095l4.95-4.95a1 1 0 0 1 1.414 0Z"/></g></svg>`;

    function msgStatusHtml(msg, isMine) {
        if (!isMine) return '';
        const isRead = !!msg.readAt;
        return `<span data-msg-status class="inline-flex items-center text-white ${isRead ? 'opacity-100' : 'opacity-70'}">${isRead ? _readSvg : _sentSvg}</span>`;
    }

    // ── Message bubble ────────────────────────────────────────────────────────

    function buildBubble(msg) {
        const isMine = String(msg.senderId) === me;
        const el = document.createElement('div');
        el.className = `flex flex-col ${isMine ? 'items-end' : 'items-start'}`;
        el.dataset.msgId   = String(msg._id);
        el.dataset.msgBody = msg.body;
        el.dataset.isMine  = isMine ? '1' : '';

        const bubbleCls = isMine
            ? 'bg-orchid-600 text-white rounded-2xl rounded-br-sm'
            : 'bg-silver-100 text-woodsmoke-800 rounded-2xl rounded-bl-sm';

        const timeCls = isMine ? 'text-white/60' : 'text-silver-400';
        const { textHtml, cardsHtml } = renderMsgBody(msg.body, msg.entities, isMine);
        const hasCards = !!cardsHtml;
        const hasText  = !!textHtml.trim();

        el.innerHTML = `
            <div class="msg-bubble-wrap max-w-[72%] cursor-pointer select-none">
                <div class="${bubbleCls} text-sm leading-relaxed overflow-hidden">
                    ${hasText || !hasCards ? `<div class="px-3.5 pt-2 ${hasCards ? 'pb-1' : 'pb-1.5 flex items-end gap-2'}">
                        <span class="${hasCards ? 'break-words' : 'flex-1 break-words'}">${textHtml}</span>
                        ${!hasCards ? `<span class="text-[10px] ${timeCls} shrink-0 leading-none mb-0.5 flex items-center gap-0.5">${formatTime(msg.createdAt)}${msgStatusHtml(msg, isMine)}</span>` : ''}
                    </div>` : ''}
                    ${hasCards ? cardsHtml : ''}
                    ${hasCards ? `<div class="flex justify-end px-3.5 pt-1 pb-1.5"><span class="text-[10px] ${timeCls} flex items-center gap-0.5">${formatTime(msg.createdAt)}${msgStatusHtml(msg, isMine)}</span></div>` : ''}
                </div>
            </div>`;
        return el;
    }

    // ── Bubble action bar (Copy / Delete / Report) ────────────────────────────
    (function () {
        let activeActionBar = null;

        function closeActionBar() {
            if (activeActionBar) {
                activeActionBar.remove();
                activeActionBar = null;
            }
        }

        messagesArea.addEventListener('click', function (e) {
            const wrap = e.target.closest('.msg-bubble-wrap');

            // Clicking outside any bubble closes the open bar
            if (!wrap) { closeActionBar(); return; }

            // Clicking a link inside the bubble — don't intercept
            if (e.target.closest('a')) return;

            const row    = wrap.closest('[data-msg-id]');
            const msgId  = row?.dataset?.msgId;
            const body   = row?.dataset?.msgBody || '';
            const isMine = row?.dataset?.isMine === '1';

            // If this bubble is already open, toggle it closed
            if (activeActionBar && activeActionBar.closest('[data-msg-id]') === row) {
                closeActionBar();
                return;
            }

            closeActionBar();

            const bar = document.createElement('div');
            bar.className = 'msg-action-bar flex items-center gap-1 mt-1 mb-0.5 animate-fade-in';

            const btnBase = 'text-[11px] font-medium px-2 py-0.5 transition-colors whitespace-nowrap';

            // Copy — always shown
            const copyBtn = document.createElement('button');
            copyBtn.className = `${btnBase} text-woodsmoke-500 hover:text-woodsmoke-900`;
            copyBtn.textContent = 'Copy';
            copyBtn.addEventListener('click', (ev) => {
                ev.stopPropagation();
                navigator.clipboard.writeText(body).catch(() => {});
                copyBtn.textContent = 'Copied!';
                setTimeout(() => closeActionBar(), 1200);
            });

            bar.appendChild(copyBtn);

            // Pin / Unpin
            const isAlreadyPinned = activePinnedMsg?.messageId === msgId;
            const pinBtn = document.createElement('button');
            pinBtn.className = `${btnBase} ${isAlreadyPinned ? 'text-orchid-500 hover:text-orchid-700' : 'text-woodsmoke-500 hover:text-woodsmoke-900'}`;
            pinBtn.textContent = isAlreadyPinned ? 'Unpin' : 'Pin';
            pinBtn.addEventListener('click', async (ev) => {
                ev.stopPropagation();
                pinBtn.disabled = true;
                pinBtn.textContent = '…';
                try {
                    if (isAlreadyPinned) {
                        await fetch(`/api/dm/${activeConvId}/pin`, { method: 'DELETE' });
                        clearPinnedBanner();
                    } else {
                        const res = await fetch(`/api/dm/${activeConvId}/pin`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ messageId: msgId }),
                        });
                        if (res.ok) {
                            const data = await res.json();
                            renderPinnedBanner(data.pinnedMessage);
                        }
                    }
                    closeActionBar();
                } catch (_) {
                    pinBtn.textContent = isAlreadyPinned ? 'Unpin' : 'Pin';
                    pinBtn.disabled = false;
                }
            });
            bar.appendChild(pinBtn);

            // Delete — only for own messages
            if (isMine) {
                const delBtn = document.createElement('button');
                delBtn.className = `${btnBase} text-red-400 hover:text-red-600`;
                delBtn.textContent = 'Delete';
                delBtn.addEventListener('click', async (ev) => {
                    ev.stopPropagation();
                    delBtn.textContent = '…';
                    delBtn.disabled = true;
                    try {
                        const res = await fetch(`/api/dm/message/${msgId}`, { method: 'DELETE' });
                        if (res.ok) {
                            row.remove();
                        } else {
                            delBtn.textContent = 'Error';
                            setTimeout(() => closeActionBar(), 1500);
                        }
                    } catch (_) {
                        delBtn.textContent = 'Error';
                        setTimeout(() => closeActionBar(), 1500);
                    }
                });
                bar.appendChild(delBtn);
            }

            // Report — only for others' messages
            if (!isMine) {
                const repBtn = document.createElement('button');
                repBtn.className = `${btnBase} text-gray-400 hover:text-woodsmoke-700`;
                repBtn.textContent = 'Report';
                repBtn.addEventListener('click', (ev) => {
                    ev.stopPropagation();
                    // TODO: hook into your report flow
                    repBtn.textContent = 'Reported';
                    repBtn.disabled = true;
                    setTimeout(() => closeActionBar(), 1500);
                });
                bar.appendChild(repBtn);
            }

            activeActionBar = bar;
            row.appendChild(bar);
        });

        // Close only when sending a new message
        document.getElementById('sendBtn')?.addEventListener('click', closeActionBar);
    })();

    function scrollBottom(smooth) {
        messagesArea.scrollTo({ top: messagesArea.scrollHeight, behavior: smooth ? 'smooth' : 'instant' });
    }

    // ── Load messages ─────────────────────────────────────────────────────────

    function renderContextCard() {
        if (!activeContext) return;
        const ctx = activeContext;
        contextCard.classList.remove('hidden');
        contextCard.innerHTML = `
            <p class="font-medium text-orchid-500 mb-1">
                Comment by <a href="/v2/u/${esc(ctx.username)}" class="hover:underline">@${esc(ctx.username)}</a>
                ${ctx.bucketName ? ` in <a href="/v2/bucket/${esc(ctx.bucketId)}" class="hover:underline">${esc(ctx.bucketName)}</a>` : ''}
            </p>
            <p class="text-woodsmoke-500">${esc(ctx.body)}</p>`;
    }

    function loadMessages(before) {
        const url = `/api/dm/${activeConvId}/messages?limit=30` + (before ? `&before=${encodeURIComponent(before)}` : '');
        return fetch(url)
            .then(r => r.ok ? r.json() : null)
            .then(data => {
                if (!data) return;
                messagesLoading.classList.add('hidden');

                const isPrepend = !!before;
                const prevH = messagesArea.scrollHeight;

                if (!isPrepend) renderContextCard();

                if (isPrepend) {
                    // Build a fragment (oldest→newest) with date separators, then prepend.
                    const frag = document.createDocumentFragment();
                    let lastGroupDate = null;
                    data.messages.forEach(msg => {
                        const dk = msgDateKey(msg.createdAt);
                        if (dk !== lastGroupDate) {
                            frag.appendChild(buildDateSeparator(msg.createdAt));
                            lastGroupDate = dk;
                        }
                        frag.appendChild(buildBubble(msg));
                    });
                    // If the first existing separator shares the same date as the last
                    // prepended group, remove the duplicate before inserting.
                    const firstExisting = messagesList.firstElementChild;
                    if (firstExisting?.dataset?.dateSep === lastGroupDate) {
                        firstExisting.remove();
                    }
                    messagesList.insertBefore(frag, messagesList.firstChild);
                } else {
                    data.messages.forEach(msg => {
                        const dk = msgDateKey(msg.createdAt);
                        if (dk !== lastRenderedDate) {
                            messagesList.appendChild(buildDateSeparator(msg.createdAt));
                            lastRenderedDate = dk;
                        }
                        messagesList.appendChild(buildBubble(msg));
                    });
                }

                if (data.messages.length) oldestDate = data.messages[0].createdAt;
                hasMore = data.hasMore;
                loadMoreWrap.classList.toggle('hidden', !hasMore);

                if (isPrepend) messagesArea.scrollTop = messagesArea.scrollHeight - prevH;
                else scrollBottom(false);
            });
    }

    // ── Open a conversation ───────────────────────────────────────────────────

    function openConversation(convId, other, ctx) {
        closeChatSearch();
        activeConvId  = convId;
        activeOther   = other;
        activeAnonId  = other.anonymousId || null;
        activeContext = ctx || null;
        contextSent      = !ctx;
        oldestDate       = null;
        lastRenderedDate = null;

        // Update URL without reload
        const newUrl = `/v2/messages/${convId}`;
        if (location.pathname !== newUrl) history.pushState({ convId }, '', newUrl);

        // Mobile: slide to chat panel. On md+ both columns stay side-by-side —
        // 'hidden' hides below md, but 'md:flex' overrides it above md.
        convPanel.classList.add('hidden');
        convPanel.classList.remove('flex');
        convPanel.classList.add('md:flex');
        chatPanel.classList.remove('hidden');
        chatPanel.classList.add('flex');
        document.body.classList.add('chat-open');

        // Hide empty, show active
        chatEmpty.classList.add('hidden');
        chatActive.classList.remove('hidden');
        chatActive.classList.add('flex');

        // Header
        renderChatHeader(other);
        fetchAndSetStatus(other);
        renderHeaderActions(other);

        // Pinned message + mute state — sourced from conversations list
        clearPinnedBanner();
        const convData = conversations.find(c => String(c._id) === String(convId));
        if (convData?.pinnedMessage) renderPinnedBanner(convData.pinnedMessage);
        activeMuted = convData?.isMuted || false;

        // Context badge in input area
        if (ctx && !contextSent) {
            document.getElementById('ctxUsername').textContent = ctx.username ? '@' + ctx.username : '';
            document.getElementById('ctxBody').textContent = ctx.body;
            contextBadge.classList.remove('hidden');
        } else {
            contextBadge.classList.add('hidden');
        }

        // Clear messages and reload
        messagesList.innerHTML = '';
        contextCard.classList.add('hidden');
        messagesLoading.classList.remove('hidden');
        loadMoreWrap.classList.add('hidden');

        loadMessages(null).then(() => {
            // Mark as read
            fetch(`/api/dm/${convId}/read`, { method: 'POST' }).catch(() => {});
            // Hide DM dot
            const dmDot = document.getElementById('dmDot');
            if (dmDot) dmDot.classList.add('hidden');
            // Update conv list to clear unread badge
            conversations = conversations.map(c =>
                String(c._id) === String(convId) ? { ...c, unreadCount: 0 } : c
            );
            renderConvList();
        });

        msgInput.focus();
    }

    // ── Mobile back button ────────────────────────────────────────────────────

    chatBackBtn.addEventListener('click', () => {
        activeConvId = null;
        history.pushState({}, '', '/v2/messages');
        // Mobile: slide back to conv panel
        chatPanel.classList.add('hidden');
        chatPanel.classList.remove('flex');
        convPanel.classList.remove('hidden');
        convPanel.classList.add('flex');
        document.body.classList.remove('chat-open');
        chatEmpty.classList.remove('hidden');
        chatActive.classList.add('hidden');
        chatActive.classList.remove('flex');
        document.getElementById('chatHeaderActions').innerHTML = '';
        renderConvList();
    });

    // ── Conversation click ────────────────────────────────────────────────────

    convList.addEventListener('click', function (e) {
        const btn = e.target.closest('.conv-item');
        if (!btn) return;
        const convId     = btn.dataset.convId;
        const otherId    = btn.dataset.otherId;
        const username   = btn.dataset.otherUsername;
        const avatar     = btn.dataset.otherAvatar   || null;
        const anonymousId = btn.dataset.otherAnonId  || null;
        const conv       = conversations.find(c => String(c._id) === convId);
        openConversation(convId, { _id: otherId, username, avatar, anonymousId }, conv?.context || null);
    });

    // ── Send message ──────────────────────────────────────────────────────────

    function autoResizeMsgInput() {
        msgInput.style.height = 'auto';
        msgInput.style.height = msgInput.scrollHeight + 'px';
    }

    msgInput.addEventListener('input', function () {
        autoResizeMsgInput();
        const len = this.value.length;
        charCounter.textContent = len + '/350';
        charCounter.classList.toggle('hidden', len < 280);
        charCounter.classList.toggle('text-red-400', len >= 340);
        charCounter.classList.toggle('text-silver-400', len < 340);
    });

    msgInput.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); doSend(); }
    });

    sendBtn.addEventListener('click', doSend);

    function doSend() {
        if (sending || !activeConvId || !activeOther) return;
        const body = msgInput.value.trim();
        if (!body) return;

        sending = true;
        sendBtn.disabled = true;

        const payload = { recipientId: activeOther._id, body };
        if (activeContext && !contextSent) payload.contextCommentId = activeContext.commentId;

        fetch('/api/dm/send', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
        })
        .then(r => r.ok ? r.json() : r.json().then(e => Promise.reject(e)))
        .then(data => {
            contextSent = true;
            contextBadge.classList.add('hidden');
            msgInput.value = '';
            msgInput.style.height = 'auto';
            charCounter.classList.add('hidden');

            // Optimistic bubble — insert date separator if day changed
            const dk = msgDateKey(data.message.createdAt);
            if (dk !== lastRenderedDate) {
                messagesList.appendChild(buildDateSeparator(data.message.createdAt));
                lastRenderedDate = dk;
            }
            messagesList.appendChild(buildBubble(data.message));
            scrollBottom(true);

            // Update local conversation state immediately — no extra network call
            conversations = conversations.map(c => {
                if (String(c._id) !== String(activeConvId)) return c;
                return {
                    ...c,
                    lastMessageAt:       data.message.createdAt,
                    lastMessagePreview:  body,
                    lastMessageSenderId: me,
                    otherUnreadCount:    (c.otherUnreadCount || 0) + 1,
                };
            });
            renderConvList();
        })
        .catch(err => alert(err?.error || 'Failed to send'))
        .finally(() => {
            sending = false;
            sendBtn.disabled = false;
            msgInput.focus();
        });
    }

    // ── Load more ─────────────────────────────────────────────────────────────

    loadMoreBtn.addEventListener('click', function () {
        if (!oldestDate) return;
        loadMoreBtn.textContent = 'Loading…';
        loadMoreBtn.disabled = true;
        loadMessages(oldestDate).then(() => {
            loadMoreBtn.textContent = 'Load earlier messages';
            loadMoreBtn.disabled = false;
        });
    });

    // ── Chat header action buttons ────────────────────────────────────────────

    const BLOCK_SVG  = `<svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24"><g fill="none"><path d="m12.593 23.258l-.011.002l-.071.035l-.02.004l-.014-.004l-.071-.035q-.016-.005-.024.005l-.004.01l-.017.428l.005.02l.01.013l.104.074l.015.004l.012-.004l.104-.074l.012-.016l.004-.017l-.017-.427q-.004-.016-.017-.018m.265-.113l-.013.002l-.185.093l-.01.01l-.003.011l.018.43l.005.012l.008.007l.201.093q.019.005.029-.008l.004-.014l-.034-.614q-.005-.018-.02-.022m-.715.002a.02.02 0 0 0-.027.006l-.006.014l-.034.614q.001.018.017.024l.015-.002l.201-.093l.01-.008l.004-.011l.017-.43l-.003-.012l-.01-.01z"/><path fill="currentColor" d="M12 2c5.523 0 10 4.477 10 10s-4.477 10-10 10S2 17.523 2 12S6.477 2 12 2m2.829 5.757l-7.072 7.071a1 1 0 1 0 1.415 1.415l7.07-7.071a1 1 0 0 0-1.414-1.415Z"/></g></svg>`;

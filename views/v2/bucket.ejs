<%
  title = bucket.name
  page  = 'explore'
  function compactNum(n) {
    n = Number(n) || 0;
    if (n >= 1e6) return (n / 1e6).toFixed(1).replace(/\.0$/, '')  + 'M';
    if (n >= 1e3) return (n / 1e3).toFixed(2).replace(/\.?0+$/, '') + 'K';
    return String(n);
  }
%>
<%- include('partials/layout') %>

<div class="w-full max-w-[65rem] mx-auto px-4 md:px-6 py-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 md:items-stretch">

        <!-- ── Column 1 · Meta ────────────────────────────────────────────── -->
        <div class="flex flex-col gap-4">

            <div class="flex flex-col gap-2">
                <!-- Title -->
                <h1 class="text-2xl font-bold text-woodsmoke-950 leading-snug break-words"><%= bucket.name %></h1>

                <!-- Curator row -->
                <div class="flex items-center gap-2">
                    <% if (curatorAvatar) { %>
                    <img src="<%= curatorAvatar %>" alt="<%= curatorName %>" class="w-8 h-8 rounded-full object-cover shrink-0 border border-silver-100">
                    <% } else { %>
                    <div class="w-8 h-8 rounded-full bg-orchid-100 flex items-center justify-center shrink-0 border border-silver-100">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" class="text-orchid-500"><g fill="none"><path d="m12.593 23.258l-.011.002l-.071.035l-.02.004l-.014-.004l-.071-.035q-.016-.005-.024.005l-.004.01l-.017.428l.005.02l.01.013l.104.074l.015.004l.012-.004l.104-.074l.012-.016l.004-.017l-.017-.427q-.004-.016-.017-.018m.265-.113l-.013.002l-.185.093l-.01.01l-.003.011l.018.43l.005.012l.008.007l.201.093q.019.005.029-.008l.004-.014l-.034-.614q-.005-.018-.02-.022m-.715.002a.02.02 0 0 0-.027.006l-.006.014l-.034.614q.001.018.017.024l.015-.002l.201-.093l.01-.008l.004-.011l.017-.43l-.003-.012l-.01-.01z"/><path fill="currentColor" d="M12 13c2.396 0 4.575.694 6.178 1.672c.8.488 1.484 1.064 1.978 1.69c.486.615.844 1.351.844 2.138c0 .845-.411 1.511-1.003 1.986c-.56.45-1.299.748-2.084.956c-1.578.417-3.684.558-5.913.558s-4.335-.14-5.913-.558c-.785-.208-1.524-.506-2.084-.956C3.41 20.01 3 19.345 3 18.5c0-.787.358-1.523.844-2.139c.494-.625 1.177-1.2 1.978-1.69C7.425 13.695 9.605 13 12 13m0-11a5 5 0 1 1 0 10a5 5 0 0 1 0-10"/></g></svg>
                    </div>
                    <% } %>
                    <div class="flex flex-col leading-tight min-w-0 flex-1">
                        <a href="/v2/profile/<%= curatorName %>" class="text-sm font-medium text-woodsmoke-800 hover:text-orchid-600 transition-colors truncate">@<%= curatorName %></a>
                        <span class="text-[11px] text-woodsmoke-400 truncate" id="bvTimeAgo"></span>
                    </div>
                    <% if (!isOwner) { %>
                    <% if (!user || user.isAnonymous) { %>
                    <a href="/?openAuth=true" class="shrink-0 h-8 px-3 text-xs font-semibold rounded-md bg-orchid-700 hover:bg-orchid-800 text-white transition-colors flex items-center">Follow</a>
                    <% } else if (isFollowing) { %>
                    <button id="bvFollowBtn" data-following="true" data-anon-id="<%= curatorAnonymousId %>"
                        class="shrink-0 h-8 px-3 text-xs font-semibold rounded-md border border-silver-200 text-woodsmoke-500 hover:border-red-200 hover:text-red-500 hover:bg-red-50 transition-colors flex items-center justify-center">
                        Following
                    </button>
                    <% } else { %>
                    <button id="bvFollowBtn" data-following="false" data-anon-id="<%= curatorAnonymousId %>"
                        class="shrink-0 h-8 px-3 text-xs font-semibold rounded-md bg-orchid-700 hover:bg-orchid-800 text-white transition-colors flex items-center justify-center">
                        Follow
                    </button>
                    <% } %>
                    <% } %>
                </div>

                <!-- Badges -->
                <div class="flex items-center flex-wrap gap-2">
                    <span class="inline-flex items-center bg-orchid-50 text-orchid-700 text-xs font-semibold px-2.5 py-1 rounded-full border border-orchid-200">
                        <%= bucket.links.length %> link<%= bucket.links.length !== 1 ? 's' : '' %>
                    </span>
                    <% if (bucket.isPaywalled) { %>
                    <span class="inline-flex items-center gap-1 bg-amber-50 text-amber-700 text-xs font-semibold px-2.5 py-1 rounded-full border border-amber-200">
                        <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24"><g fill="none" fill-rule="evenodd"><path d="m12.593 23.258l-.011.002l-.071.035l-.02.004l-.014-.004l-.071-.035q-.016-.005-.024.005l-.004.01l-.017.428l.005.02l.01.013l.104.074l.015.004l.012-.004l.104-.074l.012-.016l.004-.017l-.017-.427q-.004-.016-.017-.018m.265-.113l-.013.002l-.185.093l-.01.01l-.003.011l.018.43l.005.012l.008.007l.201.093q.019.005.029-.008l.004-.014l-.034-.614q-.005-.018-.02-.022m-.715.002a.02.02 0 0 0-.027.006l-.006.014l-.034.614q.001.018.017.024l.015-.002l.201-.093l.01-.008l.004-.011l.017-.43l-.003-.012l-.01-.01z"/><path fill="currentColor" d="M6 8a6 6 0 1 1 12 0h1a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V10a2 2 0 0 1 2-2zm6-4a4 4 0 0 1 4 4H8a4 4 0 0 1 4-4m2 10a2 2 0 0 1-1 1.732V17a1 1 0 1 1-2 0v-1.268A2 2 0 0 1 12 12a2 2 0 0 1 2 2"/></g></svg>
                        <%= (bucket.price || 0).toLocaleString('en-US') %> EWL
                    </span>
                    <% } else { %>
                    <span class="inline-flex items-center bg-green-50 text-green-700 text-xs font-semibold px-2.5 py-1 rounded-full border border-green-200">Free</span>
                    <% } %>
                </div>
            </div>

            <!-- Stats row: grabs · views · shares · rating -->
            <div class="flex items-center gap-5 text-sm font-medium text-gray-500">
                <span class="flex items-center gap-1.5">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><g fill="none" fill-rule="evenodd"><path d="m12.593 23.258l-.011.002l-.071.035l-.02.004l-.014-.004l-.071-.035q-.016-.005-.024.005l-.004.01l-.017.428l.005.02l.01.013l.104.074l.015.004l.012-.004l.104-.074l.012-.016l.004-.017l-.017-.427q-.004-.016-.017-.018m.265-.113l-.013.002l-.185.093l-.01.01l-.003.011l.018.43l.005.012l.008.007l.201.093q.019.005.029-.008l.004-.014l-.034-.614q-.005-.018-.02-.022m-.715.002a.02.02 0 0 0-.027.006l-.006.014l-.034.614q.001.018.017.024l.015-.002l.201-.093l.01-.008l.004-.011l.017-.43l-.003-.012l-.01-.01z"/><path fill="currentColor" d="M17.961 7.058a2.5 2.5 0 0 0-3.349-1.896a2.498 2.498 0 0 0-4.225 0A2.5 2.5 0 0 0 7 7.5l.001.962a4.7 4.7 0 0 0-.87-.584C5.11 7.36 4.12 7.44 3.077 7.866c-.84.345-1.107 1.308-.747 2.028l2.842 5.684A8 8 0 0 0 12.326 20H13a8 8 0 0 0 8-8V9.5a2.5 2.5 0 0 0-3.039-2.442M10 7.5a.5.5 0 1 0-1 0V11a1 1 0 0 1-1.78.625c-.925-1.156-1.517-1.72-1.995-1.964a1.2 1.2 0 0 0-.835-.117l2.57 5.14A6 6 0 0 0 12.326 18H13a6 6 0 0 0 6-6V9.5a.5.5 0 1 0-1 0v.5a1 1 0 1 1-2 0V7.5a.5.5 0 1 0-1 0V10a1 1 0 1 1-2 0V6.5a.5.5 0 1 0-1 0V10a1 1 0 1 1-2 0z"/></g></svg>
                    <%= compactNum(bucket.grabbedBy?.length ?? 0) %> grabs
                </span>
                <span class="flex items-center gap-1.5">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><g fill="none"><path d="m12.593 23.258l-.011.002l-.071.035l-.02.004l-.014-.004l-.071-.035q-.016-.005-.024.005l-.004.01l-.017.428l.005.02l.01.013l.104.074l.015.004l.012-.004l.104-.074l.012-.016l.004-.017l-.017-.427q-.004-.016-.017-.018m.265-.113l-.013.002l-.185.093l-.01.01l-.003.011l.018.43l.005.012l.008.007l.201.093q.019.005.029-.008l.004-.014l-.034-.614q-.005-.018-.02-.022m-.715.002a.02.02 0 0 0-.027.006l-.006.014l-.034.614q.001.018.017.024l.015-.002l.201-.093l.01-.008l.004-.011l.017-.43l-.003-.012l-.01-.01z"/><path fill="currentColor" d="M12 5c3.679 0 8.162 2.417 9.73 5.901c.146.328.27.71.27 1.099c0 .388-.123.771-.27 1.099C20.161 16.583 15.678 19 12 19s-8.162-2.417-9.73-5.901C2.124 12.77 2 12.389 2 12c0-.388.123-.771.27-1.099C3.839 7.417 8.322 5 12 5m0 3a4 4 0 1 0 0 8a4 4 0 0 0 0-8m0 2a2 2 0 1 1 0 4a2 2 0 0 1 0-4"/></g></svg>
                    <%= compactNum(bucket.viewCount ?? 0) %> views
                </span>
                <span class="flex items-center gap-1.5">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><g fill="none"><path d="m12.593 23.258l-.011.002l-.071.035l-.02.004l-.014-.004l-.071-.035q-.016-.005-.024.005l-.004.01l-.017.428l.005.02l.01.013l.104.074l.015.004l.012-.004l.104-.074l.012-.016l.004-.017l-.017-.427q-.004-.016-.017-.018m.265-.113l-.013.002l-.185.093l-.01.01l-.003.011l.018.43l.005.012l.008.007l.201.093q.019.005.029-.008l.004-.014l-.034-.614q-.005-.018-.02-.022m-.715.002a.02.02 0 0 0-.027.006l-.006.014l-.034.614q.001.018.017.024l.015-.002l.201-.093l.01-.008l.004-.011l.017-.43l-.003-.012l-.01-.01z"/><path fill="currentColor" d="m10.114 4.491l-.203 3.144l-.02.417l-.09.01C5.363 8.582 2 12.366 2 17q0 .686.102 1.357c.279 1.845.489 2.024 1.772.498a9 9 0 0 1 1.04-1.03a7.96 7.96 0 0 1 4.754-1.818l.226-.005l.061 1.229l.166 2.345c.08.804.926 1.353 1.704.914c.352-.198.695-.41 1.04-.62c1.787-1.118 3.46-2.403 5.09-3.738c.96-.8 1.8-1.558 2.516-2.248c.33-.323.66-.646.979-.98c.462-.484.508-1.285.024-1.792c-1.114-1.165-2.688-2.624-4.647-4.172c-1.588-1.242-3.23-2.402-4.97-3.421c-.837-.477-1.667.177-1.743.972"/></g></svg>
                    <%= compactNum(bucket.shareCount ?? 0) %> shares
                </span>
                <span class="flex items-center gap-1.5 <%= ratingCount > 0 ? 'text-amber-500' : 'text-silver-300' %>" title="<%= ratingCount > 0 ? ratingCount + ' rating' + (ratingCount !== 1 ? 's' : '') : 'No ratings yet' %>">
                    <% for (var _s = 1; _s <= 3; _s++) { %>
                    <% if (ratingCount > 0 && _s <= Math.round(ratingAvg)) { %>
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><g fill="none"><path d="m12.593 23.258l-.011.002l-.071.035l-.02.004l-.014-.004l-.071-.035q-.016-.005-.024.005l-.004.01l-.017.428l.005.02l.01.013l.104.074l.015.004l.012-.004l.104-.074l.012-.016l.004-.017l-.017-.427q-.004-.016-.017-.018m.265-.113l-.013.002l-.185.093l-.01.01l-.003.011l.018.43l.005.012l.008.007l.201.093q.019.005.029-.008l.004-.014l-.034-.614q-.005-.018-.02-.022m-.715.002a.02.02 0 0 0-.027.006l-.006.014l-.034.614q.001.018.017.024l.015-.002l.201-.093l.01-.008l.004-.011l.017-.43l-.003-.012l-.01-.01z"/><path fill="currentColor" d="M10.92 2.868a1.25 1.25 0 0 1 2.16 0l2.795 4.798l5.428 1.176a1.25 1.25 0 0 1 .667 2.054l-3.7 4.141l.56 5.525a1.25 1.25 0 0 1-1.748 1.27L12 19.592l-5.082 2.24a1.25 1.25 0 0 1-1.748-1.27l.56-5.525l-3.7-4.14a1.25 1.25 0 0 1 .667-2.055l5.428-1.176z"/></g></svg>
                    <% } else { %>
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><g fill="none" fill-rule="evenodd"><path d="m12.593 23.258l-.011.002l-.071.035l-.02.004l-.014-.004l-.071-.035q-.016-.005-.024.005l-.004.01l-.017.428l.005.02l.01.013l.104.074l.015.004l.012-.004l.104-.074l.012-.016l.004-.017l-.017-.427q-.004-.016-.017-.018m.265-.113l-.013.002l-.185.093l-.01.01l-.003.011l.018.43l.005.012l.008.007l.201.093q.019.005.029-.008l.004-.014l-.034-.614q-.005-.018-.02-.022m-.715.002a.02.02 0 0 0-.027.006l-.006.014l-.034.614q.001.018.017.024l.015-.002l.201-.093l.01-.008l.004-.011l.017-.43l-.003-.012l-.01-.01z"/><path fill="currentColor" d="M10.92 2.868a1.25 1.25 0 0 1 2.16 0l2.795 4.798l5.428 1.176a1.25 1.25 0 0 1 .667 2.054l-3.7 4.141l.56 5.525a1.25 1.25 0 0 1-1.748 1.27L12 19.592l-5.082 2.24a1.25 1.25 0 0 1-1.748-1.27l.56-5.525l-3.7-4.14a1.25 1.25 0 0 1 .667-2.055l5.428-1.176zM12 4.987L9.687 8.959a1.25 1.25 0 0 1-.816.592l-4.492.973l3.062 3.427c.234.262.347.61.312.959l-.463 4.573l4.206-1.854a1.25 1.25 0 0 1 1.008 0l4.206 1.854l-.463-4.573a1.25 1.25 0 0 1 .311-.959l3.063-3.427l-4.492-.973a1.25 1.25 0 0 1-.816-.592z"/></g></svg>
                    <% } %>
                    <% } %>
                    <span class="text-sm font-medium <%= ratingCount > 0 ? 'text-woodsmoke-500' : 'text-silver-400' %>">
                        <%= ratingCount > 0 ? ratingAvg + ' (' + ratingCount + ')' : 'No ratings' %>
                    </span>
                </span>
            </div>

            <!-- Thumbnail (full width) -->
            <div class="relative w-full aspect-square bg-silver-50 rounded-xl overflow-hidden border border-silver-100">
                <% if (thumbnailUrl) { %>
                    <img src="<%= imgSrc(thumbnailUrl) %>" alt="<%= bucket.name %>" class="absolute inset-0 w-full h-full object-cover" onerror="this.style.display='none';this.nextElementSibling&&this.nextElementSibling.classList.remove('hidden')">
                    <div class="hidden absolute inset-0 flex items-center justify-center text-silver-300">
                        <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24"><g fill="none"><path fill="currentColor" d="M20 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2zm0 2H4v10.1l4.995-4.994a1.25 1.25 0 0 1 1.768 0l4.065 4.066l1.238-1.238a1.25 1.25 0 0 1 1.768 0L20 15.101zm-4.5 2a1.5 1.5 0 1 1 0 3a1.5 1.5 0 0 1 0-3"/></g></svg>
                    </div>
                <% } else { %>
                    <div class="absolute inset-0 flex items-center justify-center text-silver-300">
                        <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24"><g fill="none"><path d="m12.593 23.258l-.011.002l-.071.035l-.02.004l-.014-.004l-.071-.035q-.016-.005-.024.005l-.004.01l-.017.428l.005.02l.01.013l.104.074l.015.004l.012-.004l.104-.074l.012-.016l.004-.017l-.017-.427q-.004-.016-.017-.018m.265-.113l-.013.002l-.185.093l-.01.01l-.003.011l.018.43l.005.012l.008.007l.201.093q.019.005.029-.008l.004-.014l-.034-.614q-.005-.018-.02-.022m-.715.002a.02.02 0 0 0-.027.006l-.006.014l-.034.614q.001.018.017.024l.015-.002l.201-.093l.01-.008l.004-.011l.017-.43l-.003-.012l-.01-.01z"/><path fill="currentColor" d="M20 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2zm0 2H4v10.1l4.995-4.994a1.25 1.25 0 0 1 1.768 0l4.065 4.066l1.238-1.238a1.25 1.25 0 0 1 1.768 0L20 15.101zm-4.5 2a1.5 1.5 0 1 1 0 3a1.5 1.5 0 0 1 0-3"/></g></svg>
                    </div>
                <% } %>
                <!-- Not Interested — Level 1: main categories -->
                <div id="bvNiOverlay1" class="hidden absolute inset-0 z-10 bg-woodsmoke-950/85 backdrop-blur-sm flex flex-col items-center justify-center gap-4 p-6">
                    <p class="text-white text-sm font-semibold text-center">Why aren't you interested?</p>
                    <div class="flex flex-col gap-2 w-full max-w-[220px]">
                        <button class="bv-ni-cat w-full h-9 px-4 text-xs font-medium rounded-md bg-white/10 hover:bg-white/20 text-white border border-white/20 transition-colors flex items-center justify-center" data-category="not-relevant">Not relevant to me</button>
                        <button class="bv-ni-cat w-full h-9 px-4 text-xs font-medium rounded-md bg-white/10 hover:bg-white/20 text-white border border-white/20 transition-colors flex items-center justify-center" data-category="low-quality">Low quality</button>
                        <button class="bv-ni-cat w-full h-9 px-4 text-xs font-medium rounded-md bg-white/10 hover:bg-white/20 text-white border border-white/20 transition-colors flex items-center justify-center" data-category="trust-safety">Trust &amp; safety</button>
                        <button class="bv-ni-cat w-full h-9 px-4 text-xs font-medium rounded-md bg-white/10 hover:bg-white/20 text-white border border-white/20 transition-colors flex items-center justify-center" data-category="already-in-feed">Already in my feed</button>
                        <button id="bvNiCancel1" class="w-full h-9 px-4 text-xs font-medium rounded-md bg-transparent hover:bg-white/10 text-white transition-colors flex items-center justify-center">Cancel</button>
                    </div>
                </div>
                <!-- Not Interested — Level 2: sub-reasons (populated by JS) -->
                <div id="bvNiOverlay2" class="hidden absolute inset-0 z-10 bg-woodsmoke-950/85 backdrop-blur-sm flex flex-col items-center justify-center gap-4 p-6">
                    <p class="text-white text-sm font-semibold text-center" id="bvNiSubTitle"></p>
                    <div id="bvNiSubReasons" class="flex flex-col gap-2 w-full max-w-[220px]"></div>
                </div>
            </div>

            <!-- Source URL row -->
            <% if (bucket.sourceUrl) { %>
            <% const sourceBlurred = bucket.isPaywalled && !hasAccess; %>
            <div class="flex items-center gap-1 px-2.5 py-2 rounded-lg border border-silver-200 bg-silver-50">
                <% if (sourceBlurred) { %>
                <span class="flex-1 min-w-0 text-xs text-woodsmoke-300 truncate select-none pointer-events-none italic">Unlock to reveal source</span>
                <span class="shrink-0 w-6 h-6 flex items-center justify-center rounded text-silver-400">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"><g fill="none" fill-rule="evenodd"><path d="m12.593 23.258l-.011.002l-.071.035l-.02.004l-.014-.004l-.071-.035q-.016-.005-.024.005l-.004.01l-.017.428l.005.02l.01.013l.104.074l.015.004l.012-.004l.104-.074l.012-.016l.004-.017l-.017-.427q-.004-.016-.017-.018m.265-.113l-.013.002l-.185.093l-.01.01l-.003.011l.018.43l.005.012l.008.007l.201.093q.019.005.029-.008l.004-.014l-.034-.614q-.005-.018-.02-.022m-.715.002a.02.02 0 0 0-.027.006l-.006.014l-.034.614q.001.018.017.024l.015-.002l.201-.093l.01-.008l.004-.011l.017-.43l-.003-.012l-.01-.01z"/><path fill="currentColor" d="M6 8a6 6 0 1 1 12 0h1a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V10a2 2 0 0 1 2-2zm6-4a4 4 0 0 1 4 4H8a4 4 0 0 1 4-4m2 10a2 2 0 0 1-1 1.732V17a1 1 0 1 1-2 0v-1.268A2 2 0 0 1 12 12a2 2 0 0 1 2 2"/></g></svg>
                </span>
                <% } else { %>
                <a href="<%= bucket.sourceUrl %>" target="_blank" rel="noopener noreferrer"
                   class="flex-1 min-w-0 text-xs text-orchid-600 hover:underline truncate">
                    <%= bucket.sourceUrl %>
                </a>
                <button
                    class="shrink-0 w-6 h-6 flex items-center justify-center rounded text-woodsmoke-400 hover:text-orchid-600 transition-colors"
                    title="Copy source URL"
                    onclick="(function(btn){var url='<%= bucket.sourceUrl.replace(/'/g, "\\'") %>';navigator.clipboard.writeText(url).then(function(){btn.title='Copied!';setTimeout(function(){btn.title='Copy source URL';},2000);});})(this)"
                >
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"><path fill="currentColor" d="M7 6V3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1h-3v3c0 .552-.45 1-1.007 1H4.007A1 1 0 0 1 3 21V7a1 1 0 0 1 1-1zm2 0h8v10h2V4H9zm-4 2v12h10V8z"/></svg>
                </button>
                <% } %>
            </div>
            <% } %>

            <!-- Description + Tags -->
            <% if (bucket.description || (bucket.hashtags && bucket.hashtags.length > 0)) { %>
            <div class="flex flex-col gap-4">

                <% if (bucket.description) { %>
                <div class="flex flex-col gap-1.5">
                    <p class="text-sm text-woodsmoke-700 leading-relaxed whitespace-pre-wrap"><%= bucket.description %></p>
                </div>
                <% } %>

                <% if (bucket.hashtags && bucket.hashtags.length > 0) { %>
                <div class="flex flex-col gap-2">
                    <div class="flex flex-wrap gap-1.5">
                        <% bucket.hashtags.forEach(function(tag) { %>
                        <span class="inline-flex items-center text-xs font-medium px-2.5 py-1 rounded-full bg-silver-100 text-woodsmoke-600"><%= tag %></span>
                        <% }); %>
                    </div>
                </div>
                <% } %>

            </div>

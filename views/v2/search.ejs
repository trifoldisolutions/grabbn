<%
  title = `"${query}" — Search`
  page  = 'explore'
%>
<%- include('partials/layout') %>

<!-- Pre-fill search inputs with the current query -->
<script>
    (function () {
        var q = <%- JSON.stringify(query) %>;
        var si  = document.getElementById('searchInput');
        var msi = document.getElementById('mobileSearchInput');
        if (si)  si.value  = q;
        if (msi) msi.value = q;
    })();
</script>

<div class="w-full max-w-4xl mx-auto px-4 md:px-6 py-8">

    <!-- ── Header ─────────────────────────────────────────────────────────── -->
    <div class="mb-7">
        <h1 class="text-xl font-bold text-woodsmoke-950">Results for "<%= query %>"</h1>
        <% const total = users.length + buckets.length; %>
        <p class="text-sm text-gray-400 mt-1"><%= total %> result<%= total !== 1 ? 's' : '' %> found</p>
    </div>

    <% if (total === 0) { %>
    <!-- ── Empty state ────────────────────────────────────────────────────── -->
    <div class="flex flex-col items-center gap-3 py-20 text-center">
        <svg xmlns="http://www.w3.org/2000/svg" width="44" height="44" viewBox="0 0 24 24" class="text-gray-200">
            <g fill="none" fill-rule="evenodd">
                <path d="m12.593 23.258l-.011.002l-.071.035l-.02.004l-.014-.004l-.071-.035q-.016-.005-.024.005l-.004.01l-.017.428l.005.02l.01.013l.104.074l.015.004l.012-.004l.104-.074l.012-.016l.004-.017l-.017-.427q-.004-.016-.017-.018m.265-.113l-.013.002l-.185.093l-.01.01l-.003.011l.018.43l.005.012l.008.007l.201.093q.019.005.029-.008l.004-.014l-.034-.614q-.005-.018-.02-.022m-.715.002a.02.02 0 0 0-.027.006l-.006.014l-.034.614q.001.018.017.024l.015-.002l.201-.093l.01-.008l.004-.011l.017-.43l-.003-.012l-.01-.01z"/>
                <path fill="currentColor" d="M10.5 2a8.5 8.5 0 1 0 5.262 15.176l3.652 3.652a1 1 0 0 0 1.414-1.414l-3.652-3.652A8.5 8.5 0 0 0 10.5 2M4 10.5a6.5 6.5 0 1 1 13 0a6.5 6.5 0 0 1-13 0"/>
            </g>
        </svg>
        <p class="font-semibold text-woodsmoke-700">Nothing found for "<%= query %>"</p>
        <p class="text-sm text-gray-400 max-w-xs">Try a different name, @username, bucket ID, or paste a share link</p>
    </div>

    <% } else { %>

    <% if (users.length > 0) { %>
    <!-- ── People ─────────────────────────────────────────────────────────── -->
    <section class="mb-8">
        <h2 class="text-[0.7rem] font-semibold uppercase tracking-widest text-gray-400 mb-3">People</h2>
        <div class="flex flex-col gap-1">
            <% users.forEach(function(u) { %>
            <a href="/v2/@<%= encodeURIComponent(u.username) %>"
               class="flex items-center gap-3 px-3 py-2.5 rounded-xl hover:bg-silver-50 transition-colors border border-transparent hover:border-silver-100 group">
                <!-- Avatar -->
                <div class="w-10 h-10 rounded-full overflow-hidden shrink-0 flex items-center justify-center <%= u.avatar ? '' : 'bg-orchid-100' %>">
                    <% if (u.avatar) { %>
                        <img src="<%= u.avatar %>" alt="@<%= u.username %>" class="w-full h-full object-cover">
                    <% } else { %>
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" class="text-orchid-500"><g fill="none"><path d="m12.593 23.258l-.011.002l-.071.035l-.02.004l-.014-.004l-.071-.035q-.016-.005-.024.005l-.004.01l-.017.428l.005.02l.01.013l.104.074l.015.004l.012-.004l.104-.074l.012-.016l.004-.017l-.017-.427q-.004-.016-.017-.018m.265-.113l-.013.002l-.185.093l-.01.01l-.003.011l.018.43l.005.012l.008.007l.201.093q.019.005.029-.008l.004-.014l-.034-.614q-.005-.018-.02-.022m-.715.002a.02.02 0 0 0-.027.006l-.006.014l-.034.614q.001.018.017.024l.015-.002l.201-.093l.01-.008l.004-.011l.017-.43l-.003-.012l-.01-.01z"/><path fill="currentColor" d="M12 13c2.396 0 4.575.694 6.178 1.672c.8.488 1.484 1.064 1.978 1.69c.486.615.844 1.351.844 2.138c0 .845-.411 1.511-1.003 1.986c-.56.45-1.299.748-2.084.956c-1.578.417-3.684.558-5.913.558s-4.335-.14-5.913-.558c-.785-.208-1.524-.506-2.084-.956C3.41 20.01 3 19.345 3 18.5c0-.787.358-1.523.844-2.139c.494-.625 1.177-1.2 1.978-1.69C7.425 13.695 9.605 13 12 13m0-11a5 5 0 1 1 0 10a5 5 0 0 1 0-10"/></g></svg>
                    <% } %>
                </div>
                <!-- Info -->
                <div class="flex-1 min-w-0">
                    <div class="font-semibold text-woodsmoke-900 text-sm">@<%= u.username %></div>
                    <div class="text-xs text-gray-400 mt-0.5"><%= u.bucketCount %> public bucket<%= u.bucketCount !== 1 ? 's' : '' %></div>
                </div>
                <!-- Chevron -->
                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" class="text-gray-300 group-hover:text-gray-400 shrink-0 transition-colors"><g fill="none" fill-rule="evenodd"><path d="M24 0v24H0V0zM12.594 23.258l-.012.002l-.071.035l-.02.004l-.014-.004l-.071-.036q-.016-.004-.024.006l-.004.01l-.017.428l.005.02l.01.013l.104.074l.015.004l.012-.004l.104-.074l.012-.016l.004-.017l-.017-.427q-.004-.016-.016-.018m.264-.113l-.014.002l-.184.093l-.01.01l-.003.011l.018.43l.005.012l.008.008l.201.092q.019.005.029-.008l.004-.014l-.034-.614q-.005-.018-.02-.022m-.715.002a.02.02 0 0 0-.027.006l-.006.014l-.034.614q.001.018.017.024l.015-.002l.201-.093l.01-.008l.003-.011l.018-.43l-.003-.012l-.01-.01z"/><path fill="currentColor" d="M15.707 11.293a1 1 0 0 1 0 1.414l-5.657 5.657a1 1 0 1 1-1.414-1.414L13.586 12L8.636 7.05a1 1 0 0 1 1.414-1.414z"/></g></svg>
            </a>
            <% }); %>
        </div>
    </section>
    <% } %>

    <% if (buckets.length > 0) { %>
    <!-- ── Buckets ─────────────────────────────────────────────────────────── -->
    <section>
        <h2 class="text-[0.7rem] font-semibold uppercase tracking-widest text-gray-400 mb-3">Buckets</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
            <% buckets.forEach(function(b) { %>
            <a href="/v2/bucket/<%= b._id %>"
               class="flex flex-col rounded-xl border border-silver-100 hover:border-orchid-200 hover:shadow-sm transition-all overflow-hidden group">
                <!-- Thumbnail -->
                <div class="h-32 bg-silver-100 shrink-0 flex items-center justify-center overflow-hidden">
                    <% if (b.thumbnail) { %>
                        <img src="<%= b.thumbnail %>" alt="<%= b.name %>" class="w-full h-full object-cover">
                    <% } else { %>
                        <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" class="text-silver-300"><g fill="none"><path fill="currentColor" d="M15.5 5a2.5 2.5 0 0 1 2.461 2.058A2.5 2.5 0 0 1 21 9.5V12a8 8 0 0 1-8 8h-.674a8 8 0 0 1-7.155-4.422L2.329 9.894c-.36-.72-.093-1.683.747-2.028c1.043-.427 2.034-.507 3.055.012q.443.227.869.584V7.5a2.5 2.5 0 0 1 3.388-2.338a2.498 2.498 0 0 1 4.224 0A2.5 2.5 0 0 1 15.5 5"/></g></svg>
                    <% } %>
                </div>
                <!-- Info -->
                <div class="px-3 py-2.5 flex flex-col gap-0.5">
                    <div class="font-semibold text-woodsmoke-900 text-sm truncate group-hover:text-orchid-700 transition-colors"><%= b.name %></div>
                    <% if (b.curator.username) { %>
                        <div class="text-xs text-gray-400">by @<%= b.curator.username %></div>
                    <% } %>
                    <div class="flex items-center gap-3 text-xs text-gray-400 mt-1.5">
                        <!-- Links count -->
                        <span class="flex items-center gap-1">
                            <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24"><g fill="none"><path fill="currentColor" d="M13.06 8.11l1.415 1.415a7 7 0 0 1 0 9.9C13.22 20.67 11.61 21.37 10 21.37s-3.22-.7-4.47-1.95a7 7 0 0 1 0-9.9l1.42 1.42a5 5 0 0 0 0 7.07c.97.96 2.23 1.46 3.52 1.46s2.55-.5 3.52-1.46a5 5 0 0 0 0-7.07zm6.96-6.94a7 7 0 0 1 0 9.9l-1.42-1.42a5 5 0 0 0 0-7.07C17.64 1.62 16.38 1.12 15.09 1.12s-2.55.5-3.52 1.46a5 5 0 0 0 0 7.07L10.15 11a7 7 0 0 1 0-9.9C11.4.84 13 .14 14.62.14s3.22.7 4.47 1.95z"/></g></svg>
                            <%= b.linksCount %>
                        </span>
                        <!-- Grab count -->
                        <span class="flex items-center gap-1">
                            <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24"><g fill="none"><path fill="currentColor" d="M15.5 5a2.5 2.5 0 0 1 2.461 2.058A2.5 2.5 0 0 1 21 9.5V12a8 8 0 0 1-8 8h-.674a8 8 0 0 1-7.155-4.422L2.329 9.894c-.36-.72-.093-1.683.747-2.028c1.043-.427 2.034-.507 3.055.012q.443.227.869.584V7.5a2.5 2.5 0 0 1 3.388-2.338a2.498 2.498 0 0 1 4.224 0A2.5 2.5 0 0 1 15.5 5"/></g></svg>
                            <%= b.grabCount %>
                        </span>
                        <!-- View count -->
                        <span class="flex items-center gap-1">
                            <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24"><g fill="none"><path fill="currentColor" d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5M12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5s5 2.24 5 5s-2.24 5-5 5m0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3s3-1.34 3-3s-1.34-3-3-3"/></g></svg>
                            <%= b.viewCount %>
                        </span>
                    </div>
                </div>
            </a>
            <% }); %>
        </div>
    </section>
    <% } %>

    <% } %>
</div>

<%- include('partials/layout-end') %>

<%
  /* Variables expected: b (bucket object), isOwn (boolean) */
  function compactNum(n) {
    n = Number(n) || 0;
    if (n >= 1e6) return (n / 1e6).toFixed(1).replace(/\.0$/, '')  + 'M';
    if (n >= 1e3) return (n / 1e3).toFixed(2).replace(/\.?0+$/, '') + 'K';
    return String(n);
  }
  const grabCount    = b.grabbedBy?.length ?? 0;
  const shareCount   = b.shareCount ?? 0;
  const viewCount    = b.viewCount  ?? 0;
  const ratingCount  = b.ratingCount ?? 0;
  const ratingAvg    = ratingCount > 0 ? Math.round((b.ratingSum / ratingCount) * 10) / 10 : null;
  const linkCount  = b.links?.length ?? 0;
  const PLACEHOLDER_COLORS = ['bg-orchid-200', 'bg-blue-200', 'bg-amber-200'];
  function timeAgo(date) {
    const s = Math.floor((Date.now() - new Date(date)) / 1000);
    if (s < 60)        return `${s}s ago`;
    if (s < 3600)      return `${Math.floor(s / 60)}m ago`;
    if (s < 86400)     return `${Math.floor(s / 3600)}h ago`;
    if (s < 2592000)   return `${Math.floor(s / 86400)}d ago`;
    if (s < 31536000)  return `${Math.floor(s / 2592000)}mo ago`;
    return `${Math.floor(s / 31536000)}y ago`;
  }
%>
<div
    class="flex flex-col rounded-md bg-white border border-silver-100 cursor-pointer hover:shadow-md transition-shadow"
    data-bucket-id="<%= b._id %>"
>
    <!-- Thumbnail section -->
    <div class="relative">
        <div class="px-3 pt-3 pb-3">
            <% if (b.displayThumb) { %>
                <img src="<%= b.displayThumb %>" class="w-full aspect-[1] object-cover rounded-md" loading="lazy" onerror="this.style.display='none'">
            <% } else { %>
                <div class="w-full aspect-[1] bg-silver-100 rounded-md flex items-center justify-center text-gray-400">
                    <!-- pic placeholder -->
                    <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24"><g fill="none"><path d="m12.593 23.258l-.011.002l-.071.035l-.02.004l-.014-.004l-.071-.035q-.016-.005-.024.005l-.004.01l-.017.428l.005.02l.01.013l.104.074l.015.004l.012-.004l.104-.074l.012-.016l.004-.017l-.017-.427q-.004-.016-.017-.018m.265-.113l-.013.002l-.185.093l-.01.01l-.003.011l.018.43l.005.012l.008.007l.201.093q.019.005.029-.008l.004-.014l-.034-.614q-.005-.018-.02-.022m-.715.002a.02.02 0 0 0-.027.006l-.006.014l-.034.614q.001.018.017.024l.015-.002l.201-.093l.01-.008l.004-.011l.017-.43l-.003-.012l-.01-.01z"/><path fill="currentColor" d="M20 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2zm0 2H4v10.1l4.995-4.994a1.25 1.25 0 0 1 1.768 0l4.065 4.066l1.238-1.238a1.25 1.25 0 0 1 1.768 0L20 15.101zm-4.5 2a1.5 1.5 0 1 1 0 3a1.5 1.5 0 0 1 0-3"/></g></svg>
                </div>
            <% } %>
        </div>

        <!-- Bottom badges: link count + price -->
        <div class="absolute bottom-6 right-6 flex items-center gap-1.5">
            <div class="px-2 py-0.5 rounded-md text-xs font-semibold bg-white/80 backdrop-blur-sm text-gray-500">
                <%= linkCount %> link<%= linkCount !== 1 ? 's' : '' %>
            </div>
            <div class="px-2 py-0.5 rounded-md text-xs font-bold backdrop-blur-sm <%= b.isPaywalled ? 'bg-orchid-600 text-white' : 'bg-white/80 text-gray-500' %>">
                <%= b.isPaywalled ? `${b.price} EWL` : 'Free' %>
            </div>
        </div>

        <!-- Grabbers avatar stack — straddles the bottom edge of the thumbnail -->
        <div class="absolute bottom-3 left-6 translate-y-1/2 flex -space-x-2 z-10">
            <% if (b.grabbedBy && b.grabbedBy.length > 0) { %>
                <% b.grabbedBy.slice(0, 4).forEach(function(g) { %>
                    <% if (g.avatar) { %>
                        <img src="<%= g.avatar %>" alt="<%= g.username %>" title="<%= g.username %>" class="w-6 h-6 sm:w-8 sm:h-8 rounded-full border-2 border-white shrink-0 overflow-hidden object-cover" loading="lazy">
                    <% } else { %>
                        <div class="w-6 h-6 sm:w-8 sm:h-8 rounded-full border-2 border-white shrink-0 bg-orchid-200"></div>
                    <% } %>
                <% }); %>
            <% } else { %>
                <div class="w-6 h-6 sm:w-8 sm:h-8 rounded-full border-2 border-white shrink-0 bg-orchid-200"></div>
                <div class="w-6 h-6 sm:w-8 sm:h-8 rounded-full border-2 border-white shrink-0 bg-blue-200"></div>
                <div class="w-6 h-6 sm:w-8 sm:h-8 rounded-full border-2 border-white shrink-0 bg-amber-200"></div>
            <% } %>
        </div>
    </div>

    <!-- Card body -->
    <div class="px-3 pt-2 pb-3 flex flex-col gap-1">
        <div class="flex items-center gap-1">
            <p class="font-medium leading-snug text-[1.1rem] truncate flex-1"><%= b.name %></p>
            <% if (isOwn) { %>
                <% if (b.isDraft) { %>
                    <span class="shrink-0 text-[10px] font-semibold px-1.5 py-0.5 rounded-full leading-none bg-sky-50 text-sky-500">Draft</span>
                <% } else { %>
                    <% const bvis = b.visibility || (b.isPublic ? 'public' : 'private'); %>
                    <span class="shrink-0 text-[10px] font-semibold px-1.5 py-0.5 rounded-full leading-none
                        <%= bvis === 'public' ? 'bg-orchid-100 text-orchid-600' : bvis === 'unlisted' ? 'bg-amber-50 text-amber-500' : 'bg-gray-100 text-gray-400' %>">
                        <%= bvis === 'public' ? 'Public' : bvis === 'unlisted' ? 'Unlisted' : 'Private' %>
                    </span>
                <% } %>
            <% } %>
        </div>
        <% if (b.description) { %>
            <p class="text-xs text-gray-500 line-clamp-2 leading-relaxed"><%= b.description %></p>
        <% } %>
        <% if (b.hashtags && b.hashtags.length > 0) { %>
            <div class="flex flex-wrap gap-1">
                <% b.hashtags.slice(0, 4).forEach(function(tag) { %>
                    <span class="text-[10px] font-medium px-1.5 py-0.5 rounded-full bg-orchid-50 text-orchid-500">#<%= tag %></span>
                <% }); %>
            </div>
        <% } %>
        <!-- Action row: rating + grab count + share btn -->
        <div class="flex items-center gap-4 pt-0.5 text-gray-500">
            <!-- Star rating -->
            <% if (ratingAvg !== null) { %>
                <span class="flex items-center gap-1 text-sm font-medium text-amber-500">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path fill="currentColor" d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2L9.19 8.63L2 9.24l5.46 4.73L5.82 21z"/></svg>
                    <span><%= ratingAvg %></span>
                    <span class="text-gray-400 font-normal">(<%= ratingCount %>)</span>
                </span>
            <% } %>
            <!-- Grab count (static display) -->
            <span class="flex items-center gap-1.5 text-sm font-medium">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"><g fill="none" fill-rule="evenodd"><path d="m12.593 23.258l-.011.002l-.071.035l-.02.004l-.014-.004l-.071-.035q-.016-.005-.024.005l-.004.01l-.017.428l.005.02l.01.013l.104.074l.015.004l.012-.004l.104-.074l.012-.016l.004-.017l-.017-.427q-.004-.016-.017-.018m.265-.113l-.013.002l-.185.093l-.01.01l-.003.011l.018.43l.005.012l.008.007l.201.093q.019.005.029-.008l.004-.014l-.034-.614q-.005-.018-.02-.022m-.715.002a.02.02 0 0 0-.027.006l-.006.014l-.034.614q.001.018.017.024l.015-.002l.201-.093l.01-.008l.004-.011l.017-.43l-.003-.012l-.01-.01z"/><path fill="currentColor" d="M17.961 7.058a2.5 2.5 0 0 0-3.349-1.896a2.498 2.498 0 0 0-4.225 0A2.5 2.5 0 0 0 7 7.5l.001.962a4.7 4.7 0 0 0-.87-.584C5.11 7.36 4.12 7.44 3.077 7.866c-.84.345-1.107 1.308-.747 2.028l2.842 5.684A8 8 0 0 0 12.326 20H13a8 8 0 0 0 8-8V9.5a2.5 2.5 0 0 0-3.039-2.442M10 7.5a.5.5 0 1 0-1 0V11a1 1 0 0 1-1.78.625c-.925-1.156-1.517-1.72-1.995-1.964a1.2 1.2 0 0 0-.835-.117l2.57 5.14A6 6 0 0 0 12.326 18H13a6 6 0 0 0 6-6V9.5a.5.5 0 1 0-1 0v.5a1 1 0 1 1-2 0V7.5a.5.5 0 1 0-1 0V10a1 1 0 1 1-2 0V6.5a.5.5 0 1 0-1 0V10a1 1 0 1 1-2 0z"/></g></svg>
                <%= compactNum(grabCount) %>
            </span>
            <!-- View count -->
            <span class="flex items-center gap-1.5 text-sm font-medium">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"><g fill="none"><path d="m12.593 23.258l-.011.002l-.071.035l-.02.004l-.014-.004l-.071-.035q-.016-.005-.024.005l-.004.01l-.017.428l.005.02l.01.013l.104.074l.015.004l.012-.004l.104-.074l.012-.016l.004-.017l-.017-.427q-.004-.016-.017-.018m.265-.113l-.013.002l-.185.093l-.01.01l-.003.011l.018.43l.005.012l.008.007l.201.093q.019.005.029-.008l.004-.014l-.034-.614q-.005-.018-.02-.022m-.715.002a.02.02 0 0 0-.027.006l-.006.014l-.034.614q.001.018.017.024l.015-.002l.201-.093l.01-.008l.004-.011l.017-.43l-.003-.012l-.01-.01z"/><path fill="currentColor" d="M12 5c3.679 0 8.162 2.417 9.73 5.901c.146.328.27.71.27 1.099c0 .388-.123.771-.27 1.099C20.161 16.583 15.678 19 12 19s-8.162-2.417-9.73-5.901C2.124 12.77 2 12.389 2 12c0-.388.123-.771.27-1.099C3.839 7.417 8.322 5 12 5m0 3a4 4 0 1 0 0 8a4 4 0 0 0 0-8m0 2a2 2 0 1 1 0 4a2 2 0 0 1 0-4"/></g></svg>
                <%= compactNum(viewCount) %>
            </span>
            <!-- Share button -->
            <button class="card-share-btn flex items-center gap-1.5 text-sm font-medium hover:text-orchid-600 transition-colors" data-bucket-id="<%= b._id %>" onclick="event.stopPropagation()">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"><g fill="none"><path d="m12.593 23.258l-.011.002l-.071.035l-.02.004l-.014-.004l-.071-.035q-.016-.005-.024.005l-.004.01l-.017.428l.005.02l.01.013l.104.074l.015.004l.012-.004l.104-.074l.012-.016l.004-.017l-.017-.427q-.004-.016-.017-.018m.265-.113l-.013.002l-.185.093l-.01.01l-.003.011l.018.43l.005.012l.008.007l.201.093q.019.005.029-.008l.004-.014l-.034-.614q-.005-.018-.02-.022m-.715.002a.02.02 0 0 0-.027.006l-.006.014l-.034.614q.001.018.017.024l.015-.002l.201-.093l.01-.008l.004-.011l.017-.43l-.003-.012l-.01-.01z"/><path fill="currentColor" d="m10.114 4.491l-.203 3.144l-.02.417l-.09.01C5.363 8.582 2 12.366 2 17q0 .686.102 1.357c.279 1.845.489 2.024 1.772.498a9 9 0 0 1 1.04-1.03a7.96 7.96 0 0 1 4.754-1.818l.226-.005l.061 1.229l.166 2.345c.08.804.926 1.353 1.704.914c.352-.198.695-.41 1.04-.62c1.787-1.118 3.46-2.403 5.09-3.738c.96-.8 1.8-1.558 2.516-2.248c.33-.323.66-.646.979-.98c.462-.484.508-1.285.024-1.792c-1.114-1.165-2.688-2.624-4.647-4.172c-1.588-1.242-3.23-2.402-4.97-3.421c-.837-.477-1.667.177-1.743.972"/></g></svg>
                <span><%= compactNum(shareCount) %></span>
            </button>
            <% if (!isOwn && b.userId?.username) { %>
                <div class="ml-auto flex flex-col items-end gap-0.5 min-w-0">
                    <% if (b.updatedAt) { %>
                        <span class="text-xs text-gray-400">updated <%= timeAgo(b.updatedAt) %></span>
                    <% } %>
                    <span class="text-sm text-gray-400 truncate">by @<%= b.userId.username %></span>
                </div>
            <% } %>
        </div>
    </div>
</div>

<header class="flex items-center px-4 md:px-6 md:justify-center h-16 border-b border-gray-100 shrink-0 gap-x-3 md:gap-x-8">

    <!-- Mobile logo -->
    <a href="/v2" class="flex md:hidden items-center gap-1.5 shrink-0 text-orchid-600">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24"><g fill="none"><path d="m12.593 23.258l-.011.002l-.071.035l-.02.004l-.014-.004l-.071-.035q-.016-.005-.024.005l-.004.01l-.017.428l.005.02l.01.013l.104.074l.015.004l.012-.004l.104-.074l.012-.016l.004-.017l-.017-.427q-.004-.016-.017-.018m.265-.113l-.013.002l-.185.093l-.01.01l-.003.011l.018.43l.005.012l.008.007l.201.093q.019.005.029-.008l.004-.014l-.034-.614q-.005-.018-.02-.022m-.715.002a.02.02 0 0 0-.027.006l-.006.014l-.034.614q.001.018.017.024l.015-.002l.201-.093l.01-.008l.004-.011l.017-.43l-.003-.012l-.01-.01z"/><path fill="currentColor" d="M15.5 5a2.5 2.5 0 0 1 2.461 2.058A2.5 2.5 0 0 1 21 9.5V12a8 8 0 0 1-8 8h-.674a8 8 0 0 1-7.155-4.422L2.329 9.894c-.36-.72-.093-1.683.747-2.028c1.043-.427 2.034-.507 3.055.012q.443.227.869.584V7.5a2.5 2.5 0 0 1 3.388-2.338a2.498 2.498 0 0 1 4.224 0A2.5 2.5 0 0 1 15.5 5"/></g></svg>
        <span class="font-bold text-[0.85rem] tracking-widest uppercase text-woodsmoke-950" style="font-variant: small-caps; letter-spacing: 0.12em;">GRABBn</span>
    </a>

    <!-- Mobile inline search -->
    <div class="flex md:hidden flex-1 h-10 bg-silver-100 rounded-md items-center px-3 gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="shrink-0 text-woodsmoke-600" width="15" height="15" viewBox="0 0 24 24"><g fill="none" fill-rule="evenodd"><path d="m12.593 23.258l-.011.002l-.071.035l-.02.004l-.014-.004l-.071-.035q-.016-.005-.024.005l-.004.01l-.017.428l.005.02l.01.013l.104.074l.015.004l.012-.004l.104-.074l.012-.016l.004-.017l-.017-.427q-.004-.016-.017-.018m.265-.113l-.013.002l-.185.093l-.01.01l-.003.011l.018.43l.005.012l.008.007l.201.093q.019.005.029-.008l.004-.014l-.034-.614q-.005-.018-.02-.022m-.715.002a.02.02 0 0 0-.027.006l-.006.014l-.034.614q.001.018.017.024l.015-.002l.201-.093l.01-.008l.004-.011l.017-.43l-.003-.012l-.01-.01z"/><path fill="currentColor" d="M10.5 2a8.5 8.5 0 1 0 5.262 15.176l3.652 3.652a1 1 0 0 0 1.414-1.414l-3.652-3.652A8.5 8.5 0 0 0 10.5 2M4 10.5a6.5 6.5 0 1 1 13 0a6.5 6.5 0 0 1-13 0"/></g></svg>
        <input id="mobileSearchInput" type="text" placeholder="search..." class="flex-1 text-sm bg-transparent focus:outline-none placeholder-gray-400 min-w-0" />
    </div>

    <!-- Search -->
    <div id="searchInputWrapper" class="relative w-full max-w-2xl h-12 hidden md:flex flex-row bg-silver-100 rounded-md items-center">
        <button id="searchInputBtn" class="h-full w-auto aspect-square flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="text-woodsmoke-950" width="16" height="16" viewBox="0 0 24 24"><g fill="none" fill-rule="evenodd"><path d="m12.593 23.258l-.011.002l-.071.035l-.02.004l-.014-.004l-.071-.035q-.016-.005-.024.005l-.004.01l-.017.428l.005.02l.01.013l.104.074l.015.004l.012-.004l.104-.074l.012-.016l.004-.017l-.017-.427q-.004-.016-.017-.018m.265-.113l-.013.002l-.185.093l-.01.01l-.003.011l.018.43l.005.012l.008.007l.201.093q.019.005.029-.008l.004-.014l-.034-.614q-.005-.018-.02-.022m-.715.002a.02.02 0 0 0-.027.006l-.006.014l-.034.614q.001.018.017.024l.015-.002l.201-.093l.01-.008l.004-.011l.017-.43l-.003-.012l-.01-.01z"/><path fill="currentColor" d="M10.5 2a8.5 8.5 0 1 0 5.262 15.176l3.652 3.652a1 1 0 0 0 1.414-1.414l-3.652-3.652A8.5 8.5 0 0 0 10.5 2M4 10.5a6.5 6.5 0 1 1 13 0a6.5 6.5 0 0 1-13 0"/></g></svg>
        </button>
        
        <input id="searchInput" type="text" placeholder="search users and buckets by name, @username, ID or share link…" class="w-full py-2 text-sm focus:outline-none focus:border-gray-400 placeholder-gray-400 bg-transparent"/>
    </div>

    <!-- Right side -->
    <div class="flex items-center justify-between w-auto md:w-72 shrink-0">
        <div id="headerUserConsoleWrapper" class="flex flex-row gap-x-4 h-auto items-center justify-end flex-1">
            <!-- Notifications -->
            <div id="notificationBtnContainer" class="relative">
            <button id="notificationBtn" class="h-8 w-8 flex items-center justify-center text-woodsmoke-800 relative">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"><g fill="none"><path d="m12.594 23.258l-.012.002l-.071.035l-.02.004l-.014-.004l-.071-.036q-.016-.004-.024.006l-.004.01l-.017.428l.005.02l.01.013l.104.074l.015.004l.012-.004l.104-.074l.012-.016l.004-.017l-.017-.427q-.004-.016-.016-.018m.264-.113l-.014.002l-.184.093l-.01.01l-.003.011l.018.43l.005.012l.008.008l.201.092q.019.005.029-.008l.004-.014l-.034-.614q-.005-.019-.02-.022m-.715.002a.02.02 0 0 0-.027.006l-.006.014l-.034.614q.001.018.017.024l.015-.002l.201-.093l.01-.008l.003-.011l.018-.43l-.003-.012l-.01-.01z"/><path fill="currentColor" d="M12 2a7 7 0 0 0-7 7v3.528a1 1 0 0 1-.105.447l-1.717 3.433A1.1 1.1 0 0 0 4.162 18h15.676a1.1 1.1 0 0 0 .984-1.592l-1.716-3.433a1 1 0 0 1-.106-.447V9a7 7 0 0 0-7-7m0 19a3 3 0 0 1-2.83-2h5.66A3 3 0 0 1 12 21"/></g></svg>
                <!-- unread dot — shown/hidden by JS -->
                <span id="notifDot" class="hidden absolute top-0.5 right-0.5 w-2 h-2 rounded-full bg-orchid-600 ring-2 ring-white"></span>
            </button>

            <!-- Notification modal -->
            <div id="notificationModal" class="hidden absolute right-0 top-full mt-2 bg-white rounded-xl shadow-lg border border-silver-100 z-50" style="width:450px;max-width:calc((100vw - 1rem) * 1.1)">
                <div class="px-4 py-3 border-b border-silver-100 flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <span class="text-sm font-semibold text-woodsmoke-900">Notifications</span>
                        <span id="notifUnreadBadge" class="hidden text-xs font-semibold bg-orchid-100 text-orchid-600 rounded-full px-2 py-0.5"></span>
                    </div>
                    <div class="flex items-center gap-3">
                        <button id="notifMarkReadBtn" class="text-xs text-gray-400 hover:text-woodsmoke-700 transition-colors">Mark all as read</button>
                        <button id="notifClearBtn" class="text-xs text-gray-400 hover:text-red-400 transition-colors">Clear all</button>
                    </div>
                </div>
                <div id="notificationList" class="overflow-y-auto max-h-[440px]">
                    <div class="py-8 text-center text-sm text-gray-400">Loading…</div>
                </div>
            </div>
            </div>

            <!-- Messages -->
            <button class="h-8 w-8 flex items-center justify-center text-woodsmoke-800">
                <% if (user?.hasMessages) { %>
                    <!-- message-1-ai-fill -->
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"><g fill="none" fill-rule="evenodd"><path d="m12.594 23.258l-.012.002l-.071.035l-.02.004l-.014-.004l-.071-.036q-.016-.004-.024.006l-.004.01l-.017.428l.005.02l.01.013l.104.074l.015.004l.012-.004l.104-.074l.012-.016l.004-.017l-.017-.427q-.004-.016-.016-.018m.264-.113l-.014.002l-.184.093l-.01.01l-.003.011l.018.43l.005.012l.008.008l.201.092q.019.005.029-.008l.004-.014l-.034-.614q-.005-.018-.02-.022m-.715.002a.02.02 0 0 0-.027.006l-.006.014l-.034.614q.001.018.017.024l.015-.002l.201-.093l.01-.008l.003-.011l.018-.43l-.003-.012l-.01-.01z"/><path fill="currentColor" d="M14.767 3a2.996 2.996 0 0 0 1.263 4.839l.378.129a1 1 0 0 1 .624.624l.13.378A2.995 2.995 0 0 0 22 10.233L21.999 16a3 3 0 0 1-3 3h-3.697l-2.61 1.74c-.42.28-.966.28-1.386 0L8.697 19H5a3 3 0 0 1-3-3V6a3 3 0 0 1 3-3zM8.5 10a1.5 1.5 0 1 0 0 3a1.5 1.5 0 0 0 0-3m7 0a1.5 1.5 0 1 0 0 3a1.5 1.5 0 0 0 0-3M20 1a1 1 0 0 1 .946.677l.13.378c.3.879.99 1.57 1.87 1.87l.377.129a1 1 0 0 1 0 1.892l-.378.13c-.879.3-1.57.99-1.87 1.87l-.129.377a1 1 0 0 1-1.892 0l-.13-.378a3 3 0 0 0-1.87-1.87l-.377-.129a1 1 0 0 1 0-1.892l.378-.13c.879-.3 1.57-.99 1.87-1.87l.129-.377A1 1 0 0 1 20 1"/></g></svg>
                <% } else { %>
                    <!-- message-1-fill -->
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"><g fill="none"><path d="m12.593 23.258l-.011.002l-.071.035l-.02.004l-.014-.004l-.071-.035q-.016-.005-.024.005l-.004.01l-.017.428l.005.02l.01.013l.104.074l.015.004l.012-.004l.104-.074l.012-.016l.004-.017l-.017-.427q-.004-.016-.017-.018m.265-.113l-.013.002l-.185.093l-.01.01l-.003.011l.018.43l.005.012l.008.007l.201.093q.019.005.029-.008l.004-.014l-.034-.614q-.005-.018-.02-.022m-.715.002a.02.02 0 0 0-.027.006l-.006.014l-.034.614q.001.018.017.024l.015-.002l.201-.093l.01-.008l.004-.011l.017-.43l-.003-.012l-.01-.01z"/><path fill="currentColor" d="M19 3a3 3 0 0 1 3 3v10a3 3 0 0 1-3 3h-3.697l-2.61 1.74c-.42.28-.966.28-1.386 0L8.697 19H5a3 3 0 0 1-3-3V6a3 3 0 0 1 3-3zM8.5 10a1.5 1.5 0 1 0 0 3a1.5 1.5 0 0 0 0-3m7 0a1.5 1.5 0 1 0 0 3a1.5 1.5 0 0 0 0-3"/></g></svg>
                <% } %>
            </button>

            <!-- Avatar (hidden on mobile — lives in bottom tab bar) -->
            <div id="profileMenuContainer" class="hidden md:block relative shrink-0">
                <div id="userAvatarWrapper" class="flex items-center gap-3 cursor-pointer">
                    <div class="w-10 h-10 rounded-full overflow-hidden shrink-0 flex items-center justify-center <%= user?.avatar ? '' : 'bg-orchid-100' %>">
                        <% if (user?.avatar) { %>
                            <img src="<%= user.avatar %>" alt="avatar" class="w-full h-full object-cover">
                        <% } else { %>
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" class="text-orchid-600"><g fill="none"><path d="m12.593 23.258l-.011.002l-.071.035l-.02.004l-.014-.004l-.071-.035q-.016-.005-.024.005l-.004.01l-.017.428l.005.02l.01.013l.104.074l.015.004l.012-.004l.104-.074l.012-.016l.004-.017l-.017-.427q-.004-.016-.017-.018m.265-.113l-.013.002l-.185.093l-.01.01l-.003.011l.018.43l.005.012l.008.007l.201.093q.019.005.029-.008l.004-.014l-.034-.614q-.005-.018-.02-.022m-.715.002a.02.02 0 0 0-.027.006l-.006.014l-.034.614q.001.018.017.024l.015-.002l.201-.093l.01-.008l.004-.011l.017-.43l-.003-.012l-.01-.01z"/><path fill="currentColor" d="M12 13c2.396 0 4.575.694 6.178 1.672c.8.488 1.484 1.064 1.978 1.69c.486.615.844 1.351.844 2.138c0 .845-.411 1.511-1.003 1.986c-.56.45-1.299.748-2.084.956c-1.578.417-3.684.558-5.913.558s-4.335-.14-5.913-.558c-.785-.208-1.524-.506-2.084-.956C3.41 20.01 3 19.345 3 18.5c0-.787.358-1.523.844-2.139c.494-.625 1.177-1.2 1.978-1.69C7.425 13.695 9.605 13 12 13m0-11a5 5 0 1 1 0 10a5 5 0 0 1 0-10"/></g></svg>
                        <% } %>
                    </div>
                    <div class="hidden md:block text-sm leading-tight min-w-0 flex-1">
                        <div class="font-bold text-[1rem] truncate"><%= user?.username ?? 'Guest' %></div>
                        <div class="text-gray-400 text-xs truncate"><%= user?.email ?? '' %></div>
                    </div>
                    <div class="hidden md:block">
                        <span>
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"><g fill="none" fill-rule="evenodd"><path d="M24 0v24H0V0zM12.594 23.258l-.012.002l-.071.035l-.02.004l-.014-.004l-.071-.036q-.016-.004-.024.006l-.004.01l-.017.428l.005.02l.01.013l.104.074l.015.004l.012-.004l.104-.074l.012-.016l.004-.017l-.017-.427q-.004-.016-.016-.018m.264-.113l-.014.002l-.184.093l-.01.01l-.003.011l.018.43l.005.012l.008.008l.201.092q.019.005.029-.008l.004-.014l-.034-.614q-.005-.018-.02-.022m-.715.002a.02.02 0 0 0-.027.006l-.006.014l-.034.614q.001.018.017.024l.015-.002l.201-.093l.01-.008l.003-.011l.018-.43l-.003-.012l-.01-.01z"/><path fill="currentColor" d="M11.293 7.293a1 1 0 0 1 1.414 0l2 2A1 1 0 0 1 14 11h-4a1 1 0 0 1-.707-1.707zm-2.217 6.324A1 1 0 0 1 10 13h4a1 1 0 0 1 .707 1.707l-2 2a1 1 0 0 1-1.414 0l-2-2a1 1 0 0 1-.217-1.09"/></g></svg>
                        </span>
                    </div>
                </div>

                <!-- Profile context menu -->
                <div id="profileContextMenu" class="hidden absolute right-0 top-full mt-2 bg-white rounded-md shadow-lg border border-silver-100 py-1 z-50 w-44">
                    <% if (user && !user.isAnonymous) { %>
                        <a href="/v2/u/<%= user.username %>" class="block px-4 py-2.5 text-sm font-medium text-woodsmoke-700 hover:bg-silver-50 transition-colors">View Profile</a>
                        <div class="border-t border-silver-100 my-1"></div>
                        <button id="profileLogoutBtn" class="w-full px-4 py-2.5 text-sm font-medium text-left text-woodsmoke-700 hover:bg-silver-50 transition-colors">Log Out</button>
                        <div class="border-t border-silver-100 my-1"></div>
                        <button id="profileDeleteBtn" class="w-full px-4 py-2.5 text-sm font-medium text-left text-red-500 hover:bg-red-50 transition-colors">Delete Account</button>
                    <% } else { %>
                        <a href="/v2/login" class="block px-4 py-2.5 text-sm font-medium text-woodsmoke-700 hover:bg-silver-50 transition-colors">Sign In / Log In</a>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</header>

<script>
    const searchInput = document.getElementById('searchInput');
    const searchWrapper = document.getElementById('searchInputWrapper');

    // ── Search redirect ───────────────────────────────────────────────────────
    const mobileSearchInput = document.getElementById('mobileSearchInput');
    const searchInputBtn    = document.getElementById('searchInputBtn');

    function submitSearch(input) {
        var q = (input ? input.value : '').trim();
        if (!q) return;
        window.location.href = '/v2/search?q=' + encodeURIComponent(q);
    }

    if (searchInput) {
        searchInput.addEventListener('keydown', function (e) {
            if (e.key === 'Enter') submitSearch(searchInput);
        });
    }
    if (mobileSearchInput) {
        mobileSearchInput.addEventListener('keydown', function (e) {
            if (e.key === 'Enter') submitSearch(mobileSearchInput);
        });
    }
    if (searchInputBtn) {
        searchInputBtn.addEventListener('click', function () {
            submitSearch(searchInput || mobileSearchInput);
        });
    }

    // ── Profile context menu ──────────────────────────────────────────────────
    const userAvatarWrapper   = document.getElementById('userAvatarWrapper');
    const profileContextMenu  = document.getElementById('profileContextMenu');

    // ── Notification modal ────────────────────────────────────────────────────
    <% if (user && !user.isAnonymous) { %>
    (function () {
        const btn       = document.getElementById('notificationBtn');
        const modal     = document.getElementById('notificationModal');
        const list      = document.getElementById('notificationList');
        const dot       = document.getElementById('notifDot');
        const badge     = document.getElementById('notifUnreadBadge');
        const clearBtn      = document.getElementById('notifClearBtn');
        const markReadBtn   = document.getElementById('notifMarkReadBtn');

        let loaded = false;

        function setBadge(count) {
            if (count > 0) {
                badge.textContent = count + ' unread';
                badge.classList.remove('hidden');
            } else {
                badge.classList.add('hidden');
            }
        }

        // ── helpers ──────────────────────────────────────────────────────────
        function setUnread(hasUnread) {
            dot.classList.toggle('hidden', !hasUnread);
        }

        function positionModal() {
            if (window.innerWidth < 768) {
                // Mobile: 70vw, fixed to viewport so centering works correctly
                const w = window.innerWidth * 0.7;
                modal.style.position  = 'fixed';
                modal.style.width     = w + 'px';
                modal.style.top       = '4.5rem';
                modal.style.right     = 'auto';
                modal.style.left      = '50%';
                modal.style.transform = 'translateX(-50%)';
            } else {
                modal.style.position  = 'absolute';
                modal.style.width     = '450px';
                modal.style.top       = '';
                modal.style.left      = 'auto';
                modal.style.right     = '0';
                modal.style.transform = 'none';
            }
        }

        function timeAgo(dateStr) {
            const diff = Date.now() - new Date(dateStr).getTime();
            const m = Math.floor(diff / 60000);
            if (m < 1)  return 'just now';
            if (m < 60) return m + 'm ago';
            const h = Math.floor(m / 60);
            if (h < 24) return h + 'h ago';
            return Math.floor(h / 24) + 'd ago';
        }

        const USER_ICON = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" class="text-orchid-400"><g fill="none"><path fill="currentColor" d="M12 13c2.396 0 4.575.694 6.178 1.672c.8.488 1.484 1.064 1.978 1.69c.486.615.844 1.351.844 2.138c0 .845-.411 1.511-1.003 1.986c-.56.45-1.299.748-2.084.956c-1.578.417-3.684.558-5.913.558s-4.335-.14-5.913-.558c-.785-.208-1.524-.506-2.084-.956C3.41 20.01 3 19.345 3 18.5c0-.787.358-1.523.844-2.139c.494-.625 1.177-1.2 1.978-1.69C7.425 13.695 9.605 13 12 13m0-11a5 5 0 1 1 0 10a5 5 0 0 1 0-10"/></g></svg>`;

        const BUCKET_ICON = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" class="text-gray-300"><g fill="none"><path fill="currentColor" d="M13 3a1 1 0 1 0-2 0v1.07A8.002 8.002 0 0 0 4 12v1a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3v-1a8.002 8.002 0 0 0-7-7.93zm-1 15a3.001 3.001 0 0 0 2.83-2H9.17A3.001 3.001 0 0 0 12 18"/></g></svg>`;

        function avatarHtml(src, username) {
            const href  = username ? `/v2/u/${encodeURIComponent(username)}` : null;
            const inner = src
                ? `<img src="${escHtml(src)}" class="w-9 h-9 rounded-full object-cover shrink-0" />`
                : `<div class="w-9 h-9 rounded-full bg-orchid-50 shrink-0 flex items-center justify-center">${USER_ICON}</div>`;
            if (!href) return inner;
            return `<a href="${href}" class="shrink-0">${inner}</a>`;
        }

        function bucketThumbHtml(src, bucketId) {
            const href  = bucketId ? `/v2/bucket/${escHtml(bucketId)}` : null;
            const inner = src
                ? `<img src="${escHtml(src)}" class="w-11 h-9 rounded-md object-cover shrink-0" />`
                : `<div class="w-11 h-9 rounded-md bg-silver-100 shrink-0 flex items-center justify-center">${BUCKET_ICON}</div>`;
            if (!href) return inner;
            return `<a href="${href}" class="shrink-0">${inner}</a>`;
        }

        function userLink(username) {
            if (!username) return '<span class="font-semibold">Someone</span>';
            return `<a href="/v2/u/${encodeURIComponent(username)}" class="font-semibold hover:underline">@${escHtml(username)}</a>`;
        }

        function bucketLink(name, bucketId) {
            if (!bucketId) return `<span class="font-semibold">${escHtml(name || 'a bucket')}</span>`;
            return `<a href="/v2/bucket/${escHtml(bucketId)}" class="font-semibold hover:underline">${escHtml(name || 'a bucket')}</a>`;
        }

        function renderItem(n) {
            const d    = n.data || {};
            const base = n.read ? '' : 'bg-orchid-100';
            const nid  = escHtml(String(n._id));

            if (n.type === 'new_follower') {
                const anonId  = escHtml(d.followerAnonymousId || '');
                const btnHtml = `<button
                    class="notif-follow-btn text-xs font-semibold px-3 py-1.5 rounded-md border border-silver-200 text-woodsmoke-700 hover:bg-silver-50 transition-colors shrink-0 whitespace-nowrap"
                    data-anon-id="${anonId}">Follow</button>`;

                return `<div class="flex items-center gap-3 px-4 py-3 ${base} hover:bg-silver-50 transition-colors" data-notif-id="${nid}">
                    ${avatarHtml(d.followerAvatar, d.followerUsername)}
                    <div class="flex-1 min-w-0">
                        <p class="text-sm text-woodsmoke-800 leading-snug">${userLink(d.followerUsername)} followed you</p>
                        <p class="text-xs text-gray-400 mt-0.5">${timeAgo(n.createdAt)}</p>
                    </div>
                    ${btnHtml}
                </div>`;
            }

            let text      = '';
            let bucketId  = d.bucketId || d.sourceBucketId || null;

            switch (n.type) {
                case 'bucket_grabbed':
                    text = `${userLink(d.grabberUsername)} grabbed ${bucketLink(d.bucketName, bucketId)}`;
                    break;
                case 'bucket_unlocked':
                    text = `Someone unlocked ${bucketLink(d.bucketName, bucketId)} · <span class="text-emerald-600 font-semibold">+${d.creditsEarned ?? 0} cr</span>`;
                    break;
                case 'new_bucket_published':
                    text = `${userLink(d.curatorUsername)} published ${bucketLink(d.bucketName, bucketId)}`;
                    break;
                case 'grabbed_bucket_updated':
                    text = `${userLink(d.curatorUsername)} updated ${bucketLink(d.bucketName, bucketId)}`;
                    break;
                default:
                    text = 'New notification';
            }

            return `<div class="flex items-center gap-3 px-4 py-3 ${base} hover:bg-silver-50 transition-colors" data-notif-id="${nid}">
                ${bucketThumbHtml(d.bucketThumbnail, bucketId)}
                <div class="flex-1 min-w-0">
                    <p class="text-sm text-woodsmoke-800 leading-snug">${text}</p>
                    <p class="text-xs text-gray-400 mt-0.5">${timeAgo(n.createdAt)}</p>
                </div>
            </div>`;
        }

        function escHtml(str) {
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;');
        }

        // ── initial unread count (first paint) ───────────────────────────────
        fetch('/api/notifications/unread-count')
            .then(r => r.ok ? r.json() : null)
            .then(data => { if (data) setUnread(data.count > 0); })
            .catch(() => {});

        // ── WebSocket — real-time push ────────────────────────────────────────
        (function connectWS() {
            const proto = location.protocol === 'https:' ? 'wss' : 'ws';
            const ws    = new WebSocket(`${proto}://${location.host}/ws?userId=<%= user._id %>`);

            ws.addEventListener('message', (e) => {
                try {
                    const msg = JSON.parse(e.data);
                    if (msg.type !== 'new_notification') return;
                    setUnread(true);
                    // Invalidate modal cache so next open fetches fresh
                    loaded = false;
                } catch (_) {}
            });

            // Reconnect on drop with a 5s back-off
            ws.addEventListener('close',  () => setTimeout(connectWS, 5000));
            ws.addEventListener('error',  () => ws.close());
        })();

        // ── Follow button ─────────────────────────────────────────────────────
        list.addEventListener('click', async function (e) {
            const btn = e.target.closest('.notif-follow-btn');
            if (!btn) return;
            const anonId = btn.dataset.anonId;
            if (!anonId) return;

            btn.disabled = true;
            btn.textContent = '…';

            try {
                const res = await fetch(`/api/users/${anonId}/subscribe`, { method: 'POST' });
                if (res.ok || res.status === 409) {
                    // 409 = already following — both cases show DM
                    btn.textContent = 'DM';
                    btn.classList.remove('border-silver-200', 'text-woodsmoke-700');
                    btn.classList.add('border-orchid-200', 'text-orchid-600');
                    btn.disabled = false;
                } else {
                    btn.textContent = 'Follow';
                    btn.disabled = false;
                }
            } catch (_) {
                btn.textContent = 'Follow';
                btn.disabled = false;
            }
        });

        // ── Mark individual notif as read on interaction (link click or follow btn) ──
        list.addEventListener('click', function (e) {
            if (!e.target.closest('a, .notif-follow-btn')) return;
            const item = e.target.closest('[data-notif-id]');
            if (!item) return;
            const id = item.dataset.notifId;
            fetch('/api/notifications/read', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ ids: [id] }),
            }).catch(() => {});
            if (item.classList.contains('bg-orchid-100')) {
                item.classList.remove('bg-orchid-100');
                const current = parseInt(badge.textContent) || 0;
                setBadge(Math.max(0, current - 1));
            }
        });

        // ── Clear all ─────────────────────────────────────────────────────────
        clearBtn.addEventListener('click', function (e) {
            e.stopPropagation();
            fetch('/api/notifications/clear', { method: 'POST' })
                .catch(() => {});
            list.innerHTML = '<p class="py-8 text-center text-sm text-gray-400">No notifications yet</p>';
            setBadge(0);
            setUnread(false);
            loaded = true; // prevent re-fetch from showing stale data
        });

        // ── open / close ──────────────────────────────────────────────────────
        function onModalClose() {
            if (!loaded) return;
            fetch('/api/notifications/seen', { method: 'POST' }).catch(() => {});
            setUnread(false);
        }

        btn.addEventListener('click', function (e) {
            e.stopPropagation();
            const opening = modal.classList.toggle('hidden') === false;
            if (opening) {
                positionModal();
                if (!loaded) loadNotifications();
            } else {
                onModalClose();
            }
        });

        document.addEventListener('click', function () {
            if (!modal.classList.contains('hidden')) onModalClose();
            modal.classList.add('hidden');
        });

        modal.addEventListener('click', function (e) { e.stopPropagation(); });

        // ── load & render ─────────────────────────────────────────────────────
        // ── Mark all as read ──────────────────────────────────────────────────
        markReadBtn.addEventListener('click', function (e) {
            e.stopPropagation();
            fetch('/api/notifications/read', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: '{}' })
                .catch(() => {});
            // Remove orchid bg from every rendered item immediately
            list.querySelectorAll('.bg-orchid-100').forEach(el => el.classList.remove('bg-orchid-100'));
            setBadge(0);
            setUnread(false);
        });

        function loadNotifications() {
            loaded = true;
            fetch('/api/notifications?limit=20')
                .then(r => r.ok ? r.json() : Promise.reject())
                .then(({ notifications }) => {
                    if (!notifications.length) {
                        list.innerHTML = '<p class="py-8 text-center text-sm text-gray-400">No notifications yet</p>';
                        return;
                    }
                    list.innerHTML = notifications.map(renderItem).join('') +
                        (notifications.length === 20
                            ? '<p class="py-2 text-center text-xs text-gray-400">Showing latest 20</p>'
                            : '');
                    setBadge(notifications.filter(n => !n.read).length);
                })
                .catch(() => {
                    list.innerHTML = '<p class="py-8 text-center text-sm text-gray-400">Failed to load</p>';
                });
        }
    })();
    <% } else { %>
    document.getElementById('notificationBtn')?.addEventListener('click', function () {
        window.location.href = '/v2/signup';
    });
    <% } %>

    if (userAvatarWrapper && profileContextMenu) {
        userAvatarWrapper.addEventListener('click', function (e) {
            e.stopPropagation();
            profileContextMenu.classList.toggle('hidden');
        });

        document.addEventListener('click', function () {
            profileContextMenu.classList.add('hidden');
        });

        profileContextMenu.addEventListener('click', function (e) {
            e.stopPropagation();
        });

        const profileLogoutBtn = document.getElementById('profileLogoutBtn');
        if (profileLogoutBtn) {
            profileLogoutBtn.addEventListener('click', async function () {
                try {
                    await fetch('/api/auth/logout', { method: 'POST' });
                } catch (_) {}
                window.location.href = '/';
            });
        }
    }
</script>

            renderLinks();
        });

        return row;
    }

    function applySearch() {
        var q = linksSearchInput.value.trim().toLowerCase();
        linksSearchClear.classList.toggle('hidden', !q);

        if (state.links.length === 0) return; // empty state already shown by renderLinks

        var rows = linksList.querySelectorAll('[data-link-id]');
        var visibleCount = 0;
        rows.forEach(function (row) {
            var link = state.links.find(function (l) { return l.id === row.dataset.linkId; });
            var matches = !q || (link && (
                link.title.toLowerCase().includes(q) ||
                link.url.toLowerCase().includes(q)
            ));
            row.classList.toggle('hidden', !matches);
            if (matches) visibleCount++;
        });

        linksSearchEmpty.classList.toggle('hidden', visibleCount > 0);
        linksSearchEmpty.classList.toggle('flex', visibleCount === 0);
    }

    function renderLinks() {
        // Clear existing rows (not the empty/search-empty states)
        var rows = linksList.querySelectorAll('[data-link-id]');
        rows.forEach(function (r) { r.remove(); });

        if (state.links.length === 0) {
            linksEmptyState.classList.remove('hidden');
            linksSearchEmpty.classList.add('hidden');
            updateBulkBar();
            return;
        }

        linksEmptyState.classList.add('hidden');
        state.links.forEach(function (link) {
            linksList.appendChild(buildLinkRow(link));
        });
        updateBulkBar();
        applySearch(); // re-apply any active filter after re-render
    }

    linksSearchInput.addEventListener('input', applySearch);

    linksSearchClear.addEventListener('click', function () {
        linksSearchInput.value = '';
        linksSearchClear.classList.add('hidden');
        applySearch();
        linksSearchInput.focus();
    });

    // Add link
    function tryAddLink() {
        var title = newLinkTitle.value.trim();
        var url   = newLinkUrl.value.trim();
        if (!url) { newLinkUrl.focus(); return; }
        state.links.push({ id: uid(), title: title || url, url: url, thumb: null, monetized: false, checked: false });
        newLinkTitle.value = '';
        newLinkUrl.value   = '';
        newLinkTitle.focus();
        renderLinks();
    }

    function updateAddBtn() {
        addLinkBtn.disabled = !newLinkTitle.value.trim() || !newLinkUrl.value.trim();
    }

    newLinkTitle.addEventListener('input', updateAddBtn);
    newLinkUrl.addEventListener('input', updateAddBtn);

    addLinkBtn.addEventListener('click', tryAddLink);
    newLinkUrl.addEventListener('keydown', function (e) { if (e.key === 'Enter') tryAddLink(); });
    newLinkTitle.addEventListener('keydown', function (e) { if (e.key === 'Enter') { newLinkUrl.focus(); } });

    // Per-link thumb upload
    linkThumbInput.addEventListener('change', function () {
        var id   = state._linkThumbTargetId;
        var file = this.files[0];
        if (!id || !file) return;
        if (!['image/jpeg', 'image/jpg', 'image/png'].includes(file.type)) { alert('Only JPG and PNG images are allowed.'); this.value = ''; return; }
        if (file.size > 5 * 1024 * 1024) { alert('Image must be under 5 MB.'); this.value = ''; return; }

        var reader = new FileReader();
        reader.onload = function (ev) {
            var link = state.links.find(function (l) { return l.id === id; });
            if (!link) return;
            link.thumb = ev.target.result;
            var row = linksList.querySelector('[data-link-id="' + id + '"]');
            if (row) {
                var box = row.querySelector('.link-thumb-box');
                box.innerHTML = '<img src="' + escapeHtml(ev.target.result) + '" class="w-full h-full object-cover" />';
            }
        };
        reader.readAsDataURL(file);
        this.value = '';
    });

    // ── Bulk select bar ───────────────────────────────────────────────────────
    function updateBulkBar() {
        var checked = state.links.filter(function (l) { return l.checked; });
        var allChecked = state.links.length > 0 && checked.length === state.links.length;

        bulkCheckboxUnchecked.classList.toggle('hidden', allChecked);
        bulkCheckboxChecked.classList.toggle('hidden', !allChecked);

        if (checked.length > 0) {
            bulkActions.classList.remove('hidden');
            bulkActions.classList.add('flex');

            // Reflect monetize toggle state: all selected are monetized → active style
            var allMonetized = checked.length > 0 && checked.every(function (l) { return l.monetized; });
            bulkMonetizeBtn.textContent = allMonetized ? 'Unmonetize All' : 'Monetize All';
            bulkMonetizeBtn.className = 'px-3 h-8 items-center justify-center text-sm rounded-md font-medium transition-colors ' +
                (allMonetized
                    ? 'bg-orchid-600 text-white hover:bg-orchid-700'
                    : 'bg-orchid-50 text-orchid-600 hover:bg-orchid-100');
        } else {
            bulkActions.classList.add('hidden');
            bulkActions.classList.remove('flex');
        }
    }

    bulkSelectAllBtn.addEventListener('click', function () {
        var allChecked = state.links.length > 0 && state.links.every(function (l) { return l.checked; });
        state.links.forEach(function (l) { l.checked = !allChecked; });
        renderLinks();
    });

    bulkDeleteBtn.addEventListener('click', function () {
        state.links = state.links.filter(function (l) { return !l.checked; });
        renderLinks();
    });

    bulkCopyBtn.addEventListener('click', function () {
        var urls = state.links.filter(function (l) { return l.checked; }).map(function (l) { return l.url; });
        navigator.clipboard.writeText(urls.join('\n')).catch(function () {});
    });

    bulkMonetizeBtn.addEventListener('click', function () {
        var checked = state.links.filter(function (l) { return l.checked; });
        var allMonetized = checked.length > 0 && checked.every(function (l) { return l.monetized; });
        checked.forEach(function (l) { l.monetized = !allMonetized; });
        renderLinks();
    });

    // ── Save / Submit ─────────────────────────────────────────────────────────
    submitBtn.addEventListener('click', async function () {
        hideError();
        var name = nameInput.value.trim();
        if (!name) {
            showError('Please enter a bucket name.');
            nameInput.focus();
            return;
        }

        setLoading(true);
        try {
            var payload = {
                name:        name,
                visibility:  state.visibility,
                monetized:   state.monetization,
                price:       priceAsEWL(),
                mature:      state.mature,
                tags:        state.tags,
                description: descInput.value.trim(),
                sourceUrl:   sourceUrlInput.value.trim(),
                thumbnail:   state.thumbnail ? state.thumbnail.dataUrl : null,
                links:       state.links.map(function (l) { return { title: l.title, url: l.url, thumb: l.thumb, monetized: l.monetized }; })
            };

            var isEdit = !!state._editBucket;
            var url    = isEdit ? '/api/buckets/' + state._editBucket._id + '/full' : '/api/buckets';
            var method = isEdit ? 'PATCH' : 'POST';

            var res  = await fetch(url, { method: method, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
            var data = await res.json();

            if (res.ok) {
                closeModal();
                // Reload the profile page to reflect changes
                if (window.location.pathname.startsWith('/v2/@')) {
                    window.location.reload();
                }
            } else if (res.status === 409) {
                showError('You already have a bucket with that name.');
                setLoading(false);
                nameInput.focus();
            } else {
                showError(data.error || 'Something went wrong. Please try again.');
                setLoading(false);
            }
        } catch (err) {
            showError('Network error. Please try again.');
            setLoading(false);
        }
    });

})();
</script>


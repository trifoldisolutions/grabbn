<!-- Hidden file input for per-link thumbnail uploads -->
<input id="linkThumbFileInput" type="file" accept=".jpg,.jpeg,.png" class="hidden" />


<script>
(function () {
    var user = window.__GRABBN_USER__;

    // ── Auth gate ────────────────────────────────────────────────────────────
    if (!user || user.isAnonymous) {
        ['newBucketCreationBtn', 'bookmarkletToolBtn'].forEach(function (id) {
            var btn = document.getElementById(id);
            if (btn) {
                btn.addEventListener('click', function (e) {
                    e.stopImmediatePropagation();
                    window.location.href = '/signup.html';
                }, true);
            }
        });
        return;
    }

    // ── State ────────────────────────────────────────────────────────────────
    var state = {
        links: [],          // { id, title, url, thumb: null, monetized: false, checked: false }
        tags:  [],
        visibility:  'public',
        monetization: false,
        mature:       false,
        thumbnail:    null, // { dataUrl, visible }
        _linkThumbTargetId: null,
        _editBucket:  null  // { _id, name } when editing an existing bucket
    };

    // ── Element refs ─────────────────────────────────────────────────────────
    var modal          = document.getElementById('newBucketModal');
    var modalStats          = document.getElementById('modalBucketStats');
    var modalStatGrabs      = document.getElementById('modalStatGrabs');
    var modalStatViews      = document.getElementById('modalStatViews');
    var modalStatShares     = document.getElementById('modalStatShares');
    var modalViewerLink     = document.getElementById('modalViewAsViewerLink');
    var backdrop       = document.getElementById('newBucketBackdrop');
    var nameInput      = document.getElementById('newBucketNameInput');
    var charCount      = document.getElementById('newBucketCharCount');
    var errorEl        = document.getElementById('newBucketError');
    var submitBtn      = document.getElementById('newBucketSubmitBtn');
    var submitLabel    = document.getElementById('newBucketSubmitLabel');
    var spinner        = document.getElementById('newBucketSpinner');
    var cancelBtn      = document.getElementById('newBucketCancelBtn');
    var deleteBtn      = document.getElementById('newBucketDeleteBtn');
    var deleteBtnLabel = document.getElementById('newBucketDeleteLabel');
    var triggerBtn     = document.getElementById('newBucketCreationBtn');

    // Thumb
    var thumbSquare      = document.getElementById('thumbnailSquare');
    var thumbPlaceholder = document.getElementById('thumbPlaceholder');
    var thumbLoading     = document.getElementById('thumbLoading');
    var thumbPreview     = document.getElementById('thumbPreviewImg');
    var thumbActionBtns  = document.getElementById('thumbActionBtns');
    var thumbVisBtn      = document.getElementById('thumbVisibilityBtn');
    var thumbEyeOpen     = document.getElementById('thumbEyeIcon');
    var thumbEyeClosed   = document.getElementById('thumbEyeClosedIcon');
    var thumbDeleteBtn   = document.getElementById('thumbDeleteBtn');
    var thumbFileInput   = document.getElementById('thumbnailFileInput');

    // Description
    var descInput        = document.getElementById('bucketDescription');
    var descCharCount    = document.getElementById('bucketDescCharCount');

    descInput.addEventListener('input', function () {
        descCharCount.textContent = descInput.value.length + ' / 256';
    });

    // Source URL
    var sourceUrlInput   = document.getElementById('bucketSourceUrl');
    var copySourceBtn    = document.getElementById('copySourceUrlBtn');
    var deleteSourceBtn  = document.getElementById('deleteSourceUrlBtn');

    // Links (col 2)
    var newLinkTitle     = document.getElementById('newLinkTitle');
    var newLinkUrl       = document.getElementById('newLinkUrl');
    var addLinkBtn       = document.getElementById('addLinkBtn');
    var pasteLinkTitleBtn = document.getElementById('pasteLinkTitleBtn');
    var clearLinkTitleBtn = document.getElementById('clearLinkTitleBtn');
    var pasteLinkUrlBtn   = document.getElementById('pasteLinkUrlBtn');

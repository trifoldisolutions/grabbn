            <a id="bookmarkletLink" href=""
                class="inline-flex items-center gap-x-1.5 px-4 py-2 bg-orchid-600 hover:bg-orchid-700 text-white text-sm font-semibold rounded-md cursor-grab active:cursor-grabbing select-none transition-colors"
                onclick="return false;"
                title="Drag this to your bookmarks bar">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"><g fill="none" fill-rule="evenodd"><path d="m12.594 23.258l-.012.002l-.071.035l-.02.004l-.014-.004l-.071-.036q-.016-.004-.024.006l-.004.01l-.017.428l.005.02l.01.013l.104.074l.015.004l.012-.004l.104-.074l.012-.016l.004-.017l-.017-.427q-.004-.016-.016-.018m.264-.113l-.014.002l-.184.093l-.01.01l-.003.011l.018.43l.005.012l.008.008l.201.092q.019.005.029-.008l.004-.014l-.034-.614q-.005-.019-.02-.022m-.715.002a.02.02 0 0 0-.027.006l-.006.014l-.034.614q.001.018.017.024l.015-.002l.201-.093l.01-.008l.003-.011l.018-.43l-.003-.012l-.01-.01z"/><path fill="currentColor" d="M5 5a3 3 0 0 1 3-3h8a3 3 0 0 1 3 3v6a1 1 0 1 1-2 0V5a1 1 0 0 0-1-1H8a1 1 0 0 0-1 1v14.131l4.168-2.778a1.5 1.5 0 0 1 1.664 0l.723.482a1 1 0 0 1-1.11 1.664L12 18.202l-4.668 3.112C6.335 21.978 5 21.264 5 20.066zm14 10a1 1 0 0 1 1 1v2h2a1 1 0 1 1 0 2h-2v2a1 1 0 1 1-2 0v-2h-2a1 1 0 1 1 0-2h2v-2a1 1 0 0 1 1-1"/></g></svg>
                Grabbn
            </a>
        </div>
        <p class="text-xs text-center text-woodsmoke-400">Drag to your bookmarks bar · or copy the code below</p>
        <div class="flex flex-row gap-x-2 items-start">
            <code id="bookmarkletCode" class="flex-1 text-xs bg-silver-50 border border-silver-200 rounded-lg p-2 break-all font-mono text-woodsmoke-500 overflow-auto max-h-20 leading-relaxed">Generating…</code>
            <button id="copyBookmarkletBtn" class="shrink-0 px-3 py-2 text-xs font-semibold border border-silver-200 rounded-lg hover:bg-silver-50 transition-colors text-woodsmoke-700">Copy</button>
        </div>
    </div>
</div>

<script>
(function () {
    var bookmarkletModal      = document.getElementById('bookmarkletModal');
    var bookmarkletLink       = document.getElementById('bookmarkletLink');
    var bookmarkletCode       = document.getElementById('bookmarkletCode');
    var closeBookmarkletModal = document.getElementById('closeBookmarkletModal');
    var copyBookmarkletBtn    = document.getElementById('copyBookmarkletBtn');
    var bookmarkletToolBtn    = document.getElementById('bookmarkletToolBtn');
    var bookmarkletToolBtn2   = document.getElementById('bookmarkletToolBtn2');

    if (!bookmarkletModal) return;

    var origin = window.location.origin;
    var cachedCode = null;

    var SPINNER_SVG = '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" style="animation:grabbn-btn-spin .7s linear infinite"><g fill="none" fill-rule="evenodd"><path d="m12.593 23.258l-.011.002l-.071.035l-.02.004l-.014-.004l-.071-.035q-.016-.005-.024.005l-.004.01l-.017.428l.005.02l.01.013l.104.074l.015.004l.012-.004l.104-.074l.012-.016l.004-.017l-.017-.427q-.004-.016-.017-.018m.265-.113l-.013.002l-.185.093l-.01.01l-.003.011l.018.43l.005.012l.008.007l.201.093q.019.005.029-.008l.004-.014l-.034-.614q-.005-.018-.02-.022m-.715.002a.02.02 0 0 0-.027.006l-.006.014l-.034.614q.001.018.017.024l.015-.002l.201-.093l.01-.008l.004-.011l.017-.43l-.003-.012l-.01-.01z"/><path fill="currentColor" d="M12 4a8 8 0 1 0 0 16a8 8 0 0 0 0-16M2 12C2 6.477 6.477 2 12 2s10 4.477 10 10s-4.477 10-10 10S2 17.523 2 12" opacity="0.1"/><path fill="currentColor" d="M12 4a7.96 7.96 0 0 0-5.533 2.222a1 1 0 1 1-1.384-1.444A9.96 9.96 0 0 1 12 2a1 1 0 1 1 0 2"/></g></svg>';

    // Inject keyframe once
    var _ks = document.createElement('style');
    _ks.textContent = '@keyframes grabbn-btn-spin{to{transform:rotate(360deg)}}';
    document.head.appendChild(_ks);

    function setButtonSpinner(btn, spinning) {
        if (!btn) return;
        if (spinning) {
            btn.dataset.origHtml = btn.innerHTML;
            btn.innerHTML = SPINNER_SVG;
            btn.disabled = true;
        } else {
            if (btn.dataset.origHtml) btn.innerHTML = btn.dataset.origHtml;
            btn.disabled = false;
        }
    }

    function buildCode(bkToken) {
        var safeTok = String(bkToken || '').replace(/['"\\]/g, '');
        return `javascript:(function(){var ex=document.getElementById('grabbn-widget');if(ex){ex.remove();return;}function xi(a,base){var el=a,img,src,attrs=['data-src','data-lazy','data-original','data-srcset','src'],depth=0;while(el&&depth<5){img=el.querySelector('img');if(img){for(var k=0;k<attrs.length;k++){src=(img.getAttribute(attrs[k])||'').trim();if(src.indexOf(' ')!==-1)src=src.split(',')[0].trim().split(' ')[0];if(src&&src.indexOf('data:')!==0&&src.indexOf('.svg')===-1){try{return new URL(src,base).href;}catch{}}}}el=el.parentElement;depth++;}return null;}function xl(doc,base){var l=[],s=new Set();doc.querySelectorAll('a[href]').forEach(function(a){var r=a.getAttribute('href');if(!r||r[0]==='#'||/^(javascript|mailto|tel):/.test(r))return;try{var h=new URL(r,base).href;if(s.has(h))return;s.add(h);var t=(a.title||a.getAttribute('aria-label')||'').trim();if(!t){var i=a.querySelector('img');if(i)t=(i.alt||'').trim();}if(!t){var f=a.textContent.trim().replace(/\\s+/g,' ');t=f.replace(/[$€£¥][\\d\\s,.]+.*/,'').trim()||f;}t=t.slice(0,120);if(t.length>2)l.push({href:h,text:t,image:xi(a,base)});}catch{}});return l;}var WN_KEY='grabbn:'+location.hostname+':';var acc=null;try{if(window.name&&window.name.indexOf(WN_KEY)===0)acc=JSON.parse(window.name.slice(WN_KEY.length));}catch{}if(acc&&acc.pagesCollected>=50){alert('Grabbn: 50-page limit reached. Save your current collection first, then continue grabbing.');return;}var curLinks=xl(document,location.href);var seen=new Set(acc?acc.links.map(function(l){return l.href;}):[]);var merged=acc?acc.links.slice():[];curLinks.forEach(function(l){if(!seen.has(l.href)){merged.push(l);seen.add(l.href);}});if(merged.length>2000)merged=merged.slice(0,2000);var pagesCollected=(acc?acc.pagesCollected:0)+1;try{window.name=WN_KEY+JSON.stringify({links:merged,pagesCollected:pagesCollected});}catch{}var maxPage=1,cp=parseInt(new URLSearchParams(location.search).get('page')||'1',10);document.querySelectorAll('a[href]').forEach(function(a){var m=(a.getAttribute('href')||'').match(/[?&]page=(\\d+)/i);if(m){var n=parseInt(m[1],10);if(n>maxPage)maxPage=n;}});var sty=document.createElement('style');sty.textContent='@keyframes grabbn-spin{to{transform:rotate(360deg)}}';document.head.appendChild(sty);var ov=document.createElement('div');ov.id='grabbn-widget';ov.style.cssText='position:fixed;bottom:20px;right:20px;width:380px;height:560px;z-index:2147483647;border-radius:12px;box-shadow:0 8px 32px rgba(0,0,0,.2);overflow:hidden;background:#fff;border:1px solid #e5e7eb;';var xb=document.createElement('button');xb.title='Close';xb.textContent='\u00d7';xb.style.cssText='position:absolute;top:9px;right:9px;z-index:10;background:rgba(255,255,255,.95);border:1px solid #e5e7eb;border-radius:6px;width:24px;height:24px;font-size:16px;cursor:pointer;color:#6b7280;display:flex;align-items:center;justify-content:center;padding:0;line-height:1;';xb.onclick=function(){ov.remove();};ov.appendChild(xb);var ld=document.createElement('div');ld.style.cssText='display:flex;align-items:center;justify-content:center;height:100%;flex-direction:column;gap:8px;color:#9ca3af;font-size:13px;font-family:-apple-system,BlinkMacSystemFont,sans-serif;';ld.innerHTML='<div style="width:20px;height:20px;border:2px solid #f3e8ff;border-top-color:#b346b3;border-radius:50%;animation:grabbn-spin .8s linear infinite;"></div><span>Loading Grabbn\u2026</span>';ov.appendChild(ld);document.body.appendChild(ov);var wf=null;window.addEventListener('message',function(e){if(e.origin!=='${origin}')return;if(e.data==='grabbn-close'){ov.remove();return;}if(e.data==='grabbn-reset'){try{window.name='';}catch{}return;}if(e.data&&e.data.type==='grabbn-fetch-pages'){var urls=e.data.urls;urls.forEach(function(u,i){fetch(u).then(function(r){return r.text();}).then(function(html){var d2=new DOMParser().parseFromString(html,'text/html');var pl=xl(d2,u);if(wf)wf.contentWindow.postMessage({type:'grabbn-page-links',links:pl,pageUrl:u,index:i,total:urls.length},'${origin}');}).catch(function(){if(wf)wf.contentWindow.postMessage({type:'grabbn-page-links',links:[],pageUrl:u,index:i,total:urls.length,error:true},'${origin}');});});}});fetch('${origin}/api/popup-session',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({links:merged,sourceUrl:location.href,maxPage:maxPage,currentPage:cp,pagesCollected:pagesCollected,bkt:'${safeTok}'})}).then(function(r){return r.json();}).then(function(d){if(!d.token){ld.querySelector('span').textContent='Server error.';return;}ld.remove();var fr=document.createElement('iframe');fr.src='${origin}/popup.html?session='+d.token;fr.style.cssText='width:100%;height:100%;border:none;display:block;';ov.appendChild(fr);wf=fr;}).catch(function(){ld.querySelector('span').textContent='Could not connect.';});})();`;
    }

    async function openBookmarkletModal(triggerBtn) {
        if (cachedCode) {
            bookmarkletModal.classList.remove('hidden');
            return;
        }
        setButtonSpinner(triggerBtn, true);
        bookmarkletCode.textContent = 'Generating…';
        try {
            var res = await fetch('/api/auth/bookmarklet-token', { credentials: 'include' });
            var data = await res.json();
            cachedCode = buildCode(data.token);
        } catch {
            cachedCode = buildCode('');
        }
        setButtonSpinner(triggerBtn, false);
        if (bookmarkletLink) bookmarkletLink.href = cachedCode;
        if (bookmarkletCode) bookmarkletCode.textContent = cachedCode;
        bookmarkletModal.classList.remove('hidden');
    }

    function closeModal() {
        bookmarkletModal.classList.add('hidden');
    }

    if (bookmarkletToolBtn)  bookmarkletToolBtn.addEventListener('click',  function () { openBookmarkletModal(bookmarkletToolBtn); });
    if (bookmarkletToolBtn2) bookmarkletToolBtn2.addEventListener('click', function () { openBookmarkletModal(bookmarkletToolBtn2); });

    closeBookmarkletModal.addEventListener('click', closeModal);
    bookmarkletModal.addEventListener('click', function (e) {
        if (e.target === bookmarkletModal) closeModal();
    });

    copyBookmarkletBtn.addEventListener('click', async function () {
        if (!cachedCode) return;
        try {
            await navigator.clipboard.writeText(cachedCode);
            copyBookmarkletBtn.textContent = 'Copied!';
            setTimeout(function () { copyBookmarkletBtn.textContent = 'Copy'; }, 2000);
        } catch {}
    });
})();
</script>

</body>

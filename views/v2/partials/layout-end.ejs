            <h3 class="font-bold text-woodsmoke-950 text-base">Get the Bookmarklet</h3>
            <button id="closeBookmarkletModal" class="w-8 h-8 flex items-center justify-center rounded-full text-woodsmoke-400 hover:text-woodsmoke-950 hover:bg-silver-100 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"><path fill="currentColor" d="m12 13.414 4.243 4.243a1 1 0 0 0 1.414-1.414L13.414 12l4.243-4.243a1 1 0 0 0-1.414-1.414L12 10.586 7.757 6.343a1 1 0 0 0-1.414 1.414L10.586 12l-4.243 4.243a1 1 0 1 0 1.414 1.414z"/></svg>
            </button>

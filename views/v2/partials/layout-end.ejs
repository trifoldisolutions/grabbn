<div id="globalImgLightbox" class="hidden fixed inset-0 z-[200] flex items-center justify-center cursor-zoom-out" aria-modal="true" role="dialog">
    <div class="absolute inset-0 bg-woodsmoke-950/85 backdrop-blur-sm"></div>
    <img id="globalImgLightboxImg" src="" alt="" class="relative w-[98vw] h-[96vh] rounded-lg shadow-2xl object-contain select-none">
    <button id="globalImgLightboxClose" class="absolute top-4 right-4 w-9 h-9 flex items-center justify-center rounded-full bg-white/10 hover:bg-white/20 text-white transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path fill="currentColor" d="m12 13.414 4.243 4.243a1 1 0 0 0 1.414-1.414L13.414 12l4.243-4.243a1 1 0 0 0-1.414-1.414L12 10.586 7.757 6.343a1 1 0 0 0-1.414 1.414L10.586 12l-4.243 4.243a1 1 0 1 0 1.414 1.414z"/></svg>
    </button>
</div>
<script>
(function () {
    var lb      = document.getElementById('globalImgLightbox');
    var lbImg   = document.getElementById('globalImgLightboxImg');
    var lbClose = document.getElementById('globalImgLightboxClose');

    window.openGlobalLightbox = function (src) {
        lbImg.src = src;
        lb.classList.remove('hidden');
    };

    function close() {
        lb.classList.add('hidden');
        lbImg.src = '';
    }

    lb.addEventListener('click', function (e) { if (e.target !== lbImg) close(); });
    lbClose.addEventListener('click', close);
    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && !lb.classList.contains('hidden')) close();
    });
})();
</script>


    // EWL ↔ USD rate (placeholder; swap with live rate when available)
    var EWL_TO_USD = 0.01; // 1 EWL = $0.01 USD
    var currentCurrency = 'EWL'; // 'EWL' | 'USD'
    var currencyToggleBtn = document.getElementById('currencyToggleBtn');

    // ── Price formatting helpers (US format: 1,234.56) ───────────────────────
    // Sanitise raw input: keep digits + at most one period (decimal)
    function sanitisePriceRaw(val) {
        var cleaned = val.replace(/[^\d.]/g, '');
        var dotIdx = cleaned.indexOf('.');
        if (dotIdx !== -1) {
            cleaned = cleaned.slice(0, dotIdx + 1) + cleaned.slice(dotIdx + 1).replace(/\./g, '');
        }
        return cleaned;
    }
    // Add comma thousands separators to the integer portion
    function formatPriceDisplay(sanitised) {
        var parts = sanitised.split('.');
        var integer = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, ',');
        return integer + (parts.length > 1 ? '.' + parts[1] : '');
    }
    // Parse display value back to a JS number (strip commas — period is already decimal)
    function parsePriceValue(display) {
        return parseFloat(display.replace(/,/g, '')) || 0;
    }
    function updateFiatLine() {
        var raw = parsePriceValue(monetizationAmountInput.value);
        if (currentCurrency === 'EWL') {
            var usd = (raw * EWL_TO_USD).toFixed(2);
            monetizationFiatValue.textContent = '≈ $' + usd + ' USD';
        } else {
            var ewl = Math.round(raw / EWL_TO_USD);
            monetizationFiatValue.textContent = '≈ ' + Number(ewl).toLocaleString('en-US') + ' EWL';
        }
    }

    // Returns the price in EWL regardless of which currency the user entered
    function priceAsEWL() {
        var raw = parsePriceValue(monetizationAmountInput.value);
        return currentCurrency === 'USD' ? raw / EWL_TO_USD : raw;
    }

    // ── Helpers ──────────────────────────────────────────────────────────────
    function uid() { return Math.random().toString(36).slice(2, 9); }

    function showError(msg) {
        errorEl.textContent = msg;
        errorEl.classList.remove('hidden');
        nameInput.classList.add('border-red-400');
        nameInput.classList.remove('border-silver-200');
    }

    function hideError() {
        errorEl.classList.add('hidden');
        nameInput.classList.remove('border-red-400');
        nameInput.classList.add('border-silver-200');
    }

    function setLoading(on) {
        submitBtn.disabled = on;
        spinner.classList.toggle('hidden', !on);
        submitLabel.classList.toggle('hidden', on);
    }

    function resetState() {
        state.links        = [];
        state.tags         = [];
        state.visibility   = 'public';
        state.monetization = false;
        state.mature       = false;
        state.thumbnail    = null;
        state._linkThumbTargetId = null;
        state._editBucket  = null;
    }

    function updateCharCount() {
        var len = nameInput.value.length;
        charCount.textContent = len + ' / 120';
        charCount.classList.toggle('text-red-500',    len >= 110);
        charCount.classList.toggle('text-woodsmoke-400', len < 110);
        submitBtn.disabled = len === 0;
    }

    nameInput.addEventListener('input', updateCharCount);

    function resetUI() {
        nameInput.value = '';
        descInput.value = '';
        descCharCount.textContent = '0 / 256';
        sourceUrlInput.value = '';
        linksSearchInput.value = '';
        linksSearchClear.classList.add('hidden');
        linksSearchEmpty.classList.add('hidden');
        hideError();
        updateCharCount();
        setLoading(false);

        // Thumbnail
        thumbPlaceholder.classList.remove('hidden');
        thumbLoading.classList.add('hidden');
        thumbPreview.classList.add('hidden');
        thumbPreview.src = '';
        thumbActionBtns.classList.add('hidden');
        thumbEyeOpen.classList.remove('hidden');
        thumbEyeClosed.classList.add('hidden');

        // Links
        renderLinks();

        // Tags
        renderTags();

        // Toggles
        setVisSegment('public');
        setToggle(monetizationToggle, false);
        monetizationToggle.disabled = false;
        monetizationToggle.classList.remove('opacity-40', 'cursor-not-allowed');
        monetizationLabel.textContent = 'Disabled';
        monetizationAmountPanel.classList.add('hidden');
        monetizationAmountInput.value = '';
        currentCurrency = 'EWL';
        currencyToggleBtn.textContent = 'EWL';
        monetizationFiatValue.textContent = '≈ $0.00 USD';
        setToggle(matureToggle,       false);

        // Inputs
        newLinkTitle.value = '';
        newLinkUrl.value   = '';
        tagInput.value     = '';
        addLinkBtn.disabled = true;
    }

    // ── Mobile tab switching ──────────────────────────────────────────────────
    var tabPanels = {
        details:  document.querySelector('[data-tab-panel="details"]'),
        content:  document.querySelector('[data-tab-panel="content"]'),
        settings: document.querySelector('[data-tab-panel="settings"]')
    };
    var tabBtns = document.querySelectorAll('[data-bucket-tab]');

    function isMobileLayout() { return window.innerWidth < 1024; }

    function switchBucketTab(tabName) {
        Object.keys(tabPanels).forEach(function (key) {
            var isMobile = isMobileLayout();
            var isActive = key === tabName;
            tabPanels[key].style.display  = isMobile ? (isActive ? 'flex' : 'none') : '';
            tabPanels[key].style.flexGrow = isMobile ? (isActive ? '1'    : '')      : '';
        });
        tabBtns.forEach(function (btn) {
            var active = btn.dataset.bucketTab === tabName;
            btn.classList.toggle('text-orchid-600',    active);
            btn.classList.toggle('border-orchid-500',  active);
            btn.classList.toggle('text-woodsmoke-400', !active);
            btn.classList.toggle('border-transparent', !active);
        });
    }

    function resetMobileTabs() {
        if (isMobileLayout()) {
            switchBucketTab('details');
        } else {
            Object.keys(tabPanels).forEach(function (key) {
                tabPanels[key].style.display  = '';
                tabPanels[key].style.flexGrow = '';
            });
        }
    }

    tabBtns.forEach(function (btn) {
        btn.addEventListener('click', function () { switchBucketTab(btn.dataset.bucketTab); });
    });

    window.addEventListener('resize', function () {
        if (!modal.classList.contains('hidden')) resetMobileTabs();
    });

    // ── Open / Close ─────────────────────────────────────────────────────────
    function openModal() {
        resetState();
        resetUI();
        deleteBtn.disabled = true;               // not available in create mode
        if (modalStats)      modalStats.classList.add('hidden');
        if (modalViewerLink) modalViewerLink.classList.add('hidden');
        modal.classList.remove('hidden');
        resetMobileTabs();
        newLinkUrl.focus();
    }

    function closeModal() {
        modal.classList.add('hidden');
    }

    // Exposed globally so the profile page (and any other page) can open a bucket for editing
    window.openBucketModal = function (bucket) {
        // Populate state from existing bucket data
        state._editBucket  = { _id: bucket._id, name: bucket.name };
        state.links        = (bucket.links || []).map(function (l) {
            return { id: uid(), title: l.text || '', url: l.href || '', thumb: l.image || null, monetized: !l.isFree, checked: false, clickCount: l.clickCount || 0 };
        });
        state.tags         = bucket.hashtags || [];
        state.monetization = !!bucket.isPaywalled;
        state.mature       = !!bucket.mature;
        state.thumbnail    = bucket.thumbnail ? { dataUrl: bucket.thumbnail, visible: true } : null;

        // Capture visibility before resetUI overwrites state.visibility to 'public'
        var bucketVisibility = bucket.visibility || (bucket.isPublic ? 'public' : 'private');

        // Reset the UI using the populated state
        resetUI();

        // resetUI hardcodes toggles — fix them to match the bucket's actual settings
        setVisSegment(bucketVisibility);
        setToggle(monetizationToggle, state.monetization);
        monetizationToggle.disabled = bucketVisibility !== 'public';
        monetizationToggle.classList.toggle('opacity-40', bucketVisibility !== 'public');
        monetizationToggle.classList.toggle('cursor-not-allowed', bucketVisibility !== 'public');
        monetizationLabel.textContent = state.monetization ? 'Enabled' : 'Disabled';
        monetizationAmountPanel.classList.toggle('hidden', !state.monetization);
        if (state.monetization) monetizationAmountInput.value = bucket.price
            ? formatPriceDisplay(sanitisePriceRaw(String(bucket.price)))
            : '';
        setToggle(matureToggle, state.mature);

        // Set bucket name, description and source URL (resetUI clears them)
        nameInput.value = bucket.name;
        updateCharCount();
        descInput.value = bucket.description || '';
        descCharCount.textContent = (bucket.description || '').length + ' / 256';
        sourceUrlInput.value = bucket.sourceUrl || '';

        // Show thumbnail if present
        if (state.thumbnail) {
            thumbPlaceholder.classList.add('hidden');
            thumbPreview.src = state.thumbnail.dataUrl;
            thumbPreview.classList.remove('hidden');
            thumbActionBtns.classList.remove('hidden');
        }

        // Viewer link
        if (modalViewerLink) {
            modalViewerLink.href = '/v2/' + bucket._id;
            modalViewerLink.classList.remove('hidden');
        }

        // Populate + show stats block
        if (modalStats) {
            var grabs  = (bucket.grabbedBy  ? bucket.grabbedBy.length  : 0);
            var views  = bucket.viewCount  || 0;
            var shares = bucket.shareCount || 0;
            if (modalStatGrabs)  modalStatGrabs.textContent  = grabs.toLocaleString();
            if (modalStatViews)  modalStatViews.textContent  = views.toLocaleString();
            if (modalStatShares) modalStatShares.textContent = shares.toLocaleString();
            modalStats.classList.remove('hidden');
        }

        // Switch submit label to Update
        submitLabel.textContent = 'Update';

        // Enable delete button (edit mode) and reset its confirm state
        deleteBtn.disabled = false;
        deleteBtnLabel.textContent = 'Delete';
        deleteBtn.dataset.confirm = '';

        modal.classList.remove('hidden');
        resetMobileTabs();
    };

    if (triggerBtn) triggerBtn.addEventListener('click', function (e) { e.stopPropagation(); openModal(); });
    if (cancelBtn) cancelBtn.addEventListener('click', closeModal);
    if (backdrop)  backdrop.addEventListener('click', closeModal);

    // ── Delete bucket (two-tap confirm: first tap → "Confirm?", second → delete)
    deleteBtn.addEventListener('click', async function () {
        if (!state._editBucket) return;

        if (deleteBtn.dataset.confirm !== 'yes') {
            // First tap — ask for confirmation
            deleteBtn.dataset.confirm = 'yes';
            deleteBtnLabel.textContent = 'Confirm?';
            deleteBtn.classList.add('bg-red-500', 'text-white', 'border-red-500');
            // Auto-reset after 4 s if user does nothing
            setTimeout(function () {
                if (deleteBtn.dataset.confirm === 'yes') {
                    deleteBtn.dataset.confirm = '';
                    deleteBtnLabel.textContent = 'Delete';
                    deleteBtn.classList.remove('bg-red-500', 'text-white', 'border-red-500');
                }
            }, 4000);
            return;
        }

        // Second tap — proceed with deletion
        deleteBtn.disabled = true;
        deleteBtnLabel.textContent = 'Deleting…';
        try {
            var res = await fetch('/api/buckets/' + encodeURIComponent(state._editBucket.name), { method: 'DELETE', credentials: 'include' });
            if (res.ok) {
                closeModal();
                window.location.reload();
            } else {
                var data = await res.json().catch(function () { return {}; });
                showError(data.error || 'Failed to delete bucket.');
                deleteBtn.disabled = false;
                deleteBtn.dataset.confirm = '';
                deleteBtnLabel.textContent = 'Delete';
                deleteBtn.classList.remove('bg-red-500', 'text-white', 'border-red-500');
            }
        } catch {
            showError('Network error. Please try again.');
            deleteBtn.disabled = false;
            deleteBtn.dataset.confirm = '';
            deleteBtnLabel.textContent = 'Delete';
            deleteBtn.classList.remove('bg-red-500', 'text-white', 'border-red-500');
        }
    });
    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && !modal.classList.contains('hidden')) closeModal();
    });

    document.addEventListener('click', function () {
        document.querySelectorAll('.link-context-menu:not(.hidden)').forEach(function (m) { m.classList.add('hidden'); });
    });

    // ── Thumbnail ─────────────────────────────────────────────────────────────
    var thumbDropZone = document.getElementById('thumbDropZone');

    function loadThumbnailFile(file) {
        if (!file) return;
        if (!['image/jpeg', 'image/jpg', 'image/png'].includes(file.type)) {
            alert('Only JPG and PNG images are allowed.');
            return;
        }
        if (file.size > 5 * 1024 * 1024) {
            alert('Image must be under 5 MB.');
            return;
        }
        thumbPlaceholder.classList.add('hidden');
        thumbPreview.classList.add('hidden');
        thumbActionBtns.classList.add('hidden');
        thumbLoading.classList.remove('hidden');
        var reader = new FileReader();
        reader.onload = function (ev) {
            state.thumbnail = { dataUrl: ev.target.result, visible: true };
            thumbLoading.classList.add('hidden');
            thumbPreview.src = ev.target.result;
            thumbPreview.classList.remove('hidden');
            thumbActionBtns.classList.remove('hidden');
            thumbEyeOpen.classList.remove('hidden');
            thumbEyeClosed.classList.add('hidden');
        };
        reader.readAsDataURL(file);
    }

    thumbFileInput.addEventListener('change', function () {
        loadThumbnailFile(this.files[0]);
        this.value = '';
    });

    // Drag & drop
    thumbDropZone.addEventListener('dragover', function (e) {
        e.preventDefault();
        this.classList.add('border-orchid-400', 'bg-orchid-50', 'text-orchid-600');
        this.classList.remove('border-silver-300');
    });
    thumbDropZone.addEventListener('dragleave', function (e) {
        if (this.contains(e.relatedTarget)) return;
        this.classList.remove('border-orchid-400', 'bg-orchid-50', 'text-orchid-600');
        this.classList.add('border-silver-300');
    });
    thumbDropZone.addEventListener('drop', function (e) {
        e.preventDefault();
        this.classList.remove('border-orchid-400', 'bg-orchid-50', 'text-orchid-600');
        this.classList.add('border-silver-300');
        var file = e.dataTransfer.files[0];
        loadThumbnailFile(file);
    });

    thumbVisBtn.addEventListener('click', function () {
        if (!state.thumbnail) return;
        state.thumbnail.visible = !state.thumbnail.visible;
        if (state.thumbnail.visible) {
            thumbPreview.style.opacity = '1';
            thumbEyeOpen.classList.remove('hidden');
            thumbEyeClosed.classList.add('hidden');
        } else {
            thumbPreview.style.opacity = '0.25';
            thumbEyeOpen.classList.add('hidden');
            thumbEyeClosed.classList.remove('hidden');
        }
    });

    thumbDeleteBtn.addEventListener('click', function () {
        state.thumbnail = null;
        thumbPreview.src = '';
        thumbPreview.classList.add('hidden');
        thumbActionBtns.classList.add('hidden');
        thumbLoading.classList.add('hidden');
        thumbPlaceholder.classList.remove('hidden');
    });

    // ── Source URL ────────────────────────────────────────────────────────────
    copySourceBtn.addEventListener('click', function () {
        var v = sourceUrlInput.value.trim();
        if (!v) return;
        navigator.clipboard.writeText(v).catch(function () {});
    });

    deleteSourceBtn.addEventListener('click', function () {
        sourceUrlInput.value = '';
        sourceUrlInput.focus();
    });

    // ── Content input actions ─────────────────────────────────────────────────
    pasteLinkTitleBtn.addEventListener('click', function () {
        navigator.clipboard.readText().then(function (text) {
            newLinkTitle.value = text.trim();
            newLinkTitle.focus();
            updateAddBtn();
        }).catch(function () {});
    });

    clearLinkTitleBtn.addEventListener('click', function () {
        newLinkTitle.value = '';
        newLinkTitle.focus();
        updateAddBtn();
    });

    pasteLinkUrlBtn.addEventListener('click', function () {
        navigator.clipboard.readText().then(function (text) {
            newLinkUrl.value = text.trim();
            newLinkUrl.focus();
            updateAddBtn();
        }).catch(function () {});
    });

    clearLinkUrlBtn.addEventListener('click', function () {
        newLinkUrl.value = '';
        newLinkUrl.focus();
        updateAddBtn();
    });

    // ── Toggle switch helper ──────────────────────────────────────────────────
    function setToggle(btn, on) {
        var knob = btn.querySelector('span');
        if (on) {
            btn.classList.remove('bg-silver-200');
            btn.classList.add('bg-orchid-500');
            knob.classList.add('translate-x-7');
        } else {
            btn.classList.remove('bg-orchid-500');
            btn.classList.add('bg-silver-200');
            knob.classList.remove('translate-x-7');
        }
    }

    // ── Visibility segment helper ─────────────────────────────────────────────
    var VIS_LABELS = {
        public:   'Discoverable',
        unlisted: 'Link only',
        private:  'Curator only'
    };
    function setVisSegment(vis) {
        state.visibility = vis;
        visibilityLabel.textContent = VIS_LABELS[vis] || VIS_LABELS.private;
        visibilitySegment.querySelectorAll('.vis-seg').forEach(function (btn) {
            var active = btn.dataset.vis === vis;
            btn.classList.remove('bg-orchid-600', 'text-orchid-200', 'text-orchid-700', 'hover:bg-orchid-200');
            if (active) {
                btn.classList.add('bg-orchid-600', 'text-orchid-200');
            } else {
                btn.classList.add('text-orchid-700', 'hover:bg-orchid-200');
            }
        });
        // Monetization is only available for public buckets
        var canMonetize = vis === 'public';
        if (!canMonetize && state.monetization) {
            state.monetization = false;
            setToggle(monetizationToggle, false);
            monetizationLabel.textContent = 'Disabled';
            monetizationAmountPanel.classList.add('hidden');
            renderLinks();
        }
        monetizationToggle.disabled = !canMonetize;
        monetizationToggle.classList.toggle('opacity-40', !canMonetize);
        monetizationToggle.classList.toggle('cursor-not-allowed', !canMonetize);
    }

    visibilitySegment.querySelectorAll('.vis-seg').forEach(function (btn) {
        btn.addEventListener('click', function () { setVisSegment(this.dataset.vis); });
    });

    monetizationToggle.addEventListener('click', function () {
        state.monetization = !state.monetization;
        setToggle(this, state.monetization);
        monetizationLabel.textContent = state.monetization ? 'Enabled' : 'Disabled';
        monetizationAmountPanel.classList.toggle('hidden', !state.monetization);
        if (state.monetization) {
            state.links.forEach(function (l) { l.monetized = true; });
        }
        renderLinks();
    });

    // ── Refresh links from bookmarklet (reads localStorage set by popup.html) ──
    var refreshLinksBtn = document.getElementById('refreshLinksBtn');
    if (refreshLinksBtn) {
        refreshLinksBtn.addEventListener('click', function () {
            var raw = null;
            try { raw = localStorage.getItem('grabbn:parsedLinks'); } catch (_) {}
            if (!raw) {
                refreshLinksBtn.classList.add('text-red-400');
                setTimeout(function () { refreshLinksBtn.classList.remove('text-red-400'); }, 1500);
                return;
            }
            var parsed = null;
            try { parsed = JSON.parse(raw); } catch (_) {}
            if (!Array.isArray(parsed) || parsed.length === 0) return;
            var existing = new Set(state.links.map(function (l) { return l.url; }));
            var added = 0;
            parsed.forEach(function (l) {
                if (l.href && !existing.has(l.href)) {
                    state.links.push({ id: uid(), title: l.text || l.href, url: l.href, thumb: l.image || null, monetized: false, checked: false });
                    existing.add(l.href);
                    added++;
                }
            });
            if (added > 0) {
                try { localStorage.removeItem('grabbn:parsedLinks'); } catch (_) {}
                renderLinks();
                // Flash green to confirm
                refreshLinksBtn.classList.add('text-green-600', 'bg-green-100');
                setTimeout(function () { refreshLinksBtn.classList.remove('text-green-600', 'bg-green-100'); }, 1500);
            }
        });
    }

    monetizationAmountInput.addEventListener('input', function () {
        var cursor = this.selectionStart;
        var oldLen = this.value.length;
        var sanitised = sanitisePriceRaw(this.value);
        var formatted = formatPriceDisplay(sanitised);
        this.value = formatted;
        // nudge cursor to account for added/removed separator dots
        var delta = formatted.length - oldLen;
        this.setSelectionRange(cursor + delta, cursor + delta);
        updateFiatLine();
    });

    currencyToggleBtn.addEventListener('click', function () {
        var raw = parsePriceValue(monetizationAmountInput.value);
        if (currentCurrency === 'EWL') {
            // switching to USD: convert current EWL amount → USD
            currentCurrency = 'USD';
            var asUsd = raw * EWL_TO_USD;
            monetizationAmountInput.value = asUsd > 0 ? formatPriceDisplay(sanitisePriceRaw(asUsd.toFixed(2))) : '';
        } else {
            // switching to EWL: convert current USD amount → EWL
            currentCurrency = 'EWL';
            var asEwl = Math.round(raw / EWL_TO_USD);
            monetizationAmountInput.value = asEwl > 0 ? formatPriceDisplay(String(asEwl)) : '';
        }
        currencyToggleBtn.textContent = currentCurrency;
        updateFiatLine();
    });

    matureToggle.addEventListener('click', function () {
        state.mature = !state.mature;
        setToggle(this, state.mature);
    });

    // ── Tags ──────────────────────────────────────────────────────────────────
    function renderTags() {
        // Remove all existing tag chips (keep the input)
        var chips = tagsContainer.querySelectorAll('.tag-chip');
        chips.forEach(function (c) { c.remove(); });

        state.tags.forEach(function (tag) {
            var chip = document.createElement('span');
            chip.className = 'tag-chip flex items-center gap-1 px-3 py-1 rounded-md bg-orchid-100 text-orchid-700 text-sm font-medium';
            chip.innerHTML =
                '<span>' + escapeHtml(tag) + '</span>' +
                '<button type="button" class="flex items-center justify-center text-orchid-400 hover:text-orchid-700 transition-colors" data-tag="' + escapeHtml(tag) + '">' +
                    // mingcute:close-small-line
                    '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><g fill="none"><path d="m12.594 23.258l-.012.002l-.071.035l-.02.004l-.014-.004l-.071-.036q-.016-.004-.024.006l-.004.01l-.017.428l.005.02l.01.013l.104.074l.015.004l.012-.004l.104-.074l.012-.016l.004-.017l-.017-.427q-.004-.016-.016-.018m.264-.113l-.014.002l-.184.093l-.01.01l-.003.011l.018.43l.005.012l.008.008l.201.092q.019.005.029-.008l.004-.014l-.034-.614q-.005-.019-.02-.022m-.715.002a.02.02 0 0 0-.027.006l-.006.014l-.034.614q.001.018.017.024l.015-.002l.201-.093l.01-.008l.003-.011l.018-.43l-.003-.012l-.01-.01z"/><path fill="currentColor" d="M15.889 6.697a1.001 1.001 0 0 1 1.415 1.414L13.414 12l3.89 3.89a1 1 0 0 1-1.414 1.414L12 13.414l-3.889 3.89a1 1 0 1 1-1.414-1.414L10.586 12L6.697 8.11a1 1 0 0 1 1.414-1.414L12 10.586z"/></g></svg>' +
                '</button>';
            chip.querySelector('button').addEventListener('click', function () {
                var t = this.getAttribute('data-tag');
                state.tags = state.tags.filter(function (x) { return x !== t; });
                renderTags();
            });
            tagsContainer.insertBefore(chip, tagInput);
        });

        tagInput.classList.toggle('hidden', state.tags.length >= 8);
    }

    tagInput.addEventListener('keydown', function (e) {

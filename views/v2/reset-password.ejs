<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Password — Grabbn</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Jost:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/tailwind/output.css">
    <style>
        button[aria-disabled="true"] { opacity: 0.5; cursor: not-allowed; }
        button[aria-disabled="true"]:hover { background-color: #c026d3; }
    </style>
</head>
<body class="bg-gray-50 min-h-screen flex items-center justify-center px-4 py-8">

    <div class="max-w-md w-full">
        <!-- Logo/Header -->
        <div class="text-center mb-8">
            <h1 class="text-3xl font-bold text-gray-800 mb-2">Grabbn &bull; Link Grabber</h1>
            <p class="text-gray-600">Choose a new password</p>
        </div>

        <!-- Request Form (shown when no token in URL) -->
        <div id="requestCard" class="bg-white rounded-lg shadow-lg p-8 hidden">
            <form id="requestForm" class="space-y-4">
                <div>
                    <label for="email" class="block text-sm font-medium text-gray-700 mb-2">
                        Email Address
                    </label>
                    <input
                        type="email"
                        id="email"
                        name="email"
                        required
                        autofocus
                        class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-orchid-500 focus:border-transparent"
                        placeholder="you@example.com"
                    >
                </div>

                <div id="requestError" class="hidden bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg text-sm"></div>
                <div id="requestSuccess" class="hidden bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-lg text-sm"></div>

                <button
                    type="submit"
                    id="requestBtn"
                    aria-disabled="true"
                    class="w-full bg-orchid-600 hover:bg-orchid-700 text-white font-semibold py-3 px-4 rounded-lg transition-colors"
                >
                    Send Reset Link
                </button>
            </form>

            <div class="mt-6 text-center">
                <a href="/v2/login" class="text-sm font-semibold text-orchid-600 hover:text-orchid-700">
                    &larr; Back to Log In
                </a>
            </div>
        </div>

        <!-- Reset Form (shown when token is in URL) -->
        <div id="resetCard" class="bg-white rounded-lg shadow-lg p-8 hidden">
            <form id="resetForm" class="space-y-4">
                <div>
                    <label for="password" class="block text-sm font-medium text-gray-700 mb-2">New Password</label>
                    <div class="relative">
                        <input
                            type="password"
                            id="password"
                            name="password"
                            required
                            minlength="8"
                            class="w-full px-4 py-3 pr-12 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-orchid-500 focus:border-transparent"
                            placeholder="••••••••"
                        >
                        <button
                            type="button"
                            id="togglePassword"
                            class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-500 hover:text-gray-700 focus:outline-none p-1"
                            aria-label="Toggle password visibility"
                        >
                            <svg id="passwordEyeOpen" xmlns="http://www.w3.org/2000/svg" width="21" height="21" viewBox="0 0 24 24">
                                <path fill="currentColor" d="M14.591 14.091q1.063-1.062 1.063-2.591T14.59 8.909T12 7.846T9.409 8.91T8.346 11.5t1.063 2.591T12 15.154t2.591-1.063m-4.503-.678Q9.3 12.625 9.3 11.5t.788-1.912T12 8.8t1.913.788t.787 1.912t-.787 1.913T12 14.2t-1.912-.787M6.56 16.43q-2.474-1.57-3.997-4.116q-.125-.205-.178-.404t-.053-.411t.053-.41t.178-.406Q4.087 8.14 6.56 6.57T12 5t5.44 1.57t3.997 4.115q.125.205.178.404t.052.411t-.052.41t-.178.406q-1.523 2.545-3.997 4.115T12 18t-5.44-1.57m10.628-.917Q19.55 14.025 20.8 11.5q-1.25-2.525-3.613-4.012T12 6T6.813 7.488T3.2 11.5q1.25 2.525 3.613 4.013T12 17t5.188-1.487"/>
                            </svg>
                            <svg id="passwordEyeClosed" class="hidden" xmlns="http://www.w3.org/2000/svg" width="21" height="21" viewBox="0 0 24 24">
                                <path fill="currentColor" d="M14.579 8.921q.494.495.822 1.314t.266 1.602q0 .202-.14.339q-.14.138-.342.138t-.34-.138t-.137-.34q.067-.669-.142-1.25q-.21-.58-.635-1.005t-1.025-.64t-1.256-.13q-.202.02-.359-.111t-.176-.333t.109-.358t.33-.176q.796-.1 1.634.218t1.39.87M12 6q-.59 0-1.165.066q-.576.067-1.14.205q-.214.056-.388-.057t-.241-.303q-.068-.207.039-.38t.314-.229q.633-.163 1.278-.233Q11.342 5 12 5q3.021 0 5.58 1.55t3.962 4.216q.1.18.14.354t.041.38t-.037.38t-.138.354q-.47.924-1.122 1.712t-1.434 1.456q-.165.14-.363.12q-.198-.022-.333-.199q-.134-.177-.106-.368q.027-.192.193-.332q.754-.652 1.369-1.433q.615-.78 1.048-1.69q-1.25-2.525-3.613-4.012T12 6m0 12q-2.966 0-5.452-1.562t-3.99-4.128q-.125-.181-.178-.39t-.053-.42t.05-.417t.175-.392q.615-1.039 1.364-1.97q.75-.933 1.734-1.644L3.21 4.631q-.14-.147-.147-.347q-.007-.201.153-.361q.159-.16.353-.16t.354.16l16.154 16.154q.14.14.153.341t-.153.366q-.16.16-.354.16t-.354-.16l-3.538-3.526q-.894.41-1.862.576Q13.002 18 12 18M6.358 7.785q-1.033.707-1.835 1.646q-.802.938-1.323 2.069q1.25 2.525 3.613 4.013T12 17q.789 0 1.562-.11q.773-.111 1.504-.398l-1.632-1.642q-.332.19-.688.247t-.746.057q-1.529 0-2.591-1.063T8.346 11.5q0-.39.067-.746t.237-.688zm4.354 4.354"/>
                            </svg>
                        </button>
                    </div>
                    <div id="passwordRequirements" class="text-xs mt-2 space-y-1">
                        <p class="text-gray-600 font-medium">Password must contain:</p>
                        <div class="grid grid-cols-2 gap-1 ml-2">
                            <p id="req-length" class="text-red-600">✗ 8+ characters</p>
                            <p id="req-lowercase" class="text-red-600">✗ 2 lowercase</p>
                            <p id="req-uppercase" class="text-red-600">✗ 2 uppercase</p>
                            <p id="req-digit" class="text-red-600">✗ 2 digits</p>
                            <p id="req-special" class="text-red-600">✗ 2 special chars</p>
                        </div>
                    </div>
                </div>

                <div>
                    <label for="passwordConfirm" class="block text-sm font-medium text-gray-700 mb-2">Confirm New Password</label>
                    <div class="relative">
                        <input
                            type="password"
                            id="passwordConfirm"
                            name="passwordConfirm"
                            required
                            minlength="8"
                            class="w-full px-4 py-3 pr-12 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-orchid-500 focus:border-transparent"
                            placeholder="••••••••"
                        >
                        <button
                            type="button"
                            id="togglePasswordConfirm"
                            class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-500 hover:text-gray-700 focus:outline-none p-1"
                            aria-label="Toggle password visibility"
                        >
                            <svg id="passwordConfirmEyeOpen" xmlns="http://www.w3.org/2000/svg" width="21" height="21" viewBox="0 0 24 24">
                                <path fill="currentColor" d="M14.591 14.091q1.063-1.062 1.063-2.591T14.59 8.909T12 7.846T9.409 8.91T8.346 11.5t1.063 2.591T12 15.154t2.591-1.063m-4.503-.678Q9.3 12.625 9.3 11.5t.788-1.912T12 8.8t1.913.788t.787 1.912t-.787 1.913T12 14.2t-1.912-.787M6.56 16.43q-2.474-1.57-3.997-4.116q-.125-.205-.178-.404t-.053-.411t.053-.41t.178-.406Q4.087 8.14 6.56 6.57T12 5t5.44 1.57t3.997 4.115q.125.205.178.404t.052.411t-.052.41t-.178.406q-1.523 2.545-3.997 4.115T12 18t-5.44-1.57m10.628-.917Q19.55 14.025 20.8 11.5q-1.25-2.525-3.613-4.012T12 6T6.813 7.488T3.2 11.5q1.25 2.525 3.613 4.013T12 17t5.188-1.487"/>
                            </svg>
                            <svg id="passwordConfirmEyeClosed" class="hidden" xmlns="http://www.w3.org/2000/svg" width="21" height="21" viewBox="0 0 24 24">
                                <path fill="currentColor" d="M14.579 8.921q.494.495.822 1.314t.266 1.602q0 .202-.14.339q-.14.138-.342.138t-.34-.138t-.137-.34q.067-.669-.142-1.25q-.21-.58-.635-1.005t-1.025-.64t-1.256-.13q-.202.02-.359-.111t-.176-.333t.109-.358t.33-.176q.796-.1 1.634.218t1.39.87M12 6q-.59 0-1.165.066q-.576.067-1.14.205q-.214.056-.388-.057t-.241-.303q-.068-.207.039-.38t.314-.229q.633-.163 1.278-.233Q11.342 5 12 5q3.021 0 5.58 1.55t3.962 4.216q.1.18.14.354t.041.38t-.037.38t-.138.354q-.47.924-1.122 1.712t-1.434 1.456q-.165.14-.363.12q-.198-.022-.333-.199q-.134-.177-.106-.368q.027-.192.193-.332q.754-.652 1.369-1.433q.615-.78 1.048-1.69q-1.25-2.525-3.613-4.012T12 6m0 12q-2.966 0-5.452-1.562t-3.99-4.128q-.125-.181-.178-.39t-.053-.42t.05-.417t.175-.392q.615-1.039 1.364-1.97q.75-.933 1.734-1.644L3.21 4.631q-.14-.147-.147-.347q-.007-.201.153-.361q.159-.16.353-.16t.354.16l16.154 16.154q.14.14.153.341t-.153.366q-.16.16-.354.16t-.354-.16l-3.538-3.526q-.894.41-1.862.576Q13.002 18 12 18M6.358 7.785q-1.033.707-1.835 1.646q-.802.938-1.323 2.069q1.25 2.525 3.613 4.013T12 17q.789 0 1.562-.11q.773-.111 1.504-.398l-1.632-1.642q-.332.19-.688.247t-.746.057q-1.529 0-2.591-1.063T8.346 11.5q0-.39.067-.746t.237-.688zm4.354 4.354"/>
                            </svg>
                        </button>
                    </div>
                    <p id="passwordMatchValidation" class="text-xs mt-1 hidden"></p>
                </div>

                <div id="resetError" class="hidden bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg text-sm"></div>
                <div id="resetSuccess" class="hidden bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-lg text-sm"></div>

                <button
                    type="submit"
                    id="resetBtn"
                    aria-disabled="true"
                    class="w-full bg-orchid-600 hover:bg-orchid-700 text-white font-semibold py-3 px-4 rounded-lg transition-colors"
                >
                    Reset Password
                </button>
            </form>
        </div>

        <!-- Back to home -->
        <div class="mt-6 text-center">
            <a href="/" class="text-sm text-gray-600 hover:text-gray-800">
                &larr; Back to Home
            </a>
        </div>
    </div>

    <script type="module">
        const params = new URLSearchParams(window.location.search);
        const token = params.get('token');

        const requestCard = document.getElementById('requestCard');
        const resetCard = document.getElementById('resetCard');

        function setupToggle(toggleId, inputId, eyeOpenId, eyeClosedId) {
            const btn = document.getElementById(toggleId);
            const input = document.getElementById(inputId);
            const eyeOpen = document.getElementById(eyeOpenId);
            const eyeClosed = document.getElementById(eyeClosedId);
            if (!btn || !input) return;
            btn.addEventListener('click', () => {
                const isPassword = input.type === 'password';
                input.type = isPassword ? 'text' : 'password';
                eyeOpen.classList.toggle('hidden', isPassword);
                eyeClosed.classList.toggle('hidden', !isPassword);
            });
        }

        setupToggle('togglePassword', 'password', 'passwordEyeOpen', 'passwordEyeClosed');
        setupToggle('togglePasswordConfirm', 'passwordConfirm', 'passwordConfirmEyeOpen', 'passwordConfirmEyeClosed');

        function validatePassword(password) {
            const requirements = {
                length: password.length >= 8,
                lowercase: (password.match(/[a-z]/g) || []).length >= 2,
                uppercase: (password.match(/[A-Z]/g) || []).length >= 2,
                digit: (password.match(/[0-9]/g) || []).length >= 2,
                special: (password.match(/[^a-zA-Z0-9]/g) || []).length >= 2
            };
            return { valid: Object.values(requirements).every(r => r), requirements };
        }

        function setReq(id, valid, text) {
            const el = document.getElementById(id);
            el.textContent = text;
            el.className = valid ? 'text-green-600' : 'text-red-600';
        }

        function updateRequirements(password) {
            if (!password) {
                setReq('req-length', false, '✗ 8+ characters');
                setReq('req-lowercase', false, '✗ 2 lowercase');
                setReq('req-uppercase', false, '✗ 2 uppercase');
                setReq('req-digit', false, '✗ 2 digits');
                setReq('req-special', false, '✗ 2 special chars');
                return;
            }
            const { requirements: r } = validatePassword(password);
            setReq('req-length',    r.length,    r.length    ? '✓ 8+ characters' : '✗ 8+ characters');
            setReq('req-lowercase', r.lowercase, r.lowercase ? '✓ 2 lowercase'   : '✗ 2 lowercase');
            setReq('req-uppercase', r.uppercase, r.uppercase ? '✓ 2 uppercase'   : '✗ 2 uppercase');
            setReq('req-digit',     r.digit,     r.digit     ? '✓ 2 digits'      : '✗ 2 digits');
            setReq('req-special',   r.special,   r.special   ? '✓ 2 special chars' : '✗ 2 special chars');
        }

        if (!token) {
            requestCard.classList.remove('hidden');

            const emailInput = document.getElementById('email');
            const requestBtn = document.getElementById('requestBtn');
            const requestError = document.getElementById('requestError');
            const requestSuccess = document.getElementById('requestSuccess');

            emailInput.addEventListener('input', () => {
                requestBtn.setAttribute('aria-disabled', String(!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailInput.value.trim())));
            });

            document.getElementById('requestForm').addEventListener('submit', async (e) => {
                e.preventDefault();
                if (requestBtn.getAttribute('aria-disabled') === 'true') return;

                requestError.classList.add('hidden');
                requestSuccess.classList.add('hidden');
                requestBtn.setAttribute('aria-disabled', 'true');
                requestBtn.textContent = 'Sending...';

                try {
                    const response = await fetch('/api/auth/forgot-password', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ email: emailInput.value.trim() })
                    });
                    const data = await response.json();
                    if (!response.ok) throw new Error(data.error || 'Request failed');
                    requestSuccess.textContent = data.message;
                    requestSuccess.classList.remove('hidden');
                    requestBtn.textContent = 'Send Reset Link';
                } catch (error) {
                    requestError.textContent = error.message;
                    requestError.classList.remove('hidden');
                    requestBtn.textContent = 'Send Reset Link';
                    requestBtn.setAttribute('aria-disabled', String(!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailInput.value.trim())));
                }
            });

        } else {
            resetCard.classList.remove('hidden');

            const passwordInput = document.getElementById('password');
            const passwordConfirmInput = document.getElementById('passwordConfirm');
            const resetBtn = document.getElementById('resetBtn');
            const resetError = document.getElementById('resetError');
            const resetSuccess = document.getElementById('resetSuccess');
            const passwordMatchValidation = document.getElementById('passwordMatchValidation');

            function validateResetForm() {
                const pw = passwordInput.value;
                const pwc = passwordConfirmInput.value;
                const pwValid = validatePassword(pw).valid;
                const match = pw && pw === pwc;

                if (!pwc) {
                    passwordMatchValidation.classList.add('hidden');
                } else if (!match) {
                    passwordMatchValidation.textContent = '✗ Passwords do not match';
                    passwordMatchValidation.className = 'text-xs mt-1 text-red-600';
                    passwordMatchValidation.classList.remove('hidden');
                } else {
                    passwordMatchValidation.textContent = '✓ Passwords match';
                    passwordMatchValidation.className = 'text-xs mt-1 text-green-600';
                    passwordMatchValidation.classList.remove('hidden');
                }

                resetBtn.setAttribute('aria-disabled', !(pwValid && match));
            }

            passwordInput.addEventListener('input', () => {
                updateRequirements(passwordInput.value);
                validateResetForm();
            });
            passwordConfirmInput.addEventListener('input', validateResetForm);

            document.getElementById('resetForm').addEventListener('submit', async (e) => {
                e.preventDefault();
                if (resetBtn.getAttribute('aria-disabled') === 'true') return;

                resetError.classList.add('hidden');
                resetSuccess.classList.add('hidden');
                resetBtn.setAttribute('aria-disabled', 'true');
                resetBtn.textContent = 'Resetting...';

                try {
                    const response = await fetch('/api/auth/reset-password', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ token, password: passwordInput.value })
                    });
                    const data = await response.json();
                    if (!response.ok) throw new Error(data.error || 'Reset failed');

                    resetSuccess.textContent = 'Password reset successfully! Redirecting to login...';
                    resetSuccess.classList.remove('hidden');
                    setTimeout(() => { window.location.href = '/v2/login'; }, 2000);
                } catch (error) {
                    resetError.textContent = error.message;
                    resetError.classList.remove('hidden');
                    resetBtn.textContent = 'Reset Password';
                    validateResetForm();
                }
            });
        }
    </script>
</body>
</html>

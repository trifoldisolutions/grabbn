    var titleEl    = document.getElementById('docsModalTitle');
    var iconEl     = document.getElementById('docsModalIcon');
    var bodyEl     = document.getElementById('docsModalBody');

    function openModal(key) {
        var doc = DOCS[key];
        if (!doc) return;
        titleEl.textContent = doc.title;
        iconEl.innerHTML = document.querySelector('[data-doc="' + key + '"] .rounded-md').innerHTML;
        bodyEl.innerHTML = doc.content;
        bodyEl.scrollTop = 0;
        modal.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
    }

    function closeModal() {
        modal.classList.add('hidden');
        document.body.style.overflow = '';
    }

    document.querySelectorAll('.doc-card').forEach(function (card) {
        card.addEventListener('click', function () {
            openModal(card.dataset.doc);
        });
    });

    closeBtn.addEventListener('click', closeModal);
    backdrop.addEventListener('click', closeModal);
    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') closeModal();
    });

}());
</script>

<%- include('partials/layout-end') %>

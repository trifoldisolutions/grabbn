<%
  title = 'Docs'
  page  = 'docs'
%>
<%- include('partials/layout') %>

<div class="max-w-[992px] mx-auto px-6 py-8 space-y-10">

    <!-- Section: Your Documents (logged-in users only) -->
    <% if (user && !user.isAnonymous) { %>
    <div id="yourDocumentsSection" class="space-y-3">
        <div>
            <h2 class="text-xs font-semibold text-woodsmoke-500 uppercase tracking-wider">Your Documents</h2>
            <p class="text-xs text-woodsmoke-400 mt-1">Documents you have submitted to Grabbn for verification.</p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3" id="docCardsGrid">

            <!-- Government ID card -->
            <div class="border border-silver-200 rounded-md p-4 space-y-3">
                <div class="flex items-start gap-3">
                    <div class="w-8 h-8 rounded-md bg-orchid-50 flex items-center justify-center shrink-0 mt-0.5 text-orchid-600">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><g fill="none" fill-rule="evenodd"><path d="m12.593 23.258l-.011.002l-.071.035l-.02.004l-.014-.004l-.071-.035q-.016-.005-.024.005l-.004.01l-.017.428l.005.02l.01.013l.104.074l.015.004l.012-.004l.104-.074l.012-.016l.004-.017l-.017-.427q-.004-.016-.017-.018m.265-.113l-.013.002l-.185.093l-.01.01l-.003.011l.018.43l.005.012l.008.007l.201.093q.019.005.029-.008l.004-.014l-.034-.614q-.005-.018-.02-.022m-.715.002a.02.02 0 0 0-.027.006l-.006.014l-.034.614q.001.018.017.024l.015-.002l.201-.093l.01-.008l.004-.011l.017-.43l-.003-.012l-.01-.01z"/><path fill="currentColor" d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2M4 6h16v2H4zm0 4h5v2H4zm0 4h5v2H4zm7-4h9v2h-9zm0 4h9v2h-9z"/></g></svg>
                    </div>
                    <div class="flex-1 min-w-0">
                        <div class="text-sm font-semibold text-woodsmoke-900">Government-issued ID</div>
                        <div class="text-xs text-woodsmoke-400 mt-0.5 leading-relaxed">Passport, driver's licence, or national ID card.</div>
                    </div>
                </div>
                <div id="govIdStatus" class="text-xs text-woodsmoke-400">Loading…</div>
                <div id="govIdDropzone" class="hidden border-2 border-dashed border-silver-200 rounded-md p-5 text-center cursor-pointer hover:border-orchid-300 transition-colors">
                    <div id="govIdPlaceholder" class="space-y-1">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" class="mx-auto text-woodsmoke-300"><path fill="currentColor" d="M19 13a1 1 0 0 0-1 1v.38l-1.48-1.48a2.79 2.79 0 0 0-3.93 0l-.7.7l-2.48-2.48a2.85 2.85 0 0 0-3.93 0L4 12.6V7a1 1 0 0 1 1-1h7a1 1 0 0 0 0-2H5a3 3 0 0 0-3 3v12a3 3 0 0 0 3 3h12a3 3 0 0 0 3-3v-5a1 1 0 0 0-1-1M5 20a1 1 0 0 1-1-1v-3.57l2.9-2.9a.79.79 0 0 1 1.09 0l3.17 3.17l.91.9L15.46 20zm13-1a1 1 0 0 1-.18.54L13.31 15l.7-.7a.77.77 0 0 1 1.1 0L18 17.21zm4.71-14.71l-3-3a1 1 0 0 0-.33-.21a1 1 0 0 0-.76 0a1 1 0 0 0-.33.21l-3 3a1 1 0 0 0 1.42 1.42L19 4.41V10a1 1 0 0 0 2 0V4.41l1.29 1.3a1 1 0 0 0 1.42 0a1 1 0 0 0 0-1.42"/></svg>
                        <div class="text-xs text-woodsmoke-400">Click or drag to upload</div>
                        <div class="text-xs text-woodsmoke-300">JPG or PNG — max 5 MB</div>
                    </div>
                    <img id="govIdPreview" class="hidden max-h-24 mx-auto rounded-md object-contain" />
                </div>
                <input type="file" id="govIdFile" accept="image/*" class="hidden" />
                <button id="govIdSubmit" style="display:none" class="w-full py-2 bg-orchid-600 hover:bg-orchid-700 text-white text-xs font-semibold rounded-md transition-colors flex items-center justify-center gap-1.5">
                    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24"><path fill="currentColor" d="M12 2a1 1 0 0 1 .707.293l4 4a1 1 0 0 1-1.414 1.414L13 5.414V15a1 1 0 1 1-2 0V5.414L8.707 7.707A1 1 0 0 1 7.293 6.293l4-4A1 1 0 0 1 12 2zM4 17a1 1 0 0 1 1 1v2h14v-2a1 1 0 1 1 2 0v2a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-2a1 1 0 0 1 1-1z"/></svg>
                    <span>Upload ID</span>
                </button>
            </div>

            <!-- Selfie card -->
            <div class="border border-silver-200 rounded-md p-4 space-y-3">
                <div class="flex items-start gap-3">
                    <div class="w-8 h-8 rounded-md bg-orchid-50 flex items-center justify-center shrink-0 mt-0.5 text-orchid-600">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><g fill="none"><path fill="currentColor" d="M9 2a1 1 0 0 0 0 2h6a1 1 0 1 0 0-2zm-4 4a3 3 0 0 0-3 3v9a3 3 0 0 0 3 3h14a3 3 0 0 0 3-3V9a3 3 0 0 0-3-3zm7 2a5 5 0 1 1 0 10A5 5 0 0 1 12 8m0 2a3 3 0 1 0 0 6a3 3 0 0 0 0-6"/></g></svg>
                    </div>
                    <div class="flex-1 min-w-0">
                        <div class="text-sm font-semibold text-woodsmoke-900">Selfie with ID</div>
                        <div class="text-xs text-woodsmoke-400 mt-0.5 leading-relaxed">A photo of you holding your government-issued ID.</div>
                    </div>
                </div>
                <div id="selfieStatus" class="text-xs text-woodsmoke-400">Loading…</div>
                <div id="selfieDropzone" class="hidden border-2 border-dashed border-silver-200 rounded-md p-5 text-center cursor-pointer hover:border-orchid-300 transition-colors">
                    <div id="selfiePlaceholder" class="space-y-1">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" class="mx-auto text-woodsmoke-300"><path fill="currentColor" d="M9 2a1 1 0 0 0 0 2h6a1 1 0 1 0 0-2zm-4 4a3 3 0 0 0-3 3v9a3 3 0 0 0 3 3h14a3 3 0 0 0 3-3V9a3 3 0 0 0-3-3zm7 2a5 5 0 1 1 0 10A5 5 0 0 1 12 8m0 2a3 3 0 1 0 0 6a3 3 0 0 0 0-6"/></svg>
                        <div class="text-xs text-woodsmoke-400">Click or drag to upload</div>
                        <div class="text-xs text-woodsmoke-300">JPG or PNG — max 5 MB</div>
                    </div>
                    <img id="selfiePreview" class="hidden max-h-24 mx-auto rounded-md object-contain" />

                    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24"><path fill="currentColor" d="M12 2a1 1 0 0 1 .707.293l4 4a1 1 0 0 1-1.414 1.414L13 5.414V15a1 1 0 1 1-2 0V5.414L8.707 7.707A1 1 0 0 1 7.293 6.293l4-4A1 1 0 0 1 12 2zM4 17a1 1 0 0 1 1 1v2h14v-2a1 1 0 1 1 2 0v2a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-2a1 1 0 0 1 1-1z"/></svg>
                    <span>Upload Selfie</span>
                </button>
            </div>

            <!-- Tax form card (coming soon) -->
            <div class="border border-silver-100 rounded-md p-4 space-y-3 bg-silver-50/40">
                <div class="flex items-start gap-3">
                    <div class="w-8 h-8 rounded-md bg-silver-100 flex items-center justify-center shrink-0 mt-0.5 text-woodsmoke-400">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><g fill="none" fill-rule="evenodd"><path d="m12.593 23.258l-.011.002l-.071.035l-.02.004l-.014-.004l-.071-.035q-.016-.005-.024.005l-.004.01l-.017.428l.005.02l.01.013l.104.074l.015.004l.012-.004l.104-.074l.012-.016l.004-.017l-.017-.427q-.004-.016-.017-.018m.265-.113l-.013.002l-.185.093l-.01.01l-.003.011l.018.43l.005.012l.008.007l.201.093q.019.005.029-.008l.004-.014l-.034-.614q-.005-.018-.02-.022m-.715.002a.02.02 0 0 0-.027.006l-.006.014l-.034.614q.001.018.017.024l.015-.002l.201-.093l.01-.008l.004-.011l.017-.43l-.003-.012l-.01-.01z"/><path fill="currentColor" d="M18 2a2 2 0 0 1 2 2v10h-6.5a1.5 1.5 0 0 0-1.5 1.5V22H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2zm1.957 14a2 2 0 0 1-.543 1L15 21.414a2 2 0 0 1-1 .543V16zM10 11H9a1 1 0 1 0 0 2h1a1 1 0 1 0 0-2m5-4H9a1 1 0 0 0 0 2h6a1 1 0 1 0 0-2"/></g></svg>
                    </div>
                    <div class="flex-1 min-w-0">
                        <div class="flex items-center gap-2">
                            <span class="text-sm font-semibold text-woodsmoke-500">Tax Form (W-9)</span>
                            <span class="text-xs font-medium text-woodsmoke-400 bg-silver-100 px-2 py-0.5 rounded-md">Coming soon</span>
                        </div>
                        <div class="text-xs text-woodsmoke-400 mt-0.5 leading-relaxed">Required for partners receiving payouts in the US.</div>
                    </div>
                </div>
                <div class="text-xs text-woodsmoke-300">This will be required when the payout system launches.</div>
            </div>

        </div>
    </div>
    <% } %>

    <!-- Section: Legal -->
    <div class="space-y-3">
        <h2 class="text-xs font-semibold text-woodsmoke-500 uppercase tracking-wider">Legal</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">

            <button data-doc="tos" class="doc-card text-left flex items-start gap-3 p-4 border border-silver-200 rounded-md hover:border-orchid-300 hover:bg-orchid-50/30 transition-colors group">
                <div class="w-8 h-8 rounded-md bg-orchid-50 flex items-center justify-center shrink-0 mt-0.5 text-orchid-600">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><g fill="none" fill-rule="evenodd"><path d="m12.593 23.258l-.011.002l-.071.035l-.02.004l-.014-.004l-.071-.035q-.016-.005-.024.005l-.004.01l-.017.428l.005.02l.01.013l.104.074l.015.004l.012-.004l.104-.074l.012-.016l.004-.017l-.017-.427q-.004-.016-.017-.018m.265-.113l-.013.002l-.185.093l-.01.01l-.003.011l.018.43l.005.012l.008.007l.201.093q.019.005.029-.008l.004-.014l-.034-.614q-.005-.018-.02-.022m-.715.002a.02.02 0 0 0-.027.006l-.006.014l-.034.614q.001.018.017.024l.015-.002l.201-.093l.01-.008l.004-.011l.017-.43l-.003-.012l-.01-.01z"/><path fill="currentColor" d="M18 2a2 2 0 0 1 2 2v10h-6.5a1.5 1.5 0 0 0-1.5 1.5V22H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2zm1.957 14a2 2 0 0 1-.543 1L15 21.414a2 2 0 0 1-1 .543V16zM10 11H9a1 1 0 1 0 0 2h1a1 1 0 1 0 0-2m5-4H9a1 1 0 0 0 0 2h6a1 1 0 1 0 0-2"/></g></svg>
